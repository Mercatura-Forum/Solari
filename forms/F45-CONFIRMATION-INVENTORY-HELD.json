{
 "id": "F45-CONFIRMATION-INVENTORY-HELD",
 "number": 45,
 "kind": "letter",
 "phase": "fieldwork",
 "title": {
  "en": "Confirmation of inventory held by others",
  "ar": "مصادقة على مخزون محتفظ به لدى الغير"
 },
 "purpose": {
  "en": "Request a warehouse or custodian's direct confirmation of the entity's goods in its custody at the period end, by description and quantity.",
  "ar": "طلب مصادقة المستودع أو أمين الحفظ مباشرةً على بضائع المنشأة في عهدته في نهاية الفترة، بالوصف والكمية."
 },
 "procedures": [
  "P-INV-004"
 ],
 "standards": [
  "ISA-501",
  "ISA-505"
 ],
