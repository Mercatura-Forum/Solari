     },
     "type": "yesno",
     "required": true
    },
    {
     "id": "prior_modified",
     "label": {
      "en": "Prior period report modified",
      "ar": "تقرير الفترة السابقة معدل"
     },
     "type": "select",
     "required": true,
     "options": [
      {
       "value": "yes",
       "label": {
        "en": "Yes",
        "ar": "نعم"
       }
      },
      {
       "value": "no",
       "label": {
        "en": "No",
        "ar": "لا"
       }
      },
      {
       "value": "na",
       "label": {
        "en": "Not applicable",
        "ar": "لا ينطبق"
       }
      }
     ]
    },
    {
     "id": "other_information",
     "label": {
      "en": "Other information read and considered",
      "ar": "المعلومات الأخرى التي تمت قراءتها والنظر فيها"
     },
     "type": "table",
     "required": false,
     "columns": [
      {
       "id": "document",
       "label": {
        "en": "Document",
        "ar": "المستند"
       },
       "type": "text",
       "required": true
      },
      {
       "id": "read",
       "label": {
        "en": "Read",
        "ar": "تمت قراءته"
       },
       "type": "yesno",
       "required": true
      },
      {
       "id": "inconsistencies",
       "label": {
        "en": "Material inconsistencies and their resolution",
        "ar": "التناقضات الجوهرية وكيفية حلها"
       },
       "type": "textarea",
       "required": false
      }
     ]
    }
   ]
  },
  {
   "id": "checklist",
   "title": {
    "en": "Disclosure checklist and open items",
    "ar": "قائمة الإفصاحات والبنود المفتوحة"
   },
   "fields": [
    {
     "id": "open_disclosures",
     "label": {
      "en": "Disclosure checklist items open",
      "ar": "بنود قائمة الإفصاحات المفتوحة"
