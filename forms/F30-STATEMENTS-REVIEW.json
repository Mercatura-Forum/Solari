{
 "id": "F30-STATEMENTS-REVIEW",
 "number": 30,
 "kind": "worksheet",
 "phase": "completion",
 "title": {
  "en": "Financial statements review",
  "ar": "فحص القوائم المالية"
 },
 "purpose": {
  "en": "Review the financial statements as a whole: the final analytical review, the tie-out of the statements to the leadsheets, the comparatives, the other information, the closing process and presentation, and the disclosure checklist.",
  "ar": "فحص القوائم المالية ككل: الفحص التحليلي النهائي، ومطابقة القوائم مع كشوف الحسابات، والمعلومات المقارنة، والمعلومات الأخرى، وعملية الإقفال والعرض، وقائمة الإفصاحات."
 },
 "procedures": [
  "P-FSL-040",
  "P-FSL-041",
  "P-FSL-042",
  "P-FSL-043",
  "P-FSL-057"
 ],
 "standards": [
  "ISA-520",
  "ISA-700",
  "ISA-710",
  "ISA-720",
  "ISA-330",
  "ISA-450"
 ],
 "computation": "analytical_review",
 "sections": [
  {
   "id": "engagement",
   "title": {
    "en": "Engagement",
    "ar": "الارتباط"
   },
   "fields": [
    {
     "id": "client",
     "label": {
      "en": "Entity audited",
      "ar": "المنشأة محل المراجعة"
     },
     "type": "text",
     "required": false,
     "autofill": "engagement.client",
     "readonly": true
    },
    {
     "id": "period_start",
     "label": {
      "en": "Period from",
      "ar": "الفترة من"
     },
     "type": "date",
     "required": false,
     "autofill": "engagement.period_start",
     "readonly": true
    },
    {
     "id": "period_end",
     "label": {
      "en": "Period to",
      "ar": "الفترة إلى"
     },
     "type": "date",
     "required": false,
     "autofill": "engagement.period_end",
     "readonly": true
    },
    {
     "id": "framework",
     "label": {
      "en": "Financial reporting framework",
      "ar": "إطار التقرير المالي"
     },
     "type": "text",
     "required": false,
     "autofill": "engagement.framework",
     "readonly": true
    }
   ]
  },
  {
   "id": "analytics",
   "title": {
    "en": "Final analytical review",
    "ar": "الفحص التحليلي النهائي"
   },
   "fields": [
    {
     "id": "lines",
     "label": {
      "en": "Lines reviewed against an expectation from the prior period and its growth",
      "ar": "البنود المفحوصة مقابل توقع من الفترة السابقة ونموها"
     },
     "type": "table",
     "required": true,
     "columns": [
      {
       "id": "name",
       "label": {
        "en": "Line",
        "ar": "البند"
       },
       "type": "text",
       "required": true
      },
      {
       "id": "recorded",
       "label": {
        "en": "Recorded",
        "ar": "المسجل"
       },
       "type": "money",
       "required": true
      },
      {
       "id": "prior",
       "label": {
        "en": "Prior period",
        "ar": "الفترة السابقة"
       },
       "type": "money",
       "required": true
      },
      {
       "id": "growth_pct",
       "label": {
        "en": "Expected growth (percent)",
        "ar": "النمو المتوقع (نسبة)"
       },
       "type": "percent",
       "required": true
      }
     ]
    },
    {
     "id": "performance_materiality",
     "label": {
      "en": "Performance materiality",
      "ar": "مادية الأداء"
     },
     "type": "money",
     "required": false,
     "autofill": "paper.materiality.performance",
     "readonly": true
    },
    {
     "id": "lines_examined",
     "label": {
      "en": "Lines examined",
      "ar": "البنود المفحوصة"
     },
     "type": "integer",
     "required": false,
     "autofill": "paper.analytical_review.lines_examined",
     "readonly": true
    },
    {
     "id": "lines_flagged",
     "label": {
      "en": "Lines to investigate",
      "ar": "البنود الواجب استقصاؤها"
     },
     "type": "integer",
     "required": false,
     "autofill": "paper.analytical_review.lines_flagged",
     "readonly": true
    },
    {
     "id": "explanations",
     "label": {
      "en": "Explanations obtained and corroborated for the lines flagged",
      "ar": "التفسيرات التي تم الحصول عليها وتأييدها للبنود المعلَّمة"
     },
     "type": "textarea",
     "required": true
    }
   ],
   "note": {
    "en": "Compute the paper from the lines before signing; the analytical review and, when statement lines are entered, the tie-out are computed together.",
    "ar": "تُحتسب الورقة من البنود قبل التوقيع؛ ويُحتسب الفحص التحليلي، وعند إدخال بنود القوائم، المطابقة معًا."
   }
  },
  {
   "id": "tieout",
   "title": {
    "en": "Tie-out of the statements",
    "ar": "مطابقة القوائم"
   },
   "fields": [
    {
     "id": "statement_lines",
     "label": {
      "en": "Statement lines and the leadsheets they present",
      "ar": "بنود القوائم وكشوف الحسابات التي تعرضها"
     },
     "type": "table",
     "required": false,
     "columns": [
      {
       "id": "line_id",
       "label": {
        "en": "Line",
        "ar": "البند"
       },
       "type": "text",
       "required": true
      },
      {
       "id": "caption",
       "label": {
        "en": "Caption",
        "ar": "العنوان"
       },
       "type": "text",
       "required": true
      },
      {
       "id": "presented",
       "label": {
        "en": "Amount presented",
        "ar": "المبلغ المعروض"
       },
       "type": "money",
       "required": true
      },
      {
       "id": "leadsheets",
       "label": {
        "en": "Leadsheets (comma separated)",
        "ar": "كشوف الحسابات (مفصولة بفواصل)"
       },
       "type": "text",
       "required": true
      },
      {
       "id": "sign",
       "label": {
        "en": "Sign",
        "ar": "الإشارة"
       },
       "type": "select",
       "required": true,
       "options": [
        {
         "value": "1",
         "label": {
          "en": "Debit positive",
          "ar": "المدين موجب"
         }
        },
        {
         "value": "-1",
         "label": {
          "en": "Credit positive",
          "ar": "الدائن موجب"
         }
        }
       ]
      }
     ]
    },
    {
     "id": "agrees",
     "label": {
      "en": "Every line agrees to its leadsheets",
      "ar": "كل بند يتطابق مع كشوف حساباته"
     },
     "type": "text",
     "required": false,
     "autofill": "paper.tieout.agrees",
     "readonly": true
    },
    {
     "id": "lines_differing",
     "label": {
      "en": "Lines that differ",
      "ar": "البنود المختلفة"
     },
     "type": "integer",
     "required": false,
     "autofill": "paper.tieout.lines_differing",
     "readonly": true
    },
    {
     "id": "closing_process",
     "label": {
      "en": "Evaluation of the closing process, the consolidation and the presentation",
      "ar": "تقييم عملية الإقفال والتوحيد والعرض"
     },
     "type": "textarea",
     "required": true
    }
   ]
  },
  {
   "id": "comparatives",
   "title": {
    "en": "Comparatives and other information",
    "ar": "المعلومات المقارنة والمعلومات الأخرى"
   },
   "fields": [
    {
     "id": "prior_auditor",
     "label": {
      "en": "Prior period audited by",
      "ar": "الفترة السابقة راجعها"
     },
     "type": "select",
     "required": true,
     "options": [
      {
       "value": "us",
       "label": {
        "en": "This firm",
        "ar": "هذا المكتب"
       }
      },
      {
       "value": "predecessor",
       "label": {
        "en": "A predecessor auditor",
        "ar": "مراجع سابق"
       }
      },
      {
       "value": "unaudited",
       "label": {
        "en": "Not audited",
        "ar": "لم تُراجع"
       }
      }
     ]
    },
    {
     "id": "comparatives_agree",
     "label": {
      "en": "Comparatives agree to the prior period's statements and policies are consistent",
