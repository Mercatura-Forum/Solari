     "type": "integer",
     "required": false,
     "autofill": "disclosures.open",
     "readonly": true
    },
    {
     "id": "open_review_notes",
     "label": {
      "en": "Review notes open",
      "ar": "ملاحظات الفحص المفتوحة"
     },
     "type": "integer",
     "required": false,
     "autofill": "records.RK-REVIEW-NOTE.open",
     "readonly": true
    },
    {
     "id": "open_procedures",
     "label": {
      "en": "Procedures of the programme open",
      "ar": "إجراءات البرنامج المفتوحة"
     },
     "type": "integer",
     "required": false,
     "autofill": "programme.open",
     "readonly": true
    },
    {
     "id": "conclusion",
     "label": {
      "en": "Conclusion on the financial statements as a whole",
      "ar": "الاستنتاج بشأن القوائم المالية ككل"
     },
     "type": "select",
     "required": true,
     "options": [
      {
       "value": "appropriate",
       "label": {
        "en": "Prepared, in all material respects, in accordance with the framework",
        "ar": "معدة، من جميع الجوانب الجوهرية، وفقًا للإطار"
       }
      },
      {
       "value": "exceptions",
       "label": {
        "en": "Exceptions carried to the misstatement evaluation and the report",
        "ar": "استثناءات مرحّلة إلى تقييم التحريفات والتقرير"
       }
      }
     ]
    }
   ]
  }
 ],
