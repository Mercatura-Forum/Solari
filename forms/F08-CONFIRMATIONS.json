   "partner",
   "manager",
   "senior",
   "staff"
  ],
  "review": [
   "partner",
   "manager"
  ],
  "approve": [
   "partner",
   "manager"
  ]
 },
 "version": 1,
 "ar_status": "draft_pending_review"
}