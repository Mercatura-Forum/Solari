{
 "id": "F08-CONFIRMATIONS",
 "number": 8,
 "kind": "letter",
 "phase": "fieldwork",
 "title": {
  "en": "External confirmation request and control log",
  "ar": "طلب المصادقة الخارجية وسجل متابعتها"
 },
 "purpose": {
  "en": "Maintain control over external confirmation requests from sending to receipt, and record exceptions and alternative procedures.",
  "ar": "الحفاظ على الرقابة على طلبات المصادقة الخارجية من الإرسال حتى الاستلام، وتسجيل الاستثناءات والإجراءات البديلة."
 },
 "procedures": [
  "P-TRE-001"
 ],
 "standards": [
  "ISA-505"
 ],
 "sections": [
  {
   "id": "engagement",
   "title": {
    "en": "Engagement",
    "ar": "الارتباط"
   },
   "fields": [
    {
     "id": "client",
     "label": {
      "en": "Entity audited",
      "ar": "المنشأة محل المراجعة"
     },
     "type": "text",
     "required": false,
     "autofill": "engagement.client",
     "readonly": true
    },
    {
     "id": "period_start",
     "label": {
      "en": "Period from",
      "ar": "الفترة من"
     },
     "type": "date",
     "required": false,
     "autofill": "engagement.period_start",
     "readonly": true
    },
    {
     "id": "period_end",
     "label": {
      "en": "Period to",
      "ar": "الفترة إلى"
     },
     "type": "date",
     "required": false,
     "autofill": "engagement.period_end",
     "readonly": true
    },
    {
     "id": "framework",
     "label": {
      "en": "Financial reporting framework",
      "ar": "إطار التقرير المالي"
     },
     "type": "text",
     "required": false,
     "autofill": "engagement.framework",
     "readonly": true
    }
   ]
  },
  {
   "id": "request",
   "title": {
    "en": "Request",
    "ar": "الطلب"
   },
   "fields": [
    {
     "id": "confirming_party",
     "label": {
      "en": "Confirming party",
      "ar": "الطرف المصادِق"
     },
     "type": "text",
     "required": true
    },
    {
     "id": "confirmation_type",
     "label": {
      "en": "Type",
      "ar": "النوع"
     },
     "type": "select",
     "required": true,
     "options": [
      {
       "value": "bank",
       "label": {
        "en": "Bank balances and facilities",
        "ar": "أرصدة وتسهيلات بنكية"
       }
      },
      {
       "value": "receivable",
       "label": {
        "en": "Receivable",
        "ar": "مدينون"
       }
      },
      {
       "value": "payable",
       "label": {
        "en": "Payable",
        "ar": "دائنون"
       }
      },
      {
       "value": "legal",
       "label": {
        "en": "Legal counsel",
        "ar": "مستشار قانوني"
       }
      },
      {
       "value": "other",
       "label": {
        "en": "Other",
        "ar": "أخرى"
       }
      }
     ]
    },
    {
     "id": "balance",
     "label": {
      "en": "Balance per the entity's records",
      "ar": "الرصيد وفقًا لسجلات المنشأة"
     },
     "type": "money",
     "required": true
    },
    {
     "id": "reply_to",
     "label": {
      "en": "Reply directly to (auditor address)",
      "ar": "يُرد مباشرةً إلى (عنوان المراجع)"
