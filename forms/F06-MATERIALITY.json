 "title": {
  "en": "Materiality",
  "ar": "الأهمية النسبية"
 },
 "purpose": {
  "en": "Determine overall materiality, performance materiality, specific materiality and the clearly trivial threshold, with the rationale for each judgment.",
  "ar": "تحديد الأهمية النسبية الإجمالية ومادية الأداء والأهمية النسبية المحددة وحد المبالغ التافهة بشكل واضح، مع مبررات كل حكم."
 },
