{
 "id": "F50-BIOLOGICAL-COUNT",
 "number": 50,
 "kind": "checklist",
 "phase": "fieldwork",
 "requires_leadsheet": "LS-BIO",
 "title": {
  "en": "Biological assets count attendance",
  "ar": "حضور جرد الأصول الحيوية"
 },
 "purpose": {
  "en": "Record attendance at the count of livestock, crops and bearer plants: the categories counted and how, the holdings with third parties, the basis on which they are measured, and the roll-forward of the carrying amount to the reporting date, agreed to the leadsheet.",
  "ar": "توثيق حضور جرد الثروة الحيوانية والمحاصيل والنباتات المثمرة: الفئات المعدودة وطريقة العدّ، والموجودات لدى الغير، وأساس قياسها، وترحيل القيمة الدفترية إلى تاريخ التقرير ومطابقتها للورقة الرئيسية."
 },
 "procedures": [
  "P-INV-002",
  "P-INV-003",
  "P-INV-004"
 ],
 "standards": [
  "ISA-501",
  "ISA-540",
  "ISA-620",
  "ISA-330"
 ],
 "sections": [
