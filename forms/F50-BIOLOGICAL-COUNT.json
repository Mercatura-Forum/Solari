         "value": "livestock",
         "label": {
          "en": "Livestock",
          "ar": "الثروة الحيوانية"
         }
        },
        {
         "value": "crops",
         "label": {
          "en": "Crops and produce before harvest",
          "ar": "المحاصيل والمنتجات قبل الحصاد"
         }
        },
        {
         "value": "bearer_plants",
         "label": {
          "en": "Bearer plants and orchards",
          "ar": "النباتات المثمرة والبساتين"
         }
        }
       ]
      },
      {
       "id": "opening",
       "label": {
