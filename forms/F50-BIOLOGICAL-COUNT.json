   },
   "fields": [
    {
     "id": "sch_bio",
     "label": {
      "en": "Biological assets movement schedule",
      "ar": "جدول حركة Biological assets"
     },
     "type": "table",
     "required": false,
     "columns": [
      {
       "id": "component",
       "label": {
        "en": "Component",
        "ar": "المكوّن"
       },
       "type": "select",
       "required": true,
       "options": [
