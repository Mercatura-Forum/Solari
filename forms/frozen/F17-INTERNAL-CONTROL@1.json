 "title": {
  "en": "Internal control evaluation, walkthroughs and tests of controls",
  "ar": "تقييم الرقابة الداخلية والتتبع واختبارات الرقابة"
 },
 "purpose": {
  "en": "Record the understanding and evaluation of the components of the system of internal control, the walkthroughs of the significant processes, the tests of controls relied upon, and the deficiencies identified.",
