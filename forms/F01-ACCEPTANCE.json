{
 "id": "F01-ACCEPTANCE",
 "number": 1,
 "kind": "checklist",
 "phase": "planning",
 "title": {
  "en": "Client acceptance and continuance",
  "ar": "قبول العميل والاستمرار في الارتباط"
 },
 "purpose": {
  "en": "Decide whether the firm may accept or continue the engagement, including the independence of the firm and every team member.",
  "ar": "تقرير ما إذا كان يجوز للمكتب قبول الارتباط أو الاستمرار فيه، بما في ذلك استقلال المكتب وكل عضو في فريق الارتباط."
 },
 "procedures": [
  "P-FSL-001",
  "P-FSL-002",
  "P-FSL-004"
 ],
 "standards": [
  "ISQM-1",
  "ISA-220",
  "ISA-210",
  "IESBA-CODE"
 ],
 "sections": [
  {
   "id": "engagement",
   "title": {
    "en": "Engagement",
    "ar": "الارتباط"
   },
   "fields": [
    {
     "id": "client",
     "label": {
      "en": "Entity audited",
      "ar": "المنشأة محل المراجعة"
     },
     "type": "text",
     "required": false,
     "autofill": "engagement.client",
     "readonly": true
    },
    {
