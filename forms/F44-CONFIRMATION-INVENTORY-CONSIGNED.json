{
 "id": "F44-CONFIRMATION-INVENTORY-CONSIGNED",
 "number": 44,
 "kind": "letter",
 "phase": "fieldwork",
 "title": {
  "en": "Confirmation of inventory consigned to others",
  "ar": "مصادقة على مخزون مودع لدى الغير"
 },
 "purpose": {
  "en": "Request a consignee's direct confirmation of the entity's goods it holds on consignment at the period end, by description and quantity.",
  "ar": "طلب مصادقة المودَع لديه مباشرةً على بضائع المنشأة التي يحتفظ بها لديه على سبيل الأمانة في نهاية الفترة، بالوصف والكمية."
 },
 "procedures": [
  "P-INV-004"
 ],
 "standards": [
  "ISA-501",
  "ISA-505"
 ],
