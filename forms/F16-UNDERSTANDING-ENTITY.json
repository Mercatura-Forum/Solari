{
 "id": "F16-UNDERSTANDING-ENTITY",
 "number": 16,
 "kind": "worksheet",
 "phase": "planning",
 "title": {
  "en": "Understanding the entity and its environment",
  "ar": "فهم المنشأة وبيئتها"
 },
 "purpose": {
  "en": "Record the understanding of the entity, its environment and the applicable framework, the preliminary analytical review, service organisations, the internal audit function and, on an initial engagement, the opening balances.",
  "ar": "توثيق فهم المنشأة وبيئتها والإطار المطبق، والفحص التحليلي الأولي، ومؤسسات الخدمة، ووظيفة المراجعة الداخلية، والأرصدة الافتتاحية في ارتباط المراجعة الأولي."
 },
