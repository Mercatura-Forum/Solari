{
 "id": "F40-BALANCE-ANALYTICS",
 "number": 40,
 "kind": "worksheet",
 "phase": "fieldwork",
 "per": "leadsheet",
 "title": {
  "en": "Substantive analytical procedure: {leadsheet_name} ({leadsheet})",
  "ar": "إجراء تحليلي أساسي: {leadsheet_name} ({leadsheet})"
 },
 "purpose": {
  "en": "Build an expectation for the balance, set the difference that is acceptable without investigation, compare the recorded balance with the expectation, and investigate any difference beyond it.",
  "ar": "بناء توقع للرصيد، وتحديد الفرق المقبول دون فحص، ومقارنة الرصيد المسجل بالتوقع، وفحص أي فرق يتجاوزه."
 },
 "procedures": [],
 "standards": [
  "ISA-520",
  "ISA-330"
 ],
 "computation": "analytical_review",
 "sections": [
  {
   "id": "engagement",
   "title": {
    "en": "Engagement",
    "ar": "الارتباط"
   },
   "fields": [
    {
     "id": "client",
     "label": {
      "en": "Entity audited",
      "ar": "المنشأة محل المراجعة"
     },
     "type": "text",
     "required": false,
     "autofill": "engagement.client",
     "readonly": true
    },
    {
     "id": "period_start",
     "label": {
      "en": "Period from",
      "ar": "الفترة من"
     },
     "type": "date",
     "required": false,
     "autofill": "engagement.period_start",
     "readonly": true
    },
    {
     "id": "period_end",
     "label": {
      "en": "Period to",
      "ar": "الفترة إلى"
     },
     "type": "date",
     "required": false,
     "autofill": "engagement.period_end",
     "readonly": true
    },
    {
     "id": "framework",
     "label": {
      "en": "Financial reporting framework",
      "ar": "إطار التقرير المالي"
     },
     "type": "text",
     "required": false,
     "autofill": "engagement.framework",
     "readonly": true
    }
   ]
  },
  {
   "id": "balance",
   "title": {
    "en": "The balance",
    "ar": "الرصيد"
   },
   "fields": [
    {
     "id": "recorded",
     "label": {
      "en": "Recorded balance, adjusted ({leadsheet})",
      "ar": "الرصيد المسجل بعد التعديل ({leadsheet})"
     },
     "type": "money",
     "required": false,
     "autofill": "tb.leadsheet.{leadsheet}",
     "readonly": true
    },
    {
     "id": "prior",
     "label": {
      "en": "Prior period balance",
      "ar": "رصيد الفترة السابقة"
     },
     "type": "money",
     "required": false,
     "autofill": "tb.leadsheet.{leadsheet}.prior",
     "readonly": true
    },
    {
     "id": "performance_materiality",
     "label": {
      "en": "Performance materiality",
      "ar": "مادية الأداء"
     },
     "type": "money",
     "required": false,
     "autofill": "paper.materiality.performance",
     "readonly": true
    },
    {
     "id": "suitability",
     "label": {
      "en": "Why a substantive analytical procedure suits the assertions on this balance",
      "ar": "لماذا يناسب الإجراء التحليلي الأساسي التأكيدات على هذا الرصيد"
     },
     "type": "textarea",
     "required": true
    },
    {
     "id": "data_reliability",
     "label": {
      "en": "Reliability of the data the expectation is built from: source, controls over it, and evidence of its accuracy",
      "ar": "موثوقية البيانات التي بُني عليها التوقع: مصدرها، والرقابة عليها، وأدلة دقتها"
     },
     "type": "textarea",
     "required": true
    }
   ],
   "note": {
    "en": "The recorded balance is the leadsheet's adjusted balance, frozen when the paper is prepared; a later trial balance or a booked entry drifts it.",
    "ar": "الرصيد المسجل هو الرصيد المعدّل للورقة الرئيسية، ويُثبت عند إعداد الورقة؛ ويؤدي ميزان لاحق أو قيد مقيد إلى انحرافه."
   }
  },
  {
   "id": "expectation",
   "title": {
    "en": "The expectation and its precision",
    "ar": "التوقع ودقته"
   },
   "fields": [
    {
     "id": "model",
     "label": {
      "en": "How the expectation is built",
      "ar": "كيفية بناء التوقع"
     },
     "type": "select",
     "required": true,
     "options": [
      {
       "value": "prior_growth",
       "label": {
        "en": "Prior period balance grown by a rate",
        "ar": "رصيد الفترة السابقة مضافاً إليه معدل نمو"
       }
      },
      {
       "value": "driver_product",
       "label": {
        "en": "Product of drivers (volume by price, balance by rate)",
        "ar": "حاصل ضرب المحركات (الكمية في السعر، الرصيد في المعدل)"
       }
      },
      {
       "value": "ratio_to_base",
       "label": {
        "en": "Ratio to a base balance",
        "ar": "نسبة إلى رصيد أساس"
       }
      },
      {
       "value": "proof_in_total",
       "label": {
        "en": "Proof in total from components",
        "ar": "إثبات إجمالي من المكونات"
       }
      }
     ]
    },
    {
     "id": "growth_pct",
     "label": {
      "en": "Growth rate applied to the prior balance (percent)",
      "ar": "معدل النمو المطبق على الرصيد السابق (بالمئة)"
     },
     "type": "percent",
     "required": false
    },
    {
     "id": "drivers",
     "label": {
      "en": "Drivers multiplied together",
      "ar": "المحركات المضروبة معاً"
     },
     "type": "table",
     "required": false,
     "columns": [
      {
       "id": "name",
       "label": {
        "en": "Driver",
        "ar": "المحرك"
       },
       "type": "text",
       "required": true
      },
      {
       "id": "value",
       "label": {
        "en": "Value",
        "ar": "القيمة"
       },
       "type": "money",
       "required": true
      }
     ]
    },
    {
     "id": "base",
     "label": {
      "en": "Base balance",
      "ar": "الرصيد الأساس"
     },
     "type": "money",
     "required": false
    },
    {
     "id": "ratio_pct",
     "label": {
      "en": "Ratio applied to the base (percent)",
      "ar": "النسبة المطبقة على الأساس (بالمئة)"
     },
     "type": "percent",
     "required": false
    },
    {
     "id": "components",
     "label": {
      "en": "Components summed",
      "ar": "المكونات المجمّعة"
     },
     "type": "table",
     "required": false,
     "columns": [
      {
       "id": "name",
       "label": {
        "en": "Component",
        "ar": "المكوّن"
       },
       "type": "text",
       "required": true
      },
      {
       "id": "amount",
       "label": {
        "en": "Amount",
        "ar": "المبلغ"
       },
       "type": "money",
       "required": true
      }
     ]
    },
    {
     "id": "threshold_pct",
     "label": {
      "en": "Acceptable difference as a share of performance materiality (percent)",
      "ar": "الفرق المقبول كنسبة من مادية الأداء (بالمئة)"
     },
     "type": "percent",
     "required": true,
     "default": "50"
    },
    {
     "id": "minimum_amount",
     "label": {
      "en": "Acceptable difference, minimum amount",
      "ar": "الفرق المقبول، الحد الأدنى"
     },
     "type": "money",
     "required": false
    },
    {
     "id": "precision",
     "label": {
      "en": "Why this expectation is precise enough to identify a material misstatement",
      "ar": "لماذا يُعد هذا التوقع دقيقاً بما يكفي لتحديد تحريف جوهري"
     },
     "type": "textarea",
     "required": true
    }
   ],
   "note": {
    "en": "Fill the inputs the chosen model needs, then compute the paper: the expectation, the threshold and the difference are read from the computation and frozen when the paper is prepared.",
    "ar": "املأ المدخلات التي يحتاجها النموذج المختار ثم احسب الورقة: يُقرأ التوقع والحد والفرق من الاحتساب وتُثبت عند إعداد الورقة."
   }
  },
  {
   "id": "results",
   "title": {
    "en": "The comparison",
    "ar": "المقارنة"
   },
   "fields": [
    {
     "id": "expected",
     "label": {
      "en": "Expected balance",
      "ar": "الرصيد المتوقع"
     },
     "type": "money",
     "required": false,
     "autofill": "paper.analytical_review.lines.0.expected",
     "readonly": true
    },
    {
     "id": "threshold",
     "label": {
      "en": "Acceptable difference",
      "ar": "الفرق المقبول"
     },
     "type": "money",
     "required": false,
     "autofill": "paper.analytical_review.threshold",
     "readonly": true
    },
    {
     "id": "difference",
     "label": {
      "en": "Difference, recorded less expected",
      "ar": "الفرق، المسجل ناقص المتوقع"
     },
     "type": "money",
     "required": false,
     "autofill": "paper.analytical_review.lines.0.difference",
     "readonly": true
    },
    {
     "id": "difference_pct",
     "label": {
      "en": "Difference as a share of the expectation (percent)",
      "ar": "الفرق كنسبة من التوقع (بالمئة)"
     },
     "type": "text",
     "required": false,
     "autofill": "paper.analytical_review.lines.0.difference_pct",
     "readonly": true
    },
    {
     "id": "investigate",
     "label": {
      "en": "Difference beyond the acceptable amount",
      "ar": "الفرق يتجاوز المقبول"
     },
     "type": "text",
     "required": false,
     "autofill": "paper.analytical_review.lines.0.investigate",
     "readonly": true
    }
   ]
  },
  {
   "id": "investigation",
   "title": {
    "en": "Investigation and conclusion",
    "ar": "الفحص والاستنتاج"
   },
   "fields": [
    {
     "id": "investigation",
     "label": {
      "en": "Inquiry of management and the further procedures performed on the difference",
      "ar": "الاستفسار من الإدارة والإجراءات الإضافية المنفذة على الفرق"
     },
     "type": "textarea",
     "required": false,
     "required_if": {
      "field": "investigate",
      "equals": true,
      "message": {
       "en": "a difference beyond the acceptable amount is investigated before the paper is prepared",
       "ar": "يُفحص الفرق الذي يتجاوز المقبول قبل إعداد الورقة"
      }
     }
    },
    {
     "id": "corroboration",
     "label": {
      "en": "Evidence obtained for management's explanation",
      "ar": "الأدلة التي تم الحصول عليها لتفسير الإدارة"
     },
     "type": "textarea",
     "required": false
    },
    {
     "id": "conclusion",
     "label": {
      "en": "Conclusion",
      "ar": "الاستنتاج"
     },
     "type": "select",
     "required": true,
     "options": [
      {
       "value": "consistent",
       "label": {
        "en": "The recorded balance is consistent with the expectation",
        "ar": "الرصيد المسجل متسق مع التوقع"
       }
      },
      {
       "value": "explained",
       "label": {
        "en": "The difference is explained and corroborated",
        "ar": "الفرق مفسر ومدعوم بأدلة"
       }
      },
      {
       "value": "misstatement",
       "label": {
        "en": "A misstatement is indicated and recorded",
        "ar": "يوجد مؤشر على تحريف وتم تسجيله"
       }
      },
      {
       "value": "inconclusive",
       "label": {
        "en": "Inconclusive: another procedure is performed",
        "ar": "غير حاسم: يُنفذ إجراء آخر"
       }
      }
     ]
    },
    {
     "id": "rationale",
     "label": {
      "en": "Rationale",
      "ar": "المبررات"
     },
     "type": "textarea",
     "required": true
    }
   ],
   "note": {
    "en": "ISA 520.7: a difference beyond the acceptable amount is investigated by inquiring of management and obtaining evidence for the responses, and by other procedures as necessary.",
    "ar": "معيار المراجعة الدولي 520.7: يُفحص الفرق الذي يتجاوز المقبول بالاستفسار من الإدارة والحصول على أدلة لردودها، وبإجراءات أخرى عند الحاجة."
   }
  }
 ],
 "signoff": {
  "prepare": [
   "partner",
   "manager",
   "senior",
   "staff"
  ],
  "review": [
   "partner",
   "manager"
  ],
  "approve": [
   "partner"
  ]
 },
 "version": 1,
 "ar_status": "draft_pending_review"
}