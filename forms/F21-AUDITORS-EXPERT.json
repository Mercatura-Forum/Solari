 "title": {
  "en": "Use of an auditor's expert and management's expert",
  "ar": "استخدام خبير المراجع وخبير الإدارة"
 },
 "purpose": {
  "en": "Document the need for an expert, the evaluation of the expert's competence, capabilities and objectivity, the terms of the work, and the evaluation of its adequacy for the auditor's purposes.",
  "ar": "توثيق الحاجة إلى خبير، وتقييم كفاءته وقدراته وموضوعيته، وشروط العمل، وتقييم كفاية عمله لأغراض المراجع."
 },
