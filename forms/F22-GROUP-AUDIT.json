{
 "id": "F22-GROUP-AUDIT",
 "number": 22,
 "kind": "worksheet",
 "phase": "planning",
 "title": {
  "en": "Group audit plan and instructions to component auditors",
  "ar": "خطة مراجعة المجموعة والتعليمات إلى مراجعي المكونات"
 },
 "purpose": {
  "en": "Set the group audit strategy: the components and their scope, component performance materiality checked against the group's, the significant risks at group level, the instructions and communications with component auditors, and the group completion.",
  "ar": "وضع استراتيجية مراجعة المجموعة: المكونات ونطاقها، ومادية الأداء للمكونات مقابل مادية المجموعة، والمخاطر المهمة على مستوى المجموعة، والتعليمات والاتصالات مع مراجعي المكونات، وإنجاز مراجعة المجموعة."
 },
 "procedures": [
  "P-FSL-021",
  "P-FSL-048"
 ],
 "standards": [
  "ISA-600",
  "ISA-320",
  "ISA-330"
 ],
