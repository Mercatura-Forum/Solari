figures += 3; check("TAX x VA", Py.natOr(cell("TAX", "VA"), "controls", 99) == 0 and Py.natOr(cell("TAX", "VA"), "relied_on", 99) == 0 and Py.natOr(cell("TAX", "VA"), "effective", 99) == 0);
