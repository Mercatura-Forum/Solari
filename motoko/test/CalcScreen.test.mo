eria_count\":1,\"entry_id\":\"J019\",\"lines\":3,\"posting_date\":\"2025-11-27\",\"prepared_by\":\"cfo\",\"source\":\"subledger\"}],\"flagged_by_criterion\":{\"PC-MANUAL\":2,\"PC-POST-CLOSE\":1,\"PC-REVERSAL-AFTER-PERIOD\":1,\"PC-SELDOM-USED-ACCOUNT\":4,\"PC-SELF-APPROVED\":2,\"PC-UNUSUAL-ACCOUNT\":3},\"flagged_entries\":5,\"population_entries\":6,\"population_lines\":16}"),
