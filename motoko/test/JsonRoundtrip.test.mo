  ("[\u{a}  {\u{a}    \"name\": \"Linear trend over four prior periods, current outside the band\",\u{a}    \"input\": {\u{a}      \"series\": [\u{a}        {\u{a}          \"period\": \"2021\",\u{a}          \"value\": \"100\"\u{a}        },\u{a}        {\u{a}          \"period\": \"2022\",\u{a}          \"value\": \"110\"\u{a}        },\u{a}        {\u{a}          \"period\": \"2023\",\u{a}          \"value\": \"121\"\u{a}        },\u{a}        {\u{a}          \"period\": \"2024\",\u{a}          \"value\": \"133\"\u{a}        },\u{a}        {\u{a}          \"period\": \"2025\",\u{a}          \"value\": \"170\"\u{a}        }\u{a}      ],\u{a}      \"method\": \"linear\",\u{a}      \"precision_pct\": \"10\"\u{a}    },\u{a}    \"expected\": {\u{a}      \"method\": \"linear\",\u{a}      \"periods_used\": 4,\u{a}      \"expected\": \"143.50\",\u{a}      \"range_low\": \"129.15\",\u{a}      \"range_high\": \"157.85\",\u{a}      \"actual\": \"170.00\",\u{a}      \"difference\": \"26.50\",\u{a}      \"outside_range\": true\u{a}    }\u{a}  },\u{a}  {\u{a}    \"name\": \"Mean of prior periods with a wide band\",\u{a}    \"input\": {\u{a}      \"series\": [\u{a}        {\u{a}          \"period\": \"2021\",\u{a}          \"value\": \"100\"\u{a}        },\u{a}        {\u{a}          \"period\": \"2022\",\u{a}          \"value\": \"110\"\u{a}        },\u{a}        {\u{a}          \"period\": \"2023\",\u{a}          \"value\": \"121\"\u{a}        },\u{a}        {\u{a}          \"period\": \"2024\",\u{a}          \"value\": \"133\"\u{a}        },\u{a}        {\u{a}          \"period\": \"2025\",\u{a}          \"value\": \"170\"\u{a}        }\u{a}      ],\u{a}      \"method\": \"mean\",\u{a}      \"precision_pct\": \"50\"\u{a}    },\u{a}    \"expected\": {\u{a}      \"method\": \"mean\",\u{a}      \"periods_used\": 4,\u{a}      \"expected\": \"116.00\",\u{a}      \"range_low\": \"58.00\",\u{a}      \"range_high\": \"174.00\",\u{a}      \"actual\": \"170.00\",\u{a}      \"difference\": \"54.00\",\u{a}      \"outside_range\": false\u{a}    }\u{a}  },\u{a}  {\u{a}    \"name\": \"Too few periods is refused\",\u{a}    \"input\": {\u{a}      \"series\": [\u{a}        {\u{a}          \"period\": \"2021\",\u{a}          \"value\": \"100\"\u{a}        },\u{a}        {\u{a}          \"period\": \"2022\",\u{a}          \"value\": \"110\"\u{a}        }\u{a}      ]\u{a}    },\u{a}    \"expected_error\": \"need at least two prior periods and the current period\"\u{a}  }\u{a}]", "[{\"expected\":{\"actual\":\"170.00\",\"difference\":\"26.50\",\"expected\":\"143.50\",\"method\":\"linear\",\"outside_range\":true,\"periods_used\":4,\"range_high\":\"157.85\",\"range_low\":\"129.15\"},\"input\":{\"method\":\"linear\",\"precision_pct\":\"10\",\"series\":[{\"period\":\"2021\",\"value\":\"100\"},{\"period\":\"2022\",\"value\":\"110\"},{\"period\":\"2023\",\"value\":\"121\"},{\"period\":\"2024\",\"value\":\"133\"},{\"period\":\"2025\",\"value\":\"170\"}]},\"name\":\"Linear trend over four prior periods, current outside the band\"},{\"expected\":{\"actual\":\"170.00\",\"difference\":\"54.00\",\"expected\":\"116.00\",\"method\":\"mean\",\"outside_range\":false,\"periods_used\":4,\"range_high\":\"174.00\",\"range_low\":\"58.00\"},\"input\":{\"method\":\"mean\",\"precision_pct\":\"50\",\"series\":[{\"period\":\"2021\",\"value\":\"100\"},{\"period\":\"2022\",\"value\":\"110\"},{\"period\":\"2023\",\"value\":\"121\"},{\"period\":\"2024\",\"value\":\"133\"},{\"period\":\"2025\",\"value\":\"170\"}]},\"name\":\"Mean of prior periods with a wide band\"},{\"expected_error\":\"need at least two prior periods and the current period\",\"input\":{\"series\":[{\"period\":\"2021\",\"value\":\"100\"},{\"period\":\"2022\",\"value\":\"110\"}]},\"name\":\"Too few periods is refused\"}]"),
