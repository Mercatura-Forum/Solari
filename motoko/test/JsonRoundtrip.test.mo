  ("[\u{a}  {\u{a}    \"name\": \"5 percent tolerable, 10 percent risk, none expected\",\u{a}    \"input\": {\u{a}      \"tolerable_rate\": \"0.05\",\u{a}      \"beta\": \"0.10\",\u{a}      \"expected_rate\": \"0\"\u{a}    },\u{a}    \"expected\": {\u{a}      \"sample_size\": 45,\u{a}      \"allowed_deviations\": 0\u{a}    }\u{a}  },\u{a}  {\u{a}    \"name\": \"10 percent tolerable, 5 percent risk, 1 percent expected\",\u{a}    \"input\": {\u{a}      \"tolerable_rate\": \"0.10\",\u{a}      \"beta\": \"0.05\",\u{a}      \"expected_rate\": \"0.01\"\u{a}    },\u{a}    \"expected\": {\u{a}      \"sample_size\": 29,\u{a}      \"allowed_deviations\": 0\u{a}    }\u{a}  },\u{a}  {\u{a}    \"name\": \"Evaluate 60 items with 1 deviation at 10 percent risk\",\u{a}    \"input\": {\u{a}      \"sample_size\": 60,\u{a}      \"deviations\": 1,\u{a}      \"beta\": \"0.10\"\u{a}    },\u{a}    \"expected\": {\u{a}      \"sample_deviation_rate\": \"0.0167\",\u{a}      \"upper_deviation_limit\": \"0.0633\"\u{a}    }\u{a}  },\u{a}  {\u{a}    \"name\": \"Evaluate 25 items with 0 deviations at 5 percent risk\",\u{a}    \"input\": {\u{a}      \"sample_size\": 25,\u{a}      \"deviations\": 0,\u{a}      \"beta\": \"0.05\"\u{a}    },\u{a}    \"expected\": {\u{a}      \"sample_deviation_rate\": \"0.0000\",\u{a}      \"upper_deviation_limit\": \"0.1129\"\u{a}    }\u{a}  }\u{a}]", "[{\"expected\":{\"allowed_deviations\":0,\"sample_size\":45},\"input\":{\"beta\":\"0.10\",\"expected_rate\":\"0\",\"tolerable_rate\":\"0.05\"},\"name\":\"5 percent tolerable, 10 percent risk, none expected\"},{\"expected\":{\"allowed_deviations\":0,\"sample_size\":29},\"input\":{\"beta\":\"0.05\",\"expected_rate\":\"0.01\",\"tolerable_rate\":\"0.10\"},\"name\":\"10 percent tolerable, 5 percent risk, 1 percent expected\"},{\"expected\":{\"sample_deviation_rate\":\"0.0167\",\"upper_deviation_limit\":\"0.0633\"},\"input\":{\"beta\":\"0.10\",\"deviations\":1,\"sample_size\":60},\"name\":\"Evaluate 60 items with 1 deviation