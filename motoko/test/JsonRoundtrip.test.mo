2\u{a}  },\u{a}  {\u{a}    \"id\": \"RK-REQUEST\",\u{a}    \"term_id\": \"T-RK-REQUEST\",\u{a}    \"name\": \"Information request\",\u{a}    \"scope\": \"engagement\",\u{a}    \"fields\": \"[{\\\"name\\\": \\\"procedure\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"addressee\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"requested\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"requested_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"due\\\", \\\"type\\\": \\\"date\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"state\\\", \\\"type\\\": \\\"enum open|received|closed\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"evidence\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}]\",\u{a}    \"immutable\": 0,\u{a}    \"description\": \"A request to the entity or a third party (prepared-by-client list, confirmation, representation) linked to the procedure it serves and the evidence it produced.\",\u{a}    \"sort_order\": 3\u{a}  },\u{a}  {\u{a}    \"id\": \"RK-EVIDENCE-LINK\",\u{a}    \"term_id\": \"T-RK-EVIDENCE-LINK\",\u{a}    \"name\": \"Evidence link\",\u{a}    \"scope\": \"engagement\",\u{a}    \"fields\": \"[{\\\"name\\\": \\\"procedure\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"evidence_item\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"evidence_kind\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"tick_mark\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"region\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"linked_by\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"linked_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}]\",\u{a}    \"immutable\": 1,\u{a}    \"description\": \"Cross-reference from a procedure step to an evidence item and the region of it examined, with the tick mark applie