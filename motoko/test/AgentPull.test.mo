850.13\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"4700\",\"credit\":\"412815.43\",\"debit\":\"510352.56\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"4800\",\"credit\":\"887405.05\",\"debit\":\"531054.70\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"4900\",\"credit\":\"852517.71\",\"debit\":\"490585.57\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"5000\",\"credit\":\"897009.47\",\"debit\":\"428753.88\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"5100\",\"credit\":\"689103.57\",\"debit\":\"547589.20\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"5200\",\"credit\":\"705159.16\",\"debit\":\"696193.60\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"5300\",\"credit\":\"1318507.22\",\"debit\":\"682916.07\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"5400\",\"credit\":\"522045.95\",\"debit\":\"702549.00\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"5500\",\"credit\":\"672097.69\",\"debit\":\"1084257.89\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"5600\",\"credit\":\"677507.18\",\"debit\":\"484221.04\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"5700\",\"credit\":\"782713.19\",\"debit\":\"641821.71\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"5800\",\"credit\":\"513165.82\",\"debit\":\"412120.70\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"5900\",\"credit\":\"1055080.92\",\"debit\":\"682625.25\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"6000\",\"credit\":\"735764.57\",\"debit\":\"625467.30\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"6100\",\"credit\":\"651397.12\",\"debit\":\"849414.00\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"6200\",\"credit\":\"410011.99\",\"debit\":\"575706.22\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"6300\",\"credit\":\"502341.21\",\"debit\":\"1130039.00\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"6400\",\"credit\":\"264157.00\",\"debit\":\"1169744.25\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"6500\",\"credit\":\"729446.33\",\"debit\":\"365707.19\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"6600\",\"credit\":\"789631.12\",\"debit\":\"541356.08\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"6700\",\"credit\":\"575731.13\",\"debit\":\"687230.25\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"6800\",\"credit\":\"527423.77\",\"debit\":\"1045270.84\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"7700\",\"credit\":\"0.00\",\"debit\":\"19587.75\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"},{\"account_code\":\"9990\",\"credit\":\"0.00\",\"debit\":\"70068.48\",\"opening_credit\":\"0.00\",\"opening_debit\":\"0.00\"}]}";

func expected(tag : Text) : Text {
  switch (Array.find<(Text, Text)>(URLS, func(r) { r.0 == tag })) { case (?r) r.1; case null Runtime.trap("no expected url " # tag) }
};
func hasToken(t : Text) : Bool { Text.contains(t, #text TOKEN) };
func begin(s : A.State, json : Text) : { #ok : A.Pull; #err : Text } { A.begin(s, by, 1, 7, 1, HOST, "odoo-rpc", j(json)) };

type Delivery = { #reply : (Nat, Text); #lost : Text; #hold };
func drive(s : A.State, p : A.Pull, deliver : (Text, Nat) -> Delivery, shuffle : Bool) : Nat {
  var at : Int = 1_000_000_000;
  var rounds = 0;
  var handle : Int64 = 1;
  var held = Map.empty<Text, Nat>();
  label run while (rounds < 400) {
    rounds += 1;
    let tags = A.advance(s, p, at);
    if (p.status == "ready" or p.status == "failed" or p.status == "done") break run;
    for (t in tags.vals()) {
      switch (A.requestFor(p, t)) {
        case (?r) {
          same("request " # t # " url", r.url, expected(t));
          check("request " # t # " carries no token", not hasToken(r.url));
          A.submitted(p, t, handle, at);
          handle += 1;
        };
        case null { failed += 1; Debug.print("FAIL no request for " # t) };
      };
    };
    var inflight = Array.fromIter<Text>(Map.keys(p.inflight));
    if (shuffle) inflight := Array.reverse<Text>(inflight);
    at += 1_000_000_000;
    for (t in inflight.vals()) {
      let n = switch (Map.get(held, Text.compare, t)) { case (?v) v; case null 0 };
      switch (deliver(t, n)) {
        case (#reply((st, b))) ignore A.landed(s, p, t, st, b, at);
        case (#lost(why)) ignore A.failed(p, t, why);
        case (#hold) Map.add(held, Text.compare, t, n + 1);
      };
    };
    if (tags.size() == 0 and inflight.size() == 0 and List.size(p.queue) == 0) break run;
  };
  rounds
};
func recorded(tag : Text, _n : Nat) : Delivery { #reply((200, body(tag))) };
func patched(patch : [(Text, Json.J)]) : Text {
  switch (j(BEGIN)) {
    case (#obj(kvs)) {
      var out : [(Text, Json.J)] = [];
      for ((k, v) in kvs.vals()) { switch (Array.find<(Text, Json.J)>(patch, func(x) { x.0 == k })) { case (?x) out := Array.concat(out, [x]); case null out := Array.concat(out, [(k, v)]) } };
      Json.toText(#obj(out))
    };
    case _ Runtime.trap("BEGIN");
  }
};

// ------------------------------------------------------------------ refusals at begin
do {
  let s = A.init();
  func refused(name : Text, json : Text, why : Text) {
    switch (begin(s, json)) { case (#ok(_)) { failed += 1; Debug.print("FAIL " # name # ": accepted") }; case (#err(m)) same(name, m, why) }
  };
  refused("token missing", patched([("token", #str(""))]), "token is required: the capability the client's browser minted for this pull");
  refused("from after to", patched([("from", #str("2027-01-01"))]), "from must not be after to");
  refused("no criteria", patched([("params", #obj([]))]), "choose at least one criterion");
  refused("page_lines too large", patched([("page_lines", Json.nat(900))]), "page_lines is 50 to 500");
  check("hostname: bad char", A.hostnameProblem("Agent_1.connect.test") != null);
  check("hostname: not qualified", A.hostnameProblem("localhost") != null);
  check("hostname: ok", A.hostnameProblem("k7q2m.connect.mercaturaforum.com") == null);
  check("url: not allowlisted", A.url(HOST, "/v1/admin") == null);
  check("url: allowlisted", A.url(HOST, "/v1/meta") == ?("https://" # HOST # "/v1/meta"));
  check("a registration on a bad hostname is refused at begin", switch (A.begin(s, by, 1, 7, 1, "bad host", "odoo-rpc", j(BEGIN))) { case (#err(m)) Text.contains(m, #text "hostname"); case _ false });
};

// ------------------------------------------------------------------ the recorded pull, ordered and shuffled
func fullPull(shuffle : Bool) : (A.State, A.Pull) {
  let s = A.init();
  let p = switch (begin(s, BEGIN)) { case (#ok(p)) p; case (#err(m)) Runtime.trap(m) };
  let label_ = if (shuffle) "shuffled: " else "ordered: ";
  check(label_ # "a second pull is refused while one runs", switch (begin(s, BEGIN)) { case (#err(m)) m == "pull 1 is still running; wait for it to finish"; case _ false });
  check(label_ # "the view never shows the token", not hasToken(Json.toText(A.view(p))));
  let rounds = drive(s, p, recorded, shuffle);
  same(label_ # "status", p.status # " " # p.failure, "ready ");
  check(label_ # "rounds bounded", rounds < 40);
  check(label_ # "read-only confirmed from meta", p.writeAccess == ?false);
  check(label_ # "the gate dropped the not-provided criterion", Array.equal<Text>(p.notAssessable, ["PC-SELF-APPROVED"], Text.equal) and p.params.size() == 9);
  check(label_ # "system named from meta", p.systemName == "Odoo" and p.systemVersion == "17.0");
  check(label_ # "pages", List.size(p.pages) == PART_SHAS.size());
  for (i in PART_SHAS.keys()) {
    if (i < List.size(p.pages)) {
      let pg = List.at(p.pages, i);
      same(label_ # "part " # Nat.toText(i) # " fingerprint is the page's SHA-256", pg.partSha, PART_SHAS[i]);
      check(label_ # "part " # Nat.toText(i) # " lines", pg.lines == PART_LINES[i]);
      check(label_ # "part " # Nat.toText(i) # " ids", pg.firstId == PART_IDS[i].0 and pg.lastId == PART_IDS[i].1);
      switch (A.partText(s, p, i)) { case (#ok(t)) same(label_ # "part " # Nat.toText(i) # " text is the agreed body", t, body("page:" # Nat.toText(i))); case (#err(m)) { failed += 1; Debug.print("FAIL part text " # m) } };
    };
  };
  same(label_ # "source fingerprint", A.sourceSha(p), SOURCE_SHA);
  same(label_ # "begin input", Json.toText(A.beginJson(p)), BEGIN_JSON);
  check(label_ # "metadata kept by tag", Array.equal<Text>(A.metaTags(p), ["accounts", "balances", "gate", "journals"], Text.equal));
  (s, p)
};
do { ignore fullPull(true) };
do {
  let (s, p) = fullPull(false);
  let pops = Pop.init();
  let popx = Pop.initExt();
  let pop = switch (Pop.begin(pops, popx, by, 3, 7, A.beginJson(p))) { case (#ok(v)) Py.natOr(v, "id", 0); case (#err(m)) Runtime.trap("begin: " # m) };
  var all : [Json.J] = [];
  for (i in Nat.range(0, List.size(p.pages))) {
    let t = switch (A.partText(s, p, i)) { case (#ok(t)) t; case (#err(m)) Runtime.trap(m) };
    switch (Pop.putPart(pops, popx, by, pop, i, t)) { case (#ok(_)) {}; case (#err(m)) { failed += 1; Debug.print("FAIL putPart " # Nat.toText(i) # ": " # m) } };
    all := Array.concat(all, Py.items(j(t)));
  };
  let c = switch (Pop.seal(pops, popx, pop)) { case (#ok(c)) c; case (#err(m)) Runtime.trap("seal: " # m) };
  check("completeness accepted against the balances the agent served", Py.truthy(Json.get(c, "accepted")));
  let oracleC = switch (Journals.completeness(#obj([("lines", #arr(all)), ("trial_balance", #arr(p.balances)), ("places", Json.nat(2))]))) { case (#ok(v)) v; case (#err(m)) Runtime.trap(m) };
  same("completeness equals the one-call oracle", Json.toText(c), Json.toText(oracleC));
  var steps = 0;
  label screen while (steps < 400) { steps += 1; let v = switch (Pop.step(pops, popx, pop, 200)) { case (#ok(v)) v; case (#err(m)) Runtime.trap(m) }; if (Py.textOr(v, "status", "") == "screened") break screen };
  let pp = switch (Pop.get(pops, pop)) { case (?x) x; case null Runtime.trap("pop") };
  let oracleS = switch (Journals.screen(#obj([("lines", #arr(all)), ("params", #obj(p.params))]))) { case (#ok(v)) v; case (#err(m)) Runtime.trap(m) };
  same("screen equals the one-call oracle", Json.toText(Pop.fullOutput(pops, pp)), Json.toText(oracleS));
  check("eighteen entries flagged (the seeded plants)", pp.flagged == 18);
  p.popId := pop;
  let (input, output) = A.paper(p);
  check("paper input carries no token and names route A", not hasToken(Json.toText(input)) and Text.contains(Json.toText(input), #text "route"));
  check("paper output carries no token", not hasToken(Json.toText(output)));
  A.finish(p);
  same("token overwritten at the end", p.key, "");
  check("after the pull a new one may begin", switch (begin(s, BEGIN)) { case (#ok(q)) q.id == 2 and not p.pagesKept; case (#err(_)) false });
};

// ------------------------------------------------------------------ the gate
func gateBody(patch : [(Text, Json.J)]) : Text {
  switch (j(B_GATE)) {
    case (#obj(kvs)) {
      var out : [(Text, Json.J)] = [];
      for ((k, v) in kvs.vals()) { switch (Array.find<(Text, Json.J)>(patch, func(x) { x.0 == k })) { case (?x) out := Array.concat(out, [x]); case null out := Array.concat(out, [(k, v)]) } };
      Json.toText(#obj(out))
    };
    case _ Runtime.trap("gate");
  }
};
do {
  let s = A.init();
  let p = switch (begin(s, BEGIN)) { case (#ok(p)) p; case (#err(m)) Runtime.trap(m) };
  ignore drive(s, p, func(t, _) { if (t == "gate") #reply((200, gateBody([("read_only", #bool(false))]))) else #reply((200, body(t))) }, false);
  check("an agent that is not read-only ends the pull", p.status == "failed" and Text.contains(p.failure, #text "not read-only"));
  same("gate: token overwritten", p.key, "");
};
do {
  let s = A.init();
  let p = switch (begin(s, BEGIN)) { case (#ok(p)) p; case (#err(m)) Runtime.trap(m) };
  ignore drive(s, p, func(t, _) { if (t == "gate") #reply((200, gateBody([("hostname", #str("other.connect.test"))]))) else #reply((200, body(t))) }, false);
  check("an agent naming another hostname ends the pull", p.status == "failed" and Text.contains(p.failure, #text "another hostname"));
};
do {
  let s = A.init();
  let p = switch (begin(s, BEGIN)) { case (#ok(p)) p; case (#err(m)) Runtime.trap(m) };
  ignore drive(s, p, func(t, _) { if (t == "gate") #reply((200, gateBody([("adapter", #str("tally-xml"))]))) else #reply((200, body(t))) }, false);
  check("an agent running another adapter than registered ends the pull", p.status == "failed" and Text.contains(p.failure, #text "another adapter"));
};
do {
  let s = A.init();
  let p = switch (begin(s, BEGIN)) { case (#ok(p)) p; case (#err(m)) Runtime.trap(m) };
  ignore drive(s, p, func(t, _) { if (t == "gate") #reply((401, "{\"detail\":\"the capability expired\"}")) else #reply((200, body(t))) }, false);
  check("a refused capability ends the pull", p.status == "failed" and Text.startsWith(p.failure, #text "the agent refused the capability (HTTP 401)"));
  same("401: token overwritten", p.key, "");
};

// ------------------------------------------------------------------ a ledger that changes, retries
do {
  let s = A.init();
  let p = switch (begin(s, BEGIN)) { case (#ok(p)) p; case (#err(m)) Runtime.trap(m) };
  ignore drive(s, p, func(t, _) { if (t == "recount") #reply((200, "2002")) else #reply((200, body(t))) }, false);
  check("a changed count is refused", p.status == "failed" and Text.contains(p.failure, #text "the ledger changed during the pull: 2002 lines now"));
};
do {
  let s = A.init();
  let p = switch (begin(s, BEGIN)) { case (#ok(p)) p; case (#err(m)) Runtime.trap(m) };
  ignore drive(s, p, func(t, _) { if (t == "page:1") #reply((200, body("page:0"))) else #reply((200, body(t))) }, false);
  check("an overlapping page is refused", p.status == "failed" and Text.contains(p.failure, #text "page 1 overlaps the previous page"));
};
do {
  let s = A.init();
  let p = switch (begin(s, BEGIN)) { case (#ok(p)) p; case (#err(m)) Runtime.trap(m) };
  ignore drive(s, p, func(t, _) { if (t == "page:0") #reply((200, "[{\"entry_id\":\"x\"}]")) else #reply((200, body(t))) }, false);
  check("a page lacking required fields is refused", p.status == "failed" and Text.contains(p.failure, #text "lacks"));
};
do {
  let s = A.init();
  let p = switch (begin(s, BEGIN)) { case (#ok(p)) p; case (#err(m)) Runtime.trap(m) };
  var tries = 0;
  ignore drive(s, p, func(t, _) { if (t == "page:2" and tries < 2) { tries += 1; #reply((503, "busy")) } else #reply((200, body(t))) }, false);
  check("a page refused twice is retried and completes", p.status == "ready" and tries == 2);
};
do {
  let s = A.init();
  let p = switch (begin(s, BEGIN)) { case (#ok(p)) p; case (#err(m)) Runtime.trap(m) };
  ignore drive(s, p, func(t, _) { if (t == "balances") #lost("no agreement among the validators within the deadline") else #reply((200, body(t))) }, false);
  check("a request without agreement ends the pull after the retries", p.status == "failed" and Text.contains(p.failure, #text "(balances, after 2 retries)"));
};

Debug.print("count: checks = " # Nat.toText(checks));
if (failed > 0) Runtime.trap("agent pull: " # Nat.toText(failed) # " checks failed");
Debug.print("AGENT GREEN");
