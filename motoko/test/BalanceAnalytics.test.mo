let node = rowWhere(Py.items(field(mapv, ["nodes"])), "id", "F40-BALANCE-ANALYTICS");
check("the map has one node for the paper with every instance under it", Py.items(field(node, ["instances"])).size() == 16 and field(node, ["status"]) == #str("prepared") and field(node, ["applicable"]) == #bool(true));
check("the completion view lists every instance as an upstream", (func() : Bool {
  var n = 0;
  for (u in Py.items(field(view(manager, "F14-COMPLETION"), ["upstream"])).vals()) { if (Text.startsWith(Py.textOr(u, "form", ""), #text "F40-BALANCE-ANALYTICS@")) n += 1 };
  n == 16
})());

