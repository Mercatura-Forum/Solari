let drifted = view(manager, "F40-BALANCE-ANALYTICS@LS-REV");
check("the paper drifts on its recorded balance", (func() : Bool { for (x in Py.items(field(drifted, ["stale"])).vals()) { if (x == #str("recorded")) return true }; false })());
check("the drift names the trial balance", (func() : Bool { for (d in Py.items(field(drifted, ["drift"])).vals()) { if (field(d, ["field"]) == #str("recorded") and field(d, ["source", "node"]) == #str("tb")) return true }; false })());

