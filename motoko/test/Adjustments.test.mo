check("the adjusted trial balance is in balance", field(atb, ["totals", "adjusted"]) == #str("0.00") and field(atb, ["totals", "adjustments"]) == #str("0.00"));
check("the booked entries are counted", field(atb, ["totals", "booked_entries"]) == #num(Nat.toText(20)));
let counts = field(atb, ["counts"]);
check("count of proposed", Py.natOr(counts, "proposed", 999) == 8);
check("count of agreed", Py.natOr(counts, "agreed", 999) == 4);
check("count of booked", Py.natOr(counts, "booked", 999) == 20);
check("count of waived", Py.natOr(counts, "waived", 999) == 8);
check("count of adjusting", Py.natOr(counts, "adjusting", 999) == 10);
check("count of reclassifying", Py.natOr(counts, "reclassifying", 999) == 10);
check("count of elimination", Py.natOr(counts, "elimination", 999) == 10);
check("count of tax", Py.natOr(counts, "tax", 999) == 10);
check("open entries are the proposed and agreed ones", A.openCount(s, 1) == 12);
check("waived entries are counted", A.waivedCount(s, 1) == 8);
check("a new account carries the leadsheet it was placed on", field(rowWhere(accounts, "account_code", "2150"), ["leadsheet_id"]) == #str("LS-ACCR") and field(rowWhere(accounts, "account_code", "2150"), ["mapping_status"]) == #str("adjustment"));

// the misstatements and the aggregation (ISA 450): the projections read as F10 reads them
ignore must("a misstatement found without an entry", E.addRecord(s, senior, false, 400, 1, #obj([("kind", #str("RK-MISSTATEMENT")), ("fields", j("{\"description\":\"Projected overstatement of receivables from the sample\",\"type\":\"projected\",\"status\":\"uncorrected\",\"assets\":\"-30000.00\",\"liabilities\":\"0.00\",\"equity\":\"0.00\",\"profit\":\"-30000.00\",\"procedure\":\"P-REV-004\"}"))])), 1);
let items = List.empty<Json.J>();
for (r in List.values(s.records)) {
  if (r.engagementId == 1 and r.kind == "RK-MISSTATEMENT") {
    let f = switch (Json.parse(r.fields)) { case (#ok(v)) v; case (#err(_)) #null_ };
    List.add(items, #obj([("id", field(f, ["description"])), ("type", field(f, ["type"])), ("status", field(f, ["status"])), ("assets", field(f, ["assets"])), ("liabilities", field(f, ["liabilities"])), ("equity", field(f, ["equity"])), ("profit", field(f, ["profit"]))]));
  };
};
check("every entry projects one misstatement, plus the one found directly", List.size(items) == 41);
let agg = must("aggregate the misstatements", E.compute(s, senior, false, 401, 1, #obj([("kind", #str("aggregation")), ("procedure_id", #str("P-FSL-039")), ("input", #obj([("items", #arr(List.toArray(items))), ("overall_materiality", #str("250000.00")), ("performance_materiality", #str("187500.00")), ("clearly_trivial", #str("12500.00"))]))])), 1);
let out = field(agg, ["output"]);
let accumulated = Py.items(field(out, ["accumulated_ids"]));
check("the aggregation examined every item", field(out, ["items_examined"]) == #num("41"));
check("the accumulated list is exactly the oracle's", accumulated.size() == 18 and (func() : Bool { for (w in ["ADJ-04 tax entry over 6300, 1002", "ADJ-06 reclassifying entry over 3000, 2200, 1401", "ADJ-07 elimination entry over 1650, 6700", "ADJ-12 tax entry over 4800, 6700, 6300", "ADJ-14 reclassifying entry over 4800, 6000", "ADJ-16 tax entry over 4100, 2200", "ADJ-21 adjusting entry over 1350, 6700", "ADJ-22 reclassifying entry over 1650, 4100", "ADJ-23 elimination entry over 6500, 2200", "ADJ-24 tax entry over 3000, 1650, 4800", "ADJ-28 tax entry over 1002, 6000", "ADJ-29 adjusting entry over 3000, 6000", "ADJ-31 elimination entry over 1350, 6600", "ADJ-32 tax entry over 1002, 6000", "ADJ-36 tax entry over 2200, 4800, 4100", "ADJ-38 reclassifying entry over 5000, 1401", "ADJ-39 elimination entry over 1400, 6600", "Projected overstatement of receivables from the sample"].vals()) { var hit = false; for (a in accumulated.vals()) { if (a == #str(w)) hit := true }; if (not hit) return false }; true })());
check("no booked entry is accumulated", (func() : Bool { for (a in accumulated.vals()) { for (w in ["ADJ-01 adjusting entry over 5000, 1400", "ADJ-02 reclassifying entry over 5000, 1002", "ADJ-03 elimination entry over 6700, 1002", "ADJ-05 adjusting entry over 1401, 2200", "ADJ-09 adjusting entry over 1650, 2150", "ADJ-10 reclassifying entry over 6000, 6600", "ADJ-11 elimination entry over 2000, 1350", "ADJ-15 elimination entry over 2000, 2200", "ADJ-17 adjusting entry over 1500, 1002", "ADJ-18 reclassifying entry over 5000, 1400, 4800", "ADJ-19 elimination entry over 2200, 4100", "ADJ-20 tax entry over 1401, 6500", "ADJ-25 adjusting entry over 1401, 1660", "ADJ-26 reclassifying entry over 5000, 6500", "ADJ-27 elimination entry over 6300, 5000", "ADJ-30 reclassifying entry over 6000, 2000, 5000", "ADJ-33 adjusting entry over 1350, 6000", "ADJ-34 reclassifying entry over 6000, 5000", "ADJ-35 elimination entry over 6000, 1401", "ADJ-40 tax entry over 6600, 6300"].vals()) { if (a == #str(w)) return false } }; true })());
check("every waived entry above clearly trivial is accumulated", (func() : Bool { for (w in ["ADJ-04 tax entry over 6300, 1002", "ADJ-12 tax entry over 4800, 6700, 6300", "ADJ-21 adjusting entry over 1350, 6700", "ADJ-28 tax entry over 1002, 6000", "ADJ-29 adjusting entry over 3000, 6000", "ADJ-36 tax entry over 2200, 4800, 4100"].vals()) { var hit = false; for (a in accumulated.vals()) { if (a == #str(w)) hit := true }; if (not hit) return false }; true })());
check("the clearly trivial entries are recorded and not accumulated", Py.items(field(out, ["clearly_trivial_ids"])).size() == 12);
check("uncorrected effect on assets", field(out, ["uncorrected", "assets"]) == #str("-398670.42"));
check("uncorrected effect on liabilities", field(out, ["uncorrected", "liabilities"]) == #str("285838.34"));
check("uncorrected effect on equity", field(out, ["uncorrected", "equity"]) == #str("-97297.01"));
check("uncorrected effect on profit", field(out, ["uncorrected", "profit"]) == #str("-587211.75"));
check("corrected effect on profit", field(out, ["corrected_profit_effect"]) == #str("10769.33"));
check("largest element effect", field(out, ["largest_element_effect"]) == #str("587211.75"));
check("the band", field(out, ["band"]) == #str("material"));
check("the summary of misstatements reads the projections live", Py.items(field(switch (F.view(s, ff, manager, false, 1, "F10-MISSTATEMENTS")) { case (#ok(v)) v; case (#err(_)) #null_ }, ["live", "misstatements"])).size() == 41);

// oracle 3: the tie-out on adjusted figures
let tieIn = j("[{\"line_id\":\"LS-PPE\",\"caption\":\"Property, plant and equipment\",\"presented\":\"3746657.27\",\"leadsheets\":[\"LS-PPE\"],\"sign\":\"1\"},{\"line_id\":\"LS-INV\",\"caption\":\"Inventories\",\"presented\":\"899972.50\",\"leadsheets\":[\"LS-INV\"],\"sign\":\"1\"},{\"line_id\":\"LS-REC\",\"caption\":\"Trade and other receivables\",\"presented\":\"1090239.90\",\"leadsheets\":[\"LS-REC\"],\"sign\":\"1\"},{\"line_id\":\"LS-CTRA\",\"caption\":\"Contract assets and accrued income\",\"presented\":\"213106.45\",\"leadsheets\":[\"LS-CTRA\"],\"sign\":\"1\"},{\"line_id\":\"LS-CASH\",\"caption\":\"Cash and cash equivalents\",\"presented\":\"337084.17\",\"leadsheets\":[\"LS-CASH\"],\"sign\":\"1\"},{\"line_id\":\"LS-SCAP\",\"caption\":\"Share capital and premium\",\"presented\":\"1878782.61\",\"leadsheets\":[\"LS-SCAP\"],\"sign\":\"-1\"},{\"line_id\":\"LS-RE\",\"caption\":\"Retained earnings\",\"presented\":\"878088.14\",\"leadsheets\":[\"LS-RE\"],\"sign\":\"-1\"},{\"line_id\":\"LS-BORNC\",\"caption\":\"Borrowings (non-current)\",\"presented\":\"1500000.00\",\"leadsheets\":[\"LS-BORNC\"],\"sign\":\"-1\"},{\"line_id\":\"LS-AP\",\"caption\":\"Trade payables\",\"presented\":\"935063.40\",\"leadsheets\":[\"LS-AP\"],\"sign\":\"-1\"},{\"line_id\":\"LS-ACCR\",\"caption\":\"Accruals and other payables\",\"presented\":\"18048.15\",\"leadsheets\":[\"LS-ACCR\"],\"sign\":\"-1\"},{\"line_id\":\"LS-VAT\",\"caption\":\"VAT and other indirect taxes\",\"presented\":\"138009.63\",\"leadsheets\":[\"LS-VAT\"],\"sign\":\"-1\"},{\"line_id\":\"LS-REV\",\"caption\":\"Revenue\",\"presented\":\"10301629.63\",\"leadsheets\":[\"LS-REV\"],\"sign\":\"-1\"},{\"line_id\":\"LS-COS\",\"caption\":\"Cost of sales\",\"presented\":\"6776670.51\",\"leadsheets\":[\"LS-COS\"],\"sign\":\"1\"},{\"line_id\":\"LS-STAFF\",\"caption\":\"Staff costs\",\"presented\":\"1980872.03\",\"leadsheets\":[\"LS-STAFF\"],\"sign\":\"1\"},{\"line_id\":\"LS-DEPR\",\"caption\":\"Depreciation and amortisation\",\"presented\":\"300162.31\",\"leadsheets\":[\"LS-DEPR\"],\"sign\":\"1\"},{\"line_id\":\"LS-FINC\",\"caption\":\"Finance costs\",\"presented\":\"-10097.01\",\"leadsheets\":[\"LS-FINC\"],\"sign\":\"1\"},{\"line_id\":\"LS-TAXEXP\",\"caption\":\"Income tax expense\",\"presented\":\"314953.43\",\"leadsheets\":[\"LS-TAXEXP\"],\"sign\":\"1\"}]");
let tieAdj = must("tie the statements out to the adjusted leadsheets", E.compute(s, senior, false, 402, 1, #obj([("kind", #str("tieout")), ("procedure_id", #str("P-FSL-041")), ("input", #obj([("statement_lines", tieIn), ("leadsheet_totals", A.leadsheetTotals(s, 1))]))])), 1);
check("the statements presented on the oracle's adjusted figures agree", field(tieAdj, ["output", "agrees"]) == #bool(true) and field(tieAdj, ["output", "lines_differing"]) == #num("0"));
func totalsOf(xs : [Json.J]) : [(Text, Json.J)] { let o = List.empty<(Text, Json.J)>(); for (l in xs.vals()) List.add(o, (Py.textOr(l, "leadsheet_id", ""), field(l, ["net"]))); List.toArray(o) };
let unadjustedTotals = (func() : Json.J {
  let tbr = switch (E.latestTb(s, 1)) { case (?t) t; case null return #obj([]) };
  let m = switch (Json.parse(tbr.mapping)) { case (#ok(v)) v; case (#err(_)) #null_ };
  #obj(totalsOf(Py.list(m, "leadsheets")))
})();
let tieUn = must("tie the same statements out to the unadjusted leadsheets", E.compute(s, senior, false, 403, 1, #obj([("kind", #str("tieout")), ("procedure_id", #str("P-FSL-041")), ("input", #obj([("statement_lines", tieIn), ("leadsheet_totals", unadjustedTotals)]))])), 1);
check("on the unadjusted figures exactly the moved leadsheets differ", field(tieUn, ["output", "lines_differing"]) == #num(Nat.toText(16)));

// the forms read the adjusted figures, and a paper prepared before drifts
let f31b = switch (F.view(s, ff, staff, false, 1, "F31-REVENUE-RECEIVABLES")) { case (#ok(v)) v; case (#err(m)) { check("view F31: " # m, false); #null_ } };
check("the cycle paper now reads the adjusted revenue leadsheet", field(f31b, ["live", "ls_rev"]) == #str("-10301629.63"));
check("the frozen figure is still the unadjusted one", field(f31b, ["frozen", "ls_rev"]) == #str("-10450000.00"));
check("the prepared paper drifted on the revenue leadsheet", (func() : Bool { for (x in Py.items(field(f31b, ["stale"])).vals()) { if (x == #str("ls_rev")) return true }; false })());
check("a leadsheet's unadjusted figure is read by name", (func() : Bool {
  let e = switch (E.engagement(s, 1)) { case (#ok(e)) e; case (#err(_)) return false };
  A.leadsheetFigure(s, 1, "LS-REV", "unadjusted") == #str("-10450000.00") and A.leadsheetFigure(s, 1, "LS-REV", "adjustments") == #str("148370.37") and e.lastDated >= "2026-02-12"
})());

// the trail
let t = E.verifyTrail(s);
check("the trail is intact", field(t, ["intact"]) == #bool(true));
check("one trail entry per record written, none for a refusal", field(t, ["entries_examined"]) == #num(Nat.toText(trailOps)));

Debug.print("count: adjustment checks = " # Nat.toText(checks));
Debug.print("count: entries proposed = " # Nat.toText(List.size(ids)));
Debug.print("count: refusals = " # Nat.toText(refusals));
Debug.print("count: account figures against the oracle = " # Nat.toText(accountFigures));
Debug.print("count: leadsheet figures against the oracle = " # Nat.toText(leadsheetFigures));
if (failed > 0) Runtime.trap("ADJUSTMENTS RED: " # Nat.toText(failed) # " of " # Nat.toText(checks) # " checks failed");
Debug.print("ADJUSTMENTS GREEN");
