  ("normalise", "{\"profile\":{\"system\":\"thebes_ledger_core\",\"description\":\"Trial balance projection from thebes-ledger-core: the fold over posted journal entries for a period, each line carrying an MMR inclusion proof for the entries that compose it. The adapter carries the proof verbatim and sets evidence_grade to cryptographic only when every line carries a proof; verification is delegated to the ledger verifier.\",\"format\":\"json\",\"columns\":{\"account_code\":[\"account_code\"],\"account_name\":[\"account_name\"],\"debit\":[\"debit\"],\"credit\":[\"credit\"],\"prior_debit\":[\"prior_debit\"],\"prior_credit\":[\"prior_credit\"],\"proof\":[\"proof\"]},\"amount_rules\":{\"decimal_separator\":\".\",\"balance_sign\":\"debit_positive\"},\"id\":\"thebes-ledger-core\",\"profile_version\":\"1.0\"},\"source\":\"{\\\"lines\\\": [{\\\"account_code\\\": \\\"6948\\\", \\\"account_name\\\": \\\"Account 6948\\\", \\\"debit\\\": \\\"1264072.15\\\", \\\"credit\\\": \\\"1196469.3\\\", \\\"prior_debit\\\": \\\"5647871.01\\\", \\\"proof\\\": {\\\"scheme\\\": \\\"thebes-mmr-sha256-v1\\\", \\\"mmr_size\\\": 1424, \\\"root\\\": \\\"9e28cded4c11848b75fcf8220a178afc261a2aec52a381d4f0fb6a66072c0c51\\\"}}, {\\\"account_code\\\": \\\"5500\\\", \\\"account_name\\\": \\\"Account 5500\\\", \\\"debit\\\": \\\"2660317.55\\\", \\\"credit\\\": \\\"4700310.71\\\"}, {\\\"account_code\\\": \\\"4600\\\", \\\"Account_Name\\\": \\\"Account 4600\\\", \\\"debit\\\": \\\"755678.25\\\", \\\"credit\\\": \\\"2625654.09\\\", \\\"prior_debit\\\": \\\"0\\\", \\\"proof\\\": {\\\"scheme\\\": \\\"thebes-mmr-sha256-v1\\\", \\\"mmr_size\\\": 3835, \\\"root\\\": \\\"ff0b98bbe19b80ec5601bc9c4b562df22445dd102e5f43c8df7cd0c4155c102c\\\"}}, {\\\"account_code\\\": \\\"2629\\\", \\\"Account_Name\\\": \\\"Account 2629\\\", \\\"debit\\\": \\\"0\\\", \\\"credit\\\": \\\"412658.73\\\", \\\"proof\\\": {\\\"scheme\\\": \\\"thebes-mmr-sha256-v1\\\", \\\"mmr_size\\\": 1816, \\\"root\\\": \\\"0f53111580d594b9f33b749d70227