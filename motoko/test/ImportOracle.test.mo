  ("normalise", "{\"profile\":{\"system\":\"thebes_ledger_core\",\"description\":\"Trial balance projection from thebes-ledger-core: the fold over posted journal entries for a period, each line carrying an MMR inclusion proof for the entries that compose it. The adapter carries the proof verbatim and sets evidence_grade to cryptographic only when every line carries a proof; verification is delegated to the ledger verifier.\",\"format\":\"json\",\"columns\":{\"account_code\":[\"account_code\"],\"account_name\":[\"account_name\"],\"debit\":[\"debit\"],\"credit\":[\"credit\"],\"prior_debit\":[\"prior_debit\"],\"prior_credit\":[\"prior_credit\"],\"proof\":[\"proof\"]},\"amount_rules\":{\"decimal_separator\":\".\",\"balance_sign\":\"debit_positive\"},\"id\":\"thebes-ledger-core\",\"profile_version\":\"1.0\"},\"source\":\"[{\\\"account_code\\\": \\\"5655\\\", \\\"account_name\\\": \\\"Account 5655\\\", \\\"debit\\\": \\\"3883572.73\\\", \\\"credit\\\": \\\"2915221.67\\\", \\\"proof\\\": {\\\"scheme\\\": \\\"thebes-mmr-sha256-v1\\\", \\\"mmr_size\\\": 3007, \\\"root\\\": \\\"6eefd8f76197fce76d945677a78df47ae545625e08a01debdf03236a5a6a7dce\\\"}}, {\\\"Account Code\\\": \\\"1777\\\", \\\"account_name\\\": \\\"Account 1777\\\", \\\"debit\\\": \\\"8955051.88\\\", \\\"credit\\\": \\\"5178530.18\\\", \\\"proof\\\": {\\\"scheme\\\": \\\"thebes-mmr-sha256-v1\\\", \\\"mmr_size\\\": 1682, \\\"root\\\": \\\"93328715f28586dceb8d6987cd6edea0bcde49954114a217557339c03211539e\\\"}}, {\\\"code\\\": \\\"5132\\\", \\\"name\\\": \\\"Account 5132\\\", \\\"debit\\\": \\\"9214729.29\\\", \\\"credit\\\": \\\"6980258.15\\\"}]\",\"entity\":\"Fixture Co\",\"period_start\":\"2025-01-01\",\"period_end\":\"2025-12-31\",\"currency\":\"EGP\",\"minor_units\":2,\"extracted_at\":\"2026-09-10T08:00:00Z\"}", "{\"counts\":{\"documents\":0,\"evidence_grade\":\"representation\",\"lines\":3,\"lines_with_proof\":2,\"partial_fragment\":false,\"rows_read\":3,\"rows_skipped\":0,\"rows_used\":3},\"tb\":{\"contract_ver