  ("normalise", "{\"profile\":{\"system\":\"thebes_ledger_core\",\"description\":\"Trial balance projection from thebes-ledger-core: the fold over posted journal entries for a period, each line carrying an MMR inclusion proof for the entries that compose it. The adapter carries the proof verbatim and sets evidence_grade to cryptographic only when every line carries a proof; verification is delegated to the ledger verifier.\",\"format\":\"json\",\"columns\":{\"account_code\":[\"account_code\"],\"account_name\":[\"account_name\"],\"debit\":[\"debit\"],\"credit\":[\"credit\"],\"prior_debit\":[\"prior_debit\"],\"prior_credit\":[\"prior_credit\"],\"proof\":[\"proof\"]},\"amount_rules\":{\"decimal_separator\":\".\",\"balance_sign\":\"debit_positive\"},\"id\":\"thebes-ledger-core\",\"profile_version\":\"1.0\"},\"source\":\"[{\\\"account_code\\\": \\\"3257\\\", \\\"account_name\\\": \\\"Account 3257\\\", \\\"debit\\\": \\\"8195777.93\\\", \\\"credit\\\": \\\"9344597.53\\\", \\\"prior_debit\\\": \\\"0\\\", \\\"proof\\\": {\\\"scheme\\\": \\\"thebes-mmr-sha256-v1\\\", \\\"mmr_size\\\": 4071, \\\"root\\\": \\\"187028de194b2e1955e9d0d581441eb20f291d865c3186e3e0f090745b61754d\\\"}}, {\\\"Account Code\\\": \\\"4570\\\", \\\"name\\\": \\\"Account 4570\\\", \\\"debit\\\": \\\"4737686.85\\\", \\\"credit\\\": \\\"0\\\", \\\"proof\\\": {\\\"scheme\\\": \\\"thebes-mmr-sha256-v1\\\", \\\"mmr_size\\\": 729, \\\"root\\\": \\\"c193386479c2ab67eb51e766592b53120aa48b334d4d80861c464f7f0c8cf223\\\"}}, {\\\"account_code\\\": \\\"4083\\\", \\\"account_name\\\": \\\"Account 4083\\\", \\\"debit\\\": \\\"0\\\", \\\"credit\\\": \\\"6851767.35\\\", \\\"proof\\\": {\\\"scheme\\\": \\\"thebes-mmr-sha256-v1\\\", \\\"mmr_size\\\": 2473, \\\"root\\\": \\\"1f11e6af41548eeacbe550e6300ab0de5f0eb88c9ec5b287054292c18ffc7fd3\\\"}}, {\\\"account_code\\\": \\\"5883\\\", \\\"account_name\\\": \\\"Account 5883\\\", \\\"debit\\\": \\\"8543793.53\\\", \\\"credit\\\": \\\"107353.96\\\", \\\"proof\\\": {\\\"scheme\\\":