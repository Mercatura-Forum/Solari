  ("normalise", "{\"profile\":{\"system\":\"thebes_ledger_core\",\"description\":\"Trial balance projection from thebes-ledger-core: the fold over posted journal entries for a period, each line carrying an MMR inclusion proof for the entries that compose it. The adapter carries the proof verbatim and sets evidence_grade to cryptographic only when every line carries a proof; verification is delegated to the ledger verifier.\",\"format\":\"json\",\"columns\":{\"account_code\":[\"account_code\"],\"account_name\":[\"account_name\"],\"debit\":[\"debit\"],\"credit\":[\"credit\"],\"prior_debit\":[\"prior_debit\"],\"prior_credit\":[\"prior_credit\"],\"proof\":[\"proof\"]},\"amount_rules\":{\"decimal_separator\":\".\",\"balance_sign\":\"debit_positive\"},\"id\":\"thebes-ledger-core\",\"profile_version\":\"1.0\"},\"source\":\"[\\n {\\n  \\\"code\\\": \\\"6831\\\",\\n  \\\"name\\\": \\\"Account 6831\\\",\\n  \\\"debit\\\": \\\"1364736.84\\\",\\n  \\\"credit\\\": \\\"0\\\",\\n  \\\"proof\\\": {\\n   \\\"scheme\\\": \\\"thebes-mmr-sha256-v1\\\",\\n   \\\"mmr_size\\\": 1113,\\n   \\\"root\\\": \\\"5b484a4110accf522d90a6a98be83de946f6ea84f22acfd65578f2e8a26870dc\\\"\\n  }\\n },\\n {\\n  \\\"account_code\\\": \\\"2384\\\",\\n  \\\"name\\\": \\\"Account 2384\\\",\\n  \\\"debit\\\": \\\"8988430.57\\\",\\n  \\\"credit\\\": \\\"3880060.29\\\",\\n  \\\"prior_debit\\\": \\\"8546972\\\"\\n }\\n]\",\"entity\":\"Fixture Co\",\"period_start\":\"2025-01-01\",\"period_end\":\"2025-12-31\",\"currency\":\"EGP\",\"minor_units\":2,\"extracted_at\":\"2026-09-10T08:00:00Z\"}", "{\"counts\":{\"documents\":0,\"evidence_grade\":\"representation\",\"lines\":2,\"lines_with_proof\":1,\"partial_fragment\":false,\"rows_read\":2,\"rows_skipped\":0,\"rows_used\":2},\"tb\":{\"contract_version\":\"1.0\",\"currency\":\"EGP\",\"entity\":{\"name\":\"Fixture Co\"},\"lines\":[{\"account_code\":\"None\",\"account_name\":\"\",\"credit\":\"0.00\",\"debit\":\"1364736.84\",\"proof\":{\"mmr_size\":1113,\"root\":\"5b484a41