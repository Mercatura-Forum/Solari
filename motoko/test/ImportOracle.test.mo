  ("normalise", "{\"profile\":{\"system\":\"thebes_ledger_core\",\"description\":\"Trial balance projection from thebes-ledger-core: the fold over posted journal entries for a period, each line carrying an MMR inclusion proof for the entries that compose it. The adapter carries the proof verbatim and sets evidence_grade to cryptographic only when every line carries a proof; verification is delegated to the ledger verifier.\",\"format\":\"json\",\"columns\":{\"account_code\":[\"account_code\"],\"account_name\":[\"account_name\"],\"debit\":[\"debit\"],\"credit\":[\"credit\"],\"prior_debit\":[\"prior_debit\"],\"prior_credit\":[\"prior_credit\"],\"proof\":[\"proof\"]},\"amount_rules\":{\"decimal_separator\":\".\",\"balance_sign\":\"debit_positive\"},\"id\":\"thebes-ledger-core\",\"profile_version\":\"1.0\"},\"source\":\"{\\n \\\"lines\\\": [\\n  {\\n   \\\"Account Code\\\": \\\"5062\\\",\\n   \\\"name\\\": \\\"Account 5062\\\",\\n   \\\"debit\\\": \\\"0\\\",\\n   \\\"credit\\\": \\\"7271762.4\\\",\\n   \\\"prior_debit\\\": \\\"0\\\",\\n   \\\"proof\\\": {\\n    \\\"scheme\\\": \\\"thebes-mmr-sha256-v1\\\",\\n    \\\"mmr_size\\\": 1645,\\n    \\\"root\\\": \\\"b6e6645d7be241e928e754a92c7c532e11be33911fb100c61eeaeb2293884a51\\\"\\n   }\\n  }\\n ]\\n}\",\"entity\":\"Fixture Co\",\"period_start\":\"2025-01-01\",\"period_end\":\"2025-12-31\",\"currency\":\"EGP\",\"minor_units\":3,\"extracted_at\":\"2026-09-10T08:00:00Z\"}", "{\"counts\":{\"documents\":0,\"evidence_grade\":\"cryptographic\",\"lines\":1,\"lines_with_proof\":1,\"partial_fragment\":false,\"rows_read\":1,\"rows_skipped\":0,\"rows_used\":1},\"tb\":{\"contract_version\":\"1.0\",\"currency\":\"EGP\",\"entity\":{\"name\":\"Fixture Co\"},\"lines\":[{\"account_code\":\"5062\",\"account_name\":\"\",\"credit\":\"7271762.400\",\"debit\":\"0.000\",\"prior_debit\":\"0.000\",\"proof\":{\"mmr_size\":1645,\"root\":\"b6e6645d7be241e928e754a92c7c532e11be33911fb100c61eeaeb2293884a51\",\"scheme\":\"thebes-mmr-sha256-v1\"}}],\"mino