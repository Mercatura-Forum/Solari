  ("normalise", "{\"profile\":{\"system\":\"thebes_ledger_core\",\"description\":\"Trial balance projection from thebes-ledger-core: the fold over posted journal entries for a period, each line carrying an MMR inclusion proof for the entries that compose it. The adapter carries the proof verbatim and sets evidence_grade to cryptographic only when every line carries a proof; verification is delegated to the ledger verifier.\",\"format\":\"json\",\"columns\":{\"account_code\":[\"account_code\"],\"account_name\":[\"account_name\"],\"debit\":[\"debit\"],\"credit\":[\"credit\"],\"prior_debit\":[\"prior_debit\"],\"prior_credit\":[\"prior_credit\"],\"proof\":[\"proof\"]},\"amount_rules\":{\"decimal_separator\":\".\",\"balance_sign\":\"debit_positive\"},\"id\":\"thebes-ledger-core\",\"profile_version\":\"1.0\"},\"source\":\"{\\\"lines\\\": [{\\\"Account Code\\\": \\\"1232\\\", \\\"name\\\": \\\"Account 1232\\\", \\\"debit\\\": \\\"6268857.49\\\", \\\"credit\\\": \\\"5091035.12\\\", \\\"proof\\\": {\\\"scheme\\\": \\\"thebes-mmr-sha256-v1\\\", \\\"mmr_size\\\": 3881, \\\"root\\\": \\\"7647d5e3de2ce56749db44bc108f16e9567760ed18519049323db1fd2cdf567f\\\"}}]}\",\"entity\":\"Fixture Co\",\"period_start\":\"2025-01-01\",\"period_end\":\"2025-12-31\",\"currency\":\"EGP\",\"minor_units\":3,\"extracted_at\":\"2026-09-10T08:00:00Z\"}", "{\"counts\":{\"documents\":0,\"evidence_grade\":\"cryptographic\",\"lines\":1,\"lines_with_proof\":1,\"partial_fragment\":false,\"rows_read\":1,\"rows_skipped\":0,\"rows_used\":1},\"tb\":{\"contract_version\":\"1.0\",\"currency\":\"EGP\",\"entity\":{\"name\":\"Fixture Co\"},\"lines\":[{\"account_code\":\"1232\",\"account_name\":\"\",\"credit\":\"5091035.120\",\"debit\":\"6268857.490\",\"proof\":{\"mmr_size\":3881,\"root\":\"7647d5e3de2ce56749db44bc108f16e9567760ed18519049323db1fd2cdf567f\",\"scheme\":\"thebes-mmr-sha256-v1\"}}],\"minor_units\":3,\"period\":{\"end\":\"2025-12-31\",\"start\":\"2025-01-01\"},\"source\":{\"adapter\":\"thebes-ledger-core\"