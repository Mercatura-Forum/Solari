  ("normalise", "{\"profile\":{\"system\":\"thebes_ledger_core\",\"description\":\"Trial balance projection from thebes-ledger-core: the fold over posted journal entries for a period, each line carrying an MMR inclusion proof for the entries that compose it. The adapter carries the proof verbatim and sets evidence_grade to cryptographic only when every line carries a proof; verification is delegated to the ledger verifier.\",\"format\":\"json\",\"columns\":{\"account_code\":[\"account_code\"],\"account_name\":[\"account_name\"],\"debit\":[\"debit\"],\"credit\":[\"credit\"],\"prior_debit\":[\"prior_debit\"],\"prior_credit\":[\"prior_credit\"],\"proof\":[\"proof\"]},\"amount_rules\":{\"decimal_separator\":\".\",\"balance_sign\":\"debit_positive\"},\"id\":\"thebes-ledger-core\",\"profile_version\":\"1.0\"},\"source\":\"[{\\\"Account Code\\\": \\\"1699\\\", \\\"account_name\\\": \\\"Account 1699\\\", \\\"debit\\\": \\\"2677830.27\\\", \\\"credit\\\": \\\"8033009.95\\\", \\\"proof\\\": {\\\"scheme\\\": \\\"thebes-mmr-sha256-v1\\\", \\\"mmr_size\\\": 825, \\\"root\\\": \\\"37c0a9db75ec0ee8bb7f7c36469719e82399155d1c3c47389bddc9cf2d282673\\\"}}, {\\\"code\\\": \\\"1242\\\", \\\"Account_Name\\\": \\\"Account 1242\\\", \\\"debit\\\": \\\"7965667.66\\\", \\\"credit\\\": \\\"379736.55\\\"}, {\\\"Account Code\\\": \\\"5527\\\", \\\"name\\\": \\\"Account 5527\\\", \\\"debit\\\": \\\"688321.58\\\", \\\"credit\\\": \\\"55241.37\\\", \\\"prior_debit\\\": \\\"5377852.99\\\", \\\"proof\\\": {\\\"scheme\\\": \\\"thebes-mmr-sha256-v1\\\", \\\"mmr_size\\\": 2367, \\\"root\\\": \\\"5244f3e2a4facf20e925fb95ba2c896374cac970a116410d351e011908e304a6\\\"}}, {\\\"account_code\\\": \\\"4876\\\", \\\"account_name\\\": \\\"Account 4876\\\", \\\"debit\\\": \\\"0\\\", \\\"credit\\\": \\\"803829.41\\\", \\\"proof\\\": {\\\"scheme\\\": \\\"thebes-mmr-sha256-v1\\\", \\\"mmr_size\\\": 3974, \\\"root\\\": \\\"9c98e243d275390f50b0e36a293099230383ab6d158ded9adb0b8c41d2f03e38\\\"}}]\",\"entity\":\"Fixture C