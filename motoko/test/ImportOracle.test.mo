  ("normalise", "{\"profile\":{\"system\":\"thebes_ledger_core\",\"description\":\"Trial balance projection from thebes-ledger-core: the fold over posted journal entries for a period, each line carrying an MMR inclusion proof for the entries that compose it. The adapter carries the proof verbatim and sets evidence_grade to cryptographic only when every line carries a proof; verification is delegated to the ledger verifier.\",\"format\":\"json\",\"columns\":{\"account_code\":[\"account_code\"],\"account_name\":[\"account_name\"],\"debit\":[\"debit\"],\"credit\":[\"credit\"],\"prior_debit\":[\"prior_debit\"],\"prior_credit\":[\"prior_credit\"],\"proof\":[\"proof\"]},\"amount_rules\":{\"decimal_separator\":\".\",\"balance_sign\":\"debit_positive\"},\"id\":\"thebes-ledger-core\",\"profile_version\":\"1.0\"},\"source\":\"{\\\"lines\\\": [{\\\"code\\\": \\\"3856\\\", \\\"name\\\": \\\"Account 3856\\\", \\\"debit\\\": \\\"465915.5\\\", \\\"credit\\\": \\\"21863.3\\\"}, {\\\"Account Code\\\": \\\"5037\\\", \\\"name\\\": \\\"Account 5037\\\", \\\"debit\\\": \\\"2890405.23\\\", \\\"credit\\\": \\\"4799287.91\\\", \\\"proof\\\": {\\\"scheme\\\": \\\"thebes-mmr-sha256-v1\\\", \\\"mmr_size\\\": 3477, \\\"root\\\": \\\"2e718efa5c1af9f2912ab9d3650aa34d2c0da14880cc999cb54c2385cb855ce4\\\"}}]}\",\"entity\":\"Fixture Co\",\"period_start\":\"2025-01-01\",\"period_end\":\"2025-12-31\",\"currency\":\"EGP\",\"minor_units\":2,\"extracted_at\":\"2026-09-10T08:00:00Z\"}", "{\"counts\":{\"documents\":0,\"evidence_grade\":\"representation\",\"lines\":2,\"lines_with_proof\":1,\"partial_fragment\":false,\"rows_read\":2,\"rows_skipped\":0,\"rows_used\":2},\"tb\":{\"contract_version\":\"1.0\",\"currency\":\"EGP\",\"entity\":{\"name\":\"Fixture Co\"},\"lines\":[{\"account_code\":\"None\",\"account_name\":\"\",\"credit\":\"21863.30\",\"debit\":\"465915.50\"},{\"account_code\":\"5037\",\"account_name\":\"\",\"credit\":\"4799287.91\",\"debit\":\"2890405.23\",\"proof\":{\"mmr_size\":3477,\"root\":\"2e