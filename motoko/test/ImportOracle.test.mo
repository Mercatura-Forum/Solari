  ("normalise", "{\"profile\":{\"system\":\"thebes_ledger_core\",\"description\":\"Trial balance projection from thebes-ledger-core: the fold over posted journal entries for a period, each line carrying an MMR inclusion proof for the entries that compose it. The adapter carries the proof verbatim and sets evidence_grade to cryptographic only when every line carries a proof; verification is delegated to the ledger verifier.\",\"format\":\"json\",\"columns\":{\"account_code\":[\"account_code\"],\"account_name\":[\"account_name\"],\"debit\":[\"debit\"],\"credit\":[\"credit\"],\"prior_debit\":[\"prior_debit\"],\"prior_credit\":[\"prior_credit\"],\"proof\":[\"proof\"]},\"amount_rules\":{\"decimal_separator\":\".\",\"balance_sign\":\"debit_positive\"},\"id\":\"thebes-ledger-core\",\"profile_version\":\"1.0\"},\"source\":\"{\\\"lines\\\": [{\\\"Account Code\\\": \\\"4091\\\", \\\"account_name\\\": \\\"Account 4091\\\", \\\"debit\\\": \\\"9633126.92\\\", \\\"credit\\\": \\\"7907782.81\\\", \\\"proof\\\": {\\\"scheme\\\": \\\"thebes-mmr-sha256-v1\\\", \\\"mmr_size\\\": 1384, \\\"root\\\": \\\"34605a418ba1cd029c029cef2e3651ada8819c1797632d35a200d1c66a4f011e\\\"}}, {\\\"Account Code\\\": \\\"3988\\\", \\\"Account_Name\\\": \\\"Account 3988\\\", \\\"debit\\\": \\\"9035170.25\\\", \\\"credit\\\": \\\"6581165.42\\\", \\\"prior_debit\\\": \\\"8621006.68\\\"}]}\",\"entity\":\"Fixture Co\",\"period_start\":\"2025-01-01\",\"period_end\":\"2025-12-31\",\"currency\":\"EGP\",\"minor_units\":2,\"extracted_at\":\"2026-09-10T08:00:00Z\"}", "{\"counts\":{\"documents\":0,\"evidence_grade\":\"representation\",\"lines\":2,\"lines_with_proof\":1,\"partial_fragment\":false,\"rows_read\":2,\"rows_skipped\":0,\"rows_used\":2},\"tb\":{\"contract_version\":\"1.0\",\"currency\":\"EGP\",\"entity\":{\"name\":\"Fixture Co\"},\"lines\":[{\"account_code\":\"4091\",\"account_name\":\"Account 4091\",\"credit\":\"7907782.81\",\"debit\":\"9633126.92\",\"proof\":{\"mmr_size\":1384,\"root\":\"34605a418ba1cd029c