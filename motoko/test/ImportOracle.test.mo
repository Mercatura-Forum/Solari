  ("normalise", "{\"profile\":{\"system\":\"thebes_ledger_core\",\"description\":\"Trial balance projection from thebes-ledger-core: the fold over posted journal entries for a period, each line carrying an MMR inclusion proof for the entries that compose it. The adapter carries the proof verbatim and sets evidence_grade to cryptographic only when every line carries a proof; verification is delegated to the ledger verifier.\",\"format\":\"json\",\"columns\":{\"account_code\":[\"account_code\"],\"account_name\":[\"account_name\"],\"debit\":[\"debit\"],\"credit\":[\"credit\"],\"prior_debit\":[\"prior_debit\"],\"prior_credit\":[\"prior_credit\"],\"proof\":[\"proof\"]},\"amount_rules\":{\"decimal_separator\":\".\",\"balance_sign\":\"debit_positive\"},\"id\":\"thebes-ledger-core\",\"profile_version\":\"1.0\"},\"source\":\"{\\n \\\"lines\\\": [\\n  {\\n   \\\"Account Code\\\": \\\"6021\\\",\\n   \\\"Account_Name\\\": \\\"Account 6021\\\",\\n   \\\"debit\\\": \\\"7933220.03\\\",\\n   \\\"credit\\\": \\\"1060750.89\\\",\\n   \\\"proof\\\": {\\n    \\\"scheme\\\": \\\"thebes-mmr-sha256-v1\\\",\\n    \\\"mmr_size\\\": 3891,\\n    \\\"root\\\": \\\"171789fbe8b26731b3230d2aa778cdf57cc6f0ad82e3d203d3efc43c0c1b83c1\\\"\\n   }\\n  }\\n ]\\n}\",\"entity\":\"Fixture Co\",\"period_start\":\"2025-01-01\",\"period_end\":\"2025-12-31\",\"currency\":\"EGP\",\"minor_units\":2,\"extracted_at\":\"2026-09-10T08:00:00Z\"}", "{\"counts\":{\"documents\":0,\"evidence_grade\":\"cryptographic\",\"lines\":1,\"lines_with_proof\":1,\"partial_fragment\":false,\"rows_read\":1,\"rows_skipped\":0,\"rows_used\":1},\"tb\":{\"contract_version\":\"1.0\",\"currency\":\"EGP\",\"entity\":{\"name\":\"Fixture Co\"},\"lines\":[{\"account_code\":\"6021\",\"account_name\":\"Account 6021\",\"credit\":\"1060750.89\",\"debit\":\"7933220.03\",\"proof\":{\"mmr_size\":3891,\"root\":\"171789fbe8b26731b3230d2aa778cdf57cc6f0ad82e3d203d3efc43c0c1b83c1\",\"scheme\":\"thebes-mmr-sha256-v1\"}}],\"minor_units\":2,\"period\":{\"end