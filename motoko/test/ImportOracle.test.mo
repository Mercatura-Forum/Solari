  ("normalise", "{\"profile\":{\"system\":\"thebes_ledger_core\",\"description\":\"Trial balance projection from thebes-ledger-core: the fold over posted journal entries for a period, each line carrying an MMR inclusion proof for the entries that compose it. The adapter carries the proof verbatim and sets evidence_grade to cryptographic only when every line carries a proof; verification is delegated to the ledger verifier.\",\"format\":\"json\",\"columns\":{\"account_code\":[\"account_code\"],\"account_name\":[\"account_name\"],\"debit\":[\"debit\"],\"credit\":[\"credit\"],\"prior_debit\":[\"prior_debit\"],\"prior_credit\":[\"prior_credit\"],\"proof\":[\"proof\"]},\"amount_rules\":{\"decimal_separator\":\".\",\"balance_sign\":\"debit_positive\"},\"id\":\"thebes-ledger-core\",\"profile_version\":\"1.0\"},\"source\":\"{\\\"lines\\\": [{\\\"account_code\\\": \\\"6547\\\", \\\"account_name\\\": \\\"Account 6547\\\", \\\"debit\\\": \\\"9059304.02\\\", \\\"credit\\\": \\\"7068402.15\\\", \\\"prior_debit\\\": \\\"9730895.88\\\", \\\"proof\\\": {\\\"scheme\\\": \\\"thebes-mmr-sha256-v1\\\", \\\"mmr_size\\\": 1764, \\\"root\\\": \\\"f89c9ed0d9f2996e7f44ef7d5312cccd4e7106da6ba4d582c561ca20b774b3f8\\\"}}, {\\\"account_code\\\": \\\"1534\\\", \\\"Account_Name\\\": \\\"Account 1534\\\", \\\"debit\\\": \\\"4388481.7\\\", \\\"credit\\\": \\\"1087914.04\\\"}]}\",\"entity\":\"Fixture Co\",\"period_start\":\"2025-01-01\",\"period_end\":\"2025-12-31\",\"currency\":\"EGP\",\"minor_units\":0,\"extracted_at\":\"2026-09-10T08:00:00Z\"}", "{\"counts\":{\"documents\":0,\"evidence_grade\":\"representation\",\"lines\":2,\"lines_with_proof\":1,\"partial_fragment\":false,\"rows_read\":2,\"rows_skipped\":0,\"rows_used\":2},\"tb\":{\"contract_version\":\"1.0\",\"currency\":\"EGP\",\"entity\":{\"name\":\"Fixture Co\"},\"lines\":[{\"account_code\":\"6547\",\"account_name\":\"Account 6547\",\"credit\":\"7068402\",\"debit\":\"9059304\",\"prior_debit\":\"9730896\",\"proof\":{\"mmr_size\":1764,\"root\"