  ("normalise", "{\"profile\":{\"system\":\"eta_einvoicing\",\"description\":\"Egyptian Tax Authority e-invoicing portal document export (JSON array of documents as returned by the document search API, or the portal CSV). This source holds documents, not balances: the adapter produces the documents population and a trial-balance FRAGMENT of revenue, output VAT and receivables control totals, flagged as partial. It never claims to be a full trial balance.\",\"format\":\"json\",\"document_fields\":{\"document_id\":[\"internalId\",\"internalID\"],\"external_uuid\":[\"uuid\"],\"date\":[\"dateTimeIssued\",\"issueDate\"],\"kind_from\":{\"field\":\"documentType\",\"map\":{\"I\":\"sales_invoice\",\"i\":\"sales_invoice\",\"C\":\"sales_credit_note\",\"c\":\"sales_credit_note\",\"D\":\"purchase_debit_note\",\"d\":\"purchase_debit_note\"}},\"counterparty_id\":[\"receiverId\",\"receiver.id\"],\"counterparty_name\":[\"receiverName\",\"receiver.name\"],\"net_amount\":[\"netAmount\"],\"tax_amount\":[\"totalTaxAmount\",\"taxTotals\"],\"total_amount\":[\"totalAmount\",\"totalAmount\"],\"status\":{\"field\":\"status\",\"map\":{\"Valid\":\"valid\",\"Cancelled\":\"cancelled\",\"Rejected\":\"rejected\",\"Submitted\":\"submitted\"}}},\"fragment_accounts\":{\"revenue\":{\"account_code\":\"ETA-REV\",\"account_name\":\"Revenue per accepted e-invoices\",\"leadsheet_override\":\"LS-REV\"},\"vat\":{\"account_code\":\"ETA-VAT\",\"account_name\":\"Output VAT per accepted e-invoices\",\"leadsheet_override\":\"LS-VAT\"},\"receivables\":{\"account_code\":\"ETA-REC\",\"account_name\":\"Gross invoiced amount per accepted e-invoices\",\"leadsheet_override\":\"LS-REC\"}},\"partial\":true,\"id\":\"eta-einvoicing-documents\",\"profile_version\":\"1.0\"},\"source\":\"[]\",\"entity\":\"Fixture Co\",\"period_start\":\"2025-01-01\",\"period_end\":\"2025-12-31\",\"currency\":\"EGP\",\"minor_units\":2,\"extracted_at\":\"2026-09-10T08:00:00Z\"}", "ERR:FAIL: zero rows used from the source; coverage requirement no