  ("normalise", "{\"profile\":{\"system\":\"thebes_ledger_core\",\"description\":\"Trial balance projection from thebes-ledger-core: the fold over posted journal entries for a period, each line carrying an MMR inclusion proof for the entries that compose it. The adapter carries the proof verbatim and sets evidence_grade to cryptographic only when every line carries a proof; verification is delegated to the ledger verifier.\",\"format\":\"json\",\"columns\":{\"account_code\":[\"account_code\"],\"account_name\":[\"account_name\"],\"debit\":[\"debit\"],\"credit\":[\"credit\"],\"prior_debit\":[\"prior_debit\"],\"prior_credit\":[\"prior_credit\"],\"proof\":[\"proof\"]},\"amount_rules\":{\"decimal_separator\":\".\",\"balance_sign\":\"debit_positive\"},\"id\":\"thebes-ledger-core\",\"profile_version\":\"1.0\"},\"source\":\"[{\\\"account_code\\\": \\\"2376\\\", \\\"Account_Name\\\": \\\"Account 2376\\\", \\\"debit\\\": \\\"885746.64\\\", \\\"credit\\\": \\\"919228.73\\\", \\\"proof\\\": {\\\"scheme\\\": \\\"thebes-mmr-sha256-v1\\\", \\\"mmr_size\\\": 2528, \\\"root\\\": \\\"e844e802b97e40e339acce02e16bf5e274b40ccd50d3f69aa7a1a1e368449dc7\\\"}}]\",\"entity\":\"Fixture Co\",\"period_start\":\"2025-01-01\",\"period_end\":\"2025-12-31\",\"currency\":\"EGP\",\"minor_units\":2,\"extracted_at\":\"2026-09-10T08:00:00Z\"}", "{\"counts\":{\"documents\":0,\"evidence_grade\":\"cryptographic\",\"lines\":1,\"lines_with_proof\":1,\"partial_fragment\":false,\"rows_read\":1,\"rows_skipped\":0,\"rows_used\":1},\"tb\":{\"contract_version\":\"1.0\",\"currency\":\"EGP\",\"entity\":{\"name\":\"Fixture Co\"},\"lines\":[{\"account_code\":\"2376\",\"account_name\":\"Account 2376\",\"credit\":\"919228.73\",\"debit\":\"885746.64\",\"proof\":{\"mmr_size\":2528,\"root\":\"e844e802b97e40e339acce02e16bf5e274b40ccd50d3f69aa7a1a1e368449dc7\",\"scheme\":\"thebes-mmr-sha256-v1\"}}],\"minor_units\":2,\"period\":{\"end\":\"2025-12-31\",\"start\":\"2025-01-01\"},\"source\":{\"adapter\":\"thebes-ledger-core\",\"