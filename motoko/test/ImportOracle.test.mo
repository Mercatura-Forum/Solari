  ("normalise", "{\"profile\":{\"system\":\"thebes_ledger_core\",\"description\":\"Trial balance projection from thebes-ledger-core: the fold over posted journal entries for a period, each line carrying an MMR inclusion proof for the entries that compose it. The adapter carries the proof verbatim and sets evidence_grade to cryptographic only when every line carries a proof; verification is delegated to the ledger verifier.\",\"format\":\"json\",\"columns\":{\"account_code\":[\"account_code\"],\"account_name\":[\"account_name\"],\"debit\":[\"debit\"],\"credit\":[\"credit\"],\"prior_debit\":[\"prior_debit\"],\"prior_credit\":[\"prior_credit\"],\"proof\":[\"proof\"]},\"amount_rules\":{\"decimal_separator\":\".\",\"balance_sign\":\"debit_positive\"},\"id\":\"thebes-ledger-core\",\"profile_version\":\"1.0\"},\"source\":\"[{\\\"Account Code\\\": \\\"2718\\\", \\\"account_name\\\": \\\"Account 2718\\\", \\\"debit\\\": \\\"347616.01\\\", \\\"credit\\\": \\\"9789557.64\\\"}]\",\"entity\":\"Fixture Co\",\"period_start\":\"2025-01-01\",\"period_end\":\"2025-12-31\",\"currency\":\"EGP\",\"minor_units\":0,\"extracted_at\":\"2026-09-10T08:00:00Z\"}", "{\"counts\":{\"documents\":0,\"evidence_grade\":\"representation\",\"lines\":1,\"lines_with_proof\":0,\"partial_fragment\":false,\"rows_read\":1,\"rows_skipped\":0,\"rows_used\":1},\"tb\":{\"contract_version\":\"1.0\",\"currency\":\"EGP\",\"entity\":{\"name\":\"Fixture Co\"},\"lines\":[{\"account_code\":\"2718\",\"account_name\":\"Account 2718\",\"credit\":\"9789558\",\"debit\":\"347616\"}],\"minor_units\":0,\"period\":{\"end\":\"2025-12-31\",\"start\":\"2025-01-01\"},\"source\":{\"adapter\":\"thebes-ledger-core\",\"adapter_version\":\"1.0\",\"evidence_grade\":\"representation\",\"extracted_at\":\"2026-09-10T08:00:00Z\",\"source_file_sha256\":\"d1a8e05c7c0c9afa073eac998119594eca915bd3b5fd00d50726a1492a2a74c4\",\"system\":\"thebes_ledger_core\"}}}"),
