{"adapter":"odoo-rpc","agent":"thebes-agent","binary_sha256":"5eef827dd147b06cdb96086809202a2381c94c23a6b8c20fad5fddc024a3bf5b","binary_sha256_note":"self-reported by the agent; a code-signed reproducible build is the stronger evidence","hostname":"local.connect.test","mapping":[["entry_id","account.move.line.move_name"],["line_no","account.move.line.id"],["account_code","account.account.code by account_id"],["posting_date","the date part of posted_at: when the entry was recorded"],["effective_date","date, the accounting date"],["debit","debit, company currency"],["credit","credit, company currency"],["prepared_by","create_uid display name"],["source","manual for an entry in a general journal, else the journal type"],["description","name, else ref"],["posted_at","create_date (UTC record creation time) shifted by utc_offset_minutes; Odoo keeps no separate posting time"],["reverses_entry_id","name of the entry whose reversal_move_ids holds this entry"],["approved_by","not provided by Odoo"]],"not_provided":[["approved_by","PC-SELF-APPROVED"]],"page_lines_max":500,"places":2,"read_only":true,"read_only_check":"account.move.check_access_rights(\"write\", raise_exception=False)","system":"Odoo","utc_offset_minutes":120,"version":"17.0"}