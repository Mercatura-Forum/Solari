    ("F34-INVENTORY-COST", "{\"id\":\"F34-INVENTORY-COST\",\"number\":34,\"kind\":\"worksheet\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Inventory and cost of sales working paper\",\"ar\":\"ورقة عمل المخزون وتكلفة المبيعات\"},\"purpose\":{\"en\":\"Document every substantive procedure of the inventory and cost of sales cycle: the work, the results, the evidence and the conclusion, against the balances the trial balance holds.\",\"ar\":\"توثيق كل إجراء أساسي في دورة المخزون وتكلفة المبيعات: العمل والنتائج والأدلة والاستنتاج، مقابل الأرصدة الواردة في ميزان المراجعة.\"},\"procedures\":[\"P-INV-005\",\"P-INV-006\",\"P-INV-007\",\"P-INV-008\",\"P-INV-009\"],\"standards\":[\"ISA-330\",\"ISA-501\",\"ISA-520\",\"ISA-530\",\"ISA-540\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"balances\",\"title\":{\"en\":\"Balances, materiality and risks\",\"ar\":\"الأرصدة والأهمية النسبية والمخاطر\"},\"fields\":[{\"id\":\"performance_materiality\",\"label\":{\"en\":\"Performance materiality\",\"ar\":\"مادية الأداء\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.performance\",\"readonly\":true},{\"id\":\"clearly_trivial\",\"label\":{\"en\":\"Clearly trivial threshold\",\"ar\