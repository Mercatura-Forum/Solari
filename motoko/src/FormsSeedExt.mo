\",\"ar\":\"التقييم\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"effective\",\"label\":{\"en\":\"Designed and implemented effectively\",\"ar\":\"مصمم ومنفذ بفعالية\"}},{\"value\":\"deficient\",\"label\":{\"en\":\"Deficiency identified\",\"ar\":\"تم تحديد قصور\"}},{\"value\":\"not_relied\",\"label\":{\"en\":\"Not relied upon\",\"ar\":\"لا يُعتمد عليه\"}}]},{\"id\":\"control_activities\",\"label\":{\"en\":\"Control activities relevant to the audit and general IT controls\",\"ar\":\"أنشطة الرقابة ذات الصلة بالمراجعة والضوابط العامة لتقنية المعلومات\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"control_activities_eval\",\"label\":{\"en\":\"Evaluation\",\"ar\":\"التقييم\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"effective\",\"label\":{\"en\":\"Designed and implemented effectively\",\"ar\":\"مصمم ومنفذ بفعالية\"}},{\"value\":\"deficient\",\"label\":{\"en\":\"Deficiency identified\",\"ar\":\"تم تحديد قصور\"}},{\"value\":\"not_relied\",\"label\":{\"en\":\"Not relied upon\",\"ar\":\"لا يُعتمد عليه\"}}]}]},{\"id\":\"walkthroughs\",\"title\":{\"en\":\"Walkthroughs\",\"ar\":\"التتبع\"},\"fields\":[{\"id\":\"walkthroughs\",\"label\":{\"en\":\"Processes walked through from initiation to the ledger\",\"ar\":\"العمليات المتتبعة من البدء حتى دفتر الأستاذ\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"cycle\",\"label\":{\"en\":\"Cycle\",\"ar\":\"الدورة\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"REV\",\"label\":{\"en\":\"Revenue and receivables\",\"ar\":\"الإيرادات والمدينون\"}},{\"value\":\"PUR\",\"label\":{\"en\":\"Purchases and payables\",\"ar\":\"المشتريات والدائنون\"}},{\"value\":\"PAY\",\"label\":{\"en\":\"Payroll\",\"ar\":\"الرواتب\"}},{\"value\":\"INV\",\"label\":{\"en\":\"Inventory\",\"ar\":\"المخزون\"}},{\"value\":\"PPE\",\"label\":{\"en\":\"Fixed assets\",\"ar\":\"الأصول الثابتة\"}},{\"value\":\"TRE\",\"label\":{\"en\":\"Treasury\",\"ar\":\"الخزينة\"}},{\"value\":\"FSL\",\"label\":{\"en\":\"Entity-wide\",\"ar\":\"على مستوى المنشأة\"}}]},{\"id\":\"process\",\"label\":{\"en\":\"Process and transaction traced\",\"ar\":\"العملية والمعاملة المتتبعة\"},\"type\":\"text\",\"required\":true},{\"id\":\"performed_on\",\"label\":{\"en\":\"Performed on\",\"ar\":\"تاريخ التنفيذ\"},\"type\":\"date\",\"required\":true},{\"id\":\"controls\",\"label\":{\"en\":\"Controls identified\",\"ar\":\"الضوابط المحددة\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"deficiencies\",\"label\":{\"en\":\"Deficiencies noted\",\"ar\":\"أوجه القصور الملاحظة\"},\"type\":\"textarea\",\"required\":false}]}]},{\"id\":\"tests\",\"title\":{\"en\":\"Tests of controls\",\"ar\":\"اختبارات الرقابة\"},\"fields\":[{\"id\":\"tolerable_rate\",\"label\":{\"en\":\"Tolerable deviation rate\",\"ar\":\"معدل الانحراف المسموح به\"},\"type\":\"percent\",\"required\":true},{\"id\":\"expected_rate\",\"label\":{\"en\":\"Expected deviation rate\",\"ar\":\"معدل الانحراف المتوقع\"},\"type\":\"percent\",\"required\":true},{\"id\":\"beta\",\"label\":{\"en\":\"Risk of over-reliance\",\"ar\":\"خطر الاعتماد المفرط\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"0.05\",\"label\":{\"en\":\"5%\",\"ar\":\"5%\"}},{\"value\":\"0.10\",\"label\":{\"en\":\"10%\",\"ar\":\"10%\"}}]},{\"id\":\"planned_size\",\"label\":{\"en\":\"Planned sample size\",\"ar\":\"حجم العينة المخطط\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"paper.attribute_sample_size.sample_size\",\"readonly\":true},{\"id\":\"allowed_deviations\",\"label\":{\"en\":\"Allowed deviations\",\"ar\":\"الانحرافات المسموح بها\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"paper.attribute_sample_size.allowed_deviations\",\"readonly\":true},{\"id\":\"sample_size\",\"label\":{\"en\":\"Items tested\",\"ar\":\"العناصر المختبرة\"},\"type\":\"integer\",\"required\":false},{\"id\":\"deviations\",\"label\":{\"en\":\"Deviations found\",\"ar\":\"الانحرافات المكتشفة\"},\"type\":\"integer\",\"required\":false},{\"id\":\"deviation_rate\",\"label\":{\"en\":\"Sample deviation rate\",\"ar\":\"معدل الانحراف في العينة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"paper.attribute_evaluate.sample_deviation_rate\",\"readonly\":true},{\"id\":\"upper_deviation_limit\",\"label\":{\"en\":\"Upper deviation limit\",\"ar\":\"الحد الأعلى للانحراف\"},\"type\":\"text\",\"required\":false,\"autofill\":\"paper.attribute_evaluate.upper_deviation_limit\",\"readonly\":true},{\"id\":\"controls_tested\",\"label\":{\"en\":\"Controls tested\",\"ar\":\"الضوابط المختبرة\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"control\",\"label\":{\"en\":\"Control\",\"ar\":\"الضابط\"},\"type\":\"text\",\"required\":true},{\"id\":\"cycle\",\"label\":{\"en\":\"Cycle\",\"ar\":\"الدورة\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"REV\",\"label\":{\"en\":\"Revenue and receivables\",\"ar\":\"الإيرادات والمدينون\"}},{\"value\":\"PUR\",\"label\":{\"en\":\"Purchases and payables\",\"ar\":\"المشتريات والدائنون\"}},{\"value\":\"PAY\",\"label\":{\"en\":\"Payroll\",\"ar\":\"الرواتب\"}},{\"value\":\"INV\",\"label\":{\"en\":\"Inventory\",\"ar\":\"المخزون\"}},{\"value\":\"PPE\",\"label\":{\"en\":\"Fixed assets\",\"ar\":\"الأصول الثابتة\"}},{\"value\":\"TRE\",\"label\":{\"en\":\"Treasury\",\"ar\":\"الخزينة\"}},{\"value\":\"FSL\",\"label\":{\"en\":\"Entity-wide\",\"ar\":\"على مستوى المنشأة\"}}]},{\"id\":\"assertion\",\"label\":{\"en\":\"Assertion addressed\",\"ar\":\"الإقرار المعني\"},\"type\":\"text\",\"required\":true},{\"id\":\"items\",\"label\":{\"en\":\"Items tested\",\"ar\":\"العناصر المختبرة\"},\"type\":\"integer\",\"required\":true},{\"id\":\"deviations\",\"label\":{\"en\":\"Deviations\",\"ar\":\"الانحرافات\"},\"type\":\"integer\",\"required\":true},{\"id\":\"conclusion\",\"label\":{\"en\":\"Operating effectively\",\"ar\":\"يعمل بفعالية\"},\"type\":\"yesno\",\"required\":true}]},{\"id\":\"rollforward\",\"label\":{\"en\":\"Interim testing rolled forward to the period end, and reliance on evidence from previous audits with its justification\",\"ar\":\"ترحيل الاختبارات المرحلية إلى نهاية الفترة، والاعتماد على أدلة من مراجعات سابقة مع مبرراته\"},\"type\":\"textarea\",\"required\":false}],\"note\":{\"en\":\"Compute the paper from these inputs: the sample size while the items tested are blank, the evaluation once they are entered.\",\"ar\":\"تُحتسب الورقة من هذه المدخلات: حجم العينة ما دامت العناصر المختبرة فارغة، والتقييم بعد إدخالها.\"}},{\"id\":\"deficiencies\",\"title\":{\"en\":\"Deficiencies in internal control\",\"ar\":\"أوجه القصور في الرقابة الداخلية\"},\"fields\":[{\"id\":\"deficiencies\",\"label\":{\"en\":\"Deficiencies identified\",\"ar\":\"أوجه القصور المحددة\"},\"type\":\"table\",\"required\":false,\"columns\":[{\"id\":\"deficiency\",\"label\":{\"en\":\"Deficiency\",\"ar\":\"القصور\"},\"type\":\"text\",\"required\":true},{\"id\":\"significant\",\"label\":{\"en\":\"Significant\",\"ar\":\"جوهري\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"effect\",\"label\":{\"en\":\"Potential effect on the financial statements\",\"ar\":\"الأثر المحتمل على القوائم المالية\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"recommendation\",\"label\":{\"en\":\"Recommendation\",\"ar\":\"التوصية\"},\"type\":\"textarea\",\"required\":false}]},{\"id\":\"conclusion\",\"label\":{\"en\":\"Conclusion on control risk and the planned reliance\",\"ar\":\"الاستنتاج بشأن خطر الرقابة والاعتماد المخطط\"},\"type\":\"textarea\",\"required\":true}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F18-JOURNAL-ENTRY-TESTING", "{\"id\":\"F18-JOURNAL-ENTRY-TESTING\",\"number\":18,\"kind\":\"worksheet\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Journal-entry testing and significant unusual transactions\",\"ar\":\"اختبار قيود اليومية والمعاملات غير العادية المهمة\"},\"purpose\":{\"en\":\"Document the testing of journal entries and other adjustments for management override, the significant unusual transactions examined, and the response to any fraud identified or suspected.\",\"ar\":\"توثيق اختبار قيود اليومية والتسويات الأخرى لتجاوز الإدارة، والمعاملات غير العادية المهمة التي تم فحصها، والاستجابة لأي غش محدد أو مشتبه به.\"},\"procedures\":[\"P-FSL-034\",\"P-FSL-035\",\"P-FSL-052\"],\"standards\":[\"ISA-240\",\"ISA-330\",\"ISA-550\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"population\",\"title\":{\"en\":\"The population screened\",\"ar\":\"المجتمع الذي تم فحصه\"},\"fields\":[{\"id\":\"lines\",\"label\":{\"en\":\"Lines in the population\",\"ar\":\"السطور في المجتمع\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"paper.journal_completeness.lines_examined\",\"readonly\":true},{\"id\":\"entries\",\"label\":{\"en\":\"Entries in the population\",\"ar\":\"القيود في المجتمع\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"paper.journal_completeness.entries_examined\",\"readonly\":true},{\"id\":\"accounts_failed\",\"label\":{\"en\":\"Accounts that did not reconcile to the trial balance\",\"ar\":\"الحسابات التي لم تتطابق مع ميزان المراجعة\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"paper.journal_completeness.accounts_failed\",\"readonly\":true},{\"id\":\"criteria_applied\",\"label\":{\"en\":\"Screening criteria applied\",\"ar\":\"معايير الفحص المطبقة\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"paper.journal_screen.criteria_applied\",\"readonly\":true},{\"id\":\"flagged\",\"label\":{\"en\":\"Entries flagged\",\"ar\":\"القيود المعلَّمة\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"paper.journal_screen.flagged_entries\",\"readonly\":true},{\"id\":\"selection\",\"label\":{\"en\":\"Selection basis: criteria weighted, thresholds, and how the flagged entries were sampled\",\"ar\":\"أساس الاختيار: المعايير ووزنها والحدود وكيفية اختيار عينة من القيود المعلَّمة\"},\"type\":\"textarea\",\"required\":true}],\"note\":{\"en\":\"The population is imported and screened on the Journals page; its papers are read here and frozen when the form is prepared.\",\"ar\":\"يُستورد المجتمع ويُفحص في صفحة القيود؛ وتُقرأ أوراقه هنا وتُثبت عند إعداد النموذج.\"}},{\"id\":\"tested\",\"title\":{\"en\":\"Entries tested\",\"ar\":\"القيود المختبرة\"},\"fields\":[{\"id\":\"tested\",\"label\":{\"en\":\"Entries examined against supporting evidence\",\"ar\":\"القيود التي تم فحصها مقابل الأدلة المؤيدة\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"entry\",\"label\":{\"en\":\"Entry\",\"ar\":\"القيد\"},\"type\":\"text\",\"required\":true},{\"id\":\"criteria\",\"label\":{\"en\":\"Criteria met\",\"ar\":\"المعايير المستوفاة\"},\"type\":\"text\",\"required\":false},{\"id\":\"amount\",\"label\":{\"en\":\"Amount\",\"ar\":\"المبلغ\"},\"type\":\"money\",\"required\":true},{\"id\":\"explanation\",\"label\":{\"en\":\"Business rationale and support obtained\",\"ar\":\"المبرر التجاري والدليل المؤيد\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"supported\",\"label\":{\"en\":\"Appropriately supported and authorised\",\"ar\":\"مدعوم ومعتمد بشكل مناسب\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"misstatement\",\"label\":{\"en\":\"Misstatement, if any\",\"ar\":\"التحريف، إن وجد\"},\"type\":\"money\",\"required\":false}]},{\"id\":\"estimates_bias\",\"label\":{\"en\":\"Retrospective review of estimates for bias and evaluation of business rationale of significant transactions\",\"ar\":\"الفحص بأثر رجعي للتقديرات بحثًا عن التحيز وتقييم المبرر التجاري للمعاملات المهمة\"},\"type\":\"textarea\",\"required\":true}]},{\"id\":\"unusual\",\"title\":{\"en\":\"Significant unusual transactions\",\"ar\":\"المعاملات غير العادية المهمة\"},\"fields\":[{\"id\":\"unusual\",\"label\":{\"en\":\"Transactions outside the normal course of business\",\"ar\":\"المعاملات خارج السياق العادي للنشاط\"},\"type\":\"table\",\"required\":false,\"columns\":[{\"id\":\"description\",\"label\":{\"en\":\"Transaction\",\"ar\":\"المعاملة\"},\"type\":\"text\",\"required\":true},{\"id\":\"date\",\"label\":{\"en\":\"Date\",\"ar\":\"التاريخ\"},\"type\":\"date\",\"required\":true},{\"id\":\"amount\",\"label\":{\"en\":\"Amount\",\"ar\":\"المبلغ\"},\"type\":\"money\",\"required\":true},{\"id\":\"counterparty\",\"label\":{\"en\":\"Counterparty and relationship\",\"ar\":\"الطرف الآخر والعلاقة\"},\"type\":\"text\",\"required\":false},{\"id\":\"rationale\",\"label\":{\"en\":\"Business rationale and accounting evaluated\",\"ar\":\"المبرر التجاري والمعالجة المحاسبية المقيّمة\"},\"type\":\"textarea\",\"required\":true}]}]},{\"id\":\"fraud\",\"title\":{\"en\":\"Fraud identified or suspected\",\"ar\":\"الغش المحدد أو المشتبه به\"},\"fields\":[{\"id\":\"fraud\",\"label\":{\"en\":\"Outcome\",\"ar\":\"النتيجة\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"none\",\"label\":{\"en\":\"No fraud identified or suspected\",\"ar\":\"لم يُحدد غش ولم يُشتبه به\"}},{\"value\":\"suspected\",\"label\":{\"en\":\"Fraud suspected\",\"ar\":\"اشتباه في غش\"}},{\"value\":\"identified\",\"label\":{\"en\":\"Fraud identified\",\"ar\":\"تم تحديد غش\"}}]},{\"id\":\"response\",\"label\":{\"en\":\"Response: procedures, effect on the risk assessment, and communications with management, those charged with governance and authorities\",\"ar\":\"الاستجابة: الإجراءات والأثر على تقييم المخاطر والاتصالات مع الإدارة والمكلفين بالحوكمة والجهات المختصة\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"textarea\",\"required\":true}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F19-RELATED-PARTIES", "{\"id\":\"F19-RELATED-PARTIES\",\"number\":19,\"kind\":\"worksheet\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Related parties\",\"ar\":\"الأطراف ذات العلاقة\"},\"purpose\":{\"en\":\"Identify the entity's related parties and relationships, test the transactions and balances with them, and evaluate their accounting and disclosure.\",\"ar\":\"تحديد الأطراف ذات العلاقة بالمنشأة وعلاقاتها، واختبار المعاملات والأرصدة معها، وتقييم معالجتها المحاسبية والإفصاح عنها.\"},\"procedures\":[\"P-FSL-014\",\"P-FSL-036\",\"P-REV-014\",\"P-PAY-007\"],\"standards\":[\"ISA-550\",\"ISA-330\",\"ISA-240\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"identification\",\"title\":{\"en\":\"Identification\",\"ar\":\"التحديد\"},\"fields\":[{\"id\":\"sources\",\"label\":{\"en\":\"Sources inquired of and records inspected\",\"ar\":\"مصادر الاستفسار والسجلات التي تم فحصها\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"source\",\"label\":{\"en\":\"Source\",\"ar\":\"المصدر\"},\"type\":\"text\",\"required\":true},{\"id\":\"date\",\"label\":{\"en\":\"Date\",\"ar\":\"التاريخ\"},\"type\":\"date\",\"required\":true},{\"id\":\"result\",\"label\":{\"en\":\"Result\",\"ar\":\"النتيجة\"},\"type\":\"textarea\",\"required\":true}]},{\"id\":\"register\",\"label\":{\"en\":\"Related parties and relationships\",\"ar\":\"الأطراف ذات العلاقة والعلاقات\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"party\",\"label\":{\"en\":\"Related party\",\"ar\":\"الطرف ذو العلاقة\"},\"type\":\"text\",\"required\":true},{\"id\":\"relationship\",\"label\":{\"en\":\"Relationship\",\"ar\":\"العلاقة\"},\"type\":\"text\",\"required\":true},{\"id\":\"nature\",\"label\":{\"en\":\"Nature of transactions during the period\",\"ar\":\"طبيعة المعاملات خلال الفترة\"},\"type\":\"textarea\",\"required\":false}]},{\"id\":\"undisclosed\",\"label\":{\"en\":\"Related parties or transactions identified that management had not disclosed\",\"ar\":\"الأطراف أو المعاملات المحددة التي لم تفصح عنها الإدارة\"},\"type\":\"textarea\",\"required\":false}]},{\"id\":\"transactions\",\"title\":{\"en\":\"Transactions and balances\",\"ar\":\"المعاملات والأرصدة\"},\"fields\":[{\"id\":\"transactions\",\"label\":{\"en\":\"Significant related-party transactions tested\",\"ar\":\"معاملات الأطراف ذات العلاقة المهمة المختبرة\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"party\",\"label\":{\"en\":\"Party\",\"ar\":\"الطرف\"},\"type\":\"text\",\"required\":true},{\"id\":\"transaction\",\"label\":{\"en\":\"Transaction\",\"ar\":\"المعاملة\"},\"type\":\"text\",\"required\":true},{\"id\":\"amount\",\"label\":{\"en\":\"Amount\",\"ar\":\"المبلغ\"},\"type\":\"money\",\"required\":true},{\"id\":\"arms_length\",\"label\":{\"en\":\"Terms equivalent to an arm's-length transaction\",\"ar\":\"شروط معادلة لمعاملة بين أطراف مستقلة\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"authorised\",\"label\":{\"en\":\"Authorised and approved\",\"ar\":\"معتمدة ومصرح بها\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"disclosed\",\"label\":{\"en\":\"Disclosed\",\"ar\":\"مفصح عنها\"},\"type\":\"yesno\",\"required\":true}]},{\"id\":\"balances\",\"label\":{\"en\":\"Balances with related parties at the period end\",\"ar\":\"الأرصدة مع الأطراف ذات العلاقة في نهاية الفترة\"},\"type\":\"money\",\"required\":false},{\"id\":\"directors_remuneration\",\"label\":{\"en\":\"Directors' remuneration\",\"ar\":\"مكافآت أعضاء مجلس الإدارة\"},\"type\":\"money\",\"required\":false},{\"id\":\"key_management\",\"label\":{\"en\":\"Key management personnel compensation\",\"ar\":\"تعويضات كبار موظفي الإدارة\"},\"type\":\"money\",\"required\":false},{\"id\":\"remuneration_evidence\",\"label\":{\"en\":\"Remuneration agreed to minutes, contracts and payroll\",\"ar\":\"مطابقة المكافآت مع المحاضر والعقود وكشوف الرواتب\"},\"type\":\"textarea\",\"required\":true}]},{\"id\":\"conclusion\",\"title\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"fields\":[{\"id\":\"conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"appropriate\",\"label\":{\"en\":\"Accounted for and disclosed appropriately\",\"ar\":\"محاسبة وإفصاح مناسبان\"}},{\"value\":\"exceptions\",\"label\":{\"en\":\"Exceptions noted, recorded as misstatements or deficiencies\",\"ar\":\"استثناءات ملاحظة ومسجلة كتحريفات أو أوجه قصور\"}}]},{\"id\":\"rationale\",\"label\":{\"en\":\"Rationale\",\"ar\":\"المبررات\"},\"type\":\"textarea\",\"required\":true}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F20-LAWS-AND-REGULATIONS", "{\"id\":\"F20-LAWS-AND-REGULATIONS\",\"number\":20,\"kind\":\"checklist\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Laws and regulations\",\"ar\":\"القوانين واللوائح\"},\"purpose\":{\"en\":\"Record the legal and regulatory framework, the inquiries and inspections made about compliance, and the response to any non-compliance identified or suspected.\",\"ar\":\"توثيق الإطار القانوني والتنظيمي، والاستفسارات والفحوصات المتعلقة بالالتزام، والاستجابة لأي عدم التزام محدد أو مشتبه به.\"},\"procedures\":[\"P-FSL-013\",\"P-FSL-051\"],\"standards\":[\"ISA-250\",\"ISA-240\",\"ISA-260\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"framework\",\"title\":{\"en\":\"The framework\",\"ar\":\"الإطار\"},\"fields\":[{\"id\":\"direct\",\"label\":{\"en\":\"Laws and regulations with a direct effect on material amounts and disclosures\",\"ar\":\"القوانين واللوائح ذات الأثر المباشر على المبالغ والإفصاحات الجوهرية\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"other\",\"label\":{\"en\":\"Other laws and regulations fundamental to the business\",\"ar\":\"القوانين واللوائح الأخرى الأساسية للنشاط\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"inquiries\",\"label\":{\"en\":\"Inquiries of management and those charged with governance\",\"ar\":\"الاستفسارات من الإدارة والمكلفين بالحوكمة\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"who\",\"label\":{\"en\":\"Person inquired of\",\"ar\":\"الشخص المستفسر منه\"},\"type\":\"text\",\"required\":true},{\"id\":\"date\",\"label\":{\"en\":\"Date\",\"ar\":\"التاريخ\"},\"type\":\"date\",\"required\":true},{\"id\":\"response\",\"label\":{\"en\":\"Response\",\"ar\":\"الرد\"},\"type\":\"textarea\",\"required\":true}]},{\"id\":\"correspondence\",\"label\":{\"en\":\"Correspondence with licensing and regulatory authorities inspected\",\"ar\":\"تم فحص المراسلات مع جهات الترخيص والجهات الرقابية\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"minutes\",\"label\":{\"en\":\"Minutes of governance meetings inspected for legal matters\",\"ar\":\"تم فحص محاضر اجتماعات الحوكمة بحثًا عن الأمور القانونية\"},\"type\":\"yesno\",\"required\":true}]},{\"id\":\"noncompliance\",\"title\":{\"en\":\"Non-compliance\",\"ar\":\"عدم الالتزام\"},\"fields\":[{\"id\":\"status\",\"label\":{\"en\":\"Outcome\",\"ar\":\"النتيجة\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"none\",\"label\":{\"en\":\"No non-compliance identified or suspected\",\"ar\":\"لم يُحدد عدم التزام ولم يُشتبه به\"}},{\"value\":\"suspected\",\"label\":{\"en\":\"Suspected\",\"ar\":\"مشتبه به\"}},{\"value\":\"identified\",\"label\":{\"en\":\"Identified\",\"ar\":\"محدد\"}}]},{\"id\":\"nature\",\"label\":{\"en\":\"Nature and circumstances\",\"ar\":\"الطبيعة والظروف\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"effect\",\"label\":{\"en\":\"Effect on the financial statements and on the audit\",\"ar\":\"الأثر على القوائم المالية وعلى المراجعة\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"response\",\"label\":{\"en\":\"Procedures performed, discussion with management and legal advice obtained\",\"ar\":\"الإجراءات المنفذة والمناقشة مع الإدارة والمشورة القانونية التي تم الحصول عليها\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"tcwg\",\"label\":{\"en\":\"Communicated to those charged with governance\",\"ar\":\"تم إبلاغ المكلفين بالحوكمة\"},\"type\":\"select\",\"required\":false,\"options\":[{\"value\":\"yes\",\"label\":{\"en\":\"Yes\",\"ar\":\"نعم\"}},{\"value\":\"no\",\"label\":{\"en\":\"No\",\"ar\":\"لا\"}},{\"value\":\"na\",\"label\":{\"en\":\"Not applicable\",\"ar\":\"لا ينطبق\"}}]},{\"id\":\"reporting\",\"label\":{\"en\":\"Reporting to an appropriate authority\",\"ar\":\"الإبلاغ إلى جهة مختصة\"},\"type\":\"select\",\"required\":false,\"options\":[{\"value\":\"none\",\"label\":{\"en\":\"Not required\",\"ar\":\"غير مطلوب\"}},{\"value\":\"considered\",\"label\":{\"en\":\"Considered, with the conclusion recorded\",\"ar\":\"تم النظر فيه مع تسجيل الاستنتاج\"}},{\"value\":\"reported\",\"label\":{\"en\":\"Reported\",\"ar\":\"تم الإبلاغ\"}}]},{\"id\":\"conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"textarea\",\"required\":true}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F21-AUDITORS-EXPERT", "{\"id\":\"F21-AUDITORS-EXPERT\",\"number\":21,\"kind\":\"worksheet\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Use of an auditor's expert and management's expert\",\"ar\":\"استخدام خبير المراجع وخبير الإدارة\"},\"purpose\":{\"en\":\"Document the need for an expert, the evaluation of the expert's competence, capabilities and objectivity, the terms of the work, and the evaluation of its adequacy for the auditor's purposes.\",\"ar\":\"توثيق الحاجة إلى خبير، وتقييم كفاءته وقدراته وموضوعيته، وشروط العمل، وتقييم كفاية عمله لأغراض المراجع.\"},\"procedures\":[\"P-FSL-019\"],\"standards\":[\"ISA-620\",\"ISA-500\",\"ISA-540\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"need\",\"title\":{\"en\":\"The need\",\"ar\":\"الحاجة\"},\"fields\":[{\"id\":\"matter\",\"label\":{\"en\":\"Matter requiring expertise and the assertions affected\",\"ar\":\"الأمر الذي يتطلب خبرة والإقرارات المتأثرة\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"kind\",\"label\":{\"en\":\"Kind of expert\",\"ar\":\"نوع الخبير\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"auditor_internal\",\"label\":{\"en\":\"Auditor's expert, from the firm\",\"ar\":\"خبير المراجع من داخل المكتب\"}},{\"value\":\"auditor_external\",\"label\":{\"en\":\"Auditor's expert, engaged\",\"ar\":\"خبير المراجع المتعاقد معه\"}},{\"value\":\"management\",\"label\":{\"en\":\"Management's expert\",\"ar\":\"خبير الإدارة\"}}]},{\"id\":\"name\",\"label\":{\"en\":\"Expert\",\"ar\":\"الخبير\"},\"type\":\"text\",\"required\":true},{\"id\":\"field\",\"label\":{\"en\":\"Field of expertise\",\"ar\":\"مجال الخبرة\"},\"type\":\"text\",\"required\":true}]},{\"id\":\"evaluation\",\"title\":{\"en\":\"Competence, capabilities and objectivity\",\"ar\":\"الكفاءة والقدرات والموضوعية\"},\"fields\":[{\"id\":\"competence\",\"label\":{\"en\":\"Competence and capabilities: qualifications, experience and reputation\",\"ar\":\"الكفاءة والقدرات: المؤهلات والخبرة والسمعة\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"objectivity\",\"label\":{\"en\":\"Objectivity: interests, relationships and threats, and safeguards\",\"ar\":\"الموضوعية: المصالح والعلاقات والتهديدات والضمانات\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"terms\",\"label\":{\"en\":\"Terms agreed: nature, scope and objectives, roles, communication, confidentiality\",\"ar\":\"الشروط المتفق عليها: الطبيعة والنطاق والأهداف والأدوار والاتصال والسرية\"},\"type\":\"textarea\",\"required\":true}]},{\"id\":\"work\",\"title\":{\"en\":\"The work and its evaluation\",\"ar\":\"العمل وتقييمه\"},\"fields\":[{\"id\":\"work\",\"label\":{\"en\":\"Work performed by the expert\",\"ar\":\"العمل الذي نفذه الخبير\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"adequacy\",\"label\":{\"en\":\"Evaluation of relevance and reasonableness of findings, assumptions, methods and source data\",\"ar\":\"تقييم ملاءمة النتائج ومعقوليتها والافتراضات والطرق والبيانات المصدرية\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"adequate\",\"label\":{\"en\":\"Adequate for the auditor's purposes\",\"ar\":\"كافٍ لأغراض المراجع\"}},{\"value\":\"additional\",\"label\":{\"en\":\"Additional procedures required\",\"ar\":\"يلزم إجراءات إضافية\"}},{\"value\":\"not_adequate\",\"label\":{\"en\":\"Not adequate\",\"ar\":\"غير كافٍ\"}}]},{\"id\":\"reference\",\"label\":{\"en\":\"Reference to the expert in the auditor's report\",\"ar\":\"الإشارة إلى الخبير في تقرير المراجع\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"no\",\"label\":{\"en\":\"No reference\",\"ar\":\"لا إشارة\"}},{\"value\":\"yes\",\"label\":{\"en\":\"Referred to, without reducing responsibility (reason recorded)\",\"ar\":\"تمت الإشارة إليه دون تخفيف المسؤولية (مع تسجيل السبب)\"}}]}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F22-GROUP-AUDIT", "{\"id\":\"F22-GROUP-AUDIT\",\"number\":22,\"kind\":\"worksheet\",\"phase\":\"planning\",\"title\":{\"en\":\"Group audit plan and instructions to component auditors\",\"ar\":\"خطة مراجعة المجموعة والتعليمات إلى مراجعي المكونات\"},\"purpose\":{\"en\":\"Set the group audit strategy: the components and their scope, component performance materiality checked against the group's, the significant risks at group level, the instructions and communications with component auditors, and the group completion.\",\"ar\":\"وضع استراتيجية مراجعة المجموعة: المكونات ونطاقها، ومادية الأداء للمكونات مقابل مادية المجموعة، والمخاطر المهمة على مستوى المجموعة، والتعليمات والاتصالات مع مراجعي المكونات، وإنجاز مراجعة المجموعة.\"},\"procedures\":[\"P-FSL-021\",\"P-FSL-048\"],\"standards\":[\"ISA-600\",\"ISA-320\",\"ISA-330\"],\"computation\":\"component_materiality\",\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"group\",\"title\":{\"en\":\"The group\",\"ar\":\"المجموعة\"},\"fields\":[{\"id\":\"structure\",\"label\":{\"en\":\"Group structure, consolidation process and the components identified\",\"ar\":\"هيكل المجموعة وعملية التوحيد والمكونات المحددة\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"ladder\",\"label\":{\"en\":\"Components on this file and their state\",\"ar\":\"المكونات في هذا الملف وحالتها\"},\"type\":\"table\",\"required\":false,\"autofill\":\"group.components\",\"readonly\":true,\"columns\":[{\"id\":\"name\",\"label\":{\"en\":\"Component\",\"ar\":\"المكون\"},\"type\":\"text\",\"required\":false},{\"id\":\"entity\",\"label\":{\"en\":\"Entity\",\"ar\":\"الكيان\"},\"type\":\"text\",\"required\":false},{\"id\":\"component_auditor\",\"label\":{\"en\":\"Component auditor\",\"ar\":\"مراجع المكون\"},\"type\":\"text\",\"required\":false},{\"id\":\"scope\",\"label\":{\"en\":\"Scope\",\"ar\":\"النطاق\"},\"type\":\"text\",\"required\":false},{\"id\":\"status\",\"label\":{\"en\":\"State\",\"ar\":\"الحالة\"},\"type\":\"text\",\"required\":false}]},{\"id\":\"group_overall\",\"label\":{\"en\":\"Group overall materiality\",\"ar\":\"الأهمية النسبية الإجمالية للمجموعة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.overall\",\"readonly\":true},{\"id\":\"group_performance\",\"label\":{\"en\":\"Group performance materiality\",\"ar\":\"مادية الأداء للمجموعة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.performance\",\"readonly\":true},{\"id\":\"group_clearly_trivial\",\"label\":{\"en\":\"Group clearly trivial threshold\",\"ar\":\"حد المبالغ التافهة للمجموعة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.clearly_trivial\",\"readonly\":true}]},{\"id\":\"materiality\",\"title\":{\"en\":\"Component materiality\",\"ar\":\"الأهمية النسبية للمكونات\"},\"fields\":[{\"id\":\"components\",\"label\":{\"en\":\"Component performance materiality and communication thresholds\",\"ar\":\"مادية الأداء للمكونات وحدود الإبلاغ\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"id\",\"label\":{\"en\":\"Component\",\"ar\":\"المكون\"},\"type\":\"text\",\"required\":true},{\"id\":\"name\",\"label\":{\"en\":\"Entity\",\"ar\":\"الكيان\"},\"type\":\"text\",\"required\":true},{\"id\":\"performance\",\"label\":{\"en\":\"Component performance materiality\",\"ar\":\"مادية الأداء للمكون\"},\"type\":\"money\",\"required\":true},{\"id\":\"threshold\",\"label\":{\"en\":\"Threshold for communicating misstatements\",\"ar\":\"حد الإبلاغ عن التحريفات\"},\"type\":\"money\",\"required\":true}]},{\"id\":\"all_compliant\",\"label\":{\"en\":\"Every component below the group's performance materiality and within the clearly trivial threshold\",\"ar\":\"كل المكونات دون مادية الأداء للمجموعة وضمن حد المبالغ التافهة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"paper.component_materiality.all_compliant\",\"readonly\":true},{\"id\":\"components_examined\",\"label\":{\"en\":\"Components checked\",\"ar\":\"المكونات التي تم فحصها\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"paper.component_materiality.components_examined\",\"readonly\":true}],\"note\":{\"en\":\"Compute the component materiality paper from the table; the check is frozen when the plan is prepared.\",\"ar\":\"تُحتسب ورقة الأهمية النسبية للمكونات من الجدول؛ ويُثبت الفحص عند إعداد الخطة.\"}},{\"id\":\"instructions\",\"title\":{\"en\":\"Instructions and communication\",\"ar\":\"التعليمات والاتصال\"},\"fields\":[{\"id\":\"significant_risks\",\"label\":{\"en\":\"Significant risks of material misstatement of the group financial statements\",\"ar\":\"المخاطر المهمة للتحريف الجوهري في القوائم المالية للمجموعة\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"work_requested\",\"label\":{\"en\":\"Work requested from component auditors, by component\",\"ar\":\"العمل المطلوب من مراجعي المكونات، حسب المكون\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"reporting_deadline\",\"label\":{\"en\":\"Reporting deadline for component auditors\",\"ar\":\"الموعد النهائي لتقارير مراجعي المكونات\"},\"type\":\"date\",\"required\":true},{\"id\":\"involvement\",\"label\":{\"en\":\"Group team's involvement in the component auditors' work\",\"ar\":\"مشاركة فريق المجموعة في عمل مراجعي المكونات\"},\"type\":\"textarea\",\"required\":true}]},{\"id\":\"completion\",\"title\":{\"en\":\"Group completion\",\"ar\":\"إنجاز مراجعة المجموعة\"},\"fields\":[{\"id\":\"evaluation\",\"label\":{\"en\":\"Evaluation of component auditors' reports and the sufficiency of group evidence\",\"ar\":\"تقييم تقارير مراجعي المكونات وكفاية أدلة المجموعة\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"consolidation\",\"label\":{\"en\":\"Consolidation adjustments and reclassifications tested\",\"ar\":\"تسويات التوحيد وإعادة التبويب المختبرة\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"select\",\"required\":false,\"options\":[{\"value\":\"sufficient\",\"label\":{\"en\":\"Sufficient appropriate evidence obtained for the group opinion\",\"ar\":\"تم الحصول على ما يكفي من الأدلة المناسبة لرأي المجموعة\"}},{\"value\":\"not_yet\",\"label\":{\"en\":\"Not yet: component work outstanding\",\"ar\":\"ليس بعد: عمل المكونات لم يكتمل\"}}]}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F23-INVENTORY-COUNT", "{\"id\":\"F23-INVENTORY-COUNT\",\"number\":23,\"kind\":\"checklist\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Inventory count attendance\",\"ar\":\"حضور جرد المخزون\"},\"purpose\":{\"en\":\"Record attendance at the physical inventory count: the instructions evaluated, the counts observed and tested, inventory held by third parties, and the roll-forward or roll-back to the period end.\",\"ar\":\"توثيق حضور الجرد الفعلي للمخزون: تقييم تعليمات الجرد، والعدّ الملاحظ والمختبر، والمخزون لدى الغير، والترحيل إلى نهاية الفترة أو منها.\"},\"procedures\":[\"P-INV-002\",\"P-INV-003\",\"P-INV-004\"],\"standards\":[\"ISA-501\",\"ISA-505\",\"ISA-330\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"count\",\"title\":{\"en\":\"The count\",\"ar\":\"الجرد\"},\"fields\":[{\"id\":\"locations\",\"label\":{\"en\":\"Locations counted and attended\",\"ar\":\"المواقع التي تم جردها وحضورها\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"location\",\"label\":{\"en\":\"Location\",\"ar\":\"الموقع\"},\"type\":\"text\",\"required\":true},{\"id\":\"date\",\"label\":{\"en\":\"Count date\",\"ar\":\"تاريخ الجرد\"},\"type\":\"date\",\"required\":true},{\"id\":\"attended\",\"label\":{\"en\":\"Attended by the team\",\"ar\":\"حضره الفريق\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"counter\",\"label\":{\"en\":\"Team member attending\",\"ar\":\"عضو الفريق الحاضر\"},\"type\":\"text\",\"required\":false}]},{\"id\":\"instructions\",\"label\":{\"en\":\"Management's count instructions evaluated as adequate\",\"ar\":\"تم تقييم تعليمات الجرد الصادرة عن الإدارة على أنها كافية\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"procedures_observed\",\"label\":{\"en\":\"Count procedures observed as performed per the instructions\",\"ar\":\"تمت ملاحظة تنفيذ إجراءات الجرد وفقًا للتعليمات\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"cutoff_recorded\",\"label\":{\"en\":\"Cut-off details recorded (last receipts and dispatches, movements during the count)\",\"ar\":\"تم تسجيل تفاصيل الفصل الزمني (آخر الاستلامات والشحنات والحركات أثناء الجرد)\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"test_counts\",\"label\":{\"en\":\"Test counts\",\"ar\":\"العدّ الاختباري\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"item\",\"label\":{\"en\":\"Item\",\"ar\":\"الصنف\"},\"type\":\"text\",\"required\":true},{\"id\":\"sheet_qty\",\"label\":{\"en\":\"Quantity per count sheet\",\"ar\":\"الكمية وفق كشف الجرد\"},\"type\":\"text\",\"required\":true},{\"id\":\"test_qty\",\"label\":{\"en\":\"Quantity counted by the team\",\"ar\":\"الكمية التي عدّها الفريق\"},\"type\":\"text\",\"required\":true},{\"id\":\"difference\",\"label\":{\"en\":\"Difference and resolution\",\"ar\":\"الفرق وكيفية معالجته\"},\"type\":\"textarea\",\"required\":false}]},{\"id\":\"condition\",\"label\":{\"en\":\"Obsolete, damaged or slow-moving items noted\",\"ar\":\"الأصناف المتقادمة أو التالفة أو بطيئة الحركة الملاحظة\"},\"type\":\"textarea\",\"required\":false}]},{\"id\":\"third_parties\",\"title\":{\"en\":\"Inventory held by third parties\",\"ar\":\"المخزون لدى الغير\"},\"fields\":[{\"id\":\"third_parties\",\"label\":{\"en\":\"Custodians\",\"ar\":\"الأمناء\"},\"type\":\"table\",\"required\":false,\"columns\":[{\"id\":\"holder\",\"label\":{\"en\":\"Third party\",\"ar\":\"الطرف الثالث\"},\"type\":\"text\",\"required\":true},{\"id\":\"quantity\",\"label\":{\"en\":\"Quantity or value held\",\"ar\":\"الكمية أو القيمة المحتفظ بها\"},\"type\":\"text\",\"required\":true},{\"id\":\"confirmed\",\"label\":{\"en\":\"Confirmation received directly\",\"ar\":\"تم استلام مصادقة مباشرة\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"alternative\",\"label\":{\"en\":\"Alternative procedures\",\"ar\":\"إجراءات بديلة\"},\"type\":\"textarea\",\"required\":false}]}]},{\"id\":\"rollforward\",\"title\":{\"en\":\"Roll-forward or roll-back\",\"ar\":\"الترحيل\"},\"fields\":[{\"id\":\"count_date\",\"label\":{\"en\":\"Count date\",\"ar\":\"تاريخ الجرد\"},\"type\":\"date\",\"required\":true},{\"id\":\"reconciled\",\"label\":{\"en\":\"Movements between the count date and the period end reconciled\",\"ar\":\"تمت مطابقة الحركات بين تاريخ الجرد ونهاية الفترة\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"yes\",\"label\":{\"en\":\"Yes\",\"ar\":\"نعم\"}},{\"value\":\"no\",\"label\":{\"en\":\"No\",\"ar\":\"لا\"}},{\"value\":\"na\",\"label\":{\"en\":\"Not applicable\",\"ar\":\"لا ينطبق\"}}]},{\"id\":\"rollforward\",\"label\":{\"en\":\"Roll-forward work and results\",\"ar\":\"عمل الترحيل ونتائجه\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"conclusion\",\"label\":{\"en\":\"Conclusion on existence and condition of inventory\",\"ar\":\"الاستنتاج بشأن وجود المخزون وحالته\"},\"type\":\"textarea\",\"required\":true}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F24-LITIGATION-AND-PROVISIONS", "{\"id\":\"F24-LITIGATION-AND-PROVISIONS\",\"number\":24,\"kind\":\"worksheet\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Litigation, claims and provisions\",\"ar\":\"الدعاوى القضائية والمطالبات والمخصصات\"},\"purpose\":{\"en\":\"Identify litigation and claims, obtain and evaluate legal letters, and test the provisions and contingent liabilities recognised or disclosed.\",\"ar\":\"تحديد الدعاوى القضائية والمطالبات، والحصول على خطابات المستشارين القانونيين وتقييمها، واختبار المخصصات والالتزامات المحتملة المثبتة أو المفصح عنها.\"},\"procedures\":[\"P-FSL-033\",\"P-PUR-009\"],\"standards\":[\"ISA-501\",\"ISA-540\",\"ISA-560\",\"ISA-505\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"inquiries\",\"title\":{\"en\":\"Inquiries and legal letters\",\"ar\":\"الاستفسارات وخطابات المستشارين القانونيين\"},\"fields\":[{\"id\":\"inquiries\",\"label\":{\"en\":\"Inquiries of management and others\",\"ar\":\"الاستفسارات من الإدارة وغيرها\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"who\",\"label\":{\"en\":\"Person inquired of\",\"ar\":\"الشخص المستفسر منه\"},\"type\":\"text\",\"required\":true},{\"id\":\"date\",\"label\":{\"en\":\"Date\",\"ar\":\"التاريخ\"},\"type\":\"date\",\"required\":true},{\"id\":\"response\",\"label\":{\"en\":\"Response\",\"ar\":\"الرد\"},\"type\":\"textarea\",\"required\":true}]},{\"id\":\"legal_letters\",\"label\":{\"en\":\"Legal letters\",\"ar\":\"خطابات المستشارين القانونيين\"},\"type\":\"table\",\"required\":false,\"columns\":[{\"id\":\"counsel\",\"label\":{\"en\":\"Counsel\",\"ar\":\"المستشار\"},\"type\":\"text\",\"required\":true},{\"id\":\"sent\",\"label\":{\"en\":\"Sent\",\"ar\":\"تاريخ الإرسال\"},\"type\":\"date\",\"required\":true},{\"id\":\"received\",\"label\":{\"en\":\"Received\",\"ar\":\"تاريخ الاستلام\"},\"type\":\"date\",\"required\":false},{\"id\":\"matters\",\"label\":{\"en\":\"Matters reported and counsel's assessment\",\"ar\":\"الأمور المبلغ عنها وتقييم المستشار\"},\"type\":\"textarea\",\"required\":false}]},{\"id\":\"minutes_reviewed\",\"label\":{\"en\":\"Minutes and legal expense accounts reviewed\",\"ar\":\"تم فحص المحاضر وحسابات المصروفات القانونية\"},\"type\":\"yesno\",\"required\":true}]},{\"id\":\"matters\",\"title\":{\"en\":\"Matters identified\",\"ar\":\"الأمور المحددة\"},\"fields\":[{\"id\":\"matters\",\"label\":{\"en\":\"Litigation, claims and assessments\",\"ar\":\"الدعاوى والمطالبات والتقديرات\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"matter\",\"label\":{\"en\":\"Matter\",\"ar\":\"الأمر\"},\"type\":\"text\",\"required\":true},{\"id\":\"nature\",\"label\":{\"en\":\"Nature\",\"ar\":\"الطبيعة\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"litigation\",\"label\":{\"en\":\"Litigation\",\"ar\":\"دعوى قضائية\"}},{\"value\":\"claim\",\"label\":{\"en\":\"Claim\",\"ar\":\"مطالبة\"}},{\"value\":\"regulatory\",\"label\":{\"en\":\"Regulatory\",\"ar\":\"تنظيمية\"}},{\"value\":\"other\",\"label\":{\"en\":\"Other\",\"ar\":\"أخرى\"}}]},{\"id\":\"probability\",\"label\":{\"en\":\"Probability of outflow\",\"ar\":\"احتمال التدفق الخارج\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"remote\",\"label\":{\"en\":\"Remote\",\"ar\":\"بعيد الاحتمال\"}},{\"value\":\"possible\",\"label\":{\"en\":\"Possible\",\"ar\":\"ممكن\"}},{\"value\":\"probable\",\"label\":{\"en\":\"Probable\",\"ar\":\"مرجح\"}}]},{\"id\":\"estimate\",\"label\":{\"en\":\"Estimated amount\",\"ar\":\"المبلغ المقدر\"},\"type\":\"money\",\"required\":false},{\"id\":\"provision\",\"label\":{\"en\":\"Provision recognised\",\"ar\":\"المخصص المثبت\"},\"type\":\"money\",\"required\":false},{\"id\":\"disclosed\",\"label\":{\"en\":\"Disclosed\",\"ar\":\"مفصح عنه\"},\"type\":\"yesno\",\"required\":true}]}]},{\"id\":\"provisions\",\"title\":{\"en\":\"Provisions\",\"ar\":\"المخصصات\"},\"fields\":[{\"id\":\"provisions_current\",\"label\":{\"en\":\"Provisions, current (trial balance)\",\"ar\":\"المخصصات المتداولة (ميزان المراجعة)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-PROVC\",\"readonly\":true},{\"id\":\"provisions_noncurrent\",\"label\":{\"en\":\"Provisions, non-current (trial balance)\",\"ar\":\"المخصصات غير المتداولة (ميزان المراجعة)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-PROVNC\",\"readonly\":true},{\"id\":\"provisions\",\"label\":{\"en\":\"Movement and basis by class\",\"ar\":\"الحركة والأساس حسب الفئة\"},\"type\":\"table\",\"required\":false,\"columns\":[{\"id\":\"class\",\"label\":{\"en\":\"Class\",\"ar\":\"الفئة\"},\"type\":\"text\",\"required\":true},{\"id\":\"opening\",\"label\":{\"en\":\"Opening\",\"ar\":\"الرصيد الافتتاحي\"},\"type\":\"money\",\"required\":true},{\"id\":\"additions\",\"label\":{\"en\":\"Additions\",\"ar\":\"الإضافات\"},\"type\":\"money\",\"required\":true},{\"id\":\"used\",\"label\":{\"en\":\"Used or released\",\"ar\":\"المستخدم أو المعكوس\"},\"type\":\"money\",\"required\":true},{\"id\":\"closing\",\"label\":{\"en\":\"Closing\",\"ar\":\"الرصيد الختامي\"},\"type\":\"money\",\"required\":true},{\"id\":\"basis\",\"label\":{\"en\":\"Basis of the estimate tested\",\"ar\":\"أساس التقدير المختبر\"},\"type\":\"textarea\",\"required\":true}]},{\"id\":\"conclusion\",\"label\":{\"en\":\"Conclusion on completeness, measurement and disclosure\",\"ar\":\"الاستنتاج بشأن الاكتمال والقياس والإفصاح\"},\"type\":\"textarea\",\"required\":true}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F25-MANAGEMENT-LETTER", "{\"id\":\"F25-MANAGEMENT-LETTER\",\"number\":25,\"kind\":\"letter\",\"phase\":\"completion\",\"title\":{\"en\":\"Management letter and control deficiencies\",\"ar\":\"خطاب الإدارة وأوجه القصور في الرقابة\"},\"purpose\":{\"en\":\"Communicate to management, in writing, the deficiencies in internal control identified during the audit that merit their attention, with the responses agreed.\",\"ar\":\"إبلاغ الإدارة كتابيًا بأوجه القصور في الرقابة الداخلية التي حُددت خلال المراجعة وتستحق اهتمامها، مع الردود المتفق عليها.\"},\"procedures\":[\"P-FSL-047\"],\"standards\":[\"ISA-265\",\"ISA-260\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"content\",\"title\":{\"en\":\"Content\",\"ar\":\"المحتوى\"},\"fields\":[{\"id\":\"addressee\",\"label\":{\"en\":\"Addressed to\",\"ar\":\"موجه إلى\"},\"type\":\"text\",\"required\":true},{\"id\":\"firm_name\",\"label\":{\"en\":\"Audit firm\",\"ar\":\"مكتب المراجعة\"},\"type\":\"text\",\"required\":true},{\"id\":\"letter_date\",\"label\":{\"en\":\"Date of the letter\",\"ar\":\"تاريخ الخطاب\"},\"type\":\"date\",\"required\":true},{\"id\":\"deficiencies\",\"label\":{\"en\":\"Deficiencies identified on the internal control form\",\"ar\":\"أوجه القصور المحددة في نموذج الرقابة الداخلية\"},\"type\":\"table\",\"required\":false,\"autofill\":\"form.F17-INTERNAL-CONTROL.deficiencies\",\"readonly\":true,\"columns\":[{\"id\":\"deficiency\",\"label\":{\"en\":\"Deficiency\",\"ar\":\"القصور\"},\"type\":\"text\",\"required\":false},{\"id\":\"significant\",\"label\":{\"en\":\"Significant\",\"ar\":\"جوهري\"},\"type\":\"text\",\"required\":false},{\"id\":\"effect\",\"label\":{\"en\":\"Potential effect\",\"ar\":\"الأثر المحتمل\"},\"type\":\"text\",\"required\":false},{\"id\":\"recommendation\",\"label\":{\"en\":\"Recommendation\",\"ar\":\"التوصية\"},\"type\":\"text\",\"required\":false}]},{\"id\":\"other_matters\",\"label\":{\"en\":\"Other matters brought to management's attention\",\"ar\":\"أمور أخرى لُفت انتباه الإدارة إليها\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"responses\",\"label\":{\"en\":\"Management's responses\",\"ar\":\"ردود الإدارة\"},\"type\":\"table\",\"required\":false,\"columns\":[{\"id\":\"deficiency\",\"label\":{\"en\":\"Deficiency\",\"ar\":\"القصور\"},\"type\":\"text\",\"required\":true},{\"id\":\"response\",\"label\":{\"en\":\"Response and action\",\"ar\":\"الرد والإجراء\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"owner\",\"label\":{\"en\":\"Responsible\",\"ar\":\"المسؤول\"},\"type\":\"text\",\"required\":false},{\"id\":\"due\",\"label\":{\"en\":\"Target date\",\"ar\":\"التاريخ المستهدف\"},\"type\":\"date\",\"required\":false}]}],\"note\":{\"en\":\"The deficiencies are read from the internal control form and frozen when this letter is prepared; a change there marks them as drifted here.\",\"ar\":\"تُقرأ أوجه القصور من نموذج الرقابة الداخلية وتُثبت عند إعداد هذا الخطاب؛ وأي تغيير هناك يسمها هنا بأنها تغيرت.\"}}],\"letter\":{\"en\":[\"To {{field:addressee}}\",\"In planning and performing our audit of the financial statements of {{engagement.client}} for the period ended {{engagement.period_end}}, we considered the entity's internal control in order to design audit procedures appropriate in the circumstances, and not to express an opinion on the effectiveness of internal control. Our consideration would not necessarily identify all deficiencies that might exist.\",\"The deficiencies below came to our attention during the audit and, in our judgement, merit management's attention. A deficiency marked significant is one that, in our judgement, is of sufficient importance to merit the attention of those charged with governance as well.\",\"{{table:deficiencies}}\",\"{{field:other_matters}}\",\"Management's responses: {{table:responses}}\",\"This letter is intended solely for the information and use of management and those charged with governance and is not intended to be and should not be used by anyone else.\",\"Yours faithfully, {{field:firm_name}}, {{field:letter_date}}\"],\"ar\":[\"إلى {{field:addressee}}\",\"عند تخطيط وتنفيذ مراجعتنا للقوائم المالية لـ {{engagement.client}} عن الفترة المنتهية في {{engagement.period_end}}، أخذنا في الاعتبار الرقابة الداخلية للمنشأة بغرض تصميم إجراءات مراجعة مناسبة للظروف، وليس بغرض إبداء رأي في فعالية الرقابة الداخلية. ولا يؤدي هذا الاعتبار بالضرورة إلى تحديد جميع أوجه القصور التي قد تكون موجودة.\",\"لفتت أوجه القصور التالية انتباهنا خلال المراجعة، ونرى أنها تستحق اهتمام الإدارة. والقصور الموسوم بأنه جوهري هو، في تقديرنا، من الأهمية بحيث يستحق اهتمام المكلفين بالحوكمة أيضًا.\",\"{{table:deficiencies}}\",\"{{field:other_matters}}\",\"ردود الإدارة: {{table:responses}}\",\"هذا الخطاب موجه حصرًا لمعلومات الإدارة والمكلفين بالحوكمة واستخدامهم، وليس معدًا ليستخدمه أي طرف آخر ولا ينبغي ذلك.\",\"وتفضلوا بقبول فائق الاحترام، {{field:firm_name}}، {{field:letter_date}}\"]},\"signoff\":{\"prepare\":[\"partner\",\"manager\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F26-KAM-AND-REPORT", "{\"id\":\"F26-KAM-AND-REPORT\",\"number\":26,\"kind\":\"worksheet\",\"phase\":\"completion\",\"title\":{\"en\":\"Key audit matters and the auditor's report\",\"ar\":\"الأمور الرئيسة للمراجعة وتقرير المراجع\"},\"purpose\":{\"en\":\"Form the opinion from the conclusions of the file, determine the key audit matters, draft the report, and record the response to facts that become known after the report date.\",\"ar\":\"تكوين الرأي من استنتاجات الملف، وتحديد الأمور الرئيسة للمراجعة، وصياغة التقرير، وتوثيق الاستجابة للحقائق التي تُعرف بعد تاريخ التقرير.\"},\"procedures\":[\"P-FSL-045\",\"P-FSL-046\",\"P-FSL-053\",\"P-FSL-055\"],\"standards\":[\"ISA-700\",\"ISA-701\",\"ISA-705\",\"ISA-706\",\"ISA-560\",\"ISA-570\",\"ISA-800\",\"ISA-805\",\"ISA-810\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"basis\",\"title\":{\"en\":\"The conclusions the opinion rests on\",\"ar\":\"الاستنتاجات التي يقوم عليها الرأي\"},\"fields\":[{\"id\":\"going_concern_conclusion\",\"label\":{\"en\":\"Going concern conclusion\",\"ar\":\"استنتاج الاستمرارية\"},\"type\":\"text\",\"required\":false,\"autofill\":\"form.F09-GOING-CONCERN.conclusion\",\"readonly\":true},{\"id\":\"misstatement_conclusion\",\"label\":{\"en\":\"Misstatement evaluation\",\"ar\":\"تقييم التحريفات\"},\"type\":\"text\",\"required\":false,\"autofill\":\"form.F10-MISSTATEMENTS.conclusion\",\"readonly\":true},{\"id\":\"uncorrected\",\"label\":{\"en\":\"Uncorrected misstatements, effect on profit\",\"ar\":\"التحريفات غير المصححة، الأثر على الربح\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.aggregation.uncorrected.profit\",\"readonly\":true},{\"id\":\"subsequent_events\",\"label\":{\"en\":\"Subsequent events conclusion\",\"ar\":\"استنتاج الأحداث اللاحقة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"form.F11-SUBSEQUENT-EVENTS.conclusion\",\"readonly\":true},{\"id\":\"open_procedures\",\"label\":{\"en\":\"Procedures of the programme still open\",\"ar\":\"إجراءات البرنامج التي لا تزال مفتوحة\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"programme.open\",\"readonly\":true},{\"id\":\"open_disclosures\",\"label\":{\"en\":\"Disclosure checklist items still open\",\"ar\":\"بنود قائمة الإفصاحات التي لا تزال مفتوحة\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"disclosures.open\",\"readonly\":true}],\"note\":{\"en\":\"These figures are read from the forms and papers they come from and frozen when this form is prepared; a change upstream marks them as drifted.\",\"ar\":\"تُقرأ هذه الأرقام من النماذج والأوراق التي تأتي منها وتُثبت عند إعداد هذا النموذج؛ وأي تغيير في المصدر يسمها بأنها تغيرت.\"}},{\"id\":\"kam\",\"title\":{\"en\":\"Key audit matters\",\"ar\":\"الأمور الرئيسة للمراجعة\"},\"fields\":[{\"id\":\"listed\",\"label\":{\"en\":\"Key audit matters are communicated (listed entity or required by law or engagement terms)\",\"ar\":\"يتم الإبلاغ عن الأمور الرئيسة للمراجعة (منشأة مدرجة أو مطلوب بموجب القانون أو شروط الارتباط)\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"yes\",\"label\":{\"en\":\"Yes\",\"ar\":\"نعم\"}},{\"value\":\"no\",\"label\":{\"en\":\"No\",\"ar\":\"لا\"}},{\"value\":\"na\",\"label\":{\"en\":\"Not applicable\",\"ar\":\"لا ينطبق\"}}]},{\"id\":\"candidates\",\"label\":{\"en\":\"Matters communicated to those charged with governance that required significant attention\",\"ar\":\"الأمور المبلغة للمكلفين بالحوكمة والتي تطلبت اهتمامًا كبيرًا\"},\"type\":\"table\",\"required\":false,\"columns\":[{\"id\":\"matter\",\"label\":{\"en\":\"Matter\",\"ar\":\"الأمر\"},\"type\":\"text\",\"required\":true},{\"id\":\"why\",\"label\":{\"en\":\"Why it was of most significance\",\"ar\":\"لماذا كان من أكثر الأمور أهمية\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"how\",\"label\":{\"en\":\"How it was addressed in the audit\",\"ar\":\"كيف تمت معالجته في المراجعة\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"kam\",\"label\":{\"en\":\"Key audit matter\",\"ar\":\"أمر رئيس للمراجعة\"},\"type\":\"yesno\",\"required\":true}]}]},{\"id\":\"report\",\"title\":{\"en\":\"The report\",\"ar\":\"التقرير\"},\"fields\":[{\"id\":\"opinion\",\"label\":{\"en\":\"Opinion\",\"ar\":\"الرأي\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"unmodified\",\"label\":{\"en\":\"Unmodified\",\"ar\":\"غير معدل\"}},{\"value\":\"qualified\",\"label\":{\"en\":\"Qualified\",\"ar\":\"متحفظ\"}},{\"value\":\"adverse\",\"label\":{\"en\":\"Adverse\",\"ar\":\"معارض\"}},{\"value\":\"disclaimer\",\"label\":{\"en\":\"Disclaimer of opinion\",\"ar\":\"امتناع عن إبداء الرأي\"}}]},{\"id\":\"basis_for_modification\",\"label\":{\"en\":\"Basis for any modification\",\"ar\":\"أساس أي تعديل\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"material_uncertainty\",\"label\":{\"en\":\"Material uncertainty related to going concern paragraph\",\"ar\":\"فقرة عدم التأكد الجوهري المتعلق بالاستمرارية\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"yes\",\"label\":{\"en\":\"Yes\",\"ar\":\"نعم\"}},{\"value\":\"no\",\"label\":{\"en\":\"No\",\"ar\":\"لا\"}},{\"value\":\"na\",\"label\":{\"en\":\"Not applicable\",\"ar\":\"لا ينطبق\"}}]},{\"id\":\"emphasis\",\"label\":{\"en\":\"Emphasis of matter and other matter paragraphs\",\"ar\":\"فقرات لفت الانتباه وفقرات أمور أخرى\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"framework_kind\",\"label\":{\"en\":\"Kind of engagement\",\"ar\":\"نوع الارتباط\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"general\",\"label\":{\"en\":\"General purpose financial statements\",\"ar\":\"قوائم مالية ذات غرض عام\"}},{\"value\":\"special\",\"label\":{\"en\":\"Special purpose framework\",\"ar\":\"إطار ذو غرض خاص\"}},{\"value\":\"single\",\"label\":{\"en\":\"Single financial statement or element\",\"ar\":\"قائمة مالية واحدة أو عنصر\"}},{\"value\":\"summary\",\"label\":{\"en\":\"Summary financial statements\",\"ar\":\"قوائم مالية ملخصة\"}}]},{\"id\":\"draft\",\"label\":{\"en\":\"Report drafted and reviewed against the file\",\"ar\":\"تمت صياغة التقرير وفحصه مقابل الملف\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"yes\",\"label\":{\"en\":\"Yes\",\"ar\":\"نعم\"}},{\"value\":\"no\",\"label\":{\"en\":\"No\",\"ar\":\"لا\"}},{\"value\":\"na\",\"label\":{\"en\":\"Not applicable\",\"ar\":\"لا ينطبق\"}}]},{\"id\":\"report_date\",\"label\":{\"en\":\"Date of the auditor's report\",\"ar\":\"تاريخ تقرير المراجع\"},\"type\":\"date\",\"required\":true}]},{\"id\":\"after\",\"title\":{\"en\":\"Facts that become known after the report date\",\"ar\":\"الحقائق التي تُعرف بعد تاريخ التقرير\"},\"fields\":[{\"id\":\"facts\",\"label\":{\"en\":\"Facts known after the report date\",\"ar\":\"حقائق عُرفت بعد تاريخ التقرير\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"none\",\"label\":{\"en\":\"None\",\"ar\":\"لا يوجد\"}},{\"value\":\"yes\",\"label\":{\"en\":\"Yes, recorded below\",\"ar\":\"نعم، مسجلة أدناه\"}}]},{\"id\":\"facts_response\",\"label\":{\"en\":\"Nature, discussion with management, effect on the statements and on the report, and action taken\",\"ar\":\"الطبيعة والمناقشة مع الإدارة والأثر على القوائم وعلى التقرير والإجراء المتخذ\"},\"type\":\"textarea\",\"required\":false}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"],\"eqr\":true},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F27-QUALITY-REVIEW", "{\"id\":\"F27-QUALITY-REVIEW\",\"number\":27,\"kind\":\"checklist\",\"phase\":\"completion\",\"title\":{\"en\":\"Engagement quality review\",\"ar\":\"فحص جودة الارتباط\"},\"purpose\":{\"en\":\"Document the engagement quality review: the reviewer's eligibility, the significant judgements and conclusions evaluated, the discussions held, and the reviewer's conclusion before the report is dated.\",\"ar\":\"توثيق فحص جودة الارتباط: أهلية الفاحص، والأحكام والاستنتاجات المهمة التي تم تقييمها، والمناقشات التي جرت، واستنتاج الفاحص قبل تأريخ التقرير.\"},\"procedures\":[\"P-FSL-049\"],\"standards\":[\"ISQM-2\",\"ISA-220\",\"ISQM-1\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"reviewer\",\"title\":{\"en\":\"The reviewer\",\"ar\":\"الفاحص\"},\"fields\":[{\"id\":\"reviewer\",\"label\":{\"en\":\"Engagement quality reviewer\",\"ar\":\"فاحص جودة الارتباط\"},\"type\":\"text\",\"required\":true},{\"id\":\"appointed_on\",\"label\":{\"en\":\"Appointed on\",\"ar\":\"تاريخ التعيين\"},\"type\":\"date\",\"required\":true},{\"id\":\"eligible\",\"label\":{\"en\":\"Eligible: not a member of the engagement team, cooling-off observed, competent and objective\",\"ar\":\"مؤهل: ليس عضوًا في فريق الارتباط، مع مراعاة فترة الانقطاع، وكفء وموضوعي\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"threats\",\"label\":{\"en\":\"Threats to the reviewer's objectivity and safeguards\",\"ar\":\"التهديدات لموضوعية الفاحص والضمانات\"},\"type\":\"textarea\",\"required\":false}]},{\"id\":\"review\",\"title\":{\"en\":\"The review\",\"ar\":\"الفحص\"},\"fields\":[{\"id\":\"judgements\",\"label\":{\"en\":\"Significant judgements and conclusions evaluated\",\"ar\":\"الأحكام والاستنتاجات المهمة التي تم تقييمها\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"area\",\"label\":{\"en\":\"Area\",\"ar\":\"المجال\"},\"type\":\"text\",\"required\":true},{\"id\":\"judgement\",\"label\":{\"en\":\"Judgement made by the team\",\"ar\":\"الحكم الذي اتخذه الفريق\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"evaluation\",\"label\":{\"en\":\"Reviewer's evaluation\",\"ar\":\"تقييم الفاحص\"},\"type\":\"textarea\",\"required\":true}]},{\"id\":\"independence\",\"label\":{\"en\":\"The team's independence conclusions reviewed\",\"ar\":\"تم فحص استنتاجات الفريق بشأن الاستقلال\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"materiality\",\"label\":{\"en\":\"Materiality, significant risks and the responses reviewed\",\"ar\":\"تم فحص الأهمية النسبية والمخاطر المهمة والاستجابات\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"misstatements\",\"label\":{\"en\":\"Misstatements, going concern and the report reviewed\",\"ar\":\"تم فحص التحريفات والاستمرارية والتقرير\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"consultations\",\"label\":{\"en\":\"Consultations and differences of opinion reviewed\",\"ar\":\"تم فحص المشاورات وخلافات الرأي\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"statements\",\"label\":{\"en\":\"The financial statements and the proposed report read\",\"ar\":\"تمت قراءة القوائم المالية والتقرير المقترح\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"discussion_date\",\"label\":{\"en\":\"Discussion with the engagement partner\",\"ar\":\"المناقشة مع شريك الارتباط\"},\"type\":\"date\",\"required\":true},{\"id\":\"matters\",\"label\":{\"en\":\"Matters raised and how they were resolved\",\"ar\":\"الأمور المثارة وكيفية حلها\"},\"type\":\"textarea\",\"required\":true}]},{\"id\":\"conclusion\",\"title\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"fields\":[{\"id\":\"conclusion\",\"label\":{\"en\":\"The reviewer is not aware of any matter that would cause the reviewer to believe the significant judgements or conclusions were not appropriate\",\"ar\":\"الفاحص ليس على علم بأي أمر يجعله يعتقد أن الأحكام أو الاستنتاجات المهمة لم تكن مناسبة\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"complete\",\"label\":{\"en\":\"Yes, review complete\",\"ar\":\"نعم، الفحص مكتمل\"}},{\"value\":\"pending\",\"label\":{\"en\":\"Not yet, matters outstanding\",\"ar\":\"ليس بعد، أمور معلقة\"}}]},{\"id\":\"completed_on\",\"label\":{\"en\":\"Review completed on\",\"ar\":\"تاريخ اكتمال الفحص\"},\"type\":\"date\",\"required\":true}]}],\"signoff\":{\"prepare\":[\"eqr\",\"partner\",\"manager\"],\"review\":[\"partner\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F28-TIME-BUDGET", "{\"id\":\"F28-TIME-BUDGET\",\"number\":28,\"kind\":\"worksheet\",\"phase\":\"planning\",\"title\":{\"en\":\"Time budget and resources\",\"ar\":\"موازنة الوقت والموارد\"},\"purpose\":{\"en\":\"Plan the hours by phase and role, the fee and its basis, and compare with the hours recorded, so the resources the engagement needs are assigned and their use explained.\",\"ar\":\"تخطيط الساعات حسب المرحلة والدور، والأتعاب وأساسها، ومقارنتها بالساعات المسجلة، بحيث تُخصص الموارد التي يحتاجها الارتباط ويُفسر استخدامها.\"},\"procedures\":[\"P-FSL-005\"],\"standards\":[\"ISA-300\",\"ISQM-1\",\"ISA-220\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"budget\",\"title\":{\"en\":\"Budget\",\"ar\":\"الموازنة\"},\"fields\":[{\"id\":\"budget\",\"label\":{\"en\":\"Hours planned\",\"ar\":\"الساعات المخططة\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"phase\",\"label\":{\"en\":\"Phase\",\"ar\":\"المرحلة\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"planning\",\"label\":{\"en\":\"Planning\",\"ar\":\"التخطيط\"}},{\"value\":\"fieldwork\",\"label\":{\"en\":\"Fieldwork\",\"ar\":\"العمل الميداني\"}},{\"value\":\"completion\",\"label\":{\"en\":\"Completion\",\"ar\":\"الإنجاز\"}}]},{\"id\":\"role\",\"label\":{\"en\":\"Role\",\"ar\":\"الدور\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"partner\",\"label\":{\"en\":\"Partner\",\"ar\":\"شريك\"}},{\"value\":\"manager\",\"label\":{\"en\":\"Manager\",\"ar\":\"مدير\"}},{\"value\":\"senior\",\"label\":{\"en\":\"Senior\",\"ar\":\"مراجع أول\"}},{\"value\":\"staff\",\"label\":{\"en\":\"Staff\",\"ar\":\"مراجع\"}},{\"value\":\"eqr\",\"label\":{\"en\":\"Quality reviewer\",\"ar\":\"فاحص الجودة\"}},{\"value\":\"expert\",\"label\":{\"en\":\"Expert\",\"ar\":\"خبير\"}}]},{\"id\":\"hours\",\"label\":{\"en\":\"Hours\",\"ar\":\"الساعات\"},\"type\":\"integer\",\"required\":true},{\"id\":\"rate\",\"label\":{\"en\":\"Rate\",\"ar\":\"المعدل\"},\"type\":\"money\",\"required\":false}]},{\"id\":\"fee\",\"label\":{\"en\":\"Agreed fee\",\"ar\":\"الأتعاب المتفق عليها\"},\"type\":\"money\",\"required\":true},{\"id\":\"fee_basis\",\"label\":{\"en\":\"Basis of the fee and billing milestones\",\"ar\":\"أساس الأتعاب ومراحل الفوترة\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"specialists\",\"label\":{\"en\":\"Specialists and experts budgeted\",\"ar\":\"المتخصصون والخبراء المدرجون في الموازنة\"},\"type\":\"textarea\",\"required\":false}]},{\"id\":\"actual\",\"title\":{\"en\":\"Hours recorded\",\"ar\":\"الساعات المسجلة\"},\"fields\":[{\"id\":\"actual\",\"label\":{\"en\":\"Hours recorded to date\",\"ar\":\"الساعات المسجلة حتى تاريخه\"},\"type\":\"table\",\"required\":false,\"columns\":[{\"id\":\"phase\",\"label\":{\"en\":\"Phase\",\"ar\":\"المرحلة\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"planning\",\"label\":{\"en\":\"Planning\",\"ar\":\"التخطيط\"}},{\"value\":\"fieldwork\",\"label\":{\"en\":\"Fieldwork\",\"ar\":\"العمل الميداني\"}},{\"value\":\"completion\",\"label\":{\"en\":\"Completion\",\"ar\":\"الإنجاز\"}}]},{\"id\":\"role\",\"label\":{\"en\":\"Role\",\"ar\":\"الدور\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"partner\",\"label\":{\"en\":\"Partner\",\"ar\":\"شريك\"}},{\"value\":\"manager\",\"label\":{\"en\":\"Manager\",\"ar\":\"مدير\"}},{\"value\":\"senior\",\"label\":{\"en\":\"Senior\",\"ar\":\"مراجع أول\"}},{\"value\":\"staff\",\"label\":{\"en\":\"Staff\",\"ar\":\"مراجع\"}},{\"value\":\"eqr\",\"label\":{\"en\":\"Quality reviewer\",\"ar\":\"فاحص الجودة\"}},{\"value\":\"expert\",\"label\":{\"en\":\"Expert\",\"ar\":\"خبير\"}}]},{\"id\":\"hours\",\"label\":{\"en\":\"Hours\",\"ar\":\"الساعات\"},\"type\":\"integer\",\"required\":true}]},{\"id\":\"variance\",\"label\":{\"en\":\"Variances against the budget and their explanation\",\"ar\":\"الانحرافات عن الموازنة وتفسيرها\"},\"type\":\"textarea\",\"required\":false}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F29-ACCOUNTING-ESTIMATES", "{\"id\":\"F29-ACCOUNTING-ESTIMATES\",\"number\":29,\"kind\":\"worksheet\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Accounting estimates\",\"ar\":\"التقديرات المحاسبية\"},\"purpose\":{\"en\":\"Record the understanding of each significant accounting estimate, the retrospective review of the prior period's estimates, the testing approach and results, and the evaluation of management bias and disclosure.\",\"ar\":\"توثيق فهم كل تقدير محاسبي مهم، والفحص بأثر رجعي لتقديرات الفترة السابقة، ومنهج الاختبار ونتائجه، وتقييم تحيز الإدارة والإفصاح.\"},\"procedures\":[\"P-FSL-030\",\"P-FSL-031\"],\"standards\":[\"ISA-540\",\"ISA-240\",\"ISA-620\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"understanding\",\"title\":{\"en\":\"Understanding\",\"ar\":\"الفهم\"},\"fields\":[{\"id\":\"estimates\",\"label\":{\"en\":\"Significant accounting estimates\",\"ar\":\"التقديرات المحاسبية المهمة\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"estimate\",\"label\":{\"en\":\"Estimate\",\"ar\":\"التقدير\"},\"type\":\"text\",\"required\":true},{\"id\":\"leadsheet\",\"label\":{\"en\":\"Leadsheet\",\"ar\":\"كشف الحساب\"},\"type\":\"text\",\"required\":false},{\"id\":\"method\",\"label\":{\"en\":\"Method, assumptions and data\",\"ar\":\"الطريقة والافتراضات والبيانات\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"uncertainty\",\"label\":{\"en\":\"Estimation uncertainty\",\"ar\":\"عدم التأكد في التقدير\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"low\",\"label\":{\"en\":\"Low\",\"ar\":\"منخفض\"}},{\"value\":\"high\",\"label\":{\"en\":\"High\",\"ar\":\"مرتفع\"}}]},{\"id\":\"inherent_risk\",\"label\":{\"en\":\"Inherent risk\",\"ar\":\"الخطر الملازم\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"low\",\"label\":{\"en\":\"Low\",\"ar\":\"منخفض\"}},{\"value\":\"moderate\",\"label\":{\"en\":\"Moderate\",\"ar\":\"متوسط\"}},{\"value\":\"high\",\"label\":{\"en\":\"High\",\"ar\":\"مرتفع\"}}]}]},{\"id\":\"retrospective\",\"label\":{\"en\":\"Retrospective review of the prior period's estimates\",\"ar\":\"الفحص بأثر رجعي لتقديرات الفترة السابقة\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"estimate\",\"label\":{\"en\":\"Estimate\",\"ar\":\"التقدير\"},\"type\":\"text\",\"required\":true},{\"id\":\"prior\",\"label\":{\"en\":\"Prior estimate\",\"ar\":\"التقدير السابق\"},\"type\":\"money\",\"required\":true},{\"id\":\"outcome\",\"label\":{\"en\":\"Outcome\",\"ar\":\"النتيجة الفعلية\"},\"type\":\"money\",\"required\":true},{\"id\":\"bias\",\"label\":{\"en\":\"Indication of bias\",\"ar\":\"مؤشر على التحيز\"},\"type\":\"yesno\",\"required\":true}]}]},{\"id\":\"testing\",\"title\":{\"en\":\"Testing\",\"ar\":\"الاختبار\"},\"fields\":[{\"id\":\"testing\",\"label\":{\"en\":\"Approach and results per estimate\",\"ar\":\"المنهج والنتائج لكل تقدير\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"estimate\",\"label\":{\"en\":\"Estimate\",\"ar\":\"التقدير\"},\"type\":\"text\",\"required\":true},{\"id\":\"approach\",\"label\":{\"en\":\"Approach\",\"ar\":\"المنهج\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"process\",\"label\":{\"en\":\"Test how management made the estimate\",\"ar\":\"اختبار كيفية إعداد الإدارة للتقدير\"}},{\"value\":\"own\",\"label\":{\"en\":\"Develop a point estimate or range\",\"ar\":\"وضع تقدير نقطي أو نطاق\"}},{\"value\":\"events\",\"label\":{\"en\":\"Events up to the report date\",\"ar\":\"الأحداث حتى تاريخ التقرير\"}}]},{\"id\":\"work\",\"label\":{\"en\":\"Work performed\",\"ar\":\"العمل المنفذ\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"result\",\"label\":{\"en\":\"Result: point estimate or range, and management's amount\",\"ar\":\"النتيجة: التقدير النقطي أو النطاق ومبلغ الإدارة\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"misstatement\",\"label\":{\"en\":\"Misstatement, if any\",\"ar\":\"التحريف، إن وجد\"},\"type\":\"money\",\"required\":false}]},{\"id\":\"experts\",\"label\":{\"en\":\"Use of experts and specialised skills\",\"ar\":\"الاستعانة بالخبراء والمهارات المتخصصة\"},\"type\":\"textarea\",\"required\":false}]},{\"id\":\"conclusion\",\"title\":{\"en\":\"Bias, disclosure and conclusion\",\"ar\":\"التحيز والإفصاح والاستنتاج\"},\"fields\":[{\"id\":\"bias\",\"label\":{\"en\":\"Indicators of possible management bias across the estimates\",\"ar\":\"مؤشرات التحيز المحتمل للإدارة عبر التقديرات\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"disclosure\",\"label\":{\"en\":\"Disclosures of estimation uncertainty adequate\",\"ar\":\"إفصاحات عدم التأكد في التقدير كافية\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"textarea\",\"required\":true}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F30-STATEMENTS-REVIEW", "{\"id\":\"F30-STATEMENTS-REVIEW\",\"number\":30,\"kind\":\"worksheet\",\"phase\":\"completion\",\"title\":{\"en\":\"Financial statements review\",\"ar\":\"فحص القوائم المالية\"},\"purpose\":{\"en\":\"Review the financial statements as a whole: the final analytical review, the tie-out of the statements to the leadsheets, the comparatives, the other information, the closing process and presentation, and the disclosure checklist.\",\"ar\":\"فحص القوائم المالية ككل: الفحص التحليلي النهائي، ومطابقة القوائم مع كشوف الحسابات، والمعلومات المقارنة، والمعلومات الأخرى، وعملية الإقفال والعرض، وقائمة الإفصاحات.\"},\"procedures\":[\"P-FSL-040\",\"P-FSL-041\",\"P-FSL-042\",\"P-FSL-043\",\"P-FSL-057\"],\"standards\":[\"ISA-520\",\"ISA-700\",\"ISA-710\",\"ISA-720\",\"ISA-330\",\"ISA-450\"],\"computation\":\"analytical_review\",\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"analytics\",\"title\":{\"en\":\"Final analytical review\",\"ar\":\"الفحص التحليلي النهائي\"},\"fields\":[{\"id\":\"lines\",\"label\":{\"en\":\"Lines reviewed against an expectation from the prior period and its growth\",\"ar\":\"البنود المفحوصة مقابل توقع من الفترة السابقة ونموها\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"name\",\"label\":{\"en\":\"Line\",\"ar\":\"البند\"},\"type\":\"text\",\"required\":true},{\"id\":\"recorded\",\"label\":{\"en\":\"Recorded\",\"ar\":\"المسجل\"},\"type\":\"money\",\"required\":true},{\"id\":\"prior\",\"label\":{\"en\":\"Prior period\",\"ar\":\"الفترة السابقة\"},\"type\":\"money\",\"required\":true},{\"id\":\"growth_pct\",\"label\":{\"en\":\"Expected growth (percent)\",\"ar\":\"النمو المتوقع (نسبة)\"},\"type\":\"percent\",\"required\":true}]},{\"id\":\"performance_materiality\",\"label\":{\"en\":\"Performance materiality\",\"ar\":\"مادية الأداء\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.performance\",\"readonly\":true},{\"id\":\"lines_examined\",\"label\":{\"en\":\"Lines examined\",\"ar\":\"البنود المفحوصة\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"paper.analytical_review.lines_examined\",\"readonly\":true},{\"id\":\"lines_flagged\",\"label\":{\"en\":\"Lines to investigate\",\"ar\":\"البنود الواجب استقصاؤها\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"paper.analytical_review.lines_flagged\",\"readonly\":true},{\"id\":\"explanations\",\"label\":{\"en\":\"Explanations obtained and corroborated for the lines flagged\",\"ar\":\"التفسيرات التي تم الحصول عليها وتأييدها للبنود المعلَّمة\"},\"type\":\"textarea\",\"required\":true}],\"note\":{\"en\":\"Compute the paper from the lines before signing; the analytical review and, when statement lines are entered, the tie-out are computed together.\",\"ar\":\"تُحتسب الورقة من البنود قبل التوقيع؛ ويُحتسب الفحص التحليلي، وعند إدخال بنود القوائم، المطابقة معًا.\"}},{\"id\":\"tieout\",\"title\":{\"en\":\"Tie-out of the statements\",\"ar\":\"مطابقة القوائم\"},\"fields\":[{\"id\":\"statement_lines\",\"label\":{\"en\":\"Statement lines and the leadsheets they present\",\"ar\":\"بنود القوائم وكشوف الحسابات التي تعرضها\"},\"type\":\"table\",\"required\":false,\"columns\":[{\"id\":\"line_id\",\"label\":{\"en\":\"Line\",\"ar\":\"البند\"},\"type\":\"text\",\"required\":true},{\"id\":\"caption\",\"label\":{\"en\":\"Caption\",\"ar\":\"العنوان\"},\"type\":\"text\",\"required\":true},{\"id\":\"presented\",\"label\":{\"en\":\"Amount presented\",\"ar\":\"المبلغ المعروض\"},\"type\":\"money\",\"required\":true},{\"id\":\"leadsheets\",\"label\":{\"en\":\"Leadsheets (comma separated)\",\"ar\":\"كشوف الحسابات (مفصولة بفواصل)\"},\"type\":\"text\",\"required\":true},{\"id\":\"sign\",\"label\":{\"en\":\"Sign\",\"ar\":\"الإشارة\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"1\",\"label\":{\"en\":\"Debit positive\",\"ar\":\"المدين موجب\"}},{\"value\":\"-1\",\"label\":{\"en\":\"Credit positive\",\"ar\":\"الدائن موجب\"}}]}]},{\"id\":\"agrees\",\"label\":{\"en\":\"Every line agrees to its leadsheets\",\"ar\":\"كل بند يتطابق مع كشوف حساباته\"},\"type\":\"text\",\"required\":false,\"autofill\":\"paper.tieout.agrees\",\"readonly\":true},{\"id\":\"lines_differing\",\"label\":{\"en\":\"Lines that differ\",\"ar\":\"البنود المختلفة\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"paper.tieout.lines_differing\",\"readonly\":true},{\"id\":\"closing_process\",\"label\":{\"en\":\"Evaluation of the closing process, the consolidation and the presentation\",\"ar\":\"تقييم عملية الإقفال والتوحيد والعرض\"},\"type\":\"textarea\",\"required\":true}]},{\"id\":\"comparatives\",\"title\":{\"en\":\"Comparatives and other information\",\"ar\":\"المعلومات المقارنة والمعلومات الأخرى\"},\"fields\":[{\"id\":\"prior_auditor\",\"label\":{\"en\":\"Prior period audited by\",\"ar\":\"الفترة السابقة راجعها\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"us\",\"label\":{\"en\":\"This firm\",\"ar\":\"هذا المكتب\"}},{\"value\":\"predecessor\",\"label\":{\"en\":\"A predecessor auditor\",\"ar\":\"مراجع سابق\"}},{\"value\":\"unaudited\",\"label\":{\"en\":\"Not audited\",\"ar\":\"لم تُراجع\"}}]},{\"id\":\"comparatives_agree\",\"label\":{\"en\":\"Comparatives agree to the prior period's statements and policies are consistent\",\"ar\":\"المعلومات المقارنة تتطابق مع قوائم الفترة السابقة والسياسات متسقة\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"prior_modified\",\"label\":{\"en\":\"Prior period report modified\",\"ar\":\"تقرير الفترة السابقة معدل\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"yes\",\"label\":{\"en\":\"Yes\",\"ar\":\"نعم\"}},{\"value\":\"no\",\"label\":{\"en\":\"No\",\"ar\":\"لا\"}},{\"value\":\"na\",\"label\":{\"en\":\"Not applicable\",\"ar\":\"لا ينطبق\"}}]},{\"id\":\"other_information\",\"label\":{\"en\":\"Other information read and considered\",\"ar\":\"المعلومات الأخرى التي تمت قراءتها والنظر فيها\"},\"type\":\"table\",\"required\":false,\"columns\":[{\"id\":\"document\",\"label\":{\"en\":\"Document\",\"ar\":\"المستند\"},\"type\":\"text\",\"required\":true},{\"id\":\"read\",\"label\":{\"en\":\"Read\",\"ar\":\"تمت قراءته\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"inconsistencies\",\"label\":{\"en\":\"Material inconsistencies and their resolution\",\"ar\":\"التناقضات الجوهرية وكيفية حلها\"},\"type\":\"textarea\",\"required\":false}]}]},{\"id\":\"checklist\",\"title\":{\"en\":\"Disclosure checklist and open items\",\"ar\":\"قائمة الإفصاحات والبنود المفتوحة\"},\"fields\":[{\"id\":\"open_disclosures\",\"label\":{\"en\":\"Disclosure checklist items open\",\"ar\":\"بنود قائمة الإفصاحات المفتوحة\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"disclosures.open\",\"readonly\":true},{\"id\":\"open_review_notes\",\"label\":{\"en\":\"Review notes open\",\"ar\":\"ملاحظات الفحص المفتوحة\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-REVIEW-NOTE.open\",\"readonly\":true},{\"id\":\"open_procedures\",\"label\":{\"en\":\"Procedures of the programme open\",\"ar\":\"إجراءات البرنامج المفتوحة\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"programme.open\",\"readonly\":true},{\"id\":\"conclusion\",\"label\":{\"en\":\"Conclusion on the financial statements as a whole\",\"ar\":\"الاستنتاج بشأن القوائم المالية ككل\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"appropriate\",\"label\":{\"en\":\"Prepared, in all material respects, in accordance with the framework\",\"ar\":\"معدة، من جميع الجوانب الجوهرية، وفقًا للإطار\"}},{\"value\":\"exceptions\",\"label\":{\"en\":\"Exceptions carried to the misstatement evaluation and the report\",\"ar\":\"استثناءات مرحّلة إلى تقييم التحريفات والتقرير\"}}]}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F31-REVENUE-RECEIVABLES", "{\"id\":\"F31-REVENUE-RECEIVABLES\",\"number\":31,\"kind\":\"worksheet\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Revenue and receivables working paper\",\"ar\":\"ورقة عمل الإيرادات والمدينين\"},\"purpose\":{\"en\":\"Document every substantive procedure of the revenue and receivables cycle: the work, the results, the evidence and the conclusion, against the balances the trial balance holds.\",\"ar\":\"توثيق كل إجراء أساسي في دورة الإيرادات والمدينين: العمل والنتائج والأدلة والاستنتاج، مقابل الأرصدة الواردة في ميزان المراجعة.\"},\"procedures\":[\"P-REV-004\",\"P-REV-005\",\"P-REV-006\",\"P-REV-007\",\"P-REV-008\",\"P-REV-009\",\"P-REV-010\",\"P-REV-011\",\"P-REV-012\",\"P-REV-013\"],\"standards\":[\"ISA-330\",\"ISA-505\",\"ISA-520\",\"ISA-530\",\"ISA-540\",\"ISA-240\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"balances\",\"title\":{\"en\":\"Balances, materiality and risks\",\"ar\":\"الأرصدة والأهمية النسبية والمخاطر\"},\"fields\":[{\"id\":\"performance_materiality\",\"label\":{\"en\":\"Performance materiality\",\"ar\":\"مادية الأداء\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.performance\",\"readonly\":true},{\"id