    ("F32-PURCHASES-PAYABLES", "{\"id\":\"F32-PURCHASES-PAYABLES\",\"number\":32,\"kind\":\"worksheet\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Purchases, payables and expenditure working paper\",\"ar\":\"ورقة عمل المشتريات والدائنين والمصروفات\"},\"purpose\":{\"en\":\"Document every substantive procedure of the purchases, payables and expenditure cycle: the work, the results, the evidence and the conclusion, against the balances the trial balance holds.\",\"ar\":\"توثيق كل إجراء أساسي في دورة المشتريات والدائنين والمصروفات: العمل والنتائج والأدلة والاستنتاج، مقابل الأرصدة الواردة في ميزان المراجعة.\"},\"procedures\":[\"P-PUR-003\",\"P-PUR-004\",\"P-PUR-005\",\"P-PUR-006\",\"P-PUR-007\",\"P-PUR-008\",\"P-PUR-010\",\"P-PUR-011\",\"P-PUR-012\"],\"standards\":[\"ISA-330\",\"ISA-500\",\"ISA-505\",\"ISA-520\",\"ISA-530\",\"ISA-540\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"balances\",\"title\":{\"en\":\"Balances, materiality and risks\",\"ar\":\"الأرصدة والأهمية النسبية والمخاطر\"},\"fields\":[{\"id\":\"performance_materiality\",\"label\":{\"en\":\"Performance materiality\",\"ar\":\"مادية الأداء\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.performa