    ("F37-EQUITY", "{\"id\":\"F37-EQUITY\",\"number\":37,\"kind\":\"worksheet\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Equity working paper\",\"ar\":\"ورقة عمل حقوق الملكية\"},\"purpose\":{\"en\":\"Document every substantive procedure of the equity cycle: the work, the results, the evidence and the conclusion, against the balances the trial balance holds.\",\"ar\":\"توثيق كل إجراء أساسي في دورة حقوق الملكية: العمل والنتائج والأدلة والاستنتاج، مقابل الأرصدة الواردة في ميزان المراجعة.\"},\"procedures\":[\"P-EQY-001\",\"P-EQY-002\",\"P-EQY-003\",\"P-EQY-004\",\"P-EQY-005\"],\"standards\":[\"ISA-330\",\"ISA-500\",\"ISA-560\",\"ISA-600\",\"ISA-700\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"balances\",\"title\":{\"en\":\"Balances, materiality and risks\",\"ar\":\"الأرصدة والأهمية النسبية والمخاطر\"},\"fields\":[{\"id\":\"performance_materiality\",\"label\":{\"en\":\"Performance materiality\",\"ar\":\"مادية الأداء\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.performance\",\"readonly\":true},{\"id\":\"clearly_trivial\",\"label\":{\"en\":\"Clearly trivial threshold\",\"ar\":\"حد المبالغ التافهة بشكل واضح\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.clearly_trivial\",\"readonly\":true},{\"id\":\"ls_scap\",\"label\":{\"en\":\"Share capital and premium (LS-SCAP)\",\"ar\":\"Share capital and premium (LS-SCAP)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-SCAP\",\"readonly\":true},{\"id\":\"ls_scap_prior\",\"label\":{\"en\":\"Share capital and premium, prior period\",\"ar\":\"Share capital and premium، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-SCAP.prior\",\"readonly\":true},{\"id\":\"ls_res\",\"label\":{\"en\":\"Reserves (LS-RES)\",\"ar\":\"Reserves (LS-RES)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-RES\",\"readonly\":true},{\"id\":\"ls_res_prior\",\"label\":{\"en\":\"Reserves, prior period\",\"ar\":\"Reserves، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-RES.prior\",\"readonly\":true},{\"id\":\"ls_re\",\"label\":{\"en\":\"Retained earnings (LS-RE)\",\"ar\":\"Retained earnings (LS-RE)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-RE\",\"readonly\":true},{\"id\":\"ls_re_prior\",\"label\":{\"en\":\"Retained earnings, prior period\",\"ar\":\"Retained earnings، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-RE.prior\",\"readonly\":true},{\"id\":\"ls_nci\",\"label\":{\"en\":\"Non-controlling interests (LS-NCI)\",\"ar\":\"Non-controlling interests (LS-NCI)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-NCI\",\"readonly\":true},{\"id\":\"ls_nci_prior\",\"label\":{\"en\":\"Non-controlling interests, prior period\",\"ar\":\"Non-controlling interests، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-NCI.prior\",\"readonly\":true},{\"id\":\"ls_oeq\",\"label\":{\"en\":\"Other equity (LS-OEQ)\",\"ar\":\"Other equity (LS-OEQ)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-OEQ\",\"readonly\":true},{\"id\":\"ls_oeq_prior\",\"label\":{\"en\":\"Other equity, prior period\",\"ar\":\"Other equity، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-OEQ.prior\",\"readonly\":true},{\"id\":\"risks\",\"label\":{\"en\":\"Risks placed on this cycle by the risk register\",\"ar\":\"المخاطر الموضوعة على هذه الدورة في سجل المخاطر\"},\"type\":\"table\",\"required\":false,\"autofill\":\"form.F04-RISK-REGISTER.risks\",\"readonly\":true,\"columns\":[{\"id\":\"risk\",\"label\":{\"en\":\"Risk\",\"ar\":\"الخطر\"},\"type\":\"text\",\"required\":true},{\"id\":\"level\",\"label\":{\"en\":\"Level\",\"ar\":\"المستوى\"},\"type\":\"text\",\"required\":false},{\"id\":\"assertions\",\"label\":{\"en\":\"Assertions affected\",\"ar\":\"الإقرارات المتأثرة\"},\"type\":\"text\",\"required\":false},{\"id\":\"inherent_risk\",\"label\":{\"en\":\"Inherent risk\",\"ar\":\"الخطر الملازم\"},\"type\":\"text\",\"required\":false},{\"id\":\"significant\",\"label\":{\"en\":\"Significant risk\",\"ar\":\"خطر مهم\"},\"type\":\"text\",\"required\":false},{\"id\":\"control_risk\",\"label\":{\"en\":\"Control risk\",\"ar\":\"خطر الرقابة\"},\"type\":\"text\",\"required\":false},{\"id\":\"response\",\"label\":{\"en\":\"Planned response\",\"ar\":\"الاستجابة المخططة\"},\"type\":\"textarea\",\"required\":false}]}],\"note\":{\"en\":\"Balances are read from the latest accepted trial balance and frozen when the paper is prepared; a later import marks them as drifted.\",\"ar\":\"تُقرأ الأرصدة من أحدث ميزان مراجعة مقبول وتُثبت عند إعداد الورقة؛ ويؤدي استيراد لاحق إلى وسمها بأنها تغيرت.\"}},{\"id\":\"p_eqy_001\",\"title\":{\"en\":\"P-EQY-001 Share capital agreement to statutory records\",\"ar\":\"P-EQY-001 مطابقة رأس المال مع السجلات القانونية\"},\"fields\":[{\"id\":\"p_eqy_001_work\",\"label\":{\"en\":\"Work performed\",\"ar\":\"العمل المنفذ\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_eqy_001_result\",\"label\":{\"en\":\"Results and exceptions\",\"ar\":\"النتائج والاستثناءات\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_eqy_001_samples\",\"label\":{\"en\":\"Samples recorded for this procedure\",\"ar\":\"العينات المسجلة لهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-SAMPLE.for.P-EQY-001\",\"readonly\":true},{\"id\":\"p_eqy_001_evidence\",\"label\":{\"en\":\"Evidence links citing this procedure\",\"ar\":\"روابط الأدلة التي تستشهد بهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-EVIDENCE-LINK.for.P-EQY-001\",\"readonly\":true},{\"id\":\"p_eqy_001_conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"performed_no_exception\",\"label\":{\"en\":\"Performed, no exception\",\"ar\":\"نُفذ دون استثناء\"}},{\"value\":\"performed_exception\",\"label\":{\"en\":\"Performed, exception noted\",\"ar\":\"نُفذ مع ملاحظة استثناء\"}},{\"value\":\"not_applicable\",\"label\":{\"en\":\"Not applicable, reason stated\",\"ar\":\"لا ينطبق، مع بيان السبب\"}}]}],\"note\":{\"en\":\"Obtain evidence over issued capital and its changes.\",\"ar\":\"Obtain evidence over issued capital and its changes.\"}},{\"id\":\"p_eqy_002\",\"title\":{\"en\":\"P-EQY-002 Reserves and legal reserve movements\",\"ar\":\"P-EQY-002 حركة الاحتياطيات والاحتياطي القانوني\"},\"fields\":[{\"id\":\"p_eqy_002_work\",\"label\":{\"en\":\"Work performed\",\"ar\":\"العمل المنفذ\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_eqy_002_result\",\"label\":{\"en\":\"Results and exceptions\",\"ar\":\"النتائج والاستثناءات\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_eqy_002_samples\",\"label\":{\"en\":\"Samples recorded for this procedure\",\"ar\":\"العينات المسجلة لهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-SAMPLE.for.P-EQY-002\",\"readonly\":true},{\"id\":\"p_eqy_002_evidence\",\"label\":{\"en\":\"Evidence links citing this procedure\",\"ar\":\"روابط الأدلة التي تستشهد بهذا الإجراء\"},\"type\":\"integer\",\"req