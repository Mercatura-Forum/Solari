ORNC.prior\",\"readonly\":true},{\"id\":\"ls_leasnc\",\"label\":{\"en\":\"Lease liabilities (non-current) (LS-LEASNC)\",\"ar\":\"Lease liabilities (non-current) (LS-LEASNC)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-LEASNC\",\"readonly\":true},{\"id\":\"ls_leasnc_prior\",\"label\":{\"en\":\"Lease liabilities (non-current), prior period\",\"ar\":\"Lease liabilities (non-current)، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-LEASNC.prior\",\"readonly\":true},{\"id\":\"ls_borc\",\"label\":{\"en\":\"Borrowings (current) (LS-BORC)\",\"ar\":\"Borrowings (current) (LS-BORC)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-BORC\",\"readonly\":true},{\"id\":\"ls_borc_prior\",\"label\":{\"en\":\"Borrowings (current), prior period\",\"ar\":\"Borrowings (current)، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-BORC.prior\",\"readonly\":true},{\"id\":\"ls_leasc\",\"label\":{\"en\":\"Lease liabilities (current) (LS-LEASC)\",\"ar\":\"Lease liabilities (current) (LS-LEASC)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-LEASC\",\"readonly\":true},{\"id\":\"ls_leasc_prior\",\"label\":{\"en\":\"Lease liabilities (current), prior period\",\"ar\":\"Lease liabilities (current)، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-LEASC.prior\",\"readonly\":true},{\"id\":\"ls_fininc\",\"label\":{\"en\":\"Finance income (LS-FININC)\",\"ar\":\"Finance income (LS-FININC)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-FININC\",\"readonly\":true},{\"id\":\"ls_fininc_prior\",\"label\":{\"en\":\"Finance income, prior period\",\"ar\":\"Finance income، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-FININC.prior\",\"readonly\":true},{\"id\":\"ls_finc\",\"label\":{\"en\":\"Finance costs (LS-FINC)\",\"ar\":\"Finance costs (LS-FINC)\"},\"type\":\"m