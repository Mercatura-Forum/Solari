    ("F16-UNDERSTANDING-ENTITY", "{\"id\":\"F16-UNDERSTANDING-ENTITY\",\"number\":16,\"kind\":\"worksheet\",\"phase\":\"planning\",\"title\":{\"en\":\"Understanding the entity and its environment\",\"ar\":\"فهم المنشأة وبيئتها\"},\"purpose\":{\"en\":\"Record the understanding of the entity, its environment and the applicable framework, the preliminary analytical review, service organisations, the internal audit function and, on an initial engagement, the opening balances.\",\"ar\":\"توثيق فهم المنشأة وبيئتها والإطار المطبق، والفحص التحليلي الأولي، ومؤسسات الخدمة، ووظيفة المراجعة الداخلية، والأرصدة الافتتاحية في ارتباط المراجعة الأولي.\"},\"procedures\":[\"P-FSL-008\",\"P-FSL-009\",\"P-FSL-017\",\"P-FSL-018\",\"P-FSL-020\"],\"standards\":[\"ISA-315\",\"ISA-520\",\"ISA-402\",\"ISA-610\",\"ISA-510\"],\"computation\":\"trend\",\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"entity\",\"title\":{\"en\":\"The entity\",\"ar\":\"المنشأة\"},\"fields\":[{\"id\":\"nature\",\"label\":{\"en\":\"Nature of the business: operations, products, markets, customers and suppliers\",\"ar\":\"طبيعة النشاط: العمليات والمنتجات والأسواق والعملاء والموردون\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"o