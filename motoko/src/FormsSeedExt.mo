 الثاني\"}},{\"value\":\"none\",\"label\":{\"en\":\"None\",\"ar\":\"لا يوجد\"}}]},{\"id\":\"reliance\",\"label\":{\"en\":\"Planned reliance and complementary controls\",\"ar\":\"الاعتماد المخطط والضوابط التكميلية\"},\"type\":\"textarea\",\"required\":false}]},{\"id\":\"internal_audit\",\"label\":{\"en\":\"Does the entity have an internal audit function?\",\"ar\":\"هل لدى المنشأة وظيفة مراجعة داخلية؟\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"internal_audit_eval\",\"label\":{\"en\":\"Evaluation of its objectivity, competence and approach, and the planned use of its work\",\"ar\":\"تقييم موضوعيتها وكفاءتها ومنهجها، والاستخدام المخطط لعملها\"},\"type\":\"textarea\",\"required\":false}]},{\"id\":\"opening\",\"title\":{\"en\":\"Opening balances (initial engagement)\",\"ar\":\"الأرصدة الافتتاحية (ارتباط المراجعة الأولي)\"},\"fields\":[{\"id\":\"initial\",\"label\":{\"en\":\"Initial audit engagement\",\"ar\":\"ارتباط مراجعة أولي\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"yes\",\"label\":{\"en\":\"Yes\",\"ar\":\"نعم\"}},{\"value\":\"no\",\"label\":{\"en\":\"No\",\"ar\":\"لا\"}},{\"value\":\"na\",\"label\":{\"en\":\"Not applicable\",\"ar\":\"لا ينطبق\"}}]},{\"id\":\"predecessor_papers\",\"label\":{\"en\":\"Predecessor auditor's working papers reviewed\",\"ar\":\"تم فحص أوراق عمل المراجع السابق\"},\"type\":\"select\",\"required\":false,\"options\":[{\"value\":\"yes\",\"label\":{\"en\":\"Yes\",\"ar\":\"نعم\"}},{\"value\":\"no\",\"label\":{\"en\":\"No\",\"ar\":\"لا\"}},{\"value\":\"na\",\"label\":{\"en\":\"Not applicable\",\"ar\":\"لا ينطبق\"}}]},{\"id\":\"opening_agreed\",\"label\":{\"en\":\"Opening balances agreed to the prior closing balances\",\"ar\":\"تمت مطابقة الأرصدة الافتتاحية مع أرصدة الإقفال السابقة\"},\"type\":\"select\",\"required\":false,\"options\":[{\"value\":\"yes\",\"label\":{\"en\":\"Yes\",\"ar\":\"نعم\"}},{\"value\":\"no\",\"label\":{\"en\":\"No\",\"ar\":\"لا\"}},{\"value\":\"na\",\"label\":{\"en\":\"Not applicable\",\"ar\":\"