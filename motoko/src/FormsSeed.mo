module {
  /// (form id, form definition as JSON), in catalogue order.
  public let FORMS : [(Text, Text)] = [
    ("F01-ACCEPTANCE", "{\"id\":\"F01-ACCEPTANCE\",\"number\":1,\"kind\":\"checklist\",\"phase\":\"planning\",\"title\":{\"en\":\"Client acceptance and continuance\",\"ar\":\"قبول العميل والاستمرار في الارتباط\"},\"purpose\":{\"en\":\"Decide whether the firm may accept or continue the engagement, including the independence of the firm and every team member.\",\"ar\":\"تقرير ما إذا كان يجوز للمكتب قبول الارتباط أو الاستمرار فيه، بما في ذلك استقلال المكتب وكل عضو في فريق الارتباط.\"},\"procedures\":[\"P-FSL-001\",\"P-FSL-002\",\"P-FSL-004\"],\"standards\":[\"ISQM-1\",\"ISA-220\",\"ISA-210\",\"IESBA-CODE\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"basis\",\"title\":{\"en\":\"Nature of the decision\",\"ar\":\"طبيعة القرار\"},\"fields\":[{\"id\":\"decision_type\",\"label\":{\"en\":\"New client or continuance\",\"ar\":\"عميل جديد أم استمرار\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"new\",\"label\":{\"en\":\"New engagement\",\"ar\":\"ارتباط جديد\"}},{\"value\":\"continuing\",\"label\":{\"en\":\"Continuance\",\"ar\":\"استمرار\"}}]},{\"id\":\"predecessor\",\"label\":{\"en\":\"Predecessor auditor communicated with (new engagements)\",\"ar\":\"تم الاتصال بالمراجع السابق (للارتباطات الجديدة)\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"yes\",\"label\":{\"en\":\"Yes\",\"ar\":\"نعم\"}},{\"value\":\"no\",\"label\":{\"en\":\"No\",\"ar\":\"لا\"}},{\"value\":\"na\",\"label\":{\"en\":\"Not applicable\",\"ar\":\"لا ينطبق\"}}]},{\"id\":\"predecessor_notes\",\"label\":{\"en\":\"Matters raised by the predecessor\",\"ar\":\"الأمور التي أثارها المراجع السابق\"},\"type\":\"textarea\",\"required\":false}]},{\"id\":\"integrity\",\"title\":{\"en\":\"Integrity of the client and its management\",\"ar\":\"نزاهة العميل وإدارته\"},\"fields\":[{\"id\":\"integrity_concerns\",\"label\":{\"en\":\"Is there information that casts doubt on the integrity of management or owners?\",\"ar\":\"هل توجد معلومات تثير الشك في نزاهة الإدارة أو الملاك؟\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"litigation\",\"label\":{\"en\":\"Is the entity subject to significant litigation or regulatory action?\",\"ar\":\"هل تخضع المنشأة لدعاوى قضائية أو إجراءات رقابية جوهرية؟\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"integrity_notes\",\"label\":{\"en\":\"Evidence considered and its source\",\"ar\":\"الأدلة التي تم النظر فيها ومصدرها\"},\"type\":\"textarea\",\"required\":true}]},{\"id\":\"capability\",\"title\":{\"en\":\"Competence, capabilities and resources\",\"ar\":\"الكفاءة والقدرات والموارد\"},\"fields\":[{\"id\":\"competence\",\"label\":{\"en\":\"Does the firm have the competence and capabilities the engagement requires?\",\"ar\":\"هل يمتلك المكتب الكفاءة والقدرات التي يتطلبها الارتباط؟\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"resources\",\"label\":{\"en\":\"Are sufficient time and resources available to perform the engagement?\",\"ar\":\"هل يتوفر الوقت والموارد الكافية لتنفيذ الارتباط؟\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"experts\",\"label\":{\"en\":\"Experts or specialists needed\",\"ar\":\"الخبراء أو المتخصصون المطلوبون\"},\"type\":\"textarea\",\"required\":false}]},{\"id\":\"independence\",\"title\":{\"en\":\"Relevant ethical requirements and independence\",\"ar\":\"المتطلبات المسلكية ذات الصلة والاستقلال\"},\"fields\":[{\"id\":\"financial_interests\",\"label\":{\"en\":\"Does the firm or any team member hold a financial interest in, or a close relationship with, the entity?\",\"ar\":\"هل يمتلك المكتب أو أي عضو في الفريق مصلحة مالية في المنشأة أو علاقة وثيقة بها؟\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"fee_dependence\",\"label\":{\"en\":\"Do total fees from the entity create a self-interest or intimidation threat?\",\"ar\":\"هل تُنشئ إجمالي الأتعاب من المنشأة تهديد المصلحة الذاتية أو التخويف؟\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"non_assurance\",\"label\":{\"en\":\"Non-assurance services provided to the entity\",\"ar\":\"الخدمات غير التأكيدية المقدمة للمنشأة\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"threats\",\"label\":{\"en\":\"Threats identified and safeguards applied\",\"ar\":\"التهديدات المحددة والضمانات المطبقة\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"confirmations\",\"label\":{\"en\":\"Independence confirmations obtained\",\"ar\":\"تأكيدات الاستقلال التي تم الحصول عليها\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"member\",\"label\":{\"en\":\"Team member\",\"ar\":\"عضو الفريق\"},\"type\":\"text\",\"required\":true},{\"id\":\"role\",\"label\":{\"en\":\"Role\",\"ar\":\"الدور\"},\"type\":\"text\",\"required\":true},{\"id\":\"confirmed_on\",\"label\":{\"en\":\"Confirmed on\",\"ar\":\"تاريخ التأكيد\"},\"type\":\"date\",\"required\":true},{\"id\":\"matters\",\"label\":{\"en\":\"Matters declared\",\"ar\":\"الأمور المفصح عنها\"},\"type\":\"textarea\",\"required\":false}]}]},{\"id\":\"conclusion\",\"title\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"fields\":[{\"id\":\"decision\",\"label\":{\"en\":\"Decision\",\"ar\":\"القرار\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"accept\",\"label\":{\"en\":\"Accept\",\"ar\":\"قبول\"}},{\"value\":\"continue\",\"label\":{\"en\":\"Continue\",\"ar\":\"استمرار\"}},{\"value\":\"decline\",\"label\":{\"en\":\"Decline\",\"ar\":\"رفض\"}}]},{\"id\":\"rationale\",\"label\":{\"en\":\"Rationale\",\"ar\":\"المبررات\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"declining_information\",\"label\":{\"en\":\"Information that would have led the firm to decline\",\"ar\":\"المعلومات التي كانت ستؤدي إلى رفض المكتب للارتباط\"},\"type\":\"textarea\",\"required\":false}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F02-ENGAGEMENT-LETTER", "{\"id\":\"F02-ENGAGEMENT-LETTER\",\"number\":2,\"kind\":\"letter\",\"phase\":\"planning\",\"title\":{\"en\":\"Engagement letter\",\"ar\":\"خطاب الارتباط\"},\"purpose\":{\"en\":\"Agree the terms of the audit engagement with management and, where appropriate, those charged with governance.\",\"ar\":\"الاتفاق على شروط ارتباط المراجعة مع الإدارة، ومع المكلفين بالحوكمة عند الاقتضاء.\"},\"procedures\":[\"P-FSL-003\"],\"standards\":[\"ISA-210\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"terms\",\"title\":{\"en\":\"Terms\",\"ar\":\"الشروط\"},\"fields\":[{\"id\":\"addressee\",\"label\":{\"en\":\"Addressed to\",\"ar\":\"موجه إلى\"},\"type\":\"text\",\"required\":true,\"help\":{\"en\":\"The board of directors or the body that appoints the auditor.\",\"ar\":\"مجلس الإدارة أو الجهة التي تعين المراجع.\"}},{\"id\":\"letter_date\",\"label\":{\"en\":\"Date of the letter\",\"ar\":\"تاريخ الخطاب\"},\"type\":\"date\",\"required\":true},{\"id\":\"firm_name\",\"label\":{\"en\":\"Audit firm\",\"ar\":\"مكتب المراجعة\"},\"type\":\"text\",\"required\":true},{\"id\":\"reporting_deadline\",\"label\":{\"en\":\"Expected date of the auditor's report\",\"ar\":\"التاريخ المتوقع لتقرير المراجع\"},\"type\":\"date\",\"required\":true},{\"id\":\"fee_basis\",\"label\":{\"en\":\"Fees and billing arrangements\",\"ar\":\"الأتعاب وترتيبات الفوترة\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"other_terms\",\"label\":{\"en\":\"Other terms agreed\",\"ar\":\"شروط أخرى متفق عليها\"},\"type\":\"textarea\",\"required\":false}]}],\"letter\":{\"en\":[\"To {{field:addressee}}\",\"You have requested that we audit the financial statements of {{engagement.client}}, which comprise the statement of financial position as at {{engagement.period_end}}, and the statements of profit or loss, changes in equity and cash flows for the period then ended, and the notes to the financial statements. We are pleased to confirm our acceptance and our understanding of this audit engagement by means of this letter.\",\"The objectives of our audit are to obtain reasonable assurance about whether the financial statements as a whole are free from material misstatement, whether due to fraud or error, and to issue an auditor's report that includes our opinion. Reasonable assurance is a high level of assurance but is not a guarantee that an audit conducted in accordance with {{engagement.audit_standard}} standards will always detect a material misstatement when it exists.\",\"We will conduct our audit in accordance with {{engagement.audit_standard}} standards. Those standards require that we comply with ethical requirements, and plan and perform the audit to obtain sufficient appropriate audit evidence. We will exercise professional judgment and maintain professional scepticism throughout the audit.\",\"Because of the inherent limitations of an audit, together with the inherent limitations of internal control, there is an unavoidable risk that some material misstatements may not be detected, even though the audit is properly planned and performed.\",\"Our audit will be conducted on the basis that management acknowledge and understand that they have responsibility: (a) for the preparation and fair presentation of the financial statements in accordance with {{engagement.framework}}; (b) for such internal control as management determines is necessary to enable the preparation of financial statements that are free from material misstatement, whether due to fraud or error; and (c) to provide us with access to all information relevant to the preparation of the financial statements, additional information that we may request, and unrestricted access to persons within the entity from whom we determine it necessary to obtain audit evidence.\",\"As part of our audit process, we will request from management written confirmation concerning representations made to us in connection with the audit.\",\"We expect to issue our report on or about {{field:reporting_deadline}}. The form and content of our report may need to be amended in the light of our audit findings.\",\"Fees: {{field:fee_basis}}\",\"{{field:other_terms}}\",\"Please sign and return a copy of this letter to indicate your acknowledgement of, and agreement with, the arrangements for our audit, including our respective responsibilities.\",\"Yours faithfully, {{field:firm_name}}\",\"Acknowledged and agreed on behalf of {{engagement.client}}: ______________________  Date: __________\"],\"ar\":[\"إلى {{field:addressee}}\",\"طلبتم منا مراجعة القوائم المالية لـ {{engagement.client}}، والتي تتكون من قائمة المركز المالي في {{engagement.period_end}}، وقوائم الأرباح أو الخسائر والتغير في حقوق الملكية والتدفقات النقدية عن الفترة المنتهية في ذلك التاريخ، والإيضاحات المتممة للقوائم المالية. ويسعدنا أن نؤكد بموجب هذا الخطاب قبولنا لارتباط المراجعة هذا وفهمنا له.\",\"تتمثل أهداف مراجعتنا في الحصول على تأكيد معقول بشأن ما إذا كانت القوائم المالية ككل خالية من التحريف الجوهري، سواء كان ناتجًا عن غش أو خطأ، وإصدار تقرير المراجع الذي يتضمن رأينا. والتأكيد المعقول هو مستوى عالٍ من التأكيد، ولكنه ليس ضمانًا بأن المراجعة التي تتم وفقًا لمعايير {{engagement.audit_standard}} ستكتشف دائمًا أي تحريف جوهري عند وجوده.\",\"سنقوم بمراجعتنا وفقًا لمعايير {{engagement.audit_standard}}. وتتطلب تلك المعايير منا الالتزام بالمتطلبات المسلكية، وتخطيط المراجعة وتنفيذها للحصول على ما يكفي من أدلة المراجعة المناسبة. وسنمارس الحكم المهني ونحافظ على نزعة الشك المهني طوال المراجعة.\",\"بسبب القيود الملازمة للمراجعة، إلى جانب القيود الملازمة للرقابة الداخلية، يوجد خطر لا يمكن تجنبه بأن بعض التحريفات الجوهرية قد لا يتم اكتشافها، حتى وإن تم تخطيط المراجعة وتنفيذها بشكل سليم.\",\"ستُنفَّذ مراجعتنا على أساس أن الإدارة تقر وتفهم أنها مسؤولة عن: (أ) إعداد القوائم المالية وعرضها بشكل عادل وفقًا لـ {{engagement.framework}}؛ (ب) الرقابة الداخلية التي تراها الإدارة ضرورية لتمكينها من إعداد قوائم مالية خالية من التحريف الجوهري، سواء كان ناتجًا عن غش أو خطأ؛ (ج) تزويدنا بإمكانية الوصول إلى جميع المعلومات ذات الصلة بإعداد القوائم المالية، وأي معلومات إضافية قد نطلبها، وإمكانية الوصول غير المقيد إلى الأشخاص داخل المنشأة الذين نرى ضرورة الحصول على أدلة المراجعة منهم.\",\"كجزء من عملية المراجعة، سنطلب من الإدارة تأكيدًا كتابيًا بشأن الإفادات المقدمة إلينا فيما يتعلق بالمراجعة.\",\"نتوقع إصدار تقريرنا في أو حوالي {{field:reporting_deadline}}. وقد يلزم تعديل شكل تقريرنا ومحتواه في ضوء نتائج مراجعتنا.\",\"الأتعاب: {{field:fee_basis}}\",\"{{field:other_terms}}\",\"يرجى توقيع نسخة من هذا الخطاب وإعادتها إلينا للإقرار بترتيبات مراجعتنا والموافقة عليها، بما في ذلك مسؤوليات كل منا.\",\"وتفضلوا بقبول فائق الاحترام، {{field:firm_name}}\",\"تم الإقرار والموافقة نيابةً عن {{engagement.client}}: ______________________  التاريخ: __________\"]},\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F03-PLANNING-MEMO", "{\"id\":\"F03-PLANNING-MEMO\",\"number\":3,\"kind\":\"worksheet\",\"phase\":\"planning\",\"title\":{\"en\":\"Planning memorandum: overall audit strategy and audit plan\",\"ar\":\"مذكرة التخطيط: استراتيجية المراجعة الشاملة وخطة المراجعة\"},\"purpose\":{\"en\":\"Set the scope, timing and direction of the audit and plan its procedures.\",\"ar\":\"تحديد نطاق المراجعة وتوقيتها واتجاهها وتخطيط إجراءاتها.\"},\"procedures\":[\"P-FSL-005\",\"P-FSL-008\"],\"standards\":[\"ISA-300\",\"ISA-315\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"scope\",\"title\":{\"en\":\"Scope of the engagement\",\"ar\":\"نطاق الارتباط\"},\"fields\":[{\"id\":\"components\",\"label\":{\"en\":\"Components, locations and business units in scope\",\"ar\":\"المكونات والمواقع ووحدات الأعمال ضمن النطاق\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"reporting_requirements\",\"label\":{\"en\":\"Statutory and regulatory reporting requirements\",\"ar\":\"متطلبات التقرير القانونية والتنظيمية\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"understanding\",\"label\":{\"en\":\"Understanding of the entity and its environment\",\"ar\":\"فهم المنشأة وبيئتها\"},\"type\":\"textarea\",\"required\":true}]},{\"id\":\"direction\",\"title\":{\"en\":\"Significant factors and direction\",\"ar\":\"العوامل المهمة والاتجاه\"},\"fields\":[{\"id\":\"preliminary_materiality\",\"label\":{\"en\":\"Preliminary overall materiality\",\"ar\":\"الأهمية النسبية الأولية الإجمالية\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.overall\",\"readonly\":true},{\"id\":\"performance_materiality\",\"label\":{\"en\":\"Performance materiality\",\"ar\":\"مادية الأداء\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.performance\",\"readonly\":true},{\"id\":\"significant_factors\",\"label\":{\"en\":\"Significant factors that direct the team's efforts\",\"ar\":\"العوامل المهمة التي توجه جهود الفريق\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"significant_risks_summary\",\"label\":{\"en\":\"Significant risks identified to date\",\"ar\":\"المخاطر المهمة المحددة حتى تاريخه\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"reliance\",\"label\":{\"en\":\"Planned reliance on controls, internal audit or experts\",\"ar\":\"الاعتماد المخطط على الرقابة أو المراجعة الداخلية أو الخبراء\"},\"type\":\"textarea\",\"required\":false}]},{\"id\":\"resources\",\"title\":{\"en\":\"Resources, supervision and timetable\",\"ar\":\"الموارد والإشراف والجدول الزمني\"},\"fields\":[{\"id\":\"team_and_supervision\",\"label\":{\"en\":\"Team, direction, supervision and review\",\"ar\":\"الفريق والتوجيه والإشراف والفحص\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"timetable\",\"label\":{\"en\":\"Timetable\",\"ar\":\"الجدول الزمني\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"milestone\",\"label\":{\"en\":\"Milestone\",\"ar\":\"المرحلة\"},\"type\":\"text\",\"required\":true},{\"id\":\"date\",\"label\":{\"en\":\"Date\",\"ar\":\"التاريخ\"},\"type\":\"date\",\"required\":true},{\"id\":\"owner\",\"label\":{\"en\":\"Responsible\",\"ar\":\"المسؤول\"},\"type\":\"text\",\"required\":false}]}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F04-RISK-REGISTER", "{\"id\":\"F04-RISK-REGISTER\",\"number\":4,\"kind\":\"worksheet\",\"phase\":\"planning\",\"title\":{\"en\":\"Risk assessment register\",\"ar\":\"سجل تقييم مخاطر التحريف الجوهري\"},\"purpose\":{\"en\":\"Record the risks of material misstatement at the financial statement and assertion levels and the planned response to each.\",\"ar\":\"تسجيل مخاطر التحريف الجوهري على مستوى القوائم المالية ومستوى الإقرارات والاستجابة المخططة لكل منها.\"},\"procedures\":[\"P-FSL-015\",\"P-FSL-016\"],\"standards\":[\"ISA-315\",\"ISA-330\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"register\",\"title\":{\"en\":\"Register\",\"ar\":\"السجل\"},\"fields\":[{\"id\":\"risks\",\"label\":{\"en\":\"Risks of material misstatement\",\"ar\":\"مخاطر التحريف الجوهري\"},\"type\":\"table\",\"required\":true,\"autofill\":\"seed.presumed_risks\",\"columns\":[{\"id\":\"risk\",\"label\":{\"en\":\"Risk\",\"ar\":\"الخطر\"},\"type\":\"text\",\"required\":true},{\"id\":\"level\",\"label\":{\"en\":\"Level\",\"ar\":\"المستوى\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"financial_statement\",\"label\":{\"en\":\"Financial statement\",\"ar\":\"القوائم المالية\"}},{\"value\":\"assertion\",\"label\":{\"en\":\"Assertion\",\"ar\":\"الإقرار\"}}]},{\"id\":\"assertions\",\"label\":{\"en\":\"Assertions affected\",\"ar\":\"الإقرارات المتأثرة\"},\"type\":\"text\",\"required\":false},{\"id\":\"inherent_risk\",\"label\":{\"en\":\"Inherent risk\",\"ar\":\"الخطر الملازم\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"low\",\"label\":{\"en\":\"Low\",\"ar\":\"منخفض\"}},{\"value\":\"moderate\",\"label\":{\"en\":\"Moderate\",\"ar\":\"متوسط\"}},{\"value\":\"high\",\"label\":{\"en\":\"High\",\"ar\":\"مرتفع\"}}]},{\"id\":\"significant\",\"label\":{\"en\":\"Significant risk\",\"ar\":\"خطر مهم\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"control_risk\",\"label\":{\"en\":\"Control risk\",\"ar\":\"خطر الرقابة\"},\"type\":\"select\",\"required\":false,\"options\":[{\"value\":\"low\",\"label\":{\"en\":\"Low\",\"ar\":\"منخفض\"}},{\"value\":\"moderate\",\"label\":{\"en\":\"Moderate\",\"ar\":\"متوسط\"}},{\"value\":\"high\",\"label\":{\"en\":\"High\",\"ar\":\"مرتفع\"}}]},{\"id\":\"response\",\"label\":{\"en\":\"Planned response\",\"ar\":\"الاستجابة المخططة\"},\"type\":\"textarea\",\"required\":true}]}],\"note\":{\"en\":\"The presumed risks of fraud in revenue recognition and of management override of controls are loaded from the standards model; the presumption in revenue may be rebutted only with a documented reason.\",\"ar\":\"يتم تحميل الخطرين المفترضين للغش في إثبات الإيرادات ولتجاوز الإدارة لأدوات الرقابة من نموذج المعايير؛ ولا يجوز دحض الافتراض المتعلق بالإيرادات إلا بسبب موثق.\"}}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F05-FRAUD-DISCUSSION", "{\"id\":\"F05-FRAUD-DISCUSSION\",\"number\":5,\"kind\":\"worksheet\",\"phase\":\"planning\",\"title\":{\"en\":\"Engagement team discussion and fraud risk\",\"ar\":\"مناقشة فريق الارتباط ومخاطر الغش\"},\"purpose\":{\"en\":\"Minute the team discussion of susceptibility to material misstatement, including fraud, and the fraud inquiries made.\",\"ar\":\"توثيق مناقشة الفريق حول قابلية القوائم المالية للتحريف الجوهري، بما في ذلك الغش، والاستفسارات المتعلقة بالغش.\"},\"procedures\":[\"P-FSL-007\",\"P-FSL-012\"],\"standards\":[\"ISA-240\",\"ISA-315\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"meeting\",\"title\":{\"en\":\"The discussion\",\"ar\":\"المناقشة\"},\"fields\":[{\"id\":\"meeting_date\",\"label\":{\"en\":\"Date of the discussion\",\"ar\":\"تاريخ المناقشة\"},\"type\":\"date\",\"required\":true},{\"id\":\"attendees\",\"label\":{\"en\":\"Attendees\",\"ar\":\"الحاضرون\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"name\",\"label\":{\"en\":\"Name\",\"ar\":\"الاسم\"},\"type\":\"text\",\"required\":true},{\"id\":\"role\",\"label\":{\"en\":\"Role\",\"ar\":\"الدور\"},\"type\":\"text\",\"required\":true}]},{\"id\":\"susceptibility\",\"label\":{\"en\":\"How and where the financial statements may be susceptible to material misstatement due to fraud\",\"ar\":\"كيف وأين قد تكون القوائم المالية عرضة للتحريف الجوهري الناتج عن الغش\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"revenue_presumption\",\"label\":{\"en\":\"Presumed risk of fraud in revenue recognition\",\"ar\":\"الخطر المفترض للغش في إثبات الإيرادات\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"not_rebutted\",\"label\":{\"en\":\"Not rebutted\",\"ar\":\"لم يُدحض\"}},{\"value\":\"rebutted\",\"label\":{\"en\":\"Rebutted (reason recorded)\",\"ar\":\"دُحض (مع تسجيل السبب)\"}}]},{\"id\":\"revenue_rebuttal_reason\",\"label\":{\"en\":\"Reason, if rebutted\",\"ar\":\"السبب في حالة الدحض\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"management_override\",\"label\":{\"en\":\"Management override of controls is treated as a significant risk\",\"ar\":\"يُعامل تجاوز الإدارة لأدوات الرقابة كخطر مهم\"},\"type\":\"yesno\",\"required\":true,\"readonly\":true,\"default\":\"yes\"},{\"id\":\"absent_members\",\"label\":{\"en\":\"How conclusions were communicated to members not present\",\"ar\":\"كيفية إبلاغ الاستنتاجات للأعضاء غير الحاضرين\"},\"type\":\"textarea\",\"required\":false}]},{\"id\":\"inquiries\",\"title\":{\"en\":\"Fraud inquiries\",\"ar\":\"الاستفسارات المتعلقة بالغش\"},\"fields\":[{\"id\":\"fraud_inquiries\",\"label\":{\"en\":\"Inquiries of management, internal audit and those charged with governance\",\"ar\":\"الاستفسارات من الإدارة والمراجعة الداخلية والمكلفين بالحوكمة\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"who\",\"label\":{\"en\":\"Person inquired of\",\"ar\":\"الشخص المستفسر منه\"},\"type\":\"text\",\"required\":true},{\"id\":\"date\",\"label\":{\"en\":\"Date\",\"ar\":\"التاريخ\"},\"type\":\"date\",\"required\":true},{\"id\":\"response\",\"label\":{\"en\":\"Response, including any known or suspected fraud\",\"ar\":\"الرد، بما في ذلك أي غش معروف أو مشتبه به\"},\"type\":\"textarea\",\"required\":true}]},{\"id\":\"risk_factors\",\"label\":{\"en\":\"Fraud risk factors identified\",\"ar\":\"عوامل خطر الغش المحددة\"},\"type\":\"textarea\",\"required\":true}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F06-MATERIALITY", "{\"id\":\"F06-MATERIALITY\",\"number\":6,\"kind\":\"worksheet\",\"phase\":\"planning\",\"title\":{\"en\":\"Materiality\",\"ar\":\"الأهمية النسبية\"},\"purpose\":{\"en\":\"Determine overall materiality, performance materiality, specific materiality and the clearly trivial threshold, with the rationale for each judgment.\",\"ar\":\"تحديد الأهمية النسبية الإجمالية ومادية الأداء والأهمية النسبية المحددة وحد المبالغ التافهة بشكل واضح، مع مبررات كل حكم.\"},\"procedures\":[\"P-FSL-006\"],\"standards\":[\"ISA-320\"],\"computation\":\"materiality\",\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"benchmark\",\"title\":{\"en\":\"Benchmark\",\"ar\":\"الأساس المرجعي\"},\"fields\":[{\"id\":\"benchmark\",\"label\":{\"en\":\"Benchmark\",\"ar\":\"الأساس المرجعي\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"profit_before_tax\",\"label\":{\"en\":\"Profit before tax\",\"ar\":\"الربح قبل الضريبة\"}},{\"value\":\"revenue\",\"label\":{\"en\":\"Revenue\",\"ar\":\"الإيرادات\"}},{\"value\":\"total_assets\",\"label\":{\"en\":\"Total assets\",\"ar\":\"إجمالي الأصول\"}},{\"value\":\"total_equity\",\"label\":{\"en\":\"Total equity\",\"ar\":\"إجمالي حقوق الملكية\"}},{\"value\":\"total_expenses\",\"label\":{\"en\":\"Total expenses\",\"ar\":\"إجمالي المصروفات\"}},{\"value\":\"gross_profit\",\"label\":{\"en\":\"Gross profit\",\"ar\":\"مجمل الربح\"}},{\"value\":\"net_assets\",\"label\":{\"en\":\"Net assets\",\"ar\":\"صافي الأصول\"}}]},{\"id\":\"benchmark_amount\",\"label\":{\"en\":\"Benchmark amount from the trial balance\",\"ar\":\"مبلغ الأساس المرجعي من ميزان المراجعة\"},\"type\":\"money\",\"required\":true,\"autofill\":\"tb.benchmark.{benchmark}\"},{\"id\":\"percentage\",\"label\":{\"en\":\"Percentage applied\",\"ar\":\"النسبة المطبقة\"},\"type\":\"percent\",\"required\":true},{\"id\":\"rationale\",\"label\":{\"en\":\"Why this benchmark and percentage\",\"ar\":\"مبررات اختيار هذا الأساس وهذه النسبة\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"pm_factor\",\"label\":{\"en\":\"Performance materiality factor\",\"ar\":\"معامل مادية الأداء\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"0.50\",\"label\":{\"en\":\"50%\",\"ar\":\"50%\"}},{\"value\":\"0.60\",\"label\":{\"en\":\"60%\",\"ar\":\"60%\"}},{\"value\":\"0.65\",\"label\":{\"en\":\"65%\",\"ar\":\"65%\"}},{\"value\":\"0.70\",\"label\":{\"en\":\"70%\",\"ar\":\"70%\"}},{\"value\":\"0.75\",\"label\":{\"en\":\"75%\",\"ar\":\"75%\"}}]},{\"id\":\"trivial_factor\",\"label\":{\"en\":\"Clearly trivial factor\",\"ar\":\"معامل المبالغ التافهة بشكل واضح\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"0.03\",\"label\":{\"en\":\"3%\",\"ar\":\"3%\"}},{\"value\":\"0.04\",\"label\":{\"en\":\"4%\",\"ar\":\"4%\"}},{\"value\":\"0.05\",\"label\":{\"en\":\"5%\",\"ar\":\"5%\"}}]}]},{\"id\":\"results\",\"title\":{\"en\":\"Results\",\"ar\":\"النتائج\"},\"fields\":[{\"id\":\"overall\",\"label\":{\"en\":\"Overall materiality\",\"ar\":\"الأهمية النسبية الإجمالية\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.overall\",\"readonly\":true},{\"id\":\"performance\",\"label\":{\"en\":\"Performance materiality\",\"ar\":\"مادية الأداء\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.performance\",\"readonly\":true},{\"id\":\"clearly_trivial\",\"label\":{\"en\":\"Clearly trivial threshold\",\"ar\":\"حد المبالغ التافهة بشكل واضح\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.clearly_trivial\",\"readonly\":true},{\"id\":\"specific\",\"label\":{\"en\":\"Specific materiality for particular classes, balances or disclosures\",\"ar\":\"الأهمية النسبية المحددة لفئات أو أرصدة أو إفصاحات معينة\"},\"type\":\"table\",\"required\":false,\"columns\":[{\"id\":\"name\",\"label\":{\"en\":\"Class, balance or disclosure\",\"ar\":\"الفئة أو الرصيد أو الإفصاح\"},\"type\":\"text\",\"required\":true},{\"id\":\"factor\",\"label\":{\"en\":\"Factor of overall materiality\",\"ar\":\"معامل من الأهمية النسبية الإجمالية\"},\"type\":\"text\",\"required\":true},{\"id\":\"reason\",\"label\":{\"en\":\"Reason\",\"ar\":\"السبب\"},\"type\":\"textarea\",\"required\":true}]},{\"id\":\"revision\",\"label\":{\"en\":\"Revisions during the audit and their effect\",\"ar\":\"التعديلات خلال المراجعة وأثرها\"},\"type\":\"textarea\",\"required\":false}],\"note\":{\"en\":\"Compute the materiality paper from these inputs before signing; the results are taken from the paper and frozen when the form is prepared.\",\"ar\":\"يجب احتساب ورقة الأهمية النسبية من هذه المدخلات قبل التوقيع؛ وتؤخذ النتائج من الورقة وتُثبت عند إعداد النموذج.\"}}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F07-SAMPLING-PLAN", "{\"id\":\"F07-SAMPLING-PLAN\",\"number\":7,\"kind\":\"worksheet\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Sampling plan and evaluation\",\"ar\":\"خطة العينة وتقييمها\"},\"purpose\":{\"en\":\"Design a sample so that sampling risk is reduced to an acceptably low level, and evaluate its results.\",\"ar\":\"تصميم عينة بحيث يُخفض خطر المعاينة إلى مستوى منخفض مقبول، وتقييم نتائجها.\"},\"procedures\":[],\"standards\":[\"ISA-530\"],\"computation\":\"mus_sample_size\",\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"design\",\"title\":{\"en\":\"Design\",\"ar\":\"التصميم\"},\"fields\":[{\"id\":\"population\",\"label\":{\"en\":\"Population and the assertion tested\",\"ar\":\"المجتمع والإقرار محل الاختبار\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"completeness_of_population\",\"label\":{\"en\":\"How the population was confirmed complete\",\"ar\":\"كيف تم التأكد من اكتمال المجتمع\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"book_value\",\"label\":{\"en\":\"Population book value\",\"ar\":\"القيمة الدفترية للمجتمع\"},\"type\":\"money\",\"required\":true},{\"id\":\"tolerable_misstatement\",\"label\":{\"en\":\"Tolerable misstatement\",\"ar\":\"الخطأ المسموح به\"},\"type\":\"money\",\"required\":true,\"autofill\":\"paper.materiality.performance\"},{\"id\":\"expected_misstatement\",\"label\":{\"en\":\"Expected misstatement\",\"ar\":\"التحريف المتوقع\"},\"type\":\"money\",\"required\":true},{\"id\":\"beta\",\"label\":{\"en\":\"Risk of incorrect acceptance\",\"ar\":\"خطر القبول الخاطئ\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"0.05\",\"label\":{\"en\":\"5%\",\"ar\":\"5%\"}},{\"value\":\"0.10\",\"label\":{\"en\":\"10%\",\"ar\":\"10%\"}},{\"value\":\"0.15\",\"label\":{\"en\":\"15%\",\"ar\":\"15%\"}},{\"value\":\"0.20\",\"label\":{\"en\":\"20%\",\"ar\":\"20%\"}}]},{\"id\":\"method\",\"label\":{\"en\":\"Selection method\",\"ar\":\"طريقة الاختيار\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"mus\",\"label\":{\"en\":\"Monetary unit (systematic)\",\"ar\":\"وحدة النقد (منتظمة)\"}},{\"value\":\"random\",\"label\":{\"en\":\"Random\",\"ar\":\"عشوائية\"}},{\"value\":\"stratified\",\"label\":{\"en\":\"Stratified random\",\"ar\":\"طبقية\"}},{\"value\":\"haphazard\",\"label\":{\"en\":\"Haphazard (non-statistical)\",\"ar\":\"عشوائية غير منظمة (غير إحصائية)\"}}]}]},{\"id\":\"size\",\"title\":{\"en\":\"Sample size\",\"ar\":\"حجم العينة\"},\"fields\":[{\"id\":\"sample_size\",\"label\":{\"en\":\"Sample size\",\"ar\":\"حجم العينة\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"paper.mus_sample_size.sample_size\",\"readonly\":true},{\"id\":\"sampling_interval\",\"label\":{\"en\":\"Sampling interval\",\"ar\":\"فترة المعاينة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.mus_sample_size.sampling_interval\",\"readonly\":true},{\"id\":\"random_start\",\"label\":{\"en\":\"Random start\",\"ar\":\"نقطة البداية العشوائية\"},\"type\":\"money\",\"required\":false}]},{\"id\":\"evaluation\",\"title\":{\"en\":\"Evaluation\",\"ar\":\"التقييم\"},\"fields\":[{\"id\":\"projected\",\"label\":{\"en\":\"Projected misstatement\",\"ar\":\"التحريف المتوقع (المسقط)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.mus_evaluate.projected_misstatement\",\"readonly\":true},{\"id\":\"upper_limit\",\"label\":{\"en\":\"Upper misstatement limit\",\"ar\":\"الحد الأعلى للتحريف\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.mus_evaluate.upper_misstatement_limit\",\"readonly\":true},{\"id\":\"evaluation_conclusion\",\"label\":{\"en\":\"Result against tolerable misstatement\",\"ar\":\"النتيجة مقارنة بالخطأ المسموح به\"},\"type\":\"text\",\"required\":false,\"autofill\":\"paper.mus_evaluate.conclusion\",\"readonly\":true},{\"id\":\"deviations_nature\",\"label\":{\"en\":\"Nature and cause of misstatements found\",\"ar\":\"طبيعة التحريفات المكتشفة وأسبابها\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"conclusion\",\"label\":{\"en\":\"Conclusion on the population\",\"ar\":\"الاستنتاج بشأن المجتمع\"},\"type\":\"textarea\",\"required\":true}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F08-CONFIRMATIONS", "{\"id\":\"F08-CONFIRMATIONS\",\"number\":8,\"kind\":\"letter\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"External confirmation request and control log\",\"ar\":\"طلب المصادقة الخارجية وسجل متابعتها\"},\"purpose\":{\"en\":\"Maintain control over external confirmation requests from sending to receipt, and record exceptions and alternative procedures.\",\"ar\":\"الحفاظ على الرقابة على طلبات المصادقة الخارجية من الإرسال حتى الاستلام، وتسجيل الاستثناءات والإجراءات البديلة.\"},\"procedures\":[\"P-TRE-001\"],\"standards\":[\"ISA-505\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"request\",\"title\":{\"en\":\"Request\",\"ar\":\"الطلب\"},\"fields\":[{\"id\":\"confirming_party\",\"label\":{\"en\":\"Confirming party\",\"ar\":\"الطرف المصادِق\"},\"type\":\"text\",\"required\":true},{\"id\":\"confirmation_type\",\"label\":{\"en\":\"Type\",\"ar\":\"النوع\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"bank\",\"label\":{\"en\":\"Bank balances and facilities\",\"ar\":\"أرصدة وتسهيلات بنكية\"}},{\"value\":\"receivable\",\"label\":{\"en\":\"Receivable\",\"ar\":\"مدينون\"}},{\"value\":\"payable\",\"label\":{\"en\":\"Payable\",\"ar\":\"دائنون\"}},{\"value\":\"legal\",\"label\":{\"en\":\"Legal counsel\",\"ar\":\"مستشار قانوني\"}},{\"value\":\"other\",\"label\":{\"en\":\"Other\",\"ar\":\"أخرى\"}}]},{\"id\":\"balance\",\"label\":{\"en\":\"Balance per the entity's records\",\"ar\":\"الرصيد وفقًا لسجلات المنشأة\"},\"type\":\"money\",\"required\":true},{\"id\":\"reply_to\",\"label\":{\"en\":\"Reply directly to (auditor address)\",\"ar\":\"يُرد مباشرةً إلى (عنوان المراجع)\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"request_date\",\"label\":{\"en\":\"Date sent\",\"ar\":\"تاريخ الإرسال\"},\"type\":\"date\",\"required\":true}]},{\"id\":\"log\",\"title\":{\"en\":\"Control log\",\"ar\":\"سجل المتابعة\"},\"fields\":[{\"id\":\"log\",\"label\":{\"en\":\"Requests\",\"ar\":\"الطلبات\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"party\",\"label\":{\"en\":\"Confirming party\",\"ar\":\"الطرف المصادِق\"},\"type\":\"text\",\"required\":true},{\"id\":\"amount\",\"label\":{\"en\":\"Amount per records\",\"ar\":\"المبلغ وفقًا للسجلات\"},\"type\":\"money\",\"required\":true},{\"id\":\"sent\",\"label\":{\"en\":\"Sent\",\"ar\":\"أُرسل\"},\"type\":\"date\",\"required\":true},{\"id\":\"received\",\"label\":{\"en\":\"Received directly by the auditor\",\"ar\":\"استُلم مباشرةً من قبل المراجع\"},\"type\":\"date\",\"required\":false},{\"id\":\"status\",\"label\":{\"en\":\"Status\",\"ar\":\"الحالة\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"sent\",\"label\":{\"en\":\"Sent\",\"ar\":\"مُرسل\"}},{\"value\":\"agreed\",\"label\":{\"en\":\"Agreed\",\"ar\":\"مطابق\"}},{\"value\":\"difference\",\"label\":{\"en\":\"Difference\",\"ar\":\"يوجد فرق\"}},{\"value\":\"no_reply\",\"label\":{\"en\":\"No reply\",\"ar\":\"لم يُرد\"}},{\"value\":\"alternative\",\"label\":{\"en\":\"Alternative procedures\",\"ar\":\"إجراءات بديلة\"}}]},{\"id\":\"difference\",\"label\":{\"en\":\"Difference and its resolution\",\"ar\":\"الفرق وكيفية تسويته\"},\"type\":\"textarea\",\"required\":false}]}]}],\"letter\":{\"en\":[\"To {{field:confirming_party}}\",\"Our auditors are performing an audit of the financial statements of {{engagement.client}} as at {{engagement.period_end}}. Please confirm directly to our auditors the balance of {{field:balance}} {{engagement.currency}} shown in our records, or state any differences with full particulars.\",\"Please send your reply directly to: {{field:reply_to}}\",\"This request is not a request for payment. Your prompt reply is appreciated.\",\"For and on behalf of {{engagement.client}}: ______________________  Date: {{field:request_date}}\",\"Confirmation: the balance stated above is correct / differs as follows: ____________________  Signed: __________  Title: __________\"],\"ar\":[\"إلى {{field:confirming_party}}\",\"يقوم مراجعو حساباتنا بمراجعة القوائم المالية لـ {{engagement.client}} في {{engagement.period_end}}. نرجو التكرم بالمصادقة مباشرةً لدى مراجعي حساباتنا على الرصيد البالغ {{field:balance}} {{engagement.currency}} الظاهر في سجلاتنا، أو بيان أي فروق مع تفاصيلها كاملة.\",\"يرجى إرسال ردكم مباشرةً إلى: {{field:reply_to}}\",\"هذا الطلب ليس مطالبة بالسداد. ونقدر ردكم السريع.\",\"عن وبالنيابة عن {{engagement.client}}: ______________________  التاريخ: {{field:request_date}}\",\"المصادقة: الرصيد الموضح أعلاه صحيح / يختلف على النحو التالي: ____________________  التوقيع: __________  الصفة: __________\"]},\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\",\"manager\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F09-GOING-CONCERN", "{\"id\":\"F09-GOING-CONCERN\",\"number\":9,\"kind\":\"worksheet\",\"phase\":\"completion\",\"title\":{\"en\":\"Going concern evaluation\",\"ar\":\"تقييم الاستمرارية\"},\"purpose\":{\"en\":\"Evaluate management's assessment of the entity's ability to continue as a going concern and conclude on material uncertainty.\",\"ar\":\"تقييم تقدير الإدارة لقدرة المنشأة على الاستمرار واستنتاج ما إذا كان يوجد عدم تأكد جوهري متعلق بالاستمرارية.\"},\"procedures\":[\"P-FSL-032\"],\"standards\":[\"ISA-570\"],\"computation\":\"going_concern\",\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"assessment\",\"title\":{\"en\":\"Management's assessment\",\"ar\":\"تقدير الإدارة\"},\"fields\":[{\"id\":\"assessment_obtained\",\"label\":{\"en\":\"Has management made an assessment covering at least twelve months?\",\"ar\":\"هل أعدت الإدارة تقديرًا يغطي اثني عشر شهرًا على الأقل؟\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"required_end\",\"label\":{\"en\":\"Required end of the assessment period\",\"ar\":\"النهاية المطلوبة لفترة التقدير\"},\"type\":\"date\",\"required\":false,\"autofill\":\"paper.going_concern.required_assessment_end\",\"readonly\":true},{\"id\":\"shortfall_days\",\"label\":{\"en\":\"Shortfall of the assessment period (days)\",\"ar\":\"نقص فترة التقدير (بالأيام)\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"paper.going_concern.assessment_shortfall_days\",\"readonly\":true},{\"id\":\"indicators\",\"label\":{\"en\":\"Events or conditions indicated by the computation\",\"ar\":\"الأحداث أو الظروف التي يشير إليها الاحتساب\"},\"type\":\"text\",\"required\":false,\"autofill\":\"paper.going_concern.indicators\",\"readonly\":true},{\"id\":\"method_and_assumptions\",\"label\":{\"en\":\"Evaluation of the method, assumptions and data\",\"ar\":\"تقييم الطريقة والافتراضات والبيانات\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"plans\",\"label\":{\"en\":\"Management's plans and whether they are feasible\",\"ar\":\"خطط الإدارة ومدى إمكانية تنفيذها\"},\"type\":\"textarea\",\"required\":true}]},{\"id\":\"conclusion\",\"title\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"fields\":[{\"id\":\"conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"no_uncertainty\",\"label\":{\"en\":\"Basis appropriate; no material uncertainty\",\"ar\":\"الأساس ملائم؛ لا يوجد عدم تأكد جوهري\"}},{\"value\":\"uncertainty_disclosed\",\"label\":{\"en\":\"Material uncertainty, adequately disclosed\",\"ar\":\"يوجد عدم تأكد جوهري مفصح عنه بشكل كافٍ\"}},{\"value\":\"uncertainty_not_disclosed\",\"label\":{\"en\":\"Material uncertainty, not adequately disclosed\",\"ar\":\"يوجد عدم تأكد جوهري غير مفصح عنه بشكل كافٍ\"}},{\"value\":\"basis_inappropriate\",\"label\":{\"en\":\"Going concern basis inappropriate\",\"ar\":\"أساس الاستمرارية غير ملائم\"}}]},{\"id\":\"disclosure_evaluation\",\"label\":{\"en\":\"Evaluation of the related disclosures\",\"ar\":\"تقييم الإفصاحات ذات الصلة\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"report_effect\",\"label\":{\"en\":\"Effect on the auditor's report\",\"ar\":\"الأثر على تقرير المراجع\"},\"type\":\"textarea\",\"required\":true}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F10-MISSTATEMENTS", "{\"id\":\"F10-MISSTATEMENTS\",\"number\":10,\"kind\":\"worksheet\",\"phase\":\"completion\",\"title\":{\"en\":\"Summary of misstatements\",\"ar\":\"ملخص التحريفات\"},\"purpose\":{\"en\":\"Accumulate identified misstatements other than clearly trivial ones and evaluate uncorrected misstatements, individually and in aggregate.\",\"ar\":\"تجميع التحريفات المحددة بخلاف التافهة بشكل واضح، وتقييم التحريفات غير المصححة بشكل فردي وفي مجملها.\"},\"procedures\":[\"P-FSL-039\"],\"standards\":[\"ISA-450\"],\"computation\":\"aggregation\",\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"schedule\",\"title\":{\"en\":\"Schedule\",\"ar\":\"الجدول\"},\"fields\":[{\"id\":\"misstatements\",\"label\":{\"en\":\"Misstatements recorded on the engagement\",\"ar\":\"التحريفات المسجلة على الارتباط\"},\"type\":\"table\",\"required\":false,\"autofill\":\"records.RK-MISSTATEMENT\",\"readonly\":true,\"columns\":[{\"id\":\"description\",\"label\":{\"en\":\"Description\",\"ar\":\"الوصف\"},\"type\":\"text\",\"required\":false},{\"id\":\"type\",\"label\":{\"en\":\"Type\",\"ar\":\"النوع\"},\"type\":\"text\",\"required\":false},{\"id\":\"status\",\"label\":{\"en\":\"Status\",\"ar\":\"الحالة\"},\"type\":\"text\",\"required\":false},{\"id\":\"assets\",\"label\":{\"en\":\"Assets\",\"ar\":\"الأصول\"},\"type\":\"money\",\"required\":false},{\"id\":\"liabilities\",\"label\":{\"en\":\"Liabilities\",\"ar\":\"الالتزامات\"},\"type\":\"money\",\"required\":false},{\"id\":\"equity\",\"label\":{\"en\":\"Equity\",\"ar\":\"حقوق الملكية\"},\"type\":\"money\",\"required\":false},{\"id\":\"profit\",\"label\":{\"en\":\"Profit\",\"ar\":\"الربح\"},\"type\":\"money\",\"required\":false}]},{\"id\":\"uncorrected_profit\",\"label\":{\"en\":\"Uncorrected effect on profit\",\"ar\":\"أثر التحريفات غير المصححة على الربح\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.aggregation.uncorrected.profit\",\"readonly\":true},{\"id\":\"largest_effect\",\"label\":{\"en\":\"Largest effect on any element\",\"ar\":\"أكبر أثر على أي عنصر\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.aggregation.largest_element_effect\",\"readonly\":true},{\"id\":\"band\",\"label\":{\"en\":\"Proximity to overall materiality\",\"ar\":\"مدى القرب من الأهمية النسبية الإجمالية\"},\"type\":\"text\",\"required\":false,\"autofill\":\"paper.aggregation.band\",\"readonly\":true}]},{\"id\":\"evaluation\",\"title\":{\"en\":\"Evaluation\",\"ar\":\"التقييم\"},\"fields\":[{\"id\":\"reasons_not_corrected\",\"label\":{\"en\":\"Management's reasons for not correcting\",\"ar\":\"أسباب عدم قيام الإدارة بالتصحيح\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"qualitative\",\"label\":{\"en\":\"Qualitative considerations\",\"ar\":\"الاعتبارات النوعية\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"not_material\",\"label\":{\"en\":\"Not material, individually or in aggregate\",\"ar\":\"غير جوهرية بشكل فردي أو في مجملها\"}},{\"value\":\"material\",\"label\":{\"en\":\"Material (effect on the opinion recorded)\",\"ar\":\"جوهرية (مع تسجيل الأثر على الرأي)\"}}]}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F11-SUBSEQUENT-EVENTS", "{\"id\":\"F11-SUBSEQUENT-EVENTS\",\"number\":11,\"kind\":\"checklist\",\"phase\":\"completion\",\"title\":{\"en\":\"Subsequent events review\",\"ar\":\"مراجعة الأحداث اللاحقة\"},\"purpose\":{\"en\":\"Identify events between the period end and the report date that require adjustment or disclosure.\",\"ar\":\"تحديد الأحداث الواقعة بين نهاية الفترة وتاريخ التقرير والتي تتطلب تعديلًا أو إفصاحًا.\"},\"procedures\":[\"P-FSL-037\"],\"standards\":[\"ISA-560\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"procedures\",\"title\":{\"en\":\"Procedures performed to the report date\",\"ar\":\"الإجراءات المنفذة حتى تاريخ التقرير\"},\"fields\":[{\"id\":\"reviewed_to\",\"label\":{\"en\":\"Review performed up to\",\"ar\":\"تمت المراجعة حتى\"},\"type\":\"date\",\"required\":true},{\"id\":\"management_procedures\",\"label\":{\"en\":\"Management's procedures for identifying subsequent events understood\",\"ar\":\"فهم إجراءات الإدارة لتحديد الأحداث اللاحقة\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"yes\",\"label\":{\"en\":\"Yes\",\"ar\":\"نعم\"}},{\"value\":\"no\",\"label\":{\"en\":\"No\",\"ar\":\"لا\"}},{\"value\":\"na\",\"label\":{\"en\":\"Not applicable\",\"ar\":\"لا ينطبق\"}}]},{\"id\":\"inquiries\",\"label\":{\"en\":\"Inquiries of management and those charged with governance\",\"ar\":\"الاستفسار من الإدارة والمكلفين بالحوكمة\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"yes\",\"label\":{\"en\":\"Yes\",\"ar\":\"نعم\"}},{\"value\":\"no\",\"label\":{\"en\":\"No\",\"ar\":\"لا\"}},{\"value\":\"na\",\"label\":{\"en\":\"Not applicable\",\"ar\":\"لا ينطبق\"}}]},{\"id\":\"minutes\",\"label\":{\"en\":\"Minutes of meetings held after the period end read\",\"ar\":\"قراءة محاضر الاجتماعات المنعقدة بعد نهاية الفترة\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"yes\",\"label\":{\"en\":\"Yes\",\"ar\":\"نعم\"}},{\"value\":\"no\",\"label\":{\"en\":\"No\",\"ar\":\"لا\"}},{\"value\":\"na\",\"label\":{\"en\":\"Not applicable\",\"ar\":\"لا ينطبق\"}}]},{\"id\":\"interim\",\"label\":{\"en\":\"Latest interim financial information read\",\"ar\":\"قراءة أحدث معلومات مالية أولية\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"yes\",\"label\":{\"en\":\"Yes\",\"ar\":\"نعم\"}},{\"value\":\"no\",\"label\":{\"en\":\"No\",\"ar\":\"لا\"}},{\"value\":\"na\",\"label\":{\"en\":\"Not applicable\",\"ar\":\"لا ينطبق\"}}]},{\"id\":\"legal\",\"label\":{\"en\":\"Post-period legal and regulatory matters reviewed\",\"ar\":\"مراجعة الأمور القانونية والتنظيمية بعد نهاية الفترة\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"yes\",\"label\":{\"en\":\"Yes\",\"ar\":\"نعم\"}},{\"value\":\"no\",\"label\":{\"en\":\"No\",\"ar\":\"لا\"}},{\"value\":\"na\",\"label\":{\"en\":\"Not applicable\",\"ar\":\"لا ينطبق\"}}]}]},{\"id\":\"events\",\"title\":{\"en\":\"Events identified\",\"ar\":\"الأحداث المحددة\"},\"fields\":[{\"id\":\"events\",\"label\":{\"en\":\"Events\",\"ar\":\"الأحداث\"},\"type\":\"table\",\"required\":false,\"columns\":[{\"id\":\"event\",\"label\":{\"en\":\"Event\",\"ar\":\"الحدث\"},\"type\":\"text\",\"required\":true},{\"id\":\"date\",\"label\":{\"en\":\"Date\",\"ar\":\"التاريخ\"},\"type\":\"date\",\"required\":true},{\"id\":\"nature\",\"label\":{\"en\":\"Adjusting or non-adjusting\",\"ar\":\"مُعدِّل أم غير مُعدِّل\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"adjusting\",\"label\":{\"en\":\"Adjusting\",\"ar\":\"مُعدِّل\"}},{\"value\":\"non_adjusting\",\"label\":{\"en\":\"Non-adjusting\",\"ar\":\"غير مُعدِّل\"}}]},{\"id\":\"treatment\",\"label\":{\"en\":\"Treatment in the financial statements\",\"ar\":\"المعالجة في القوائم المالية\"},\"type\":\"textarea\",\"required\":true}]},{\"id\":\"conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"textarea\",\"required\":true}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F12-REPRESENTATION-LETTER", "{\"id\":\"F12-REPRESENTATION-LETTER\",\"number\":12,\"kind\":\"letter\",\"phase\":\"completion\",\"title\":{\"en\":\"Management representation letter\",\"ar\":\"خطاب الإفادات المكتوبة من الإدارة\"},\"purpose\":{\"en\":\"Obtain written representations from management, dated as near as practicable to the date of the auditor's report.\",\"ar\":\"الحصول على الإفادات المكتوبة من الإدارة، مؤرخة بأقرب تاريخ ممكن لتاريخ تقرير المراجع.\"},\"procedures\":[\"P-FSL-038\"],\"standards\":[\"ISA-580\",\"ISA-240\",\"ISA-250\",\"ISA-450\",\"ISA-550\",\"ISA-560\",\"ISA-570\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"details\",\"title\":{\"en\":\"Details\",\"ar\":\"البيانات\"},\"fields\":[{\"id\":\"firm_name\",\"label\":{\"en\":\"Audit firm\",\"ar\":\"مكتب المراجعة\"},\"type\":\"text\",\"required\":true},{\"id\":\"letter_date\",\"label\":{\"en\":\"Date (the date of the auditor's report)\",\"ar\":\"التاريخ (تاريخ تقرير المراجع)\"},\"type\":\"date\",\"required\":true},{\"id\":\"uncorrected_reference\",\"label\":{\"en\":\"Reference to the attached schedule of uncorrected misstatements\",\"ar\":\"الإشارة إلى الجدول المرفق للتحريفات غير المصححة\"},\"type\":\"text\",\"required\":true},{\"id\":\"signatories\",\"label\":{\"en\":\"Signatories\",\"ar\":\"الموقعون\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"name\",\"label\":{\"en\":\"Name\",\"ar\":\"الاسم\"},\"type\":\"text\",\"required\":true},{\"id\":\"title\",\"label\":{\"en\":\"Title\",\"ar\":\"الصفة\"},\"type\":\"text\",\"required\":true}]}]}],\"letter\":{\"en\":[\"To {{field:firm_name}}\",\"This representation letter is provided in connection with your audit of the financial statements of {{engagement.client}} for the period ended {{engagement.period_end}} for the purpose of expressing an opinion as to whether the financial statements are presented fairly, in all material respects, in accordance with {{engagement.framework}}.\",\"We confirm that we have fulfilled our responsibilities, as set out in the terms of the audit engagement, for the preparation of the financial statements in accordance with {{engagement.framework}}, and that they are presented fairly in accordance therewith.\",\"We have provided you with access to all information of which we are aware that is relevant to the preparation of the financial statements, additional information that you requested, and unrestricted access to persons within the entity from whom you determined it necessary to obtain audit evidence. All transactions have been recorded in the accounting records and are reflected in the financial statements.\",\"We acknowledge our responsibility for the design, implementation and maintenance of internal control to prevent and detect fraud. We have disclosed to you the results of our assessment of the risk that the financial statements may be materially misstated as a result of fraud, and all information in relation to fraud or suspected fraud that we are aware of and that affects the entity.\",\"We have disclosed to you all known instances of non-compliance or suspected non-compliance with laws and regulations whose effects should be considered when preparing the financial statements.\",\"We have disclosed to you the identity of the entity's related parties and all the related party relationships and transactions of which we are aware, and they have been appropriately accounted for and disclosed.\",\"Significant assumptions used by us in making accounting estimates are reasonable.\",\"All events subsequent to the date of the financial statements for which {{engagement.framework}} requires adjustment or disclosure have been adjusted or disclosed.\",\"The effects of uncorrected misstatements are immaterial, both individually and in the aggregate, to the financial statements as a whole. A list of the uncorrected misstatements is attached to this letter ({{field:uncorrected_reference}}).\",\"We have assessed the entity's ability to continue as a going concern and have disclosed to you all information relevant to that assessment.\",\"Date: {{field:letter_date}}\",\"{{table:signatories}}\"],\"ar\":[\"إلى {{field:firm_name}}\",\"نقدم خطاب الإفادات هذا فيما يتعلق بمراجعتكم للقوائم المالية لـ {{engagement.client}} عن الفترة المنتهية في {{engagement.period_end}}، بغرض إبداء رأي حول ما إذا كانت القوائم المالية معروضة بشكل عادل، من جميع الجوانب الجوهرية، وفقًا لـ {{engagement.framework}}.\",\"نؤكد أننا قد وفينا بمسؤولياتنا، كما وردت في شروط ارتباط المراجعة، عن إعداد القوائم المالية وفقًا لـ {{engagement.framework}}، وأنها معروضة بشكل عادل وفقًا له.\",\"لقد زودناكم بإمكانية الوصول إلى جميع المعلومات التي نعلم بها وذات الصلة بإعداد القوائم المالية، والمعلومات الإضافية التي طلبتموها، وإمكانية الوصول غير المقيد إلى الأشخاص داخل المنشأة الذين رأيتم ضرورة الحصول على أدلة المراجعة منهم. وقد تم تسجيل جميع المعاملات في السجلات المحاسبية وهي منعكسة في القوائم المالية.\",\"نقر بمسؤوليتنا عن تصميم الرقابة الداخلية وتطبيقها والحفاظ عليها لمنع الغش واكتشافه. وقد أفصحنا لكم عن نتائج تقييمنا لخطر أن تكون القوائم المالية محرفة تحريفًا جوهريًا نتيجة الغش، وعن جميع المعلومات المتعلقة بالغش أو الغش المشتبه به التي نعلم بها والتي تؤثر على المنشأة.\",\"لقد أفصحنا لكم عن جميع حالات عدم الالتزام أو الاشتباه في عدم الالتزام بالأنظمة واللوائح المعروفة لنا والتي ينبغي مراعاة آثارها عند إعداد القوائم المالية.\",\"لقد أفصحنا لكم عن هوية الأطراف ذات العلاقة بالمنشأة وعن جميع العلاقات والمعاملات مع الأطراف ذات العلاقة التي نعلم بها، وقد تمت المحاسبة عنها والإفصاح عنها بشكل مناسب.\",\"الافتراضات المهمة التي استخدمناها في إعداد التقديرات المحاسبية معقولة.\",\"تم تعديل أو الإفصاح عن جميع الأحداث اللاحقة لتاريخ القوائم المالية التي يتطلب {{engagement.framework}} تعديلها أو الإفصاح عنها.\",\"آثار التحريفات غير المصححة غير جوهرية، بشكل فردي وفي مجملها، بالنسبة للقوائم المالية ككل. ومرفق بهذا الخطاب قائمة بالتحريفات غير المصححة ({{field:uncorrected_reference}}).\",\"لقد قيّمنا قدرة المنشأة على الاستمرار وأفصحنا لكم عن جميع المعلومات ذات الصلة بهذا التقييم.\",\"التاريخ: {{field:letter_date}}\",\"{{table:signatories}}\"]},\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F13-TCWG-LETTER", "{\"id\":\"F13-TCWG-LETTER\",\"number\":13,\"kind\":\"letter\",\"phase\":\"completion\",\"title\":{\"en\":\"Letter to those charged with governance\",\"ar\":\"خطاب إلى المكلفين بالحوكمة\"},\"purpose\":{\"en\":\"Communicate in writing the planned scope and timing, significant findings, uncorrected misstatements, significant deficiencies in internal control and independence.\",\"ar\":\"الإبلاغ كتابةً عن النطاق والتوقيت المخططين، والنتائج المهمة، والتحريفات غير المصححة، وأوجه القصور المهمة في الرقابة الداخلية، والاستقلال.\"},\"procedures\":[\"P-FSL-047\"],\"standards\":[\"ISA-260\",\"ISA-265\",\"ISA-450\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"content\",\"title\":{\"en\":\"Content\",\"ar\":\"المحتوى\"},\"fields\":[{\"id\":\"addressee\",\"label\":{\"en\":\"Addressed to\",\"ar\":\"موجه إلى\"},\"type\":\"text\",\"required\":true},{\"id\":\"firm_name\",\"label\":{\"en\":\"Audit firm\",\"ar\":\"مكتب المراجعة\"},\"type\":\"text\",\"required\":true},{\"id\":\"letter_date\",\"label\":{\"en\":\"Date\",\"ar\":\"التاريخ\"},\"type\":\"date\",\"required\":true},{\"id\":\"scope_and_timing\",\"label\":{\"en\":\"Planned scope and timing, including significant risks\",\"ar\":\"النطاق والتوقيت المخططان، بما في ذلك المخاطر المهمة\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"significant_findings\",\"label\":{\"en\":\"Significant findings from the audit\",\"ar\":\"النتائج المهمة للمراجعة\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"uncorrected\",\"label\":{\"en\":\"Uncorrected misstatements (effect on profit)\",\"ar\":\"التحريفات غير المصححة (الأثر على الربح)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.aggregation.uncorrected.profit\",\"readonly\":true},{\"id\":\"deficiencies\",\"label\":{\"en\":\"Significant deficiencies in internal control\",\"ar\":\"أوجه القصور المهمة في الرقابة الداخلية\"},\"type\":\"table\",\"required\":false,\"columns\":[{\"id\":\"deficiency\",\"label\":{\"en\":\"Deficiency\",\"ar\":\"أوجه القصور\"},\"type\":\"text\",\"required\":true},{\"id\":\"effect\",\"label\":{\"en\":\"Potential effect\",\"ar\":\"الأثر المحتمل\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"recommendation\",\"label\":{\"en\":\"Recommendation\",\"ar\":\"التوصية\"},\"type\":\"textarea\",\"required\":true}]},{\"id\":\"independence\",\"label\":{\"en\":\"Statement on independence\",\"ar\":\"بيان الاستقلال\"},\"type\":\"textarea\",\"required\":true}]}],\"letter\":{\"en\":[\"To {{field:addressee}}\",\"We are pleased to communicate the matters arising from our audit of the financial statements of {{engagement.client}} for the period ended {{engagement.period_end}} that we consider relevant to your responsibility to oversee the financial reporting process.\",\"Our responsibility is to form and express an opinion on the financial statements prepared by management with your oversight. The audit does not relieve management or you of your responsibilities.\",\"Planned scope and timing: {{field:scope_and_timing}}\",\"Significant findings: {{field:significant_findings}}\",\"Uncorrected misstatements: the aggregate effect on profit of misstatements that management has not corrected is {{field:uncorrected}} {{engagement.currency}}. We request that they be corrected.\",\"Significant deficiencies in internal control: {{table:deficiencies}}\",\"Independence: {{field:independence}}\",\"This communication is intended solely for those charged with governance and management and should not be used for any other purpose.\",\"Yours faithfully, {{field:firm_name}}  Date: {{field:letter_date}}\"],\"ar\":[\"إلى {{field:addressee}}\",\"يسعدنا أن نبلغكم بالأمور الناشئة عن مراجعتنا للقوائم المالية لـ {{engagement.client}} عن الفترة المنتهية في {{engagement.period_end}} والتي نرى أنها ذات صلة بمسؤوليتكم عن الإشراف على عملية التقرير المالي.\",\"تتمثل مسؤوليتنا في تكوين رأي وإبدائه حول القوائم المالية التي أعدتها الإدارة تحت إشرافكم. ولا تعفي المراجعة الإدارة أو إياكم من مسؤولياتكم.\",\"النطاق والتوقيت المخططان: {{field:scope_and_timing}}\",\"النتائج المهمة: {{field:significant_findings}}\",\"التحريفات غير المصححة: يبلغ الأثر المجمع على الربح للتحريفات التي لم تصححها الإدارة {{field:uncorrected}} {{engagement.currency}}. ونطلب تصحيحها.\",\"أوجه القصور المهمة في الرقابة الداخلية: {{table:deficiencies}}\",\"الاستقلال: {{field:independence}}\",\"هذا الإبلاغ مقصود حصرًا للمكلفين بالحوكمة والإدارة، ولا ينبغي استخدامه لأي غرض آخر.\",\"وتفضلوا بقبول فائق الاحترام، {{field:firm_name}}  التاريخ: {{field:letter_date}}\"]},\"signoff\":{\"prepare\":[\"partner\",\"manager\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F14-COMPLETION", "{\"id\":\"F14-COMPLETION\",\"number\":14,\"kind\":\"checklist\",\"phase\":\"completion\",\"title\":{\"en\":\"Completion and sign-off\",\"ar\":\"إنجاز المراجعة والتوقيع\"},\"purpose\":{\"en\":\"Confirm that sufficient appropriate audit evidence supports the opinion, that the partner has discharged the quality responsibilities, and that the file is ready for assembly.\",\"ar\":\"التأكد من أن ما يكفي من أدلة المراجعة المناسبة يؤيد الرأي، وأن الشريك قد وفى بمسؤوليات الجودة، وأن الملف جاهز للتجميع.\"},\"procedures\":[\"P-FSL-044\",\"P-FSL-045\",\"P-FSL-049\",\"P-FSL-050\"],\"standards\":[\"ISA-220\",\"ISA-230\",\"ISA-700\",\"ISQM-2\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"checklist\",\"title\":{\"en\":\"Completion checklist\",\"ar\":\"قائمة مراجعة الإنجاز\"},\"fields\":[{\"id\":\"open_review_notes\",\"label\":{\"en\":\"Review notes not yet cleared\",\"ar\":\"ملاحظات الفحص التي لم تُغلق بعد\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-REVIEW-NOTE.open\",\"readonly\":true},{\"id\":\"open_disclosures\",\"label\":{\"en\":\"Disclosure checklist items applicable and not yet disclosed\",\"ar\":\"بنود قائمة الإفصاح المنطبقة التي لم يُفصح عنها بعد\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"disclosures.open\",\"readonly\":true},{\"id\":\"evidence_sufficient\",\"label\":{\"en\":\"Sufficient appropriate audit evidence has been obtained\",\"ar\":\"تم الحصول على ما يكفي من أدلة المراجعة المناسبة\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"misstatements_evaluated\",\"label\":{\"en\":\"Misstatements have been evaluated (form 10)\",\"ar\":\"تم تقييم التحريفات (النموذج 10)\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"going_concern_concluded\",\"label\":{\"en\":\"Going concern has been concluded on (form 9)\",\"ar\":\"تم الاستنتاج بشأن الاستمرارية (النموذج 9)\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"subsequent_events\",\"label\":{\"en\":\"Subsequent events reviewed to the report date (form 11)\",\"ar\":\"تمت مراجعة الأحداث اللاحقة حتى تاريخ التقرير (النموذج 11)\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"representations\",\"label\":{\"en\":\"Written representations obtained, dated at the report date (form 12)\",\"ar\":\"تم الحصول على الإفادات المكتوبة مؤرخة بتاريخ التقرير (النموذج 12)\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"tcwg\",\"label\":{\"en\":\"Matters communicated to those charged with governance (form 13)\",\"ar\":\"تم إبلاغ المكلفين بالحوكمة بالأمور المطلوبة (النموذج 13)\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"consultations\",\"label\":{\"en\":\"Consultations on difficult or contentious matters documented and implemented\",\"ar\":\"تم توثيق المشاورات بشأن الأمور الصعبة أو الخلافية وتنفيذ نتائجها\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"eqr\",\"label\":{\"en\":\"Engagement quality review\",\"ar\":\"فحص جودة الارتباط\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"completed\",\"label\":{\"en\":\"Required and completed\",\"ar\":\"مطلوب وتم\"}},{\"value\":\"not_required\",\"label\":{\"en\":\"Not required by firm policy\",\"ar\":\"غير مطلوب وفقًا لسياسة المكتب\"}}]}]},{\"id\":\"opinion\",\"title\":{\"en\":\"Opinion and report\",\"ar\":\"الرأي والتقرير\"},\"fields\":[{\"id\":\"opinion\",\"label\":{\"en\":\"Opinion\",\"ar\":\"الرأي\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"unmodified\",\"label\":{\"en\":\"Unmodified\",\"ar\":\"غير معدل\"}},{\"value\":\"qualified\",\"label\":{\"en\":\"Qualified\",\"ar\":\"رأي متحفظ\"}},{\"value\":\"adverse\",\"label\":{\"en\":\"Adverse\",\"ar\":\"رأي معارض\"}},{\"value\":\"disclaimer\",\"label\":{\"en\":\"Disclaimer of opinion\",\"ar\":\"الامتناع عن إبداء الرأي\"}}]},{\"id\":\"basis_for_modification\",\"label\":{\"en\":\"Basis for any modification\",\"ar\":\"أساس أي تعديل\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"emphasis\",\"label\":{\"en\":\"Emphasis of matter or other matter paragraphs\",\"ar\":\"فقرات لفت الانتباه أو فقرات أمور أخرى\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"key_audit_matters\",\"label\":{\"en\":\"Key audit matters (listed entities)\",\"ar\":\"الأمور الرئيسة للمراجعة (للمنشآت المدرجة)\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"report_date\",\"label\":{\"en\":\"Date of the auditor's report\",\"ar\":\"تاريخ تقرير المراجع\"},\"type\":\"date\",\"required\":true},{\"id\":\"assembly_deadline\",\"label\":{\"en\":\"File assembly deadline (within 60 days of the report date)\",\"ar\":\"الموعد النهائي لتجميع الملف (خلال 60 يومًا من تاريخ التقرير)\"},\"type\":\"date\",\"required\":true}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"],\"eqr\":true},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
  ];

  public func get(id : Text) : ?Text {
    for ((k, v) in FORMS.vals()) { if (k == id) return ?v };
    null
  };
};
