{\"id\":\"response\",\"label\":{\"en\":\"Planned response\",\"ar\":\"الاستجابة المخططة\"},\"type\":\"textarea\",\"required\":false}]}],\"note\":{\"en\":\"Balances are read from the latest accepted trial balance and frozen when the paper is prepared; a later import marks them as drifted.\",\"ar\":\"تُقرأ الأرصدة من أحدث ميزان مراجعة مقبول وتُثبت عند إعداد الورقة؛ ويؤدي استيراد لاحق إلى وسمها بأنها تغيرت.\"}},{\"id\":\"p_ppe_001\",\"title\":{\"en\":\"P-PPE-001 Fixed asset register reconciliation\",\"ar\":\"P-PPE-001 مطابقة سجل الأصول الثابتة\"},\"fields\":[{\"id\":\"p_ppe_001_work\",\"label\":{\"en\":\"Work performed\",\"ar\":\"العمل المنفذ\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_ppe_001_result\",\"label\":{\"en\":\"Results and exceptions\",\"ar\":\"النتائج والاستثناءات\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_ppe_001_samples\",\"label\":{\"en\":\"Samples recorded for this procedure\",\"ar\":\"العينات المسجلة لهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-SAMPLE.for.P-PPE-001\",\"readonly\":true},{\"id\":\"p_ppe_001_evidence\",\"label\":{\"en\":\"Evidence links citing this procedure\",\"ar\":\"روابط الأدلة التي تستشهد بهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-EVIDENCE-LINK.for.P-PPE-001\",\"readonly\":true},{\"id\":\"p_ppe_001_conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"performed_no_exception\",\"label\":{\"en\":\"Performed, no exception\",\"ar\":\"نُفذ دون استثناء\"}},{\"value\":\"performed_exception\",\"label\":{\"en\":\"Performed, exception noted\",\"ar\":\"نُفذ مع ملاحظة استثناء\"}},{\"value\":\"not_applicable\",\"label\":{\"en\":\"Not applicable, reason stated\",\"ar\":\"لا ينطبق، مع بيان السبب\"}}]}],\"note\":{\"en\":\"Agree the register to the ledger and the movements schedule.\",\"ar\":\"Agree the register to the ledger and the movements schedule.\"}},{\"id\":\"p_ppe_00