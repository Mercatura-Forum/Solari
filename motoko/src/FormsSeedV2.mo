only\":true},{\"id\":\"p_tre_009_conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"performed_no_exception\",\"label\":{\"en\":\"Performed, no exception\",\"ar\":\"نُفذ دون استثناء\"}},{\"value\":\"performed_exception\",\"label\":{\"en\":\"Performed, exception noted\",\"ar\":\"نُفذ مع ملاحظة استثناء\"}},{\"value\":\"not_applicable\",\"label\":{\"en\":\"Not applicable, reason stated\",\"ar\":\"لا ينطبق، مع بيان السبب\"}}]}],\"note\":{\"en\":\"Obtain evidence over translation of foreign balances and derivative accounting.\",\"ar\":\"Obtain evidence over translation of foreign balances and derivative accounting.\"}},{\"id\":\"p_tre_010\",\"title\":{\"en\":\"P-TRE-010 Cash flow statement and liquidity disclosures\",\"ar\":\"P-TRE-010 قائمة التدفقات النقدية وإفصاحات السيولة\"},\"fields\":[{\"id\":\"p_tre_010_work\",\"label\":{\"en\":\"Work performed\",\"ar\":\"العمل المنفذ\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_tre_010_result\",\"label\":{\"en\":\"Results and exceptions\",\"ar\":\"النتائج والاستثناءات\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_tre_010_samples\",\"label\":{\"en\":\"Samples recorded for this procedure\",\"ar\":\"العينات المسجلة لهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-SAMPLE.for.P-TRE-010\",\"readonly\":true},{\"id\":\"p_tre_010_evidence\",\"label\":{\"en\":\"Evidence links citing this procedure\",\"ar\":\"روابط الأدلة التي تستشهد بهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-EVIDENCE-LINK.for.P-TRE-010\",\"readonly\":true},{\"id\":\"p_tre_010_conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"performed_no_exception\",\"label\":{\"en\":\"Performed, no exception\",\"ar\":\"نُفذ دون استثناء\"}},{\"value\":\"performed_exception\",\"label\":{\"en\":\"Performed, exception noted\",\"ar\":\"نُفذ مع ملاحظة استثناء\"}},{\"value\":\"not_applicable\",\"label\":{\"en\":\"Not applicable, reason stated\",\"ar\":\"لا ينطبق، مع بيان السبب\"}}]}],\"note\":{\"en\":\"Obtain evidence that the cash flow statement and liquidity disclosures are correct.\",\"ar\":\"Obtain evidence that the cash flow statement and liquidity disclosures are correct.\"}},{\"id\":\"sch_bor\",\"title\":{\"en\":\"Movement schedule: Borrowings (LS-BORNC)\",\"ar\":\"جدول الحركة: Borrowings (LS-BORNC)\"},\"fields\":[{\"id\":\"sch_bor\",\"label\":{\"en\":\"Borrowings movement schedule\",\"ar\":\"جدول حركة Borrowings\"},\"type\":\"table\",\"required\":false,\"columns\":[{\"id\":\"component\",\"label\":{\"en\":\"Component\",\"ar\":\"المكوّن\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"principal\",\"label\":{\"en\":\"Principal\",\"ar\":\"أصل القرض\"}},{\"value\":\"accrued_interest\",\"label\":{\"en\":\"Accrued interest\",\"ar\":\"الفوائد المستحقة\"}}]},{\"id\":\"opening\",\"label\":{\"en\":\"Opening balance\",\"ar\":\"الرصيد الافتتاحي\"},\"type\":\"money\",\"required\":true},{\"id\":\"additions\",\"label\":{\"en\":\"Drawdowns\",\"ar\":\"السحوبات\"},\"type\":\"money\",\"required\":false},{\"id\":\"disposals\",\"label\":{\"en\":\"Repayments\",\"ar\":\"السداد\"},\"type\":\"money\",\"required\":false},{\"id\":\"transfers\",\"label\":{\"en\":\"Transfers and reclassifications\",\"ar\":\"التحويلات وإعادة التبويب\"},\"type\":\"money\",\"required\":false},{\"id\":\"revaluation\",\"label\":{\"en\":\"Exchange differences\",\"ar\":\"فروق العملة\"},\"type\":\"money\",\"required\":false},{\"id\":\"other\",\"label\":{\"en\":\"Interest, fees and other\",\"ar\":\"الفوائد والرسوم وأخرى\"},\"type\":\"money\",\"required\":false},{\"id\":\"closing\",\"label\":{\"en\":\"Closing balance\",\"ar\":\"الرصيد الختامي\"},\"type\":\"money\",\"required\":true}]},{\"id\":\"sch_bor_difference\",\"label\":{\"en\":\"Difference between the closing total and the leadsheet\",\"ar\":\"الفرق بين الإجمالي الختامي والورقة الرئيسية\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.rollforward.schedules.SCH-BOR.difference\",\"readonly\":true},{\"id\":\"sch_bor_agrees\",\"label\":{\"en\":\"Schedule agrees to the leadsheet\",\"ar\":\"الجدول يتفق مع الورقة الرئيسية\"},\"type\":\"text\",\"required\":false,\"autofill\":\"paper.rollforward.schedules.SCH-BOR.agrees\",\"readonly\":true},{\"id\":\"sch_bor_opening_difference\",\"label\":{\"en\":\"Difference between the opening total and the prior period\",\"ar\":\"الفرق بين الإجمالي الافتتاحي والفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.rollforward.schedules.SCH-BOR.opening_difference\",\"readonly\":true}],\"note\":{\"en\":\"Principal and accrued interest reconciled from the opening to the closing balance, the reconciliation of liabilities arising from financing activities. Required by IAS 7.44A. Closing balance = opening + additions - disposals + transfers + revaluation + other for every component. The closing total must equal the adjusted balance of Borrowings (non-current) (LS-BORNC) read above; the paper computes the schedule and shows the difference.\",\"ar\":\"يشترطه IAS 7.44A. الرصيد الختامي = الافتتاحي + الإضافات - الاستبعادات + التحويلات + إعادة التقييم + أخرى لكل مكوّن. يجب أن يساوي الإجمالي الختامي الرصيد المعدّل لـ Borrowings (non-current) (LS-BORNC) المقروء أعلاه؛ وتحسب الورقة الجدول وتعرض الفرق.\"}}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"computation\":\"rollforward\",\"version\":2,\"ar_status\":\"draft_pending_review\"}"),
    ("F37-EQUITY", "{\"id\":\"F37-EQUITY\",\"number\":37,\"kind\":\"worksheet\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Equity working paper\",\"ar\":\"ورقة عمل حقوق الملكية\"},\"purpose\":{\"en\":\"Document every substantive procedure of the equity cycle: the work, the results, the evidence and the conclusion, against the balances the trial balance holds.\",\"ar\":\"توثيق كل إجراء أساسي في دورة حقوق الملكية: العمل والنتائج والأدلة والاستنتاج، مقابل الأرصدة الواردة في ميزان المراجعة.\"},\"procedures\":[\"P-EQY-001\",\"P-EQY-002\",\"P-EQY-003\",\"P-EQY-004\",\"P-EQY-005\"],\"standards\":[\"ISA-330\",\"ISA-500\",\"ISA-560\",\"ISA-600\",\"ISA-700\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"balances\",\"title\":{\"en\":\"Balances, materiality and risks\",\"ar\":\"الأرصدة والأهمية النسبية والمخاطر\"},\"fields\":[{\"id\":\"performance_materiality\",\"label\":{\"en\":\"Performance materiality\",\"ar\":\"مادية الأداء\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.performance\",\"readonly\":true},{\"id\":\"clearly_trivial\",\"label\":{\"en\":\"Clearly trivial threshold\",\"ar\":\"حد المبالغ التافهة بشكل واضح\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.clearly_trivial\",\"readonly\":true},{\"id\":\"ls_scap\",\"label\":{\"en\":\"Share capital and premium (LS-SCAP)\",\"ar\":\"Share capital and premium (LS-SCAP)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-SCAP\",\"readonly\":true},{\"id\":\"ls_scap_prior\",\"label\":{\"en\":\"Share capital and premium, prior period\",\"ar\":\"Share capital and premium، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-SCAP.prior\",\"readonly\":true},{\"id\":\"ls_res\",\"label\":{\"en\":\"Reserves (LS-RES)\",\"ar\":\"Reserves (LS-RES)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-RES\",\"readonly\":true},{\"id\":\"ls_res_prior\",\"label\":{\"en\":\"Reserves, prior period\",\"ar\":\"Reserves، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-RES.prior\",\"readonly\":true},{\"id\":\"ls_re\",\"label\":{\"en\":\"Retained earnings (LS-RE)\",\"ar\":\"Retained earnings (LS-RE)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-RE\",\"readonly\":true},{\"id\":\"ls_re_prior\",\"label\":{\"en\":\"Retained earnings, prior period\",\"ar\":\"Retained earnings، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-RE.prior\",\"readonly\":true},{\"id\":\"ls_nci\",\"label\":{\"en\":\"Non-controlling interests (LS-NCI)\",\"ar\":\"Non-controlling interests (LS-NCI)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-NCI\",\"readonly\":true},{\"id\":\"ls_nci_prior\",\"label\":{\"en\":\"Non-controlling interests, prior period\",\"ar\":\"Non-controlling interests، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-NCI.prior\",\"readonly\":true},{\"id\":\"ls_oeq\",\"label\":{\"en\":\"Other equity (LS-OEQ)\",\"ar\":\"Other equity (LS-OEQ)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-OEQ\",\"readonly\":true},{\"id\":\"ls_oeq_prior\",\"label\":{\"en\":\"Other equity, prior period\",\"ar\":\"Other equity، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-OEQ.prior\",\"readonly\":true},{\"id\":\"risks\",\"label\":{\"en\":\"Risks placed on this cycle by the risk register\",\"ar\":\"المخاطر الموضوعة على هذه الدورة في سجل المخاطر\"},\"type\":\"table\",\"required\":false,\"autofill\":\"form.F04-RISK-REGISTER.risks\",\"readonly\":true,\"columns\":[{\"id\":\"risk\",\"label\":{\"en\":\"Risk\",\"ar\":\"الخطر\"},\"type\":\"text\",\"required\":true},{\"id\":\"level\",\"label\":{\"en\":\"Level\",\"ar\":\"المستوى\"},\"type\":\"text\",\"required\":false},{\"id\":\"assertions\",\"label\":{\"en\":\"Assertions affected\",\"ar\":\"الإقرارات المتأثرة\"},\"type\":\"text\",\"required\":false},{\"id\":\"inherent_risk\",\"label\":{\"en\":\"Inherent risk\",\"ar\":\"الخطر الملازم\"},\"type\":\"text\",\"required\":false},{\"id\":\"significant\",\"label\":{\"en\":\"Significant risk\",\"ar\":\"خطر مهم\"},\"type\":\"text\",\"required\":false},{\"id\":\"control_risk\",\"label\":{\"en\":\"Control risk\",\"ar\":\"خطر الرقابة\"},\"type\":\"text\",\"required\":false},{\"id\":\"response\",\"label\":{\"en\":\"Planned response\",\"ar\":\"الاستجابة المخططة\"},\"type\":\"textarea\",\"required\":false}]}],\"note\":{\"en\":\"Balances are read from the latest accepted trial balance and frozen when the paper is prepared; a later import marks them as drifted.\",\"ar\":\"تُقرأ الأرصدة من أحدث ميزان مراجعة مقبول وتُثبت عند إعداد الورقة؛ ويؤدي استيراد لاحق إلى وسمها بأنها تغيرت.\"}},{\"id\":\"p_eqy_001\",\"title\":{\"en\":\"P-EQY-001 Share capital agreement to statutory records\",\"ar\":\"P-EQY-001 مطابقة رأس المال مع السجلات القانونية\"},\"fields\":[{\"id\":\"p_eqy_001_work\",\"label\":{\"en\":\"Work performed\",\"ar\":\"العمل المنفذ\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_eqy_001_result\",\"label\":{\"en\":\"Results and exceptions\",\"ar\":\"النتائج والاستثناءات\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_eqy_001_samples\",\"label\":{\"en\":\"Samples recorded for this procedure\",\"ar\":\"العينات المسجلة لهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-SAMPLE.for.P-EQY-001\",\"readonly\":true},{\"id\":\"p_eqy_001_evidence\",\"label\":{\"en\":\"Evidence links citing this procedure\",\"ar\":\"روابط الأدلة التي تستشهد بهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-EVIDENCE-LINK.for.P-EQY-001\",\"readonly\":true},{\"id\":\"p_eqy_001_conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"performed_no_exception\",\"label\":{\"en\":\"Performed, no exception\",\"ar\":\"نُفذ دون استثناء\"}},{\"value\":\"performed_exception\",\"label\":{\"en\":\"Performed, exception noted\",\"ar\":\"نُفذ مع ملاحظة استثناء\"}},{\"value\":\"not_applicable\",\"label\":{\"en\":\"Not applicable, reason stated\",\"ar\":\"لا ينطبق، مع بيان السبب\"}}]}],\"note\":{\"en\":\"Obtain evidence over issued capital and its changes.\",\"ar\":\"Obtain evidence over issued capital and its changes.\"}},{\"id\":\"p_eqy_002\",\"title\":{\"en\":\"P-EQY-002 Reserves and legal reserve movements\",\"ar\":\"P-EQY-002 حركة الاحتياطيات والاحتياطي القانوني\"},\"fields\":[{\"id\":\"p_eqy_002_work\",\"label\":{\"en\":\"Work performed\",\"ar\":\"العمل المنفذ\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_eqy_002_result\",\"label\":{\"en\":\"Results and exceptions\",\"ar\":\"النتائج والاستثناءات\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_eqy_002_samples\",\"label\":{\"en\":\"Samples recorded for this procedure\",\"ar\":\"العينات المسجلة لهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-SAMPLE.for.P-EQY-002\",\"readonly\":true},{\"id\":\"p_eqy_002_evidence\",\"label\":{\"en\":\"Evidence links citing this procedure\",\"ar\":\"روابط الأدلة التي تستشهد بهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-EVIDENCE-LINK.for.P-EQY-002\",\"readonly\":true},{\"id\":\"p_eqy_002_conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"performed_no_exception\",\"label\":{\"en\":\"Performed, no exception\",\"ar\":\"نُفذ دون استثناء\"}},{\"value\":\"performed_exception\",\"label\":{\"en\":\"Performed, exception noted\",\"ar\":\"نُفذ مع ملاحظة استثناء\"}},{\"value\":\"not_applicable\",\"label\":{\"en\":\"Not applicable, reason stated\",\"ar\":\"لا ينطبق، مع بيان السبب\"}}]}],\"note\":{\"en\":\"Obtain evidence that reserve movements comply with law, the articles and the framework.\",\"ar\":\"Obtain evidence that reserve movements comply with law, the articles and the framework.\"}},{\"id\":\"p_eqy_003\",\"title\":{\"en\":\"P-EQY-003 Dividends and retained earnings\",\"ar\":\"P-EQY-003 توزيعات الأرباح والأرباح المحتجزة\"},\"fields\":[{\"id\":\"p_eqy_003_work\",\"label\":{\"en\":\"Work performed\",\"ar\":\"العمل المنفذ\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_eqy_003_result\",\"label\":{\"en\":\"Results and exceptions\",\"ar\":\"النتائج والاستثناءات\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_eqy_003_samples\",\"label\":{\"en\":\"Samples recorded for this procedure\",\"ar\":\"العينات المسجلة لهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-SAMPLE.for.P-EQY-003\",\"readonly\":true},{\"id\":\"p_eqy_003_evidence\",\"label\":{\"en\":\"Evidence links citing this procedure\",\"ar\":\"روابط الأدلة التي تستشهد بهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-EVIDENCE-LINK.for.P-EQY-003\",\"readonly\":true},{\"id\":\"p_eqy_003_conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"performed_no_exception\",\"label\":{\"en\":\"Performed, no exception\",\"ar\":\"نُفذ دون استثناء\"}},{\"value\":\"performed_except