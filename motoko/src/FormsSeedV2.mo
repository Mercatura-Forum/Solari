quired.\"}},{\"id\":\"p_inv_007\",\"title\":{\"en\":\"P-INV-007 Inventory cut-off\",\"ar\":\"P-INV-007 الفصل الزمني للمخزون\"},\"fields\":[{\"id\":\"p_inv_007_work\",\"label\":{\"en\":\"Work performed\",\"ar\":\"العمل المنفذ\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_inv_007_result\",\"label\":{\"en\":\"Results and exceptions\",\"ar\":\"النتائج والاستثناءات\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_inv_007_samples\",\"label\":{\"en\":\"Samples recorded for this procedure\",\"ar\":\"العينات المسجلة لهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-SAMPLE.for.P-INV-007\",\"readonly\":true},{\"id\":\"p_inv_007_evidence\",\"label\":{\"en\":\"Evidence links citing this procedure\",\"ar\":\"روابط الأدلة التي تستشهد بهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-EVIDENCE-LINK.for.P-INV-007\",\"readonly\":true},{\"id\":\"p_inv_007_conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"performed_no_exception\",\"label\":{\"en\":\"Performed, no exception\",\"ar\":\"نُفذ دون استثناء\"}},{\"value\":\"performed_exception\",\"label\":{\"en\":\"Performed, exception noted\",\"ar\":\"نُفذ مع ملاحظة استثناء\"}},{\"value\":\"not_applicable\",\"label\":{\"en\":\"Not applicable, reason stated\",\"ar\":\"لا ينطبق، مع بيان السبب\"}}]}],\"note\":{\"en\":\"Ensure receipts and dispatches are recorded in the correct period consistently with payables and revenue.\",\"ar\":\"Ensure receipts and dispatches are recorded in the correct period consistently with payables and revenue.\"}},{\"id\":\"p_inv_008\",\"title\":{\"en\":\"P-INV-008 Cost of sales analytical procedures\",\"ar\":\"P-INV-008 الإجراءات التحليلية لتكلفة المبيعات\"},\"fields\":[{\"id\":\"p_inv_008_work\",\"label\":{\"en\":\"Work performed\",\"ar\":\"العمل المنفذ\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_inv_008_result\",\"label\":{\"en\":\"Results and exceptions\",\"ar\":\"النتائج والاستثناءات\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_inv_008_samples\",\"label\":{\"en\":\"Samples recorded for this procedure\",\"ar\":\"العينات المسجلة لهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-SAMPLE.for.P-INV-008\",\"readonly\":true},{\"id\":\"p_inv_008_evidence\",\"label\":{\"en\":\"Evidence links citing this procedure\",\"ar\":\"روابط الأدلة التي تستشهد بهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-EVIDENCE-LINK.for.P-INV-008\",\"readonly\":true},{\"id\":\"p_inv_008_flagged\",\"label\":{\"en\":\"Lines flagged by the analytical review paper\",\"ar\":\"البنود المعلَّمة في ورقة الفحص التحليلي\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"paper.analytical_review.lines_flagged\",\"readonly\":true},{\"id\":\"p_inv_008_conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"performed_no_exception\",\"label\":{\"en\":\"Performed, no exception\",\"ar\":\"نُفذ دون استثناء\"}},{\"value\":\"performed_exception\",\"label\":{\"en\":\"Performed, exception noted\",\"ar\":\"نُفذ مع ملاحظة استثناء\"}},{\"value\":\"not_applicable\",\"label\":{\"en\":\"Not applicable, reason stated\",\"ar\":\"لا ينطبق، مع بيان السبب\"}}]}],\"note\":{\"en\":\"Obtain evidence over cost of sales through gross margin expectations.\",\"ar\":\"Obtain evidence over cost of sales through gross margin expectations.\"}},{\"id\":\"p_inv_009\",\"title\":{\"en\":\"P-INV-009 Inventory presentation and pledges\",\"ar\":\"P-INV-009 عرض المخزون والرهون\"},\"fields\":[{\"id\":\"p_inv_009_work\",\"label\":{\"en\":\"Work performed\",\"ar\":\"العمل المنفذ\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_inv_009_result\",\"label\":{\"en\":\"Results and exceptions\",\"ar\":\"النتائج والاستثناءات\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_inv_009_samples\",\"label\":{\"en\":\"Samples recorded for this procedure\",\"ar\":\"العينات المسجلة لهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-SAMPLE.for.P-INV-009\",\"readonly\":true},{\"id\":\"p_inv_009_evidence\",\"label\":{\"en\":\"Evidence links citing this procedure\",\"ar\":\"روابط الأدلة التي تستشهد بهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-EVIDENCE-LINK.for.P-INV-009\",\"readonly\":true},{\"id\":\"p_inv_009_conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"performed_no_exception\",\"label\":{\"en\":\"Performed, no exception\",\"ar\":\"نُفذ دون استثناء\"}},{\"value\":\"performed_exception\",\"label\":{\"en\":\"Performed, exception noted\",\"ar\":\"نُفذ مع ملاحظة استثناء\"}},{\"value\":\"not_applicable\",\"label\":{\"en\":\"Not applicable, reason stated\",\"ar\":\"لا ينطبق، مع بيان السبب\"}}]}],\"note\":{\"en\":\"Evaluate disclosure and rights over inventory.\",\"ar\":\"Evaluate disclosure and rights over inventory.\"}},{\"id\":\"sch_inv\",\"title\":{\"en\":\"Movement schedule: Inventories (LS-INV)\",\"ar\":\"جدول الحركة: Inventories (LS-INV)\"},\"fields\":[{\"id\":\"sch_inv\",\"label\":{\"en\":\"Inventories movement schedule\",\"ar\":\"جدول حركة Inventories\"},\"type\":\"table\",\"required\":false,\"columns\":[{\"id\":\"component\",\"label\":{\"en\":\"Component\",\"ar\":\"المكوّن\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"raw_materials\",\"label\":{\"en\":\"Raw materials\",\"ar\":\"المواد الخام\"}},{\"value\":\"work_in_progress\",\"label\":{\"en\":\"Work in progress\",\"ar\":\"الإنتاج تحت التشغيل\"}},{\"value\":\"finished_goods\",\"label\":{\"en\":\"Finished goods\",\"ar\":\"الإنتاج التام\"}},{\"value\":\"write_down\",\"label\":{\"en\":\"Write-down to net realisable value\",\"ar\":\"التخفيض إلى صافي القيمة القابلة للتحقق\"}}]},{\"id\":\"opening\",\"label\":{\"en\":\"Opening balance\",\"ar\":\"الرصيد الافتتاحي\"},\"type\":\"money\",\"required\":true},{\"id\":\"additions\",\"label\":{\"en\":\"Purchases and production\",\"ar\":\"المشتريات والإنتاج\"},\"type\":\"money\",\"required\":false},{\"id\":\"disposals\",\"label\":{\"en\":\"Cost of sales\",\"ar\":\"تكلفة المبيعات\"},\"type\":\"money\",\"required\":false},{\"id\":\"transfers\",\"label\":{\"en\":\"Transfers and reclassifications\",\"ar\":\"التحويلات وإعادة التبويب\"},\"type\":\"money\",\"required\":false},{\"id\":\"revaluation\",\"label\":{\"en\":\"Revaluation or remeasurement\",\"ar\":\"إعادة التقييم أو إعادة القياس\"},\"type\":\"money\",\"required\":false},{\"id\":\"other\",\"label\":{\"en\":\"Write-downs and reversals\",\"ar\":\"التخفيضات وعكسها\"},\"type\":\"money\",\"required\":false},{\"id\":\"closing\",\"label\":{\"en\":\"Closing balance\",\"ar\":\"الرصيد الختامي\"},\"type\":\"money\",\"required\":true}]},{\"id\":\"sch_inv_difference\",\"label\":{\"en\":\"Difference between the closing total and the leadsheet\",\"ar\":\"الفرق بين الإجمالي الختامي والورقة الرئيسية\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.rollforward.schedules.SCH-INV.difference\",\"readonly\":true},{\"id\":\"sch_inv_agrees\",\"label\":{\"en\":\"Schedule agrees to the leadsheet\",\"ar\":\"الجدول يتفق مع الورقة الرئيسية\"},\"type\":\"text\",\"required\":false,\"autofill\":\"paper.rollforward.schedules.SCH-INV.agrees\",\"readonly\":true},{\"id\":\"sch_inv_opening_difference\",\"label\":{\"en\":\"Difference between the opening total and the prior period\",\"ar\":\"الفرق بين الإجمالي الافتتاحي والفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.rollforward.schedules.SCH-INV.opening_difference\",\"readonly\":true}],\"note\":{\"en\":\"Each category of inventory reconciled from the opening to the closing balance, with the write-down provision. Required by IAS 2.36. Closing balance = opening + additions - disposals + transfers + revaluation + other for every component; Write-down to net realisable value is stated positive and deducted. The closing total must equal the adjusted balance of Inventories (LS-INV) read above; the paper computes the schedule and shows the difference.\",\"ar\":\"يشترطه IAS 2.36. الرصيد الختامي = الافتتاحي + الإضافات - الاستبعادات + التحويلات + إعادة التقييم + أخرى لكل مكوّن؛ ويُذكر المكوّن المقابل موجباً ويُخصم. يجب أن يساوي الإجمالي الختامي الرصيد المعدّل لـ Inventories (LS-INV) المقروء أعلاه؛ وتحسب الورقة الجدول وتعرض الفرق.\"}}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"computation\":\"rollforward\",\"version\":2,\"ar_status\":\"draft_pending_review\"}"),
    ("F35-PPE-INTANGIBLES", "{\"id\":\"F35-PPE-INTANGIBLES\",\"number\":35,\"kind\":\"worksheet\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Property, plant, equipment and intangibles working paper\",\"ar\":\"ورقة عمل الممتلكات والآلات والمعدات والأصول غير الملموسة\"},\"purpose\":{\"en\":\"Document every substantive procedure of the property, plant, equipment and intangibles cycle: the work, the results, the evidence and the conclusion, against the balances the trial balance holds.\",\"ar\":\"توثيق كل إجراء أساسي في دورة الممتلكات والآلات والمعدات والأصول غير الملموسة: العمل والنتائج والأدلة والاستنتاج، مقابل الأرصدة الواردة في ميزان المراجعة.\"},\"procedures\":[\"P-PPE-001\",\"P-PPE-002\",\"P-PPE-003\",\"P-PPE-004\",\"P-PPE-005\",\"P-PPE-006\",\"P-PPE-007\",\"P-PPE-008\",\"P-PPE-009\",\"P-PPE-010\"],\"standards\":[\"ISA-330\",\"ISA-500\",\"ISA-530\",\"ISA-540\",\"ISA-620\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"balances\",\"title\":{\"en\":\"Balances, materiality and risks\",\"ar\":\"الأرصدة والأهمية النسبية والمخاطر\"},\"fields\":[{\"id\":\"performance_materiality\",\"label\":{\"en\":\"Performance materiality\",\"ar\":\"مادية الأداء\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.performance\",\"readonly\":true},{\"id\":\"clearly_trivial\",\"label\":{\"en\":\"Clearly trivial threshold\",\"ar\":\"حد المبالغ التافهة بشكل واضح\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.clearly_trivial\",\"readonly\":true},{\"id\":\"ls_ppe\",\"label\":{\"en\":\"Property, plant and equipment (LS-PPE)\",\"ar\":\"Property, plant and equipment (LS-PPE)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-PPE\",\"readonly\":true},{\"id\":\"ls_ppe_prior\",\"label\":{\"en\":\"Property, plant and equipment, prior period\",\"ar\":\"Property, plant and equipment، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-PPE.prior\",\"readonly\":true},{\"id\":\"ls_invp\",\"label\":{\"en\":\"Investment property (LS-INVP)\",\"ar\":\"Investment property (LS-INVP)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-INVP\",\"readonly\":true},{\"id\":\"ls_invp_prior\",\"label\":{\"en\":\"Investment property, prior period\",\"ar\":\"Investment property، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-INVP.prior\",\"readonly\":true},{\"id\":\"ls_intg\",\"label\":{\"en\":\"Intangible assets and goodwill (LS-INTG)\",\"ar\":\"Intangible assets and goodwill (LS-INTG)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-INTG\",\"readonly\":true},{\"id\":\"ls_intg_prior\",\"label\":{\"en\":\"Intangible assets and goodwill, prior period\",\"ar\":\"Intangible assets and goodwill، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-INTG.prior\",\"readonly\":true},{\"id\":\"ls_rou\",\"label\":{\"en\":\"Right-of-use assets (LS-ROU)\",\"ar\":\"Right-of-use assets (LS-ROU)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-ROU\",\"readonly\":true},{\"id\":\"ls_rou_prior\",\"label\":{\"en\":\"Right-of-use assets, prior period\",\"ar\":\"Right-of-use 