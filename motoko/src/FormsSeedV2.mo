    ("F14-COMPLETION", "{\"id\":\"F14-COMPLETION\",\"number\":14,\"kind\":\"checklist\",\"phase\":\"completion\",\"version\":2,\"title\":{\"en\":\"Completion and sign-off\",\"ar\":\"إنجاز المراجعة والتوقيع\"},\"purpose\":{\"en\":\"Confirm that sufficient appropriate audit evidence supports the opinion, that the partner has discharged the quality responsibilities, and that the file is ready for assembly.\",\"ar\":\"التأكد من أن ما يكفي من أدلة المراجعة المناسبة يؤيد الرأي، وأن الشريك قد وفى بمسؤوليات الجودة، وأن الملف جاهز للتجميع.\"},\"procedures\":[\"P-FSL-044\",\"P-FSL-045\",\"P-FSL-049\",\"P-FSL-050\"],\"standards\":[\"ISA-220\",\"ISA-230\",\"ISA-700\",\"ISQM-2\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"checklist\",\"title\":{\"en\":\"Completion checklist\",\"ar\":\"قائمة مراجعة الإنجاز\"},\"fields\":[{\"id\":\"open_review_notes\",\"label\":{\"en\":\"Review notes not yet cleared\",\"ar\":\"ملاحظات الفحص التي لم تُغلق بعد\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-REVIEW-NOTE.open\",\"readonly\":true},{\"id\":\"open_disclosures\",\"label\":{\"en\":\"Disclosure checklist items applicable and not yet disclosed\",\"ar\":\"بنود قائمة الإفصاح المنطبقة ا