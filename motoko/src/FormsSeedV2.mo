trols: Financial-statement level and entity-wide (FSL)\",\"ar\":\"الضوابط: Financial-statement level and entity-wide (FSL)\"},\"fields\":[{\"id\":\"controls_fsl\",\"label\":{\"en\":\"Controls of the financial-statement level and entity-wide cycle in the register\",\"ar\":\"ضوابط دورة Financial-statement level and entity-wide في السجل\"},\"type\":\"table\",\"required\":false,\"autofill\":\"controls.FSL\",\"readonly\":true,\"columns\":[{\"id\":\"name\",\"label\":{\"en\":\"Control\",\"ar\":\"الضابط\"},\"type\":\"text\",\"required\":false},{\"id\":\"assertions\",\"label\":{\"en\":\"Assertions\",\"ar\":\"الإقرارات\"},\"type\":\"text\",\"required\":false},{\"id\":\"type\",\"label\":{\"en\":\"Type\",\"ar\":\"النوع\"},\"type\":\"text\",\"required\":false},{\"id\":\"frequency\",\"label\":{\"en\":\"Frequency\",\"ar\":\"التكرار\"},\"type\":\"text\",\"required\":false},{\"id\":\"design\",\"label\":{\"en\":\"Design\",\"ar\":\"التصميم\"},\"type\":\"text\",\"required\":false},{\"id\":\"implementation\",\"label\":{\"en\":\"Implementation\",\"ar\":\"التطبيق\"},\"type\":\"text\",\"required\":false},{\"id\":\"test_result\",\"label\":{\"en\":\"Test result\",\"ar\":\"نتيجة الاختبار\"},\"type\":\"text\",\"required\":false},{\"id\":\"relied_on\",\"label\":{\"en\":\"Relied on\",\"ar\":\"معتمد عليه\"},\"type\":\"text\",\"required\":false}]}],\"note\":{\"en\":\"Read live from the control register; frozen when the paper is prepared, so a control changed afterwards drifts it.\",\"ar\":\"تُقرأ مباشرة من سجل الضوابط وتُثبت عند إعداد الورقة، فيؤدي تغيير ضابط بعدها إلى انحرافها.\"}},{\"id\":\"controls_gitc\",\"title\":{\"en\":\"General IT controls: access, change and operations\",\"ar\":\"الضوابط العامة لتقنية المعلومات: الوصول والتغيير والتشغيل\"},\"fields\":[{\"id\":\"controls_gitc\",\"label\":{\"en\":\"General IT controls in the register\",\"ar\":\"الضوابط العامة لتقنية المعلومات في السجل\"},\"type\":\"table\",\"required\":false,\"autofill\":\"controls.GITC\",\"readonly\":true,\"columns\":[{\"id\":\"name\",\"label\":{\"en\":\"Control\",\"ar\":\"الضابط\"},\"type\":\"text\",\"required\":false},{\"id\":\"gitc_area\",\"label\":{\"en\":\"Area\",\"ar\":\"المجال\"},\"type\":\"text\",\"required\":false},{\"id\":\"design\",\"label\":{\"en\":\"Design\",\"ar\":\"التصميم\"},\"type\":\"text\",\"required\":false},{\"id\":\"implementation\",\"label\":{\"en\":\"Implementation\",\"ar\":\"التطبيق\"},\"type\":\"text\",\"required\":false},{\"id\":\"test_result\",\"label\":{\"en\":\"Test result\",\"ar\":\"نتيجة الاختبار\"},\"type\":\"text\",\"required\":false},{\"id\":\"relied_on\",\"label\":{\"en\":\"Relied on\",\"ar\":\"معتمد عليه\"},\"type\":\"text\",\"required\":false}]},{\"id\":\"reliance_gaps\",\"label\":{\"en\":\"Reliance without an effective test (open)\",\"ar\":\"الاعتماد دون اختبار فعال (مفتوح)\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"controls.gaps\",\"readonly\":true}],\"note\":{\"en\":\"A control the audit relies on whose test is not effective, or a risk whose relied-on controls have no effective test, is counted here until it is resolved; the count is live and never frozen.\",\"ar\":\"يُحسب هنا الضابط المعتمد عليه الذي لم يُختبر بفعالية، أو الخطر الذي لا يملك ضوابطه المعتمد عليها اختباراً فعالاً، حتى يُحل؛ والعدد حي ولا يُثبت.\"}}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":2,\"ar_status\":\"draft_pending_review\"}"),
    ("F22-GROUP-AUDIT", "{\"id\":\"F22-GROUP-AUDIT\",\"number\":22,\"kind\":\"worksheet\",\"phase\":\"planning\",\"version\":2,\"title\":{\"en\":\"Group audit plan and instructions to component auditors\",\"ar\":\"خطة مراجعة المجموعة والتعليمات إلى مراجعي المكونات\"},\"purpose\":{\"en\":\"Set the group audit strategy: the components and their scope, component performance materiality checked against the group's, the significant risks at group level, the instructions and communications with component auditors, and the group completion.\",\"ar\":\"وضع استراتيجية مراجعة المجموعة: المكونات ونطاقها، ومادية الأداء للمكونات مقابل مادية المجموعة، والمخاطر المهمة على مستوى المجموعة، والتعليمات والاتصالات مع مراجعي المكونات، وإنجاز مراجعة المجموعة.\"},\"procedures\":[\"P-FSL-021\",\"P-FSL-048\"],\"standards\":[\"ISA-600\",\"ISA-320\",\"ISA-330\"],\"computation\":\"component_materiality\",\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"group\",\"title\":{\"en\":\"The group\",\"ar\":\"المجموعة\"},\"fields\":[{\"id\":\"structure\",\"label\":{\"en\":\"Group structure, consolidation process and the components identified\",\"ar\":\"هيكل المجموعة وعملية التوحيد والمكونات المحددة\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"ladder\",\"label\":{\"en\":\"Components on this file and their state\",\"ar\":\"المكونات في هذا الملف وحالتها\"},\"type\":\"table\",\"required\":false,\"autofill\":\"group.components\",\"readonly\":true,\"columns\":[{\"id\":\"name\",\"label\":{\"en\":\"Component\",\"ar\":\"المكون\"},\"type\":\"text\",\"required\":false},{\"id\":\"entity\",\"label\":{\"en\":\"Entity\",\"ar\":\"الكيان\"},\"type\":\"text\",\"required\":false},{\"id\":\"component_auditor\",\"label\":{\"en\":\"Component auditor\",\"ar\":\"مراجع المكون\"},\"type\":\"text\",\"required\":false},{\"id\":\"scope\",\"label\":{\"en\":\"Scope\",\"ar\":\"النطاق\"},\"type\":\"text\",\"required\":false},{\"id\":\"status\",\"label\":{\"en\":\"State\",\"ar\":\"الحالة\"},\"type\":\"text\",\"required\":false}]},{\"id\":\"group_overall\",\"label\":{\"en\":\"Group overall materiality\",\"ar\":\"الأهمية النسبية الإجمالية للمجموعة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.overall\",\"readonly\":true},{\"id\":\"group_performance\",\"label\":{\"en\":\"Group performance materiality\",\"ar\":\"مادية الأداء للمجموعة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.performance\",\"readonly\":true},{\"id\":\"group_clearly_trivial\",\"label\":{\"en\":\"Group clearly trivial threshold\",\"ar\":\"حد المبالغ التافهة للمجموعة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.clearly_trivial\",\"readonly\":true}]},{\"id\":\"materiality\",\"title\":{\"en\":\"Component materiality\",\"ar\":\"الأهمية النسبية للمكونات\"},\"fields\":[{\"id\":\"components\",\"label\":{\"en\":\"Component performance materiality and communication thresholds\",\"ar\":\"مادية الأداء للمكونات وحدود الإبلاغ\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"id\",\"label\":{\"en\":\"Component\",\"ar\":\"المكون\"},\"type\":\"text\",\"required\":true},{\"id\":\"name\",\"label\":{\"en\":\"Entity\",\"ar\":\"الكيان\"},\"type\":\"text\",\"required\":true},{\"id\":\"performance\",\"label\":{\"en\":\"Component performance materiality\",\"ar\":\"مادية الأداء للمكون\"},\"type\":\"money\",\"required\":true},{\"id\":\"threshold\",\"label\":{\"en\":\"Threshold for communicating misstatements\",\"ar\":\"حد الإبلاغ عن التحريفات\"},\"type\":\"money\",\"required\":true}]},{\"id\":\"all_compliant\",\"label\":{\"en\":\"Every component below the group's performance materiality and within the clearly trivial threshold\",\"ar\":\"كل المكونات دون مادية الأداء للمجموعة وضمن حد المبالغ التافهة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"paper.component_materiality.all_compliant\",\"readonly\":true},{\"id\":\"components_examined\",\"label\":{\"en\":\"Components checked\",\"ar\":\"المكونات التي تم فحصها\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"paper.component_materiality.components_examined\",\"readonly\":true}],\"note\":{\"en\":\"Compute the component materiality paper from the table; the check is frozen when the plan is prepared.\",\"ar\":\"تُحتسب ورقة الأهمية النسبية للمكونات من الجدول؛ ويُثبت الفحص عند إعداد الخطة.\"}},{\"id\":\"instructions\",\"title\":{\"en\":\"Instructions and communication\",\"ar\":\"التعليمات والاتصال\"},\"fields\":[{\"id\":\"significant_risks\",\"label\":{\"en\":\"Significant risks of material misstatement of the group financial statements\",\"ar\":\"المخاطر المهمة للتحريف الجوهري في القوائم المالية للمجموعة\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"work_requested\",\"label\":{\"en\":\"Work requested from component auditors, by component\",\"ar\":\"العمل المطلوب من مراجعي المكونات، حسب المكون\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"reporting_deadline\",\"label\":{\"en\":\"Reporting deadline for component auditors\",\"ar\":\"الموعد النهائي لتقارير مراجعي المكونات\"},\"type\":\"date\",\"required\":true},{\"id\":\"auditor_evaluations\",\"label\":{\"en\":\"Component auditors evaluated before they are instructed (ISA 600.26 to .28, .32 to .34)\",\"ar\":\"مراجعو المكونات الذين تم تقييمهم قبل إصدار التعليمات إليهم (معيار 600 فقرات 26 إلى 28 و32 إلى 34)\"},\"type\":\"table\",\"required\":false,\"autofill\":\"group.auditors\",\"readonly\":true,\"columns\":[{\"id\":\"component\",\"label\":{\"en\":\"Component\",\"ar\":\"المكون\"},\"type\":\"text\",\"required\":false},{\"id\":\"firm\",\"label\":{\"en\":\"Firm\",\"ar\":\"المكتب\"},\"type\":\"text\",\"required\":false},{\"id\":\"independence\",\"label\":{\"en\":\"Independence\",\"ar\":\"الاستقلال\"},\"type\":\"text\",\"required\":false},{\"id\":\"evaluation\",\"label\":{\"en\":\"Evaluation\",\"ar\":\"التقييم\"},\"type\":\"text\",\"required\":false},{\"id\":\"involvement\",\"label\":{\"en\":\"Involvement\",\"ar\":\"المشاركة\"},\"type\":\"text\",\"required\":false}]},{\"id\":\"involvement\",\"label\":{\"en\":\"Group team's involvement in the component auditors' work\",\"ar\":\"مشاركة فريق المجموعة في عمل مراجعي المكونات\"},\"type\":\"textarea\",\"required\":true}]},{\"id\":\"completion\",\"title\":{\"en\":\"Group completion\",\"ar\":\"إنجاز مراجعة المجموعة\"},\"fields\":[{\"id\":\"evaluation\",\"label\":{\"en\":\"Evaluation of component auditors' reports and the sufficiency of group evidence\",\"ar\":\"تقييم تقارير مراجعي المكونات وكفاية أدلة المجموعة\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"eliminations\",\"label\":{\"en\":\"Consolidation eliminations booked, by leadsheet: the elimination entries of the adjusted trial balance (IFRS 10.B86)\",\"ar\":\"استبعادات التوحيد المقيدة حسب الورقة الرئيسية: قيود الاستبعاد في ميزان المراجعة المعدّل (المعيار الدولي 10 فقرة ب86)\"},\"type\":\"table\",\"required\":false,\"autofill\":\"adjustments.eliminations\",\"readonly\":true,\"columns\":[{\"id\":\"leadsheet\",\"label\":{\"en\":\"Leadsheet\",\"ar\":\"الورقة الرئيسية\"},\"type\":\"text\",\"required\":false},{\"id\":\"name\",\"label\":{\"en\":\"Name\",\"ar\":\"الاسم\"},\"type\":\"text\",\"required\":false},{\"id\":\"amount\",\"label\":{\"en\":\"Eliminated (debit less credit)\",\"ar\":\"المستبعد (المدين ناقص الدائن)\"},\"type\":\"money\",\"required\":false},{\"id\":\"entries\",\"label\":{\"en\":\"Entries\",\"ar\":\"القيود\"},\"type\":\"integer\",\"required\":false}]},{\"id\":\"eliminations_count\",\"label\":{\"en\":\"Leadsheets touched by eliminations\",\"ar\":\"الأوراق الرئيسية التي مستها الاستبعادات\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"adjustments.eliminations_count\",\"readonly\":true},{\"id\":\"intragroup_agreed\",\"label\":{\"en\":\"Intra-group balances and transactions agreed between components before elimination\",\"ar\":\"تمت مطابقة الأرصدة والمعاملات داخل المجموعة بين المكونات قبل الاستبعاد\"},\"type\":\"yesno\",\"required\":false},{\"id\":\"uniform_policies\",\"label\":{\"en\":\"Uniform accounting policies applied across the components, or adjusted for on consolidation\",\"ar\":\"طُبقت سياسات محاسبية موحدة عبر المكونات، أو عُدّلت عند التوحيد\"},\"type\":\"yesno\",\"required\":false},{\"id\":\"consolidation\",\"label\":{\"en\":\"Consolidation adjustments and reclassifications tested\",\"ar\":\"تسويات التوحيد وإعادة التبويب المختبرة\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"select\",\"required\":false,\"options\":[{\"value\":\"sufficient\",\"label\":{\"en\":\"Sufficient appropriate evidence obtained for the group opinion\",\"ar\":\"تم الحصول على ما يكفي من الأدلة المناسبة لرأي المجموعة\"}},{\"value\":\"not_yet\",\"label\":{\"en\":\"Not yet: component work outstanding\",\"ar\":\"ليس بعد: عمل المكونات لم يكتمل\"}}]}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"ar_status\":\"draft_pending_review\"}"),
    ("F31-REVENUE-RECEIVABLES", "{\"id\":\"F31-REVENUE-RECEIVABLES\",\"number\":31,\"kind\":\"worksheet\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Revenue and receivables working paper\",\"ar\":\"ورقة عمل الإيرادات والمدينين\"},\"purpose\":{\"en\":\"Document every substantive procedure of the revenue and receivables cycle: the work, the results, the evidence and the conclusion, against the balances the trial balance holds.\",\"ar\":\"توثيق كل إجراء أساسي في دورة الإيرادات والمدينين: العمل والنتائج والأدلة والاستنتاج، مقابل الأرصدة الواردة في ميزان المراجعة.\"},\"procedures\":[\"P-REV-004\",\"P-REV-005\",\"P-REV-006\",\"P-REV-007\",\"P-REV-008\",\"P-REV-009\",\"P-REV-010\",\"P-REV-011\",\"P-REV-012\",\"P-REV-013\"],\"standards\":[\"ISA-330\",\"ISA-505\",\"ISA-520\",\"ISA-530\",\"ISA-540\",\"ISA-240\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"balances\",\"title\":{\"en\":\"Balances, materiality and risks\",\"ar\":\"الأرصدة والأهمية النسبية والمخاطر\"},\"fields\":[{\"id\":\"performance_materiality\",\"label\":{\"en\":\"Performance materiality\",\"ar\":\"مادية الأداء\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.performance\",\"readonly\":true},{\"id\":\"clearly_trivial\",\"label\":{\"en\":\"Clearly trivial threshold\",\"ar\":\"حد المبالغ التافهة بشكل واضح\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.clearly_trivial\",\"readonly\":true},{\"id\":\"ls_recnc\",\"label\":{\"en\":\"Non-current receivables (LS-RECNC)\",\"ar\":\"Non-current receivables (LS-RECNC)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-RECNC\",\"readonly\":true},{\"id\":\"ls_recnc_prior\",\"label\":{\"en\":\"Non-current receivables, prior period\",\"ar\":\"Non-current receivables، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-RECNC.prior\",\"readonly\":true},{\"id\":\"ls_rec\",\"label\":{\"en\":\"Trade and other receivables (LS-REC)\",\"ar\":\"Trade and other receivables (LS-REC)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-REC\",\"readonly\":true},{\"id\":\"ls_rec_prior\",\"label\":{\"en\":\"Trade and other receivables, prior period\",\"ar\":\"Trade and other receivables، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-REC.prior\",\"readonly\":true},{\"id\":\"ls_ctra\",\"label\":{\"en\":\"Contract assets and accrued income (LS-CTRA)\",\"ar\":\"Contract assets and accrued income (LS-CTRA)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-CTRA\",\"readonly\":true},{\"id\":\"ls_ctra_prior\",\"label\":{\"en\":\"Contract assets and accrued income, prior period\",\"ar\":\"Contract assets and accrued income، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-CTRA.prior\",\"readonly\":true},{\"id\":\"ls_ctrl\",\"label\":{\"en\":\"Contract liabilities and deferred revenue (LS-CTRL)\",\"ar\":\"Contract liabilities and deferred revenue (LS-CTRL)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-CTRL\",\"readonly\":true},{\"id\":\"ls_ctrl_prior\",\"label\":{\"en\":\"Contract liabilities and deferred revenue, prior period\",\"ar\":\"Contract liabilities and deferred revenue، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-CTRL.prior\",\"readonly\":true},{\"id\":\"ls_rev\",\"label\":{\"en\":\"Revenue (LS-REV)\",\"ar\":\"Revenue (LS-REV)\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-REV\",\"readonly\":true},{\"id\":\"ls_rev_prior\",\"label\":{\"en\":\"Revenue, prior period\",\"ar\":\"Revenue، الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.LS-REV.prior\",\"readonly\":true},{\"id\":\"risks\",\"label\":{\"en\":\"Risks placed on this cycle by the risk register\",\"ar\":\"المخاطر الموضوعة على هذه الدورة في سجل المخاطر\"},\"type\":\"table\",\"required\":false,\"autofill\":\"form.F04-RISK-REGISTER.risks\",\"readonly\":true,\"columns\":[{\"id\":\"risk\",\"label\":{\"en\":\"Risk\",\"ar\":\"الخطر\"},\"type\":\"text\",\"required\":true},{\"id\":\"level\",\"label\":{\"en\":\"Level\",\"ar\":\"المستوى\"},\"type\":\"text\",\"required\":false},{\"id\":\"assertions\",\"label\":{\"en\":\"Assertions affected\",\"ar\":\"الإقرارات المتأثرة\"},\"type\":\"text\",\"required\":false},{\"id\":\"inherent_risk\",\"label\":{\"en\":\"Inherent risk\",\"ar\":\"الخطر الملازم\"},\"type\":\"text\",\"required\":false},{\"id\":\"significant\",\"label\":{\"en\":\"Significant risk\",\"ar\":\"خطر مهم\"},\"type\":\"text\",\"required\":false},{\"id\":\"control_risk\",\"label\":{\"en\":\"Control risk\",\"ar\":\"خطر الرقابة\"},\"type\":\"text\",\"required\":false},{\"id\":\"response\",\"label\":{\"en\":\"Planned response\",\"ar\":\"الاستجابة المخططة\"},\"type\":\"textarea\",\"required\":false}]}],\"note\":{\"en\":\"Balances are read from the latest accepted trial balance and frozen when the paper is prepared; a later import marks them as drifted.\",\"ar\":\"تُقرأ الأرصدة من أحدث ميزان مراجعة مقبول وتُثبت عند إعداد الورقة؛ ويؤدي استيراد لاحق إلى وسمها بأنها تغيرت.\"}},{\"id\":\"p_rev_004\",\"title\":{\"en\":\"P-REV-004 Substantive analytical procedure on revenue\",\"ar\":\"P-REV-004 الإجراء التحليلي الأساسي للإيرادات\"},\"fields\":[{\"id\":\"p_rev_004_work\",\"label\":{\"en\":\"Work performed\",\"ar\":\"العمل المنفذ\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_rev_004_result\",\"label\":{\"en\":\"Results and exceptions\",\"ar\":\"النتائج والاستثناءات\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_rev_004_samples\",\"label\":{\"en\":\"Samples recorded for this procedure\",\"ar\":\"العينات المسجلة لهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-SAMPLE.for.P-REV-004\",\"readonly\":true},{\"id\":\"p_rev_004_evidence\",\"label\":{\"en\":\"Evidence links citing this procedure\",\"ar\":\"روابط الأدلة التي تستشهد بهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-EVIDENCE-LINK.for.P-REV-004\",\"readonly\":true},{\"id\":\"p_rev_004_flagged\",\"label\":{\"en\":\"Lines flagged by the analytical review paper\",\"ar\":\"البنود المعلَّمة في ورقة الفحص التحليلي\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"paper.analytical_review.lines_flagged\",\"readonly\":true},{\"id\":\"p_rev_004_conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"performed_no_exception\",\"label\":{\"en\":\"Performed, no exception\",\"ar\":\"نُفذ دون استثناء\"}},{\"value\":\"performed_exception\",\"label\":{\"en\":\"Performed, exception noted\",\"ar\":\"نُفذ مع ملاحظة استثناء\"}},{\"value\":\"not_applicable\",\"label\":{\"en\":\"Not applicable, reason stated\",\"ar\":\"لا ينطبق، مع بيان السبب\"}}]}],\"note\":{\"en\":\"Obtain evidence over revenue occurrence, completeness and accuracy through a precise expectation.\",\"ar\":\"Obtain evidence over revenue occurrence, completeness and accuracy through a precise expectation.\"}},{\"id\":\"p_rev_005\",\"title\":{\"en\":\"P-REV-005 Revenue cut-off testing\",\"ar\":\"P-REV-005 اختبار الفصل الزمني للإيرادات\"},\"fi