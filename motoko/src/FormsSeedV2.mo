quired.\"}},{\"id\":\"p_inv_007\",\"title\":{\"en\":\"P-INV-007 Inventory cut-off\",\"ar\":\"P-INV-007 الفصل الزمني للمخزون\"},\"fields\":[{\"id\":\"p_inv_007_work\",\"label\":{\"en\":\"Work performed\",\"ar\":\"العمل المنفذ\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_inv_007_result\",\"label\":{\"en\":\"Results and exceptions\",\"ar\":\"النتائج والاستثناءات\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_inv_007_samples\",\"label\":{\"en\":\"Samples recorded for this procedure\",\"ar\":\"العينات المسجلة لهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-SAMPLE.for.P-INV-007\",\"readonly\":true},{\"id\":\"p_inv_007_evidence\",\"label\":{\"en\":\"Evidence links citing this procedure\",\"ar\":\"روابط الأدلة التي تستشهد بهذا الإجراء\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-EVIDENCE-LINK.for.P-INV-007\",\"readonly\":true},{\"id\":\"p_inv_007_conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"performed_no_exception\",\"label\":{\"en\":\"Performed, no exception\",\"ar\":\"نُفذ دون استثناء\"}},{\"value\":\"performed_exception\",\"label\":{\"en\":\"Performed, exception noted\",\"ar\":\"نُفذ مع ملاحظة استثناء\"}},{\"value\":\"not_applicable\",\"label\":{\"en\":\"Not applicable, reason stated\",\"ar\":\"لا ينطبق، مع بيان السبب\"}}]}],\"note\":{\"en\":\"Ensure receipts and dispatches are recorded in the correct period consistently with payables and revenue.\",\"ar\":\"Ensure receipts and dispatches are recorded in the correct period consistently with payables and revenue.\"}},{\"id\":\"p_inv_008\",\"title\":{\"en\":\"P-INV-008 Cost of sales analytical procedures\",\"ar\":\"P-INV-008 الإجراءات التحليلية لتكلفة المبيعات\"},\"fields\":[{\"id\":\"p_inv_008_work\",\"label\":{\"en\":\"Work performed\",\"ar\":\"العمل المنفذ\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"p_inv_008_result\",\"label\":{\"en\":\"Results and