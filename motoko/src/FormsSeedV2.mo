pe\":\"table\",\"required\":false,\"columns\":[{\"id\":\"component\",\"label\":{\"en\":\"Component\",\"ar\":\"المكوّن\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"retained_earnings\",\"label\":{\"en\":\"Retained earnings\",\"ar\":\"الأرباح المحتجزة\"}}]},{\"id\":\"opening\",\"label\":{\"en\":\"Opening balance\",\"ar\":\"الرصيد الافتتاحي\"},\"type\":\"money\",\"required\":true},{\"id\":\"additions\",\"label\":{\"en\":\"Profit for the year\",\"ar\":\"ربح السنة\"},\"type\":\"money\",\"required\":false},{\"id\":\"disposals\",\"label\":{\"en\":\"Dividends\",\"ar\":\"توزيعات الأرباح\"},\"type\":\"money\",\"required\":false},{\"id\":\"transfers\",\"label\":{\"en\":\"Transfers to and from reserves\",\"ar\":\"التحويلات من الاحتياطيات وإليها\"},\"type\":\"money\",\"required\":false},{\"id\":\"revaluation\",\"label\":{\"en\":\"Remeasurements recognised directly\",\"ar\":\"إعادة القياس المعترف بها مباشرة\"},\"type\":\"money\",\"required\":false},{\"id\":\"other\",\"label\":{\"en\":\"Other movements\",\"ar\":\"حركات أخرى\"},\"type\":\"money\",\"required\":false},{\"id\":\"closing\",\"label\":{\"en\":\"Closing balance\",\"ar\":\"الرصيد الختامي\"},\"type\":\"money\",\"required\":true}]},{\"id\":\"sch_re_difference\",\"label\":{\"en\":\"Difference between the closing total and the leadsheet\",\"ar\":\"الفرق بين الإجمالي الختامي والورقة الرئيسية\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.rollforward.schedules.SCH-RE.difference\",\"readonly\":true},{\"id\":\"sch_re_agrees\",\"label\":{\"en\":\"Schedule agrees to the leadsheet\",\"ar\":\"الجدول يتفق مع الورقة الرئيسية\"},\"type\":\"text\",\"required\":false,\"autofill\":\"paper.rollforward.schedules.SCH-RE.agrees\",\"readonly\":true},{\"id\":\"sch_re_opening_difference\",\"label\":{\"en\":\"Difference between the opening total and the prior period\",\"ar\":\"الفرق بين الإجمالي الافتتاحي والفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.rollforward.schedules.SCH-RE.opening_difference\",\"readonly\":true}],\"note\":{\"en\":\"Retained earnings reconciled from the opening to the closing balance, one component of the statement of changes in equity. Required by IAS 1.106. Closing balance = opening + additions - disposals + transfers + revaluation + other for every component. The closing total must equal the adjusted balance of Retained earnings (LS-RE) read above; the paper computes the schedule and shows the difference.\",\"ar\":\"يشترطه IAS 1.106. الرصيد الختامي = الافتتاحي + الإضافات - الاستبعادات + التحويلات + إعادة التقييم + أخرى لكل مكوّن. يجب أن يساوي الإجمالي الختامي الرصيد المعدّل لـ Retained earnings (LS-RE) المقروء أعلاه؛ وتحسب الورقة الجدول وتعرض الفرق.\"}}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"computation\":\"rollforward\",\"version\":2,\"ar_status\":\"draft_pending_review\"}"),
  ];

