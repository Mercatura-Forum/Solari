        ignore ok("save F35-PPE-INTANGIBLES", F.save(s, ff, P3, false, at, a, "F35-PPE-INTANGIBLES", j("{\"values\":{\"p_ppe_001_work\":\"Reconciled the fixed asset register to the ledger by class.\",\"p_ppe_001_result\":\"Reconciled.\",\"p_ppe_001_conclusion\":\"performed_no_exception\",\"p_ppe_002_work\":\"Vouched a monetary-unit sample of 25 additions to invoices, the capitalisation policy and physical existence.\",\"p_ppe_002_result\":\"Loom spare parts of EGP 0.6m capitalised that are consumables: reclassified to expense by management.\",\"p_ppe_002_conclusion\":\"performed_exception\",\"p_ppe_003_work\":\"Tested the disposal of the ring-spinning line to the contract, the customs record and the receipt; recalculated the gain.\",\"p_ppe_003_result\":\"Gain of EGP 3.1m correctly computed and presented.\",\"p_ppe_003_conclusion\":\"performed_no_exception\",\"p_ppe_004_work\":\"Inspected the 2024 looms and the disposal site during the count; inspected title deeds to the site.\",\"p_ppe_004_result\":\"Assets exist; title held.\",\"p_ppe_004_conclusion\":\"performed_no_exception\",\"p_ppe_005_work\":\"Recalculated depreciation by class from the register.\",\"p_ppe_005_result\":\"Within EGP 40,000 of the recorded charge.\",\"p_ppe_005_conclusion\":\"performed_no_exception\",\"p_ppe_006_work\":\"Considered impairment indicators: margins, the idle ring-spinning line (sold), energy tariffs.\",\"p_ppe_006_result\":\"No indicator beyond the disposed line.\",\"p_ppe_006_conclusion\":\"performed_no_exception\",\"p_ppe_007_work\":\"Reviewed the ERP licence and the software development costs.\",\"p_ppe_007_result\":\"Intangibles are licences amortised over the term; no development costs.\",\"p_ppe_007_conclusion\":\"performed_no_exception\",\"p_ppe_008_work\":\"Tested the Alexandria office lease: the lease liability and right-of-use asset recalculated.\",\"p_ppe_008_result\":\"Recalculated within EGP 12,000.\",\"p_ppe_008_conclusion\":\"performed_no_exception\",\"p_ppe_009_work\":\"Considered whether any property is investment property.\",\"p_ppe_009_result\":\"None held.\",\"p_ppe_009_conclusion\":\"not_applicable\",\"p_ppe_010_work\":\"Reviewed the presentation of non-current assets and the capital commitments (loom spares contract).\",\"p_ppe_010_result\":\"Commitments of EGP 4.2m disclosed.\",\"p_ppe_010_conclusion\":\"performed_no_exception\"}}")));
