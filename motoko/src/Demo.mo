        ignore ok("save F34-INVENTORY-COST", F.save(s, ff, P3, false, at, a, "F34-INVENTORY-COST", j("{\"values\":{\"p_inv_005_work\":\"Tested the weighted average cost of a monetary-unit sample of 40 items to auction invoices, the cost roll and the waste percentages recomputed from the mill reports.\",\"p_inv_005_result\":\"Waste on Ne 30/1 yarn recomputed at 11.2% against 10.5% in the roll; effect EGP 0.9m below performance materiality, recorded as a judgmental misstatement.\",\"p_inv_005_conclusion\":\"performed_exception\",\"p_inv_006_work\":\"Aged the fabric stock; compared cost with post-year-end prices; used the expert's grading for cotton.\",\"p_inv_006_result\":\"The slow-moving provision is understated by EGP 260,000 (round sum booked); carried to the evaluation of misstatements.\",\"p_inv_006_conclusion\":\"performed_exception\",\"p_inv_007_work\":\"Agreed the last receipts and dispatches recorded at the count to the ledger.\",\"p_inv_007_result\":\"Cut-off correct.\",\"p_inv_007_conclusion\":\"performed_no_exception\",\"p_inv_008_work\":\"Compared the gross margin by product line with the prior year and the budget.\",\"p_inv_008_result\":\"Yarn margin down with cotton bought at the 2024 peak; fabric margin stable; consistent with the cost work.\",\"p_inv_008_conclusion\":\"performed_no_exception\",\"p_inv_009_work\":\"Inspected the USD facility agreement for the pledge on cotton stocks; reviewed the presentation.\",\"p_inv_009_result\":\"Pledged cotton stocks disclosed in note 12.\",\"p_inv_009_conclusion\":\"performed_no_exception\"}}")));
