        ignore ok("save F36-TREASURY", F.save(s, ff, P3, false, at, a, "F36-TREASURY", j("{\"values\":{\"p_tre_002_work\":\"Tested the December bank reconciliations of all four accounts to statements and subsequent clearance.\",\"p_tre_002_result\":\"Reconciling items cleared in January.\",\"p_tre_002_conclusion\":\"performed_no_exception\",\"p_tre_003_work\":\"Counted petty cash at both mills on 31 December.\",\"p_tre_003_result\":\"Agreed to the ledger.\",\"p_tre_003_conclusion\":\"performed_no_exception\",\"p_tre_004_work\":\"Reviewed December and January transfers between accounts and large payments around the year end.\",\"p_tre_004_result\":\"No window dressing.\",\"p_tre_004_conclusion\":\"performed_no_exception\",\"p_tre_005_work\":\"Confirmed the USD facility and the EGP term loan with the banks; recalculated the interest cover covenant.\",\"p_tre_005_result\":\"Confirmed; covenant met with headroom of 1.4 times.\",\"p_tre_005_conclusion\":\"performed_no_exception\",\"p_tre_006_work\":\"Recalculated interest expense from the facility balances and rates.\",\"p_tre_006_result\":\"Within EGP 60,000.\",\"p_tre_006_conclusion\":\"performed_no_exception\",\"p_tre_007_work\":\"Recalculated the lease liability at the incremental borrowing rate.\",\"p_tre_007_result\":\"Agrees.\",\"p_tre_007_conclusion\":\"performed_no_exception\",\"p_tre_008_work\":\"Considered investments held.\",\"p_tre_008_result\":\"None beyond bank deposits, confirmed.\",\"p_tre_008_conclusion\":\"not_applicable\",\"p_tre_009_work\":\"Recalculated the translation of USD receivables, payables and the facility at the closing rate from the central bank; tested the realised differences on a sample.\",\"p_tre_009_result\":\"Closing rate agrees; net foreign-exchange loss of EGP 7.8m correctly computed.\",\"p_tre_009_conclusion\":\"performed_no_exception\",\"p_tre_010_work\":\"Agreed the cash flow statement to the movements in the balances and the liquidity disclosures to the facility terms.\",\"p_tre_010_result\":\"Agrees.\",\"p_tre_010_conclusion\":\"performed_no_exception\"}}")));
