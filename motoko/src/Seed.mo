7\",\"requirement_id\":\"ISA-220.39\",\"relation\":\"applied_at_engagement\"},{\"qm_requirement_id\":\"QM-51\",\"requirement_id\":\"ISA-220.39\",\"relation\":\"applied_at_engagement\"},{\"qm_requirement_id\":\"QM-55\",\"requirement_id\":\"ISA-260.17\",\"relation\":\"communicated_at_engagement\"}]"),
    ("quality_management_requirements", 72, "[{\"id\":\"QM-17\",\"requirement_id\":\"ISQM-1.17\",\"component_id\":\"QMC-LEAD\",\"item\":null,\"kind\":\"responsibility\",\"scope\":\"firm\",\"statement\":\"Comply with every requirement of ISQM 1 relevant to the firm's nature and circumstances.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"A documented relevance assessment for each requirement.\",\"record_type\":\"policy\"},{\"id\":\"QM-18\",\"requirement_id\":\"ISQM-1.18\",\"component_id\":\"QMC-LEAD\",\"item\":null,\"kind\":\"responsibility\",\"scope\":\"firm\",\"statement\":\"Those with ultimate and operational responsibility understand ISQM 1 and its application material.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Training and acknowledgement records for the responsible individuals.\",\"record_type\":\"assignment\"},{\"id\":\"QM-19\",\"requirement_id\":\"ISQM-1.19\",\"component_id\":\"QMC-LEAD\",\"item\":null,\"kind\":\"responsibility\",\"scope\":\"firm\",\"statement\":\"Design, implement and operate a system of quality management using professional judgment.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"The system description and its operating evidence.\",\"record_type\":\"policy\"},{\"id\":\"QM-20a\",\"requirement_id\":\"ISQM-1.20\",\"component_id\":\"QMC-LEAD\",\"item\":\"a\",\"kind\":\"responsibility\",\"scope\":\"firm\",\"statement\":\"Assign ultimate responsibility and accountability for the system to the chief executive, managing partner or managing board.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"A board or partnership resolution naming the individual or body.\",\"record_type\":\"assignment\"},{\"id\":\"QM-20b\",\"requirement_id\":\"ISQM-1.20\",\"component_id\":\"QMC-LEAD\",\"item\":\"b\",\"kind\":\"responsibility\",\"scope\":\"firm\",\"statement\":\"Assign operational responsibility for the system.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"The appointment record.\",\"record_type\":\"assignment\"},{\"id\":\"QM-20c\",\"requirement_id\":\"ISQM-1.20\",\"component_id\":\"QMC-LEAD\",\"item\":\"c\",\"kind\":\"responsibility\",\"scope\":\"firm\",\"statement\":\"Assign operational responsibility for compliance with independence requirements and for the monitoring and remediation process.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"The appointment records for both roles.\",\"record_type\":\"assignment\"},{\"id\":\"QM-21\",\"requirement_id\":\"ISQM-1.21\",\"component_id\":\"QMC-LEAD\",\"item\":null,\"kind\":\"responsibility\",\"scope\":\"firm\",\"statement\":\"Determine that those assigned have the experience, knowledge, influence, authority and time to fulfil their roles and understand their accountability.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"A suitability assessment for each responsible individual.\",\"record_type\":\"assignment\"},{\"id\":\"QM-22\",\"requirement_id\":\"ISQM-1.22\",\"component_id\":\"QMC-LEAD\",\"item\":null,\"kind\":\"responsibility\",\"scope\":\"firm\",\"statement\":\"Give those with operational responsibilities a direct line of communication to those with ultimate responsibility.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"The reporting-line description in the system documentation.\",\"record_type\":\"assignment\"},{\"id\":\"QM-23\",\"requirement_id\":\"ISQM-1.23\",\"component_id\":\"QMC-RISK\",\"item\":null,\"kind\":\"process\",\"scope\":\"firm\",\"statement\":\"Design and implement a risk assessment process that establishes quality objectives, identifies and assesses quality risks, and designs and implements responses.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"The process description and its outputs.\",\"record_type\":\"policy\"},{\"id\":\"QM-24\",\"requirement_id\":\"ISQM-1.24\",\"component_id\":\"QMC-RISK\",\"item\":null,\"kind\":\"process\",\"scope\":\"firm\",\"statement\":\"Establish the quality objectives ISQM 1 specifies and any additional objectives the firm needs.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"The objective register.\",\"record_type\":\"objective_register\"},{\"id\":\"QM-25\",\"requirement_id\":\"ISQM-1.25\",\"component_id\":\"QMC-RISK\",\"item\":null,\"kind\":\"process\",\"scope\":\"firm\",\"statement\":\"Identify and assess quality risks by understanding the conditions relating to the firm and its engagements and how they may adversely affect the objectives.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"The quality risk register with the assessment rationale.\",\"record_type\":\"risk_register\"},{\"id\":\"QM-26\",\"requirement_id\":\"ISQM-1.26\",\"component_id\":\"QMC-RISK\",\"item\":null,\"kind\":\"process\",\"scope\":\"firm\",\"statement\":\"Design and implement responses that are based on and responsive to the assessed quality risks, including the specified responses.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"The response register linking each response to its risks.\",\"record_type\":\"response_register\"},{\"id\":\"QM-27\",\"requirement_id\":\"ISQM-1.27\",\"component_id\":\"QMC-RISK\",\"item\":null,\"kind\":\"process\",\"scope\":\"firm\",\"statement\":\"Establish policies to identify information indicating that objectives, risks or responses need adding or changing, and act on it.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Change log of the objective, risk and response registers with triggering information.\",\"record_type\":\"policy\"},{\"id\":\"QM-28a\",\"requirement_id\":\"ISQM-1.28\",\"component_id\":\"QMC-GOV\",\"item\":\"a\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"The firm demonstrates a commitment to quality through a culture that recognises its public interest role, professional ethics, universal responsibility for quality, and quality in strategic decisions.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Leadership communications, tone-at-the-top statements, strategy documents.\",\"record_type\":\"policy\"},{\"id\":\"QM-28b\",\"requirement_id\":\"ISQM-1.28\",\"component_id\":\"QMC-GOV\",\"item\":\"b\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Leadership is responsible and accountable for quality.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"The accountability assignments and performance evaluations.\",\"record_type\":\"assignment\"},{\"id\":\"QM-28c\",\"requirement_id\":\"ISQM-1.28\",\"component_id\":\"QMC-GOV\",\"item\":\"c\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Leadership demonstrates commitment to quality through actions and behaviour.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Evidence of decisions and resourcing consistent with the commitment.\",\"record_type\":\"evaluation\"},{\"id\":\"QM-28d\",\"requirement_id\":\"ISQM-1.28\",\"component_id\":\"QMC-GOV\",\"item\":\"d\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"The organisational structure and assignment of roles, responsibilities and authority enable the system.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"The organisation chart and role descriptions.\",\"record_type\":\"assignment\"},{\"id\":\"QM-28e\",\"requirement_id\":\"ISQM-1.28\",\"component_id\":\"QMC-GOV\",\"item\":\"e\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Resource needs including financial resources are planned and allocated consistently with the commitment to quality.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Budget and resourcing plans.\",\"record_type\":\"policy\"},{\"id\":\"QM-29a\",\"requirement_id\":\"ISQM-1.29\",\"component_id\":\"QMC-ETH\",\"item\":\"a\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"The firm and its personnel understand and fulfil the relevant ethical requirements, including independence.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Ethics policies, training records, independence confirmations.\",\"record_type\":\"confirmation\"},{\"id\":\"QM-29b\",\"requirement_id\":\"ISQM-1.29\",\"component_id\":\"QMC-ETH\",\"item\":\"b\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Others subject to the ethical requirements, including the network, network firms, their personnel and service providers, understand and fulfil them.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Network and service provider ethics confirmations.\",\"record_type\":\"confirmation\"},{\"id\":\"QM-30a\",\"requirement_id\":\"ISQM-1.30\",\"component_id\":\"QMC-ACC\",\"item\":\"a\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Acceptance and continuance judgments rest on sufficient information about the engagement and the client's integrity and ethical values, and on the firm's ability to perform the engagement.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Acceptance and continuance assessments with partner approval.\",\"record_type\":\"evaluation\"},{\"id\":\"QM-30b\",\"requirement_id\":\"ISQM-1.30\",\"component_id\":\"QMC-ACC\",\"item\":\"b\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Financial and operational priorities do not lead to inappropriate acceptance or continuance judgments.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Fee and capacity considerations recorded separately from the acceptance decision.\",\"record_type\":\"policy\"},{\"id\":\"QM-31a\",\"requirement_id\":\"ISQM-1.31\",\"component_id\":\"QMC-PERF\",\"item\":\"a\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Engagement teams understand and fulfil their responsibilities, including the engagement partner's overall responsibility and sufficient involvement.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Engagement quality documentation by the partner.\",\"record_type\":\"file\"},{\"id\":\"QM-31b\",\"requirement_id\":\"ISQM-1.31\",\"component_id\":\"QMC-PERF\",\"item\":\"b\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Direction, supervision and review are appropriate to the engagement and its resources, with less experienced work directed, supervised and reviewed by more experienced members.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Review evidence in engagement files.\",\"record_type\":\"file\"},{\"id\":\"QM-31c\",\"requirement_id\":\"ISQM-1.31\",\"component_id\":\"QMC-PERF\",\"item\":\"c\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Engagement teams exercise professional judgment and, where applicable, professional scepticism.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Documented judgments and scepticism in engagement files.\",\"record_type\":\"file\"},{\"id\":\"QM-31d\",\"requirement_id\":\"ISQM-1.31\",\"component_id\":\"QMC-PERF\",\"item\":\"d\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Consultation on difficult or contentious matters is undertaken and the agreed conclusions implemented.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Consultation records.\",\"record_type\":\"file\"},{\"id\":\"QM-31e\",\"requirement_id\":\"ISQM-1.31\",\"component_id\":\"QMC-PERF\",\"item\":\"e\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Differences of opinion within the team or with the reviewer or others are brought to the firm's attention and resolved.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Differences-of-opinion resolution records.\",\"record_type\":\"file\"},{\"id\":\"QM-31f\",\"requirement_id\":\"ISQM-1.31\",\"component_id\":\"QMC-PERF\",\"item\":\"f\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Engagement documentation is assembled on a timely basis after the report date and is maintained and retained as law, ethics and standards require.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"File assembly and retention logs.\",\"record_type\":\"file\"},{\"id\":\"QM-32a\",\"requirement_id\":\"ISQM-1.32\",\"component_id\":\"QMC-RES\",\"item\":\"a\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Personnel are hired, developed and retained with the competence and capabilities to perform quality engagements and system activities.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Recruitment, development and retention records.\",\"record_type\":\"policy\"},{\"id\":\"QM-32b\",\"requirement_id\":\"ISQM-1.32\",\"component_id\":\"QMC-RES\",\"item\":\"b\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Personnel demonstrate commitment to quality, maintain competence, and are held accountable or recognised through evaluations, compensation, promotion and incentives.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Performance evaluation criteria and outcomes.\",\"record_type\":\"evaluation\"},{\"id\":\"QM-32c\",\"requirement_id\":\"ISQM-1.32\",\"component_id\":\"QMC-RES\",\"item\":\"c\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Individuals are obtained from the network or service providers when the firm lacks sufficient personnel.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Resourcing arrangements.\",\"record_type\":\"policy\"},{\"id\":\"QM-32d\",\"requirement_id\":\"ISQM-1.32\",\"component_id\":\"QMC-RES\",\"item\":\"d\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Engagement team members including an engagement partner with appropriate competence, capabilities and time are assigned to each engagement.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Assignment records against competence requirements.\",\"record_type\":\"assignment\"},{\"id\":\"QM-32e\",\"requirement_id\":\"ISQM-1.32\",\"component_id\":\"QMC-RES\",\"item\":\"e\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Individuals with appropriate competence, capabilities and time are assigned to system activities.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Assignment records for system roles.\",\"record_type\":\"assignment\"},{\"id\":\"QM-32f\",\"requirement_id\":\"ISQM-1.32\",\"component_id\":\"QMC-RES\",\"item\":\"f\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Appropriate technological resources are obtained, implemented, maintained and used for the system and for engagements.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Technology inventory and controls.\",\"record_type\":\"policy\"},{\"id\":\"QM-32g\",\"requirement_id\":\"ISQM-1.32\",\"component_id\":\"QMC-RES\",\"item\":\"g\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Appropriate intellectual resources consistent with professional standards and law are obtained, implemented, maintained and used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Methodology, manuals and templates with version control.\",\"record_type\":\"policy\"},{\"id\":\"QM-32h\",\"requirement_id\":\"ISQM-1.32\",\"component_id\":\"QMC-RES\",\"item\":\"h\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Resources from service providers are appropriate for the system and for engagements.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Service provider evaluations.\",\"record_type\":\"evaluation\"},{\"id\":\"QM-33a\",\"requirement_id\":\"ISQM-1.33\",\"component_id\":\"QMC-INFO\",\"item\":\"a\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"The information system captures, processes and maintains relevant and reliable information supporting the system.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"The information system description.\",\"record_type\":\"policy\"},{\"id\":\"QM-33b\",\"requirement_id\":\"ISQM-1.33\",\"component_id\":\"QMC-INFO\",\"item\":\"b\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"The culture recognises and reinforces the responsibility of personnel to exchange information with the firm and each other.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Communication policies and channels.\",\"record_type\":\"policy\"},{\"id\":\"QM-33c\",\"requirement_id\":\"ISQM-1.33\",\"component_id\":\"QMC-INFO\",\"item\":\"c\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Relevant and reliable information is exchanged throughout the firm and with engagement teams, in both directions.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Communications to and from engagement teams.\",\"record_type\":\"communication\"},{\"id\":\"QM-33d\",\"requirement_id\":\"ISQM-1.33\",\"component_id\":\"QMC-INFO\",\"item\":\"d\",\"kind\":\"objective\",\"scope\":\"firm\",\"statement\":\"Relevant and reliable information is communicated to external parties: the network, service providers, and others when required by law or to support their understanding of the system.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"External communications register.\",\"record_type\":\"communication\"},{\"id\":\"QM-34a\",\"requirement_id\":\"ISQM-1.34\",\"component_id\":\"QMC-RESP\",\"item\":\"a\",\"kind\":\"response\",\"scope\":\"firm\",\"statement\":\"Establish policies for identifying, evaluating and addressing threats to ethical compliance, and for identifying, communicating, evaluating, reporting and responding to breaches.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Threat and breach registers.\",\"record_type\":\"policy\"},{\"id\":\"QM-34b\",\"requirement_id\":\"ISQM-1.34\",\"component_id\":\"QMC-RESP\",\"item\":\"b\",\"kind\":\"response\",\"scope\":\"firm\",\"statement\":\"Obtain at least annually a documented confirmation of compliance with independence requirements from all personnel required to be independent.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Annual independence confirmations.\",\"record_type\":\"confirmation\"},{\"id\":\"QM-34c\",\"requirement_id\":\"ISQM-1.34\",\"component_id\":\"QMC-RESP\",\"item\":\"c\",\"kind\":\"response\",\"scope\":\"firm\",\"statement\":\"Establish policies for receiving, investigating and resolving complaints and allegations about failures to perform work to standards or non-compliance with firm policies.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Complaints and allegations log.\",\"record_type\":\"policy\"},{\"id\":\"QM-34d\",\"requirement_id\":\"ISQM-1.34\",\"component_id\":\"QMC-RESP\",\"item\":\"d\",\"kind\":\"response\",\"scope\":\"firm\",\"statement\":\"Establish policies for information learned after acceptance that would have caused the firm to decline, and for engagements the firm is legally obliged to accept.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Post-acceptance information records and legally mandated engagement records.\",\"record_type\":\"policy\"},{\"id\":\"QM-34e\",\"requirement_id\":\"ISQM-1.34\",\"component_id\":\"QMC-RESP\",\"item\":\"e\",\"kind\":\"response\",\"scope\":\"firm\",\"statement\":\"Establish policies requiring communication with those charged with governance of listed entities about how the system supports quality audits, addressing other appropriate external communication, and the content, timing and form of such communication.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Governance communications on the system.\",\"record_type\":\"communication\"},{\"id\":\"QM-34f\",\"requirement_id\":\"ISQM-1.34\",\"component_id\":\"QMC-RESP\",\"item\":\"f\",\"kind\":\"response\",\"scope\":\"firm\",\"statement\":\"Establish policies addressing engagement quality reviews under ISQM 2 and requiring a review for listed entity audits, engagements where law requires one, and engagements where the firm determines a review is an appropriate response to quality risks.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Engagement quality review policy and the register of engagements requiring review.\",\"record_type\":\"policy\"},{\"id\":\"QM-35\",\"requirement_id\":\"ISQM-1.35\",\"component_id\":\"QMC-MON\",\"item\":null,\"kind\":\"monitoring\",\"scope\":\"firm\",\"statement\":\"Establish a monitoring and remediation process that provides relevant, reliable and timely information about the system and remediates deficiencies on a timely basis.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"The monitoring plan.\",\"record_type\":\"policy\"},{\"id\":\"QM-36\",\"requirement_id\":\"ISQM-1.36\",\"component_id\":\"QMC-MON\",\"item\":null,\"kind\":\"monitoring\",\"scope\":\"firm\",\"statement\":\"Design and perform monitoring activities that provide a basis for identifying deficiencies.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Monitoring activity records.\",\"record_type\":\"inspection\"},{\"id\":\"QM-37\",\"requirement_id\":\"ISQM-1.37\",\"component_id\":\"QMC-MON\",\"item\":null,\"kind\":\"monitoring\",\"scope\":\"firm\",\"statement\":\"Determine the nature, timing and extent of monitoring from the risk assessment reasons, the design of responses and processes, changes, prior results, and other information including complaints, inspections and service provider information.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"The monitoring rationale.\",\"record_type\":\"policy\"},{\"id\":\"QM-38\",\"requirement_id\":\"ISQM-1.38\",\"component_id\":\"QMC-MON\",\"item\":null,\"kind\":\"monitoring\",\"scope\":\"firm\",\"statement\":\"Include inspection of completed engagements, selecting engagements and partners with regard to the monitoring factors, and inspect at least one completed engagement per engagement partner on a cycle.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"The inspection cycle plan and inspection files.\",\"record_type\":\"inspection\"},{\"id\":\"QM-39\",\"requirement_id\":\"ISQM-1.39\",\"component_id\":\"QMC-MON\",\"item\":null,\"kind\":\"monitoring\",\"scope\":\"firm\",\"statement\":\"Require monitors to be competent with sufficient time and to be objective, prohibiting team members and the engagement quality reviewer from inspecting their own engagement.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Monitor assignment and objectivity confirmations.\",\"record_type\":\"confirmation\"},{\"id\":\"QM-40\",\"requirement_id\":\"ISQM-1.40\",\"component_id\":\"QMC-MON\",\"item\":null,\"kind\":\"monitoring\",\"scope\":\"firm\",\"statement\":\"Evaluate findings to determine whether deficiencies exist, including in the monitoring process itself.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Findings evaluation records.\",\"record_type\":\"deficiency\"},{\"id\":\"QM-41\",\"requirement_id\":\"ISQM-1.41\",\"component_id\":\"QMC-MON\",\"item\":null,\"kind\":\"monitoring\",\"scope\":\"firm\",\"statement\":\"Evaluate the severity and pervasiveness of deficiencies by investigating root causes and their individual and aggregate effect.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Root cause analyses.\",\"record_type\":\"deficiency\"},{\"id\":\"QM-42\",\"requirement_id\":\"ISQM-1.42\",\"component_id\":\"QMC-MON\",\"item\":null,\"kind\":\"monitoring\",\"scope\":\"firm\",\"statement\":\"Design and implement remedial actions responsive to the root cause analysis.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Remedial action plans.\",\"record_type\":\"remediation\"},{\"id\":\"QM-43\",\"requirement_id\":\"ISQM-1.43\",\"component_id\":\"QMC-MON\",\"item\":null,\"kind\":\"monitoring\",\"scope\":\"firm\",\"statement\":\"The monitoring lead evaluates whether remedial actions are appropriately designed, implemented and effective.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Remediation effectiveness evaluations.\",\"record_type\":\"remediation\"},{\"id\":\"QM-44\",\"requirement_id\":\"ISQM-1.44\",\"component_id\":\"QMC-MON\",\"item\":null,\"kind\":\"monitoring\",\"scope\":\"firm\",\"statement\":\"Where remedial actions are not effective, act to modify them so that they are.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Revised remedial action plans.\",\"record_type\":\"remediation\"},{\"id\":\"QM-45\",\"requirement_id\":\"ISQM-1.45\",\"component_id\":\"QMC-MON\",\"item\":null,\"kind\":\"monitoring\",\"scope\":\"firm\",\"statement\":\"Where findings indicate omitted procedures or an inappropriate report on an engagement, act to comply with standards and law and consider the implications including legal advice.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Engagement-specific remediation records.\",\"record_type\":\"remediation\"},{\"id\":\"QM-46\",\"requirement_id\":\"ISQM-1.46\",\"component_id\":\"QMC-MON\",\"item\":null,\"kind\":\"monitoring\",\"scope\":\"firm\",\"statement\":\"The monitoring lead communicates to those with ultimate and operational responsibility the monitoring performed, deficiencies with severity and pervasiveness, and remedial actions.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Monitoring reports to leadership.\",\"record_type\":\"communication\"},{\"id\":\"QM-47\",\"requirement_id\":\"ISQM-1.47\",\"component_id\":\"QMC-MON\",\"item\":null,\"kind\":\"monitoring\",\"scope\":\"firm\",\"statement\":\"Communicate monitoring matters to engagement teams and others with system responsibilities so that they can act promptly.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Communications to engagement teams.\",\"record_type\":\"communication\"},{\"id\":\"QM-48\",\"requirement_id\":\"ISQM-1.48\",\"component_id\":\"QMC-NET\",\"item\":null,\"kind\":\"network\",\"scope\":\"firm\",\"statement\":\"Understand the network's requirements and services and the firm's responsibilities to implement them, without letting them contravene ISQM 1.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Network requirements inventory.\",\"record_type\":\"policy\"},{\"id\":\"QM-49\",\"requirement_id\":\"ISQM-1.49\",\"component_id\":\"QMC-NET\",\"item\":null,\"kind\":\"network\",\"scope\":\"firm\",\"statement\":\"Determine how network requirements and services are taken into account in the firm's system and whether they need adapting.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Network adaptation assessment.\",\"record_type\":\"evaluation\"},{\"id\":\"QM-50\",\"requirement_id\":\"ISQM-1.50\",\"component_id\":\"QMC-NET\",\"item\":null,\"kind\":\"network\",\"scope\":\"firm\",\"statement\":\"Where the network monitors the firm's system, determine the effect on the firm's monitoring, its responsibilities, and obtain the results timely.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Network monitoring results.\",\"record_type\":\"inspection\"},{\"id\":\"QM-51\",\"requirement_id\":\"ISQM-1.51\",\"component_id\":\"QMC-NET\",\"item\":null,\"kind\":\"network\",\"scope\":\"firm\",\"statement\":\"Understand the network's monitoring across firms, obtain the overall results at least annually, communicate them internally and consider their effect.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Annual network monitoring communication.\",\"record_type\":\"communication\"},{\"id\":\"QM-52\",\"requirement_id\":\"ISQM-1.52\",\"component_id\":\"QMC-NET\",\"item\":null,\"kind\":\"network\",\"scope\":\"firm\",\"statement\":\"Where a deficiency in network requirements or services is identified, communicate it to the network and remediate its effect.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Network deficiency communications and remediation.\",\"record_type\":\"remediation\"},{\"id\":\"QM-53\",\"requirement_id\":\"ISQM-1.53\",\"component_id\":\"QMC-EVAL\",\"item\":null,\"kind\":\"evaluation\",\"scope\":\"firm\",\"statement\":\"The individual with ultimate responsibility evaluates the system at a point in time at least annually.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"The annual evaluation.\",\"record_type\":\"evaluation\"},{\"id\":\"QM-54\",\"requirement_id\":\"ISQM-1.54\",\"component_id\":\"QMC-EVAL\",\"item\":null,\"kind\":\"evaluation\",\"scope\":\"firm\",\"statement\":\"Conclude whether the system provides reasonable assurance, provides it except for severe but not pervasive deficiencies, or does not provide it.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"The documented conclusion.\",\"record_type\":\"evaluation\"},{\"id\":\"QM-55\",\"requirement_id\":\"ISQM-1.55\",\"component_id\":\"QMC-EVAL\",\"item\":null,\"kind\":\"evaluation\",\"scope\":\"firm\",\"statement\":\"On an except-for or negative conclusion, take prompt action and communicate internally and externally under the firm's policies.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Action and communication records.\",\"record_type\":\"communication\"},{\"id\":\"QM-56\",\"requirement_id\":\"ISQM-1.56\",\"component_id\":\"QMC-EVAL\",\"item\":null,\"kind\":\"evaluation\",\"scope\":\"firm\",\"statement\":\"Undertake periodic performance evaluations of those with ultimate and operational responsibility, taking the system evaluation into account.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Leadership performance evaluations.\",\"record_type\":\"evaluation\"},{\"id\":\"QM-57\",\"requirement_id\":\"ISQM-1.57\",\"component_id\":\"QMC-DOC\",\"item\":null,\"kind\":\"documentation\",\"scope\":\"firm\",\"statement\":\"Document the system sufficiently to support consistent understanding, consistent operation of responses, and evidence for the evaluation.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"The system documentation.\",\"record_type\":\"file\"},{\"id\":\"QM-58\",\"requirement_id\":\"ISQM-1.58\",\"component_id\":\"QMC-DOC\",\"item\":null,\"kind\":\"documentation\",\"scope\":\"firm\",\"statement\":\"Document the responsible individuals, objectives and risks, responses and how they address risks, monitoring evidence, findings, deficiencies, root causes, remedial actions and communications, and the basis for the conclusion.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"The documented registers and evaluation.\",\"record_type\":\"file\"},{\"id\":\"QM-59\",\"requirement_id\":\"ISQM-1.59\",\"component_id\":\"QMC-DOC\",\"item\":null,\"kind\":\"documentation\",\"scope\":\"firm\",\"statement\":\"Document network-related matters and the evaluation of network requirements and services.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"Network documentation.\",\"record_type\":\"file\"},{\"id\":\"QM-60\",\"requirement_id\":\"ISQM-1.60\",\"component_id\":\"QMC-DOC\",\"item\":null,\"kind\":\"documentation\",\"scope\":\"firm\",\"statement\":\"Establish a retention period for system documentation sufficient to monitor the system, or longer where law requires.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\",\"evidence\":\"The retention policy.\",\"record_type\":\"policy\"}]"),
