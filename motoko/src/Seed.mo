49\"},{\"criterion_id\":\"PC-NO-DESCRIPTION\",\"requirement_id\":\"ISA-330.20\"},{\"criterion_id\":\"PC-KEYWORD\",\"requirement_id\":\"ISA-240.33\"},{\"criterion_id\":\"PC-KEYWORD\",\"requirement_id\":\"ISA-240.34\"},{\"criterion_id\":\"PC-KEYWORD\",\"requirement_id\":\"ISA-240R.48\"},{\"criterion_id\":\"PC-KEYWORD\",\"requirement_id\":\"ISA-240R.49\"},{\"criterion_id\":\"PC-KEYWORD\",\"requirement_id\":\"ISA-330.20\"},{\"criterion_id\":\"PC-REVERSAL-AFTER-PERIOD\",\"requirement_id\":\"ISA-240.33\"},{\"criterion_id\":\"PC-REVERSAL-AFTER-PERIOD\",\"requirement_id\":\"ISA-240.34\"},{\"criterion_id\":\"PC-REVERSAL-AFTER-PERIOD\",\"requirement_id\":\"ISA-240R.48\"},{\"criterion_id\":\"PC-REVERSAL-AFTER-PERIOD\",\"requirement_id\":\"ISA-240R.49\"},{\"criterion_id\":\"PC-REVERSAL-AFTER-PERIOD\",\"requirement_id\":\"ISA-330.20\"},{\"criterion_id\":\"PC-SELDOM-USED-ACCOUNT\",\"requirement_id\":\"ISA-240.33\"},{\"criterion_id\":\"PC-SELDOM-USED-ACCOUNT\",\"requirement_id\":\"ISA-240.34\"},{\"criterion_id\":\"PC-SELDOM-USED-ACCOUNT\",\"requirement_id\":\"ISA-240R.48\"},{\"criterion_id\":\"PC-SELDOM-USED-ACCOUNT\",\"requirement_id\":\"ISA-240R.49\"},{\"criterion_id\":\"PC-SELDOM-USED-ACCOUNT\",\"requirement_id\":\"ISA-330.20\"},{\"criterion_id\":\"PC-DUPLICATE\",\"requirement_id\":\"ISA-240.33\"},{\"criterion_id\":\"PC-DUPLICATE\",\"requirement_id\":\"ISA-240.34\"},{\"criterion_id\":\"PC-DUPLICATE\",\"requirement_id\":\"ISA-240R.48\"},{\"criterion_id\":\"PC-DUPLICATE\",\"requirement_id\":\"ISA-240R.49\"},{\"criterion_id\":\"PC-DUPLICATE\",\"requirement_id\":\"ISA-330.20\"},{\"criterion_id\":\"PC-BELOW-THRESHOLD\",\"requirement_id\":\"ISA-240.33\"},{\"criterion_id\":\"PC-BELOW-THRESHOLD\",\"requirement_id\":\"ISA-240.34\"},{\"criterion_id\":\"PC-BELOW-THRESHOLD\",\"requirement_id\":\"ISA-240R.48\"},{\"criterion_id\":\"PC-BELOW-THRESHOLD\",\"requirement_id\":\"ISA-240R.49\"},{\"criterion_id\":\"PC-BELOW-THRESHOLD\",\"requirement_id\":\"ISA-330.20\"},{\"criterion_id\":\"PC-TOP-SIDE\",\"requirement_id\":\"ISA-240.33\"},{\"criterion_id\":\"PC-TOP-SIDE\",\"requirement_id\":\"ISA-240.34\"},{\"criterion_id\":\"PC-TOP-SIDE\",\"requirement_id\":\"ISA-240R.48\"},{\"criterion_id\":\"PC-TOP-SIDE\",\"requirement_id\":\"ISA-240R.49\"},{\"criterion_id\":\"PC-TOP-SIDE\",\"requirement_id\":\"ISA-330.20\"},{\"criterion_id\":\"PC-LEAVER\",\"requirement_id\":\"ISA-240.33\"},{\"criterion_id\":\"PC-LEAVER\",\"requirement_id\":\"ISA-240.34\"},{\"criterion_id\":\"PC-LEAVER\",\"requirement_id\":\"ISA-240R.48\"},{\"criterion_id\":\"PC-LEAVER\",\"requirement_id\":\"ISA-240R.49\"},{\"criterion_id\":\"PC-LEAVER\",\"requirement_id\":\"ISA-330.20\"},{\"criterion_id\":\"PC-UNAUTHORISED-APPROVER\",\"requirement_id\":\"ISA-240.33\"},{\"criterion_id\":\"PC-UNAUTHORISED-APPROVER\",\"requirement_id\":\"ISA-240.34\"},{\"criterion_id\":\"PC-UNAUTHORISED-APPROVER\",\"requirement_id\":\"ISA-240R.48\"},{\"criterion_id\":\"PC-UNAUTHORISED-APPROVER\",\"requirement_id\":\"ISA-240R.49\"},{\"criterion_id\":\"PC-UNAUTHORISED-APPROVER\",\"requirement_id\":\"ISA-330.20\"},{\"criterion_id\":\"PC-UNUSUAL-FLOW\",\"requirement_id\":\"ISA-240.33\"},{\"criterion_id\":\"PC-UNUSUAL-FLOW\",\"requirement_id\":\"ISA-240.34\"},{\"criterion_id\":\"PC-UNUSUAL-FLOW\",\"requirement_id\":\"ISA-240R.48\"},{\"criterion_id\":\"PC-UNUSUAL-FLOW\",\"requirement_id\":\"ISA-240R.49\"},{\"criterion_id\":\"PC-UNUSUAL-FLOW\",\"requirement_id\":\"ISA-330.20\"},{\"criterion_id\":\"PC-ACCOUNT-PAIR\",\"requirement_id\":\"ISA-240.33\"},{\"criterion_id\":\"PC-ACCOUNT-PAIR\",\"requirement_id\":\"ISA-240.34\"},{\"criterion_id\":\"PC-ACCOUNT-PAIR\",\"requirement_id\":\"ISA-240R.48\"},{\"criterion_id\":\"PC-ACCOUNT-PAIR\",\"requirement_id\":\"ISA-240R.49\"},{\"criterion_id\":\"PC-ACCOUNT-PAIR\",\"requirement_id\":\"ISA-330.20\"},{\"criterion_id\":\"PC-BACKDATED\",\"requirement_id\":\"ISA-240.33\"},{\"criterion_id\":\"PC-BACKDATED\",\"requirement_id\":\"ISA-240.34\"},{\"criterion_id\":\"PC-BACKDATED\",\"requirement_id\":\"ISA