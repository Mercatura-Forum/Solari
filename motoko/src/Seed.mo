    ("population_fields", 15, "[{\"id\":\"PF-ENTRY-ID\",\"name\":\"entry_id\",\"data_type\":\"string\",\"required\":1,\"description\":\"Identifier of the journal entry (document number); lines of one entry share it.\",\"used_by\":\"[\\\"PC-*\\\"]\"},{\"id\":\"PF-LINE-NO\",\"name\":\"line_no\",\"data_type\":\"integer\",\"required\":1,\"description\":\"Line number within the entry.\",\"used_by\":\"[]\"},{\"id\":\"PF-ACCOUNT\",\"name\":\"account_code\",\"data_type\":\"string\",\"required\":1,\"description\":\"Ledger account the line posts to; must exist in the trial balance.\",\"used_by\":\"[\\\"PC-UNUSUAL-ACCOUNT\\\",\\\"PC-SELDOM-USED-ACCOUNT\\\"]\"},{\"id\":\"PF-POSTING-DATE\",\"name\":\"posting_date\",\"data_type\":\"date\",\"required\":1,\"description\":\"Date the entry was recorded in the ledger.\",\"used_by\":\"[\\\"PC-PERIOD-END\\\",\\\"PC-POST-CLOSE\\\",\\\"PC-WEEKEND-HOLIDAY\\\",\\\"PC-REVERSAL-AFTER-PERIOD\\\"]\"},{\"id\":\"PF-EFFECTIVE-DATE\",\"name\":\"effective_date\",\"data_type\":\"date\",\"required\":1,\"description\":\"Accounting date the entry takes effect (period it belongs to).\",\"used_by\":\"[\\\"PC-POST-CLOSE\\\"]\"},{\"id\":\"PF-POSTED-AT\",\"name\":\"posted_at\",\"data_type\":\"datetime\",\"required\":0,\"description\":\"Timestamp of posting where the system records one.\",\"used_by\":\"[\\\"PC-OUT-OF-HOURS\\\"]\"},{\"id\":\"PF-DEBIT\",\"name\":\"debit\",\"data_type\":\"money\",\"required\":1,\"description\":\"Debit amount of the line, or 0.\",\"used_by\":\"[\\\"PC-ROUND-AMOUNT\\\",\\\"PC-LARGE-AMOUNT\\\"]\"},{\"id\":\"PF-CREDIT\",\"name\":\"credit\",\"data_type\":\"money\",\"required\":1,\"description\":\"Credit amount of the line, or 0.\",\"used_by\":\"[\\\"PC-ROUND-AMOUNT\\\",\\\"PC-LARGE-AMOUNT\\\"]\"},{\"id\":\"PF-PREPARED-BY\",\"name\":\"prepared_by\",\"data_type\":\"string\",\"required\":1,\"description\":\"User who created or posted the entry.\",\"used_by\":\"[\\\"PC-SELF-APPROVED\\\",\\\"PC-UNUSUAL-USER\\\"]\"},{\"id\":\"PF-APPROVED-BY\",\"name\":\"approved_by\",\"data_type\":\"string\",\"required\":0,\"description\":\"User who approved the entry, where the system records approval.\",\"used_by\":\"[\\\"PC-SELF-APPROVED\\\"]\"},{\"id\":\"PF-SOURCE\",\"name\":\"source\",\"data_type\":\"enum\",\"required\":1,\"description\":\"Origin of the entry: subledger, system, manual, top_side, reversal, recurring.\",\"used_by\":\"[\\\"PC-MANUAL\\\",\\\"PC-SELF-APPROVED\\\"]\"},{\"id\":\"PF-DESCRIPTION\",\"name\":\"description\",\"data_type\":\"string\",\"required\":0,\"description\":\"Narrative of the entry.\",\"used_by\":\"[\\\"PC-NO-DESCRIPTION\\\",\\\"PC-KEYWORD\\\"]\"},{\"id\":\"PF-REFERENCE\",\"name\":\"reference\",\"data_type\":\"string\",\"required\":0,\"description\":\"External document reference (invoice, contract, bank line).\",\"used_by\":\"[]\"},{\"id\":\"PF-REVERSES\",\"name\":\"reverses_entry_id\",\"data_type\":\"string\",\"required\":0,\"description\":\"Entry this one reverses, where the system links reversals.\",\"used_by\":\"[\\\"PC-REVERSAL-AFTER-PERIOD\\\"]\"},{\"id\":\"PF-CURRENCY\",\"name\":\"currency\",\"data_type\":\"string\",\"required\":0,\"description\":\"Currency of the amounts where the ledger is multi-currency; the population is screened per currency.\",\"used_by\":\"[]\"}]"),
