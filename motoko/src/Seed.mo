    ("assertions", 8, "[{\"id\":\"EO\",\"name\":\"Existence / occurrence\",\"level\":\"primary\",\"primary_id\":null,\"applies_to\":\"both\",\"definition\":\"Recorded assets, liabilities and equity interests exist at the period end, and recorded transactions and events took place and pertain to the entity. The direction of testing runs from the record to the underlying evidence: a recorded item is selected and its reality is corroborated.\",\"term_id\":\"T-ASSERT-EO\",\"definition_ar\":null,\"definition_ar_status\":\"pending_draft\"},{\"id\":\"C\",\"name\":\"Completeness\",\"level\":\"primary\",\"primary_id\":null,\"applies_to\":\"both\",\"definition\":\"Everything that should have been recorded has been recorded, and every disclosure that should have been made is included. The direction of testing runs from the underlying population to the record: an item is selected from a source outside the ledger (a shipping log, a bank statement, a contract register) and traced into the books.\",\"term_id\":\"T-ASSERT-C\",\"definition_ar\":null,\"definition_ar_status\":\"pending_draft\"},{\"id\":\"VA\",\"name\":\"Valuation and allocation\",\"level\":\"primary\",\"primary_id\":null,\"applies_to\":\"both\",\"definition\":\"Assets, liabilities and equity interests are carried at appropriate amounts under the applicable framework, and any resulting valuation or allocation adjustments (depreciation, impairment, expected credit losses, net realisable value, fair value) are appropriately recorded. For transactions this covers accuracy: amounts and other data are recorded appropriately.\",\"term_id\":\"T-ASSERT-VA\",\"definition_ar\":null,\"definition_ar_status\":\"pending_draft\"},{\"id\":\"RO\",\"name\":\"Rights and obligations\",\"level\":\"primary\",\"primary_id\":null,\"applies_to\":\"balances\",\"definition\":\"The entity holds or controls the rights to recorded assets, and recorded liabilities are the obligations of the entity. Legal form and economic substance are both examined: title, encumbrances, pledges, consignment and repurchase arrangements.\",\"term_id\":\"T-ASSERT-RO\",\"definition_ar\":null,\"definition_ar_status\":\"pending_draft\"},{\"id\":\"PD\",\"name\":\"Presentation and disclosure\",\"level\":\"primary\",\"primary_id\":null,\"applies_to\":\"both\",\"definition\":\"Transactions, balances and events are appropriately aggregated or disaggregated, clearly described, and disclosed in accordance with the applicable framework; classification between current and non-current, operating and financing, and between line items is correct.\",\"term_id\":\"T-ASSERT-PD\",\"definition_ar\":null,\"definition_ar_status\":\"pending_draft\"},{\"id\":\"ACC\",\"name\":\"Accuracy\",\"level\":\"secondary\",\"primary_id\":\"VA\",\"applies_to\":\"transactions\",\"definition\":\"Amounts and other data relating to recorded transactions and events have been recorded appropriately, and related disclosures are measured and described appropriately. Rolls up to valuation and allocation.\",\"term_id\":\"T-ASSERT-ACC\",\"definition_ar\":null,\"definition_ar_status\":\"pending_draft\"},{\"id\":\"CO\",\"name\":\"Cut-off\",\"level\":\"secondary\",\"primary_id\":\"C\",\"applies_to\":\"transactions\",\"definition\":\"Transactions and events have been recorded in the correct accounting period. A cut-off error is simultaneously a completeness failure in one period and an occurrence failure in the adjacent period; procedures that test cut-off therefore also carry EO.\",\"term_id\":\"T-ASSERT-CO\",\"definition_ar\":null,\"definition_ar_status\":\"pending_draft\"},{\"id\":\"CL\",\"name\":\"Classification\",\"level\":\"secondary\",\"primary_id\":\"PD\",\"applies_to\":\"transactions\",\"definition\":\"Transactions and events have been recorded in the proper accounts. Rolls up to presentation and disclosure.\",\"term_id\":\"T-ASSERT-CL\",\"definition_ar\":null,\"definition_ar_status\":\"pending_draft\"}]"),
