    ("record_kinds", 24, "[{\"id\":\"RK-SIGNOFF\",\"term_id\":\"T-RK-SIGNOFF\",\"name\":\"Sign-off\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"object\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"object_version\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"role\\\", \\\"type\\\": \\\"enum preparer|reviewer|engagement_partner|eqr_reviewer\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"person\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"signed_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"scope\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 0}]\",\"immutable\":1,\"description\":\"Who prepared or reviewed what, at which version, when; a later change to the object invalidates the sign-off and requires a new one.\",\"sort_order\":1},{\"id\":\"RK-REVIEW-NOTE\",\"term_id\":\"T-RK-REVIEW-NOTE\",\"name\":\"Review note\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"object\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"raised_by\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"raised_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"text\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"state\\\", \\\"type\\\": \\\"enum open|answered|cleared\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"answered_by\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"cleared_by\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"cleared_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"answer\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"answered_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 0}]\",\"immutable\":0,\"description\":\"A reviewer's query on a working paper tracked to resolution; cleared notes stay in the file.\",\"sort_order\":2},{\"id\":\"RK-REQUEST\",\"term_id\":\"T-RK-REQUEST\",\"name\":\"Information request\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"procedure\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"addressee\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"requested\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"requested_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"due\\\", \\\"type\\\": \\\"date\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"state\\\", \\\"type\\\": \\\"enum open|received|closed\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"evidence\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"response\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"responded_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 0}]\",\"immutable\":0,\"description\":\"A request to the entity or a third party (prepared-by-client list, confirmation, representation) linked to the procedure it serves and the evidence it produced.\",\"sort_order\":3},{\"id\":\"RK-EVIDENCE-LINK\",\"term_id\":\"T-RK-EVIDENCE-LINK\",\"name\":\"Evidence link\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"procedure\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"step\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"evidence_item\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"evidence_kind\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"tick_mark\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"region\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"linked_by\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"linked_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}]\",\"immutable\":1,\"description\":\"Cross-reference from a procedure step to an evidence item and the region of it examined, with the tick mark applied; a link may name the step (the requirement of the procedure) it evidences.\",\"sort_order\":4},{\"id\":\"RK-SAMPLE\",\"term_id\":\"T-RK-SAMPLE\",\"name\":\"Sample record\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"procedure\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"population\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"selection_method\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"statistical\\\", \\\"type\\\": \\\"boolean\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"seed_or_start\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"size\\\", \\\"type\\\": \\\"integer\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"items\\\", \\\"type\\\": \\\"list\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"evaluation\\\", \\\"type\\\": \\\"object\\\", \\\"required\\\": 0}]\",\"immutable\":1,\"description\":\"The sample drawn: population, method, statistical flag, seed or random start, the items, and the evaluation (projected misstatement, upper limit, conclusion).\",\"sort_order\":5},{\"id\":\"RK-POPULATION-COMPLETENESS\",\"term_id\":\"T-RK-POPULATION-COMPLETENESS\",\"name\":\"Population completeness check\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"population\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"trial_balance\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"grade\\\", \\\"type\\\": \\\"enum representation|cryptographic\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"accounts_reconciled\\\", \\\"type\\\": \\\"integer\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"accounts_failed\\\", \\\"type\\\": \\\"integer\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"accepted\\\", \\\"type\\\": \\\"boolean\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"performed_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}]\",\"immutable\":1,\"description\":\"The reconciliation of a population to the trial balance before any test is applied to it, stating which completeness grade applies.\",\"sort_order\":6},{\"id\":\"RK-MISSTATEMENT\",\"term_id\":\"T-MISSTATEMENT\",\"name\":\"Misstatement\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"description\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"type\\\", \\\"type\\\": \\\"enum factual|judgmental|projected\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"status\\\", \\\"type\\\": \\\"enum corrected|uncorrected\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"assets\\\", \\\"type\\\": \\\"money\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"liabilities\\\", \\\"type\\\": \\\"money\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"equity\\\", \\\"type\\\": \\\"money\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"profit\\\", \\\"type\\\": \\\"money\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"procedure\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"communicated_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 0}]\",\"immutable\":0,\"description\":\"One identified misstatement with its balanced effect, feeding the aggregation computation.\",\"sort_order\":7},{\"id\":\"RK-COMPONENT\",\"term_id\":\"T-RK-COMPONENT\",\"name\":\"Group component\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"name\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"entity\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"component_auditor\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"scope\\\", \\\"type\\\": \\\"enum full|specific_balances|analytical|none\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"performance_materiality\\\", \\\"type\\\": \\\"money\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"threshold\\\", \\\"type\\\": \\\"money\\\", \\\"required\\\": 1}]\",\"immutable\":0,\"description\":\"A component of a group audit with its scope, materiality and auditor.\",\"sort_order\":8},{\"id\":\"RK-COMMUNICATION\",\"term_id\":\"T-RK-COMMUNICATION\",\"name\":\"Communication log entry\",\"scope\":\"both\",\"fields\":\"[{\\\"name\\\": \\\"with\\\", \\\"type\\\": \\\"enum management|tcwg|component_auditor|regulator|predecessor|expert\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"direction\\\", \\\"type\\\": \\\"enum sent|received\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"subject\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"form\\\", \\\"type\\\": \\\"enum written|oral\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"document\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}]\",\"immutable\":1,\"description\":\"A dated record of a required communication and its form.\",\"sort_order\":9},{\"id\":\"RK-FILE-ASSEMBLY\",\"term_id\":\"T-RK-FILE-ASSEMBLY\",\"name\":\"File assembly event\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"report_date\\\", \\\"type\\\": \\\"date\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"assembled_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"deadline\\\", \\\"type\\\": \\\"date\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"assembled_by\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"object_count\\\", \\\"type\\\": \\\"integer\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"hash\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 0}]\",\"immutable\":1,\"description\":\"The event that closes the file after the report date; every object's version at that moment is frozen.\",\"sort_order\":10},{\"id\":\"RK-POST-ASSEMBLY-CHANGE\",\"term_id\":\"T-RK-POST-ASSEMBLY-CHANGE\",\"name\":\"Post-assembly change\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"object\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"reason\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"changed_by\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"changed_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"reviewed_by\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"reviewed_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}]\",\"immutable\":1,\"description\":\"A change or addition to the file after assembly, with the reason and who made and reviewed it.\",\"sort_order\":11},{\"id\":\"RK-PRIOR-PERIOD-REFERENCE\",\"term_id\":\"T-RK-PRIOR-PERIOD-REFERENCE\",\"name\":\"Prior-period evidence reference\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"prior_object\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"current_procedure\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"re_evaluated\\\", \\\"type\\\": \\\"boolean\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"re_evaluated_by\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"conclusion\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}]\",\"immutable\":0,\"description\":\"A rollforward reference to prior-period evidence with the explicit re-evaluation that the standard requires before reliance.\",\"sort_order\":12},{\"id\":\"RK-AUTOMATED-TOOL-OUTPUT\",\"term_id\":\"T-RK-AUTOMATED-TOOL-OUTPUT\",\"name\":\"Automated tool output\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"tool\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"version\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"inputs_hash\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"output\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"reproducible\\\", \\\"type\\\": \\\"boolean\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"human_override\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 0}]\",\"immutable\":1,\"description\":\"Evidence produced by an automated tool or technique, recording whether the output can be reproduced from its inputs and any human override of it.\",\"sort_order\":13},{\"id\":\"RK-MONITORING-FINDING\",\"term_id\":\"T-RK-MONITORING-FINDING\",\"name\":\"Monitoring finding\",\"scope\":\"firm\",\"fields\":\"[{\\\"name\\\": \\\"activity\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"engagement\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"finding\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"deficiency\\\", \\\"type\\\": \\\"boolean\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"severity\\\", \\\"type\\\": \\\"enum low|moderate|severe\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"pervasive\\\", \\\"type\\\": \\\"boolean\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"root_cause\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"found_at\\\", \\\"type\\\": \\\"date\\\", \\\"required\\\": 1}]\",\"immutable\":0,\"description\":\"A finding from the firm's monitoring activities, evaluated for whether it is a deficiency and for severity and pervasiveness.\",\"sort_order\":14},{\"id\":\"RK-REMEDIATION\",\"term_id\":\"T-RK-REMEDIATION\",\"name\":\"Remedial action\",\"scope\":\"firm\",\"fields\":\"[{\\\"name\\\": \\\"finding\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"action\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"owner\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"due\\\", \\\"type\\\": \\\"date\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"state\\\", \\\"type\\\": \\\"enum planned|implemented|effective|ineffective\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"evaluated_at\\\", \\\"type\\\": \\\"date\\\", \\\"required\\\": 0}]\",\"immutable\":0,\"description\":\"A remedial action responsive to a root cause, with its implementation and effectiveness evaluation.\",\"sort_order\":15},{\"id\":\"RK-DISCLOSURE-CHECKLIST\",\"term_id\":\"T-RK-DISCLOSURE-CHECKLIST\",\"name\":\"Disclosure checklist\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"framework\\\", \\\"type\\\": \\\"enum IFRS|EAS|other\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"item\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"applicable\\\", \\\"type\\\": \\\"boolean\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"disclosed\\\", \\\"type\\\": \\\"boolean\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"reference\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"reviewed_by\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}]\",\"immutable\":0,\"description\":\"One item of the framework disclosure checklist with its applicability and where the disclosure sits.\",\"sort_order\":16},{\"id\":\"RK-PROCEDURE-CONCLUSION\",\"term_id\":\"T-RK-PROCEDURE-CONCLUSION\",\"name\":\"Procedure conclusion\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"procedure\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"conclusion\\\", \\\"type\\\": \\\"enum performed_no_exception|performed_exception|not_applicable\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"rationale\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"performed_by\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"performed_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}]\",\"immutable\":1,\"description\":\"The conclusion of one procedure of the audit programme on one engagement: performed without exception, performed with an exception (which then lives in a misstatement, a review note or a communication), or not applicable with the reason. Immutable: a change is a new conclusion at a later time; the programme reads the latest. The reviewer's sign-off on it is an RK-SIGNOFF whose object is this record. A file is not assembled while an applicable procedure has no reviewed conclusion (ISA 230.14, ISA 300.9–10).\",\"sort_order\":17},{\"id\":\"RK-COMPONENT-INSTRUCTION\",\"term_id\":\"T-RK-COMPONENT-INSTRUCTION\",\"name\":\"Component auditor instruction\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"component\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"issued_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"issued_by\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"work_requested\\\", \\\"type\\\": \\\"enum audit|specific_balances|specified_procedures|review|none\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"performance_materiality\\\", \\\"type\\\": \\\"money\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"threshold\\\", \\\"type\\\": \\\"money\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"significant_risks\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"reporting_deadline\\\", \\\"type\\\": \\\"date\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"instructions\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"document\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}]\",\"immutable\":1,\"description\":\"The group auditor's instruction to a component auditor for one component: the work requested, the component performance materiality and misstatement threshold, the significant risks communicated, the reporting deadline and the instruction text (ISA 600.29, .31, .36, .37). Immutable: a changed instruction is a new one; the component reads the latest.\",\"sort_order\":18},{\"id\":\"RK-COMPONENT-REPORT\",\"term_id\":\"T-RK-COMPONENT-REPORT\",\"name\":\"Component auditor report\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"component\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"instruction\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"received_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"work_performed\\\", \\\"type\\\": \\\"enum as_instructed|with_exceptions|not_performed\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"uncorrected_misstatements\\\", \\\"type\\\": \\\"money\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"subsequent_events\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"document\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"evaluated_by\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"evaluated_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"evaluation\\\", \\\"type\\\": \\\"enum sufficient|additional_procedures|not_adequate\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"evaluation_notes\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 0}]\",\"immutable\":0,\"description\":\"What the component auditor communicated back against an instruction (ISA 600.45): the work performed, findings, uncorrected misstatements, subsequent events — and the group auditor's evaluation of it (ISA 600.46, .48, .51): sufficient, additional procedures needed, or not adequate. Mutable: the evaluation is added after receipt.\",\"sort_order\":20},{\"id\":\"RK-ADJUSTMENT\",\"term_id\":\"T-RK-ADJUSTMENT\",\"name\":\"Adjusting entry\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"description\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"type\\\", \\\"type\\\": \\\"enum adjusting|reclassifying|elimination|tax\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"source\\\", \\\"type\\\": \\\"enum auditor_proposed|client_booked\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"state\\\", \\\"type\\\": \\\"enum proposed|agreed|booked|waived\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"legs\\\", \\\"type\\\": \\\"list\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"misstatement_type\\\", \\\"type\\\": \\\"enum factual|judgmental|projected\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"misstatement\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"procedure\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"proposed_by\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"proposed_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"decided_by\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"decided_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"reason\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"communicated_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 0}]\",\"immutable\":0,\"description\":\"A balanced set of legs over trial-balance accounts, proposed by the auditor or booked by the client: adjusting, reclassifying, elimination or tax. Booked, it changes the adjusted trial balance; waived, it is an uncorrected misstatement. The misstatement record it names is its projection: corrected when booked, uncorrected while proposed, agreed or waived.\",\"sort_order\":21},{\"id\":\"RK-CONTROL\",\"term_id\":\"T-RK-CONTROL\",\"name\":\"Control\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"name\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"cycle\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"assertions\\\", \\\"type\\\": \\\"list\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"type\\\", \\\"type\\\": \\\"enum preventive|detective|general_it\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"gitc_area\\\", \\\"type\\\": \\\"enum access|change|operations\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"frequency\\\", \\\"type\\\": \\\"enum each_transaction|daily|weekly|monthly|quarterly|annually\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"owner\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"description\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"design\\\", \\\"type\\\": \\\"enum effective|deficient|not_evaluated\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"implementation\\\", \\\"type\\\": \\\"enum implemented|not_implemented|not_evaluated\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"walkthrough\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"test_procedure\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"test_result\\\", \\\"type\\\": \\\"enum effective|ineffective|not_tested\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"items_tested\\\", \\\"type\\\": \\\"integer\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"deviations\\\", \\\"type\\\": \\\"integer\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"test_evidence\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"relied_on\\\", \\\"type\\\": \\\"boolean\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"risks\\\", \\\"type\\\": \\\"list\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"deficiency\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"identified_by\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"identified_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}]\",\"immutable\":0,\"description\":\"A control relevant to the audit: its cycle and the assertions it addresses, its type (preventive, detective, general IT with its area), its design and implementation conclusions, the walkthrough that evidenced it, the test of controls with its result and evidence, whether the audit relies on it and the risks whose response it carries. The control matrix and the reliance report are queries over these records.\",\"sort_order\":22},{\"id\":\"RK-MINUTES-REVIEW\",\"term_id\":\"T-RK-MINUTES-REVIEW\",\"name\":\"Minutes review\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"meeting\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"held_on\\\", \\\"type\\\": \\\"date\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"extract\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"matter\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"significance\\\", \\\"type\\\": \\\"enum none|significant\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"resolution\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"procedure\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"reviewed_by\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"reviewed_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}]\",\"immutable\":0,\"description\":\"An extract of the minutes of a meeting of those charged with governance, the board or a committee, read as a source of the understanding of the entity (ISA 315.14, inspection) and of the significant matters of the audit: the meeting and its date, the extract, the matter of audit significance it raises, whether the matter is significant, its resolution once known, the procedure it informs, and who read it and when. A significant matter without its resolution holds the assembly of the file (ISA 230.8(c), ISA 230.10).\",\"sort_order\":23},{\"id\":\"RK-MEETING-NOTE\",\"term_id\":\"T-RK-MEETING-NOTE\",\"name\":\"Meeting note\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"with_whom\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"party\\\", \\\"type\\\": \\\"enum management|tcwg|internal_audit|component_auditor|expert|regulator|other\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"held_on\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"discussed\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"agreed\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"significance\\\", \\\"type\\\": \\\"enum none|significant\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"resolution\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"recorded_by\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"recorded_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}]\",\"immutable\":0,\"description\":\"The note of a meeting or discussion with management, those charged with governance or others: with whom and in what capacity, when, what was discussed and what was agreed, whether it raised a significant matter and, once known, its resolution (ISA 230.10: the nature, timing and participants of discussions of significant matters; ISA 260.23). A significant matter without its resolution holds the assembly of the file.\",\"sort_order\":24},{\"id\":\"RK-CARRY-FORWARD\",\"term_id\":\"T-RK-CARRY-FORWARD\",\"name\":\"Matter carried forward\",\"scope\":\"engagement\",\"fields\":\"[{\\\"name\\\": \\\"matter\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"action\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"raised_by\\\", \\\"type\\\": \\\"ref\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"raised_at\\\", \\\"type\\\": \\\"datetime\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"source\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"carried_from\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 0}, {\\\"name\\\": \\\"state\\\", \\\"type\\\": \\\"enum open|addressed\\\", \\\"required\\\": 1}, {\\\"name\\\": \\\"addressed_note\\\", \\\"type\\\": \\\"string\\\", \\\"required\\\": 0}]\",\"immutable\":0,\"description\":\"A matter for the next engagement: what was noted, what the next audit should do about it, who raised it and when, and the record or form it came from. Rolling an assembled file forward carries every open matter into the new file, naming the engagement it came from, where it stays open until addressed with a note (ISA 300.7, ISA 315.16: previous experience with the entity evaluated for the current audit).\",\"sort_order\":25}]"),
    ("requirements", 750, "[{\"id\":\"ISA-200.14\",\"standard_id\":\"ISA-200\",\"paragraph\":\"14\",\"topic\":\"Ethical requirements\",\"statement\":\"Comply with the ethical requirements that apply to a financial statement audit, including independence.\",\"kind\":\"ethics\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-200.15\",\"standard_id\":\"ISA-200\",\"paragraph\":\"15\",\"topic\":\"Professional scepticism\",\"statement\":\"Plan and perform the audit with professional scepticism, recognising that circumstances may exist that cause the financial statements to be materially misstated.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-200.16\",\"standard_id\":\"ISA-200\",\"paragraph\":\"16\",\"topic\":\"Professional judgment\",\"statement\":\"Exercise professional judgment in planning and performing the audit.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-200.17\",\"standard_id\":\"ISA-200\",\"paragraph\":\"17\",\"topic\":\"Sufficient appropriate evidence\",\"statement\":\"Obtain sufficient appropriate audit evidence to reduce audit risk to an acceptably low level, so that reasonable conclusions can be drawn on which to base the opinion.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-200.18\",\"standard_id\":\"ISA-200\",\"paragraph\":\"18\",\"topic\":\"Comply with relevant ISAs\",\"statement\":\"Comply with every ISA that is relevant to the audit; an ISA is relevant when it is in effect and the circumstances it addresses exist.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-200.19\",\"standard_id\":\"ISA-200\",\"paragraph\":\"19\",\"topic\":\"Understand the entire text\",\"statement\":\"Understand the whole text of each relevant ISA, including its application material, so that its objectives are understood and its requirements applied properly.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-200.20\",\"standard_id\":\"ISA-200\",\"paragraph\":\"20\",\"topic\":\"No false claim of ISA compliance\",\"statement\":\"Do not state in the auditor's report that the audit complied with the ISAs unless the requirements of ISA 200 and of every other relevant ISA have been met.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-200.21\",\"standard_id\":\"ISA-200\",\"paragraph\":\"21\",\"topic\":\"Use of ISA objectives\",\"statement\":\"Use the objectives stated in the relevant ISAs, having regard to their interrelationships, to decide whether procedures beyond those the ISAs require are needed and to evaluate whether sufficient appropriate evidence has been obtained.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-200.22\",\"standard_id\":\"ISA-200\",\"paragraph\":\"22\",\"topic\":\"Comply with each requirement\",\"statement\":\"Comply with each requirement of a relevant ISA unless the whole ISA is not relevant, or the requirement is conditional and the condition is absent.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-200.23\",\"standard_id\":\"ISA-200\",\"paragraph\":\"23\",\"topic\":\"Departure from a requirement\",\"statement\":\"Where a departure from a relevant requirement is judged necessary, perform alternative procedures that achieve the aim of that requirement; departure is expected only where the requirement prescribes a specific procedure that would be ineffective in the circumstances.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The auditor judges it necessary, in exceptional circumstances, to depart from a relevant requirement.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-200.24\",\"standard_id\":\"ISA-200\",\"paragraph\":\"24\",\"topic\":\"Failure to achieve an objective\",\"statement\":\"If an ISA objective cannot be achieved, evaluate whether that prevents achieving the overall objectives and therefore requires a modified opinion or withdrawal; document the failure as a significant matter.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"An objective in a relevant ISA cannot be achieved.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-210.6\",\"standard_id\":\"ISA-210\",\"paragraph\":\"6\",\"topic\":\"Preconditions for an audit\",\"statement\":\"Establish that the preconditions for an audit are present: the financial reporting framework is acceptable, and management acknowledges its responsibility for preparing the financial statements, for the internal control it deems necessary, and for giving the auditor access to all relevant information, additional information requested, and unrestricted access to persons.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-210.7\",\"standard_id\":\"ISA-210\",\"paragraph\":\"7\",\"topic\":\"Scope limitation before acceptance\",\"statement\":\"Do not accept as an audit an engagement whose proposed terms carry a scope limitation the auditor believes would result in a disclaimer of opinion, unless law or regulation requires acceptance.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Management or those charged with governance impose a scope limitation in the proposed terms that would lead to a disclaimer.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-210.8\",\"standard_id\":\"ISA-210\",\"paragraph\":\"8\",\"topic\":\"Preconditions absent\",\"statement\":\"If the preconditions are absent, discuss the matter with management and, unless required by law or regulation, do not accept the engagement where the framework is unacceptable or management's acknowledgement of its responsibilities has not been obtained.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The preconditions for an audit are not present.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-210.9\",\"standard_id\":\"ISA-210\",\"paragraph\":\"9\",\"topic\":\"Agree the terms\",\"statement\":\"Agree the terms of the engagement with management or those charged with governance, as appropriate.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-210.10\",\"standard_id\":\"ISA-210\",\"paragraph\":\"10\",\"topic\":\"Engagement letter content\",\"statement\":\"Record the agreed terms in an engagement letter or other written agreement covering the objective and scope of the audit, the responsibilities of the auditor and of management, the applicable financial reporting framework, the expected form and content of reports, and a statement that a report may differ from its expected form.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-210.11\",\"standard_id\":\"ISA-210\",\"paragraph\":\"11\",\"topic\":\"Terms prescribed by law\",\"statement\":\"Where law or regulation prescribes the terms in sufficient detail, a written agreement need only record that the law applies and that management acknowledges its responsibilities.\",\"kind\":\"documentation\",\"conditional\":1,\"condition\":\"Law or regulation prescribes the engagement terms in sufficient detail.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-210.12\",\"standard_id\":\"ISA-210\",\"paragraph\":\"12\",\"topic\":\"Responsibilities described by law\",\"statement\":\"Where law or regulation prescribes management responsibilities equivalent in effect to those required, the wording of the law may be used; responsibilities not so prescribed are described in the standard's own terms.\",\"kind\":\"documentation\",\"conditional\":1,\"condition\":\"Law or regulation prescribes management responsibilities similar to those in paragraph 6(b).\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-210.13\",\"standard_id\":\"ISA-210\",\"paragraph\":\"13\",\"topic\":\"Recurring audits\",\"statement\":\"On a recurring audit, assess whether circumstances require the terms to be revised and whether the entity needs reminding of the existing terms.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-210.14\",\"standard_id\":\"ISA-210\",\"paragraph\":\"14\",\"topic\":\"No unjustified change of terms\",\"statement\":\"Do not agree to a change in the terms of the engagement without reasonable justification.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-210.15\",\"standard_id\":\"ISA-210\",\"paragraph\":\"15\",\"topic\":\"Request for lower assurance\",\"statement\":\"If asked before completion to change to an engagement conveying a lower level of assurance, determine whether there is reasonable justification.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The auditor is asked, before completion, to change the engagement to one conveying lower assurance.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-210.16\",\"standard_id\":\"ISA-210\",\"paragraph\":\"16\",\"topic\":\"Record changed terms\",\"statement\":\"If the terms are changed, agree and record the new terms in an engagement letter or other written agreement.\",\"kind\":\"documentation\",\"conditional\":1,\"condition\":\"The terms of the engagement are changed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-210.17\",\"standard_id\":\"ISA-210\",\"paragraph\":\"17\",\"topic\":\"Unable to agree a change\",\"statement\":\"If unable to agree a change and not permitted to continue, withdraw where possible and determine whether any obligation exists to report the circumstances to others such as those charged with governance, owners or regulators.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The auditor cannot agree to a change of terms and is not permitted to continue the original engagement.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-210.18\",\"standard_id\":\"ISA-210\",\"paragraph\":\"18\",\"topic\":\"Framework supplemented by law\",\"statement\":\"Where reporting standards are supplemented by law or regulation, determine whether conflicts exist and agree with management whether additional disclosure or an amended framework description resolves them; otherwise consider a modified opinion.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Financial reporting standards are supplemented by law or regulation.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-210.19\",\"standard_id\":\"ISA-210\",\"paragraph\":\"19\",\"topic\":\"Framework prescribed by law but unacceptable\",\"statement\":\"Accept an engagement under a legally prescribed but otherwise unacceptable framework only if management agrees to additional disclosures that avoid misleading statements and the terms recognise an emphasis-of-matter paragraph and the absence of fair-presentation wording.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The framework prescribed by law or regulation would otherwise be unacceptable.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-210.20\",\"standard_id\":\"ISA-210\",\"paragraph\":\"20\",\"topic\":\"Required to audit under a misleading framework\",\"statement\":\"Where the paragraph 19 conditions are absent yet law requires the audit, evaluate the effect of the misleading financial statements on the report and refer to the matter in the engagement terms.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The conditions in paragraph 19 are absent and law requires the audit.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-210.21\",\"standard_id\":\"ISA-210\",\"paragraph\":\"21\",\"topic\":\"Report format prescribed by law\",\"statement\":\"Where law prescribes a report form that differs significantly from the ISAs, evaluate whether users might misunderstand the assurance obtained and whether additional explanation mitigates that; if not, do not accept unless required by law, and never refer to the ISAs in such a report.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Law or regulation prescribes a report layout or wording significantly different from the ISAs.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-230.7\",\"standard_id\":\"ISA-230\",\"paragraph\":\"7\",\"topic\":\"Timely preparation\",\"statement\":\"Prepare audit documentation on a timely basis.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-230.8\",\"standard_id\":\"ISA-230\",\"paragraph\":\"8\",\"topic\":\"Experienced-auditor test\",\"statement\":\"Prepare documentation sufficient for an experienced auditor with no prior connection to the audit to understand the nature, timing and extent of procedures performed, their results and the evidence obtained, and the significant matters, conclusions and judgments.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-230.9\",\"standard_id\":\"ISA-230\",\"paragraph\":\"9\",\"topic\":\"Identifying characteristics, preparer, reviewer\",\"statement\":\"Record the identifying characteristics of the items tested, who performed the work and when, and who reviewed it, when, and to what extent.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-230.10\",\"standard_id\":\"ISA-230\",\"paragraph\":\"10\",\"topic\":\"Discussions of significant matters\",\"statement\":\"Document discussions of significant matters with management, those charged with governance and others, including their nature, timing and participants.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-230.11\",\"standard_id\":\"ISA-230\",\"paragraph\":\"11\",\"topic\":\"Inconsistent information\",\"statement\":\"Where information inconsistent with the final conclusion on a significant matter was identified, document how the inconsistency was addressed.\",\"kind\":\"documentation\",\"conditional\":1,\"condition\":\"Information inconsistent with the final conclusion on a significant matter was identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-230.12\",\"standard_id\":\"ISA-230\",\"paragraph\":\"12\",\"topic\":\"Departure from a requirement\",\"statement\":\"Where a relevant requirement is departed from, document how the alternative procedures achieve its aim and the reasons for the departure.\",\"kind\":\"documentation\",\"conditional\":1,\"condition\":\"The auditor departs from a relevant ISA requirement.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-230.13\",\"standard_id\":\"ISA-230\",\"paragraph\":\"13\",\"topic\":\"Procedures after the report date\",\"statement\":\"Where new procedures are performed or new conclusions drawn after the report date, document the circumstances, the procedures, evidence and conclusions and their effect on the report, and when and by whom the changes were made and reviewed.\",\"kind\":\"documentation\",\"conditional\":1,\"condition\":\"New or additional procedures are performed, or new conclusions drawn, after the report date.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-230.14\",\"standard_id\":\"ISA-230\",\"paragraph\":\"14\",\"topic\":\"Assemble the final file\",\"statement\":\"Assemble the final audit file on a timely basis after the date of the auditor's report.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-230.15\",\"standard_id\":\"ISA-230\",\"paragraph\":\"15\",\"topic\":\"No deletion before retention ends\",\"statement\":\"After final assembly, do not delete or discard any audit documentation before the end of its retention period.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-230.16\",\"standard_id\":\"ISA-230\",\"paragraph\":\"16\",\"topic\":\"Later modifications\",\"statement\":\"Where documentation is modified or added after final assembly, document the specific reasons and when and by whom the changes were made and reviewed.\",\"kind\":\"documentation\",\"conditional\":1,\"condition\":\"Documentation is modified or added after final assembly, other than under paragraph 13.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-300.5\",\"standard_id\":\"ISA-300\",\"paragraph\":\"5\",\"topic\":\"Key team members in planning\",\"statement\":\"The engagement partner and other key team members are involved in planning, including the engagement team discussion.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-300.6\",\"standard_id\":\"ISA-300\",\"paragraph\":\"6\",\"topic\":\"Preliminary engagement activities\",\"statement\":\"At the start of the engagement perform the acceptance and continuance procedures, evaluate compliance with ethical requirements including independence, and establish an understanding of the engagement terms.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-300.7\",\"standard_id\":\"ISA-300\",\"paragraph\":\"7\",\"topic\":\"Overall audit strategy\",\"statement\":\"Establish an overall audit strategy that sets the scope, timing and direction of the audit and guides the audit plan.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-300.8\",\"standard_id\":\"ISA-300\",\"paragraph\":\"8\",\"topic\":\"Content of the strategy\",\"statement\":\"In setting the strategy, identify the engagement characteristics that define its scope, the reporting objectives and timing, the factors that direct the team's efforts, the results of preliminary activities and relevant knowledge from other engagements, and the resources needed.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-300.9\",\"standard_id\":\"ISA-300\",\"paragraph\":\"9\",\"topic\":\"Audit plan\",\"statement\":\"Develop an audit plan describing the planned direction, supervision and review, the planned risk assessment procedures, the planned further procedures at the assertion level, and other procedures required for ISA compliance.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-300.10\",\"standard_id\":\"ISA-300\",\"paragraph\":\"10\",\"topic\":\"Update the plan\",\"statement\":\"Update and change the overall strategy and the audit plan as necessary during the audit.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-300.11\",\"standard_id\":\"ISA-300\",\"paragraph\":\"11\",\"topic\":\"Partner review of strategy and plan\",\"statement\":\"The engagement partner reviews the overall audit strategy and audit plan.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-300.12\",\"standard_id\":\"ISA-300\",\"paragraph\":\"12\",\"topic\":\"Documentation of planning\",\"statement\":\"Document the overall strategy, the audit plan, and any significant changes to either during the audit with the reasons.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-300.13\",\"standard_id\":\"ISA-300\",\"paragraph\":\"13\",\"topic\":\"Initial engagements\",\"statement\":\"Before starting an initial audit, perform the acceptance procedures and communicate with the predecessor auditor where there has been a change of auditors, in compliance with ethical requirements.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The engagement is an initial audit.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-320.10\",\"standard_id\":\"ISA-320\",\"paragraph\":\"10\",\"topic\":\"Materiality for the financial statements as a whole\",\"statement\":\"When establishing the overall audit strategy, determine materiality for the financial statements as a whole; where misstatements below that amount in particular classes of transactions, balances or disclosures could reasonably influence users, also determine the materiality level or levels for those items.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-320.11\",\"standard_id\":\"ISA-320\",\"paragraph\":\"11\",\"topic\":\"Performance materiality\",\"statement\":\"Determine performance materiality for the purpose of assessing the risks of material misstatement and determining the nature, timing and extent of further procedures.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-320.12\",\"standard_id\":\"ISA-320\",\"paragraph\":\"12\",\"topic\":\"Revision during the audit\",\"statement\":\"Revise materiality for the financial statements as a whole, and any specific materiality levels, on becoming aware of information that would have caused a different amount to be determined initially.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Information becomes known during the audit that would have led to a different initial determination.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-320.13\",\"standard_id\":\"ISA-320\",\"paragraph\":\"13\",\"topic\":\"Consequences of a lower materiality\",\"statement\":\"Where a lower materiality is appropriate, determine whether performance materiality must be revised and whether the nature, timing and extent of further procedures remain appropriate.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The auditor concludes that a lower materiality is appropriate.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-320.14\",\"standard_id\":\"ISA-320\",\"paragraph\":\"14\",\"topic\":\"Documentation of materiality\",\"statement\":\"Document materiality for the financial statements as a whole, any specific materiality levels, performance materiality, any revisions during the audit, and the factors considered in determining each.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-450.5\",\"standard_id\":\"ISA-450\",\"paragraph\":\"5\",\"topic\":\"Accumulate misstatements\",\"statement\":\"Accumulate all misstatements identified during the audit other than those that are clearly trivial.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-450.6\",\"standard_id\":\"ISA-450\",\"paragraph\":\"6\",\"topic\":\"Reconsider the plan\",\"statement\":\"Determine whether the strategy and plan need revising when the nature of identified misstatements suggests others may exist that could be material in aggregate, or when accumulated misstatements approach materiality.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-450.7\",\"standard_id\":\"ISA-450\",\"paragraph\":\"7\",\"topic\":\"After management corrects at the auditor's request\",\"statement\":\"Where management has corrected misstatements in an area examined at the auditor's request, perform additional procedures to determine whether misstatements remain.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Management has examined a class of transactions, balance or disclosure at the auditor's request and corrected detected misstatements.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-450.8\",\"standard_id\":\"ISA-450\",\"paragraph\":\"8\",\"topic\":\"Communicate and request correction\",\"statement\":\"Communicate all accumulated misstatements to the appropriate level of management on a timely basis, unless prohibited by law, and request that they be corrected.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-450.9\",\"standard_id\":\"ISA-450\",\"paragraph\":\"9\",\"topic\":\"Management refuses to correct\",\"statement\":\"Where management refuses to correct misstatements, understand its reasons and take that understanding into account when evaluating whether the financial statements as a whole are free from material misstatement.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Management refuses to correct some or all communicated misstatements.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-450.10\",\"standard_id\":\"ISA-450\",\"paragraph\":\"10\",\"topic\":\"Reassess materiality\",\"statement\":\"Before evaluating uncorrected misstatements, reassess materiality to confirm it remains appropriate in the light of the entity's actual financial results.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-450.11\",\"standard_id\":\"ISA-450\",\"paragraph\":\"11\",\"topic\":\"Are uncorrected misstatements material\",\"statement\":\"Determine whether uncorrected misstatements are material individually or in aggregate, considering their size and nature relative to particular items and to the financial statements as a whole, the circumstances of their occurrence, and the effect of uncorrected prior-period misstatements.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-450.12\",\"standard_id\":\"ISA-450\",\"paragraph\":\"12\",\"topic\":\"Communicate to those charged with governance\",\"statement\":\"Communicate uncorrected misstatements and their possible effect on the opinion to those charged with governance, unless prohibited by law, identifying material uncorrected misstatements individually, and request their correction.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-450.13\",\"standard_id\":\"ISA-450\",\"paragraph\":\"13\",\"topic\":\"Prior-period effect\",\"statement\":\"Communicate to those charged with governance the effect of uncorrected misstatements relating to prior periods.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-450.14\",\"standard_id\":\"ISA-450\",\"paragraph\":\"14\",\"topic\":\"Written representation\",\"statement\":\"Request a written representation from management and, where appropriate, those charged with governance that they believe the effects of uncorrected misstatements are immaterial individually and in aggregate, with a summary of those items included in or attached to the representation.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-450.15\",\"standard_id\":\"ISA-450\",\"paragraph\":\"15\",\"topic\":\"Documentation of misstatements\",\"statement\":\"Document the clearly trivial threshold, all accumulated misstatements and whether corrected, and the conclusion on whether uncorrected misstatements are material with its basis.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-500.6\",\"standard_id\":\"ISA-500\",\"paragraph\":\"6\",\"topic\":\"Design procedures for sufficient appropriate evidence\",\"statement\":\"Design and perform audit procedures appropriate in the circumstances for the purpose of obtaining sufficient appropriate audit evidence.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-500.7\",\"standard_id\":\"ISA-500\",\"paragraph\":\"7\",\"topic\":\"Relevance and reliability of information\",\"statement\":\"When designing and performing procedures, consider the relevance and reliability of the information to be used as evidence, including information from external information sources.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-500.8\",\"standard_id\":\"ISA-500\",\"paragraph\":\"8\",\"topic\":\"Management's expert\",\"statement\":\"Where evidence relies on the work of a management's expert, evaluate the expert's competence, capabilities and objectivity, understand the expert's work, and evaluate its appropriateness as evidence for the relevant assertion, to the extent the work is significant.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Information to be used as evidence was prepared using the work of a management's expert.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-500.9\",\"standard_id\":\"ISA-500\",\"paragraph\":\"9\",\"topic\":\"Entity-produced information\",\"statement\":\"When using information produced by the entity, evaluate whether it is sufficiently reliable, obtaining evidence about its accuracy and completeness and evaluating whether it is sufficiently precise and detailed.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Information produced by the entity is used as evidence.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-500.10\",\"standard_id\":\"ISA-500\",\"paragraph\":\"10\",\"topic\":\"Selecting items for testing\",\"statement\":\"When designing tests of controls and tests of details, determine means of selecting items for testing that are effective in meeting the purpose of the procedure: all items, specific items, or audit sampling.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-500.11\",\"standard_id\":\"ISA-500\",\"paragraph\":\"11\",\"topic\":\"Inconsistent or doubtful evidence\",\"statement\":\"Where evidence from different sources is inconsistent or reliability is in doubt, determine what modifications or additions to procedures are needed to resolve the matter and consider its effect on other aspects of the audit.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Evidence from one source is inconsistent with another, or reliability of information is in doubt.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-520.5\",\"standard_id\":\"ISA-520\",\"paragraph\":\"5\",\"topic\":\"Design of substantive analytical procedures\",\"statement\":\"When designing substantive analytical procedures, determine their suitability for the assertions given the assessed risks and any tests of details, evaluate the reliability of the data behind the expectation (source, comparability, nature, relevance and controls over preparation), develop an expectation precise enough to identify a material misstatement, and set the difference from the expectation that is acceptable without investigation.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-520.6\",\"standard_id\":\"ISA-520\",\"paragraph\":\"6\",\"topic\":\"Overall-conclusion analytics\",\"statement\":\"Near the end of the audit, design and perform analytical procedures that assist in forming an overall conclusion on whether the financial statements are consistent with the auditor's understanding of the entity.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-520.7\",\"standard_id\":\"ISA-520\",\"paragraph\":\"7\",\"topic\":\"Investigate differences\",\"statement\":\"Investigate significant differences or inconsistent relationships by inquiring of management and corroborating its responses, and by performing other procedures as necessary.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Analytical procedures identify fluctuations or relationships inconsistent with other information or that differ significantly from expected values.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-530.6\",\"standard_id\":\"ISA-530\",\"paragraph\":\"6\",\"topic\":\"Purpose and population\",\"statement\":\"When designing a sample, consider the purpose of the procedure and the characteristics of the population from which the sample will be drawn.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-530.7\",\"standard_id\":\"ISA-530\",\"paragraph\":\"7\",\"topic\":\"Sample size\",\"statement\":\"Determine a sample size sufficient to reduce sampling risk to an acceptably low level.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-530.8\",\"standard_id\":\"ISA-530\",\"paragraph\":\"8\",\"topic\":\"Selection gives every unit a chance\",\"statement\":\"Select items so that each sampling unit in the population has a chance of selection.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-530.9\",\"standard_id\":\"ISA-530\",\"paragraph\":\"9\",\"topic\":\"Perform the procedure on every item\",\"statement\":\"Perform procedures appropriate to the purpose on each item selected.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-530.10\",\"standard_id\":\"ISA-530\",\"paragraph\":\"10\",\"topic\":\"Replacement item\",\"statement\":\"Where the procedure is not applicable to a selected item, perform it on a replacement item.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The procedure is not applicable to a selected item.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-530.11\",\"standard_id\":\"ISA-530\",\"paragraph\":\"11\",\"topic\":\"Unable to apply procedures\",\"statement\":\"Where neither the designed nor a suitable alternative procedure can be applied to a selected item, treat it as a deviation (tests of controls) or a misstatement (tests of details).\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The designed procedures or suitable alternatives cannot be applied to a selected item.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-530.12\",\"standard_id\":\"ISA-530\",\"paragraph\":\"12\",\"topic\":\"Nature and cause\",\"statement\":\"Investigate the nature and cause of any deviations or misstatements identified and evaluate their possible effect on the purpose of the procedure and on other areas of the audit.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-530.13\",\"standard_id\":\"ISA-530\",\"paragraph\":\"13\",\"topic\":\"Anomalies\",\"statement\":\"Treat a misstatement or deviation as an anomaly only after obtaining a high degree of certainty, through additional procedures, that it is not representative of the population.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The auditor considers a misstatement or deviation to be an anomaly.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-530.14\",\"standard_id\":\"ISA-530\",\"paragraph\":\"14\",\"topic\":\"Project misstatements\",\"statement\":\"For tests of details, project misstatements found in the sample to the population.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-530.15\",\"standard_id\":\"ISA-530\",\"paragraph\":\"15\",\"topic\":\"Evaluate results\",\"statement\":\"Evaluate the results of the sample and whether the use of sampling has provided a reasonable basis for conclusions about the population tested.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-265.7\",\"standard_id\":\"ISA-265\",\"paragraph\":\"7\",\"topic\":\"Identify deficiencies\",\"statement\":\"Determine, on the basis of the audit work performed, whether one or more deficiencies in internal control have been identified.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-265.8\",\"standard_id\":\"ISA-265\",\"paragraph\":\"8\",\"topic\":\"Significant deficiencies\",\"statement\":\"Where deficiencies were identified, determine whether individually or in combination they constitute significant deficiencies.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"One or more deficiencies were identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-265.9\",\"standard_id\":\"ISA-265\",\"paragraph\":\"9\",\"topic\":\"Written communication to those charged with governance\",\"statement\":\"Communicate significant deficiencies identified during the audit in writing to those charged with governance on a timely basis.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-265.10\",\"standard_id\":\"ISA-265\",\"paragraph\":\"10\",\"topic\":\"Communication to management\",\"statement\":\"Communicate to management at an appropriate level, on a timely basis, significant deficiencies in writing (unless inappropriate) and other deficiencies of sufficient importance to merit management's attention that others have not already communicated.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-265.11\",\"standard_id\":\"ISA-265\",\"paragraph\":\"11\",\"topic\":\"Content of the written communication\",\"statement\":\"In the written communication describe the deficiencies and their potential effects, and explain that the audit's purpose was to opine on the financial statements, that internal control was considered only to design procedures and not to opine on its effectiveness, and that the matters reported are limited to deficiencies identified and judged important enough to report.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.13\",\"standard_id\":\"ISA-220\",\"paragraph\":\"13\",\"topic\":\"Partner responsibility for quality\",\"statement\":\"The engagement partner takes overall responsibility for managing and achieving quality on the engagement, creating an environment that emphasises the firm's culture and expected behaviour, and is sufficiently involved throughout to have a basis for judging that significant judgments and conclusions are appropriate.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.14\",\"standard_id\":\"ISA-220\",\"paragraph\":\"14\",\"topic\":\"Expected behaviour of the team\",\"statement\":\"The engagement partner takes responsibility for clear, consistent and effective actions that establish and communicate expected behaviour: shared responsibility for quality, professional ethics and values, open communication without fear of reprisal, and professional scepticism throughout.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.15\",\"standard_id\":\"ISA-220\",\"paragraph\":\"15\",\"topic\":\"Assigning tasks does not transfer responsibility\",\"statement\":\"Where quality-related tasks are assigned to other team members, the partner retains overall responsibility through direction, supervision and review of their work.\",\"kind\":\"quality\",\"conditional\":1,\"condition\":\"The partner assigns the design or performance of quality-related tasks to other team members.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.16\",\"standard_id\":\"ISA-220\",\"paragraph\":\"16\",\"topic\":\"Understand ethical requirements\",\"statement\":\"The engagement partner understands the ethical requirements, including independence, that apply given the nature and circumstances of the engagement.\",\"kind\":\"ethics\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.17\",\"standard_id\":\"ISA-220\",\"paragraph\":\"17\",\"topic\":\"Team awareness of ethical requirements\",\"statement\":\"The engagement partner takes responsibility for the team being made aware of the applicable ethical requirements and the firm's related policies, including identifying and addressing threats, circumstances that may cause breaches and responsibilities on becoming aware of them, and responsibilities on learning of non-compliance with laws and regulations by the entity.\",\"kind\":\"ethics\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.18\",\"standard_id\":\"ISA-220\",\"paragraph\":\"18\",\"topic\":\"Threats to compliance\",\"statement\":\"Where a threat to ethical compliance is indicated, evaluate it under the firm's policies using information from the firm, the team and other sources, and take appropriate action.\",\"kind\":\"ethics\",\"conditional\":1,\"condition\":\"Matters indicating a threat to compliance with ethical requirements come to the partner's attention.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.19\",\"standard_id\":\"ISA-220\",\"paragraph\":\"19\",\"topic\":\"Alertness to breaches\",\"statement\":\"Remain alert throughout the engagement, through observation and inquiry, for breaches of ethical requirements or the firm's policies by team members.\",\"kind\":\"ethics\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.20\",\"standard_id\":\"ISA-220\",\"paragraph\":\"20\",\"topic\":\"Ethical requirements not fulfilled\",\"statement\":\"Where information indicates that ethical requirements have not been fulfilled, take appropriate action in consultation with others in the firm.\",\"kind\":\"ethics\",\"conditional\":1,\"condition\":\"Matters indicate that applicable ethical requirements have not been fulfilled.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.21\",\"standard_id\":\"ISA-220\",\"paragraph\":\"21\",\"topic\":\"Independence conclusion before dating the report\",\"statement\":\"Before dating the report, determine whether the applicable ethical requirements, including independence, have been fulfilled.\",\"kind\":\"ethics\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.22\",\"standard_id\":\"ISA-220\",\"paragraph\":\"22\",\"topic\":\"Acceptance and continuance procedures followed\",\"statement\":\"Determine that the firm's acceptance and continuance policies were followed and that the conclusions reached are appropriate.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.23\",\"standard_id\":\"ISA-220\",\"paragraph\":\"23\",\"topic\":\"Use acceptance information in planning\",\"statement\":\"Take account of information obtained in acceptance and continuance when planning and performing the engagement.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.24\",\"standard_id\":\"ISA-220\",\"paragraph\":\"24\",\"topic\":\"Information that would have led to declining\",\"statement\":\"Where the team learns of information that might have led the firm to decline the engagement, communicate it promptly to the firm so that necessary action can be taken.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"The team becomes aware of information that might have caused the firm to decline the engagement.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.25\",\"standard_id\":\"ISA-220\",\"paragraph\":\"25\",\"topic\":\"Sufficient appropriate resources\",\"statement\":\"Determine that sufficient and appropriate resources are assigned or made available in a timely manner, taking into account the engagement's nature and circumstances, the firm's policies and any changes during the engagement.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.26\",\"standard_id\":\"ISA-220\",\"paragraph\":\"26\",\"topic\":\"Collective competence and capabilities\",\"statement\":\"Determine that the team, together with any auditor's external experts and internal auditors providing direct assistance, collectively has the competence, capabilities and time to perform the engagement.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.27\",\"standard_id\":\"ISA-220\",\"paragraph\":\"27\",\"topic\":\"Insufficient resources\",\"statement\":\"Where resources are insufficient or inappropriate, take appropriate action, including communicating the need for additional or alternative resources.\",\"kind\":\"quality\",\"conditional\":1,\"condition\":\"Resources are determined to be insufficient or inappropriate.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.28\",\"standard_id\":\"ISA-220\",\"paragraph\":\"28\",\"topic\":\"Appropriate use of resources\",\"statement\":\"Take responsibility for using the assigned resources appropriately given the nature and circumstances of the engagement.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.29\",\"standard_id\":\"ISA-220\",\"paragraph\":\"29\",\"topic\":\"Direction, supervision and review\",\"statement\":\"Take responsibility for the direction and supervision of the team and the review of its work.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.30\",\"standard_id\":\"ISA-220\",\"paragraph\":\"30\",\"topic\":\"Nature, timing and extent of direction and review\",\"statement\":\"Determine that direction, supervision and review are planned and performed under the firm's policies, professional standards and legal requirements, and are responsive to the engagement's circumstances and resources.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.31\",\"standard_id\":\"ISA-220\",\"paragraph\":\"31\",\"topic\":\"Partner review of documentation\",\"statement\":\"Review audit documentation at appropriate points during the engagement, including documentation of significant matters, significant judgments and difficult or contentious matters, and other matters relevant to the partner's responsibilities.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.32\",\"standard_id\":\"ISA-220\",\"paragraph\":\"32\",\"topic\":\"Sufficient evidence before the report\",\"statement\":\"On or before the report date, determine through review of documentation and discussion with the team that sufficient appropriate evidence supports the conclusions and the report.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.33\",\"standard_id\":\"ISA-220\",\"paragraph\":\"33\",\"topic\":\"Review of financial statements and report\",\"statement\":\"Before dating the report, review the financial statements and the auditor's report, including any key audit matters and related documentation, to determine that the report is appropriate.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.34\",\"standard_id\":\"ISA-220\",\"paragraph\":\"34\",\"topic\":\"Review of formal written communications\",\"statement\":\"Review formal written communications to management, those charged with governance or regulators before they are issued.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.35\",\"standard_id\":\"ISA-220\",\"paragraph\":\"35\",\"topic\":\"Consultation\",\"statement\":\"Take responsibility for consultation on difficult or contentious matters and matters the firm requires to be consulted on; determine that appropriate consultation occurred, that its nature, scope and conclusions were agreed with the party consulted, and that agreed conclusions were implemented.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.36\",\"standard_id\":\"ISA-220\",\"paragraph\":\"36\",\"topic\":\"Engagement quality review\",\"statement\":\"Where an engagement quality review is required, determine that a reviewer has been appointed, cooperate with the reviewer and require the team to do so, discuss significant matters and judgments with the reviewer, and do not date the report until the review is complete.\",\"kind\":\"quality\",\"conditional\":1,\"condition\":\"An engagement quality review is required.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.37\",\"standard_id\":\"ISA-220\",\"paragraph\":\"37\",\"topic\":\"Differences of opinion\",\"statement\":\"Where differences of opinion arise, follow the firm's policies for dealing with and resolving them.\",\"kind\":\"quality\",\"conditional\":1,\"condition\":\"Differences of opinion arise within the team or with the reviewer or others in the firm.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.38\",\"standard_id\":\"ISA-220\",\"paragraph\":\"38\",\"topic\":\"Resolution before dating the report\",\"statement\":\"Take responsibility for differences of opinion being resolved under the firm's policies, determine that conclusions are documented and implemented, and do not date the report until they are resolved.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.39\",\"standard_id\":\"ISA-220\",\"paragraph\":\"39\",\"topic\":\"Monitoring and remediation information\",\"statement\":\"Understand the information from the firm's (and network's) monitoring and remediation process, determine its relevance and effect on the engagement and act on it, and remain alert for information relevant to that process and communicate it.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.40\",\"standard_id\":\"ISA-220\",\"paragraph\":\"40\",\"topic\":\"Stand-back on overall responsibility\",\"statement\":\"Before dating the report, determine that overall responsibility for quality has been taken: that the partner's involvement was sufficient and appropriate, and that the engagement's circumstances, changes and the firm's policies were taken into account.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220.41\",\"standard_id\":\"ISA-220\",\"paragraph\":\"41\",\"topic\":\"Documentation of quality management\",\"statement\":\"Document the matters identified, discussions and conclusions on ethical requirements including independence and on acceptance and continuance; the nature, scope and conclusions of consultations and how they were implemented; and, where applicable, that the engagement quality review was completed on or before the report date.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-250.13\",\"standard_id\":\"ISA-250\",\"paragraph\":\"13\",\"topic\":\"Understand the legal framework\",\"statement\":\"As part of understanding the entity, obtain a general understanding of the legal and regulatory framework applicable to the entity and its industry, and how the entity complies with it.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-250.14\",\"standard_id\":\"ISA-250\",\"paragraph\":\"14\",\"topic\":\"Laws with a direct effect\",\"statement\":\"Obtain sufficient appropriate evidence about compliance with those laws and regulations generally recognised to have a direct effect on material amounts and disclosures in the financial statements.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-250.15\",\"standard_id\":\"ISA-250\",\"paragraph\":\"15\",\"topic\":\"Procedures for other laws\",\"statement\":\"To help identify non-compliance with other laws that may materially affect the financial statements, inquire of management and, where appropriate, those charged with governance about compliance, and inspect any correspondence with licensing or regulatory authorities.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-250.16\",\"standard_id\":\"ISA-250\",\"paragraph\":\"16\",\"topic\":\"Remain alert\",\"statement\":\"Remain alert during the audit to the possibility that other procedures bring instances of non-compliance or suspected non-compliance to the auditor's attention.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-250.17\",\"standard_id\":\"ISA-250\",\"paragraph\":\"17\",\"topic\":\"Written representation on non-compliance\",\"statement\":\"Request written representations that all known instances of non-compliance or suspected non-compliance whose effects should be considered in preparing the financial statements have been disclosed to the auditor.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-250.18\",\"standard_id\":\"ISA-250\",\"paragraph\":\"18\",\"topic\":\"No further procedures absent indications\",\"statement\":\"In the absence of identified or suspected non-compliance, no procedures on compliance beyond those in paragraphs 13 to 17 are required.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-250.19\",\"standard_id\":\"ISA-250\",\"paragraph\":\"19\",\"topic\":\"Understand suspected non-compliance\",\"statement\":\"On becoming aware of non-compliance or suspected non-compliance, obtain an understanding of the nature of the act and its circumstances and further information to evaluate the possible effect on the financial statements.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Information about non-compliance or suspected non-compliance comes to the auditor's attention.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-250.20\",\"standard_id\":\"ISA-250\",\"paragraph\":\"20\",\"topic\":\"Discuss with management; legal advice\",\"statement\":\"Where non-compliance is suspected, discuss it with the appropriate level of management and where appropriate those charged with governance, unless prohibited by law; if they do not provide sufficient support for compliance and the effect may be material, consider obtaining legal advice.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"The auditor suspects non-compliance.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-250.21\",\"standard_id\":\"ISA-250\",\"paragraph\":\"21\",\"topic\":\"Insufficient information\",\"statement\":\"Where sufficient information about suspected non-compliance cannot be obtained, evaluate the effect of the lack of evidence on the opinion.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Sufficient information about suspected non-compliance cannot be obtained.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-250.22\",\"standard_id\":\"ISA-250\",\"paragraph\":\"22\",\"topic\":\"Implications for the rest of the audit\",\"statement\":\"Evaluate the implications of identified or suspected non-compliance for other aspects of the audit, including the risk assessment and the reliability of written representations, and take appropriate action.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-250.23\",\"standard_id\":\"ISA-250\",\"paragraph\":\"23\",\"topic\":\"Communicate with those charged with governance\",\"statement\":\"Unless all of those charged with governance are involved in management and already informed, communicate with them, unless prohibited by law, the matters involving non-compliance that come to the auditor's attention, other than clearly inconsequential matters.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-250.24\",\"standard_id\":\"ISA-250\",\"paragraph\":\"24\",\"topic\":\"Intentional and material non-compliance\",\"statement\":\"Where non-compliance is believed intentional and material, communicate it to those charged with governance as soon as practicable.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"The non-compliance is believed to be intentional and material.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-250.25\",\"standard_id\":\"ISA-250\",\"paragraph\":\"25\",\"topic\":\"Involvement of management or governance\",\"statement\":\"Where management or those charged with governance are suspected of involvement, communicate to the next higher level of authority if one exists; otherwise, or if communication may not be acted upon, consider obtaining legal advice.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Management or those charged with governance are suspected of involvement.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-250.26\",\"standard_id\":\"ISA-250\",\"paragraph\":\"26\",\"topic\":\"Material effect not reflected\",\"statement\":\"Where identified or suspected non-compliance has a material effect not adequately reflected in the financial statements, express a qualified or adverse opinion.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Non-compliance has a material effect not adequately reflected in the financial statements.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-250.27\",\"standard_id\":\"ISA-250\",\"paragraph\":\"27\",\"topic\":\"Precluded from obtaining evidence\",\"statement\":\"Where the auditor is precluded by management or governance from obtaining evidence to evaluate possibly material non-compliance, express a qualified opinion or disclaim an opinion for scope limitation.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Management or those charged with governance preclude the auditor from obtaining evidence about possibly material non-compliance.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-250.28\",\"standard_id\":\"ISA-250\",\"paragraph\":\"28\",\"topic\":\"Limitation imposed by circumstances\",\"statement\":\"Where circumstances rather than management prevent determining whether non-compliance occurred, evaluate the effect on the opinion under ISA 705.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The auditor cannot determine whether non-compliance occurred because of circumstances rather than management.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-250.29\",\"standard_id\":\"ISA-250\",\"paragraph\":\"29\",\"topic\":\"Reporting to an outside authority\",\"statement\":\"Determine whether law, regulation or ethical requirements require reporting identified or suspected non-compliance to an appropriate authority outside the entity, or establish responsibilities under which such reporting may be appropriate.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Non-compliance has been identified or is suspected.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-250.30\",\"standard_id\":\"ISA-250\",\"paragraph\":\"30\",\"topic\":\"Documentation of non-compliance\",\"statement\":\"Document identified or suspected non-compliance, the procedures performed, the significant judgments and conclusions, and the discussions with management, those charged with governance and others, including their responses.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-260.11\",\"standard_id\":\"ISA-260\",\"paragraph\":\"11\",\"topic\":\"Determine whom to communicate with\",\"statement\":\"Determine the appropriate person or persons within the governance structure with whom to communicate.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-260.12\",\"standard_id\":\"ISA-260\",\"paragraph\":\"12\",\"topic\":\"Communication with a subgroup\",\"statement\":\"Where communication is with a subgroup or individual, determine whether communication with the governing body is also needed.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The auditor communicates with a subgroup such as an audit committee or an individual.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-260.13\",\"standard_id\":\"ISA-260\",\"paragraph\":\"13\",\"topic\":\"All governance involved in management\",\"statement\":\"Where all those charged with governance manage the entity, matters communicated to them in their management capacity need not be repeated, provided the communication adequately informs everyone who would otherwise be addressed in a governance capacity.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"All of those charged with governance are involved in managing the entity.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-260.14\",\"standard_id\":\"ISA-260\",\"paragraph\":\"14\",\"topic\":\"Auditor's responsibilities\",\"statement\":\"Communicate the auditor's responsibilities for the audit: forming and expressing an opinion on financial statements prepared by management with governance oversight, and that the audit does not relieve management or governance of their responsibilities.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-260.15\",\"standard_id\":\"ISA-260\",\"paragraph\":\"15\",\"topic\":\"Planned scope and timing\",\"statement\":\"Communicate an overview of the planned scope and timing of the audit, including the significant risks identified.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-260.16\",\"standard_id\":\"ISA-260\",\"paragraph\":\"16\",\"topic\":\"Significant findings\",\"statement\":\"Communicate the auditor's views on significant qualitative aspects of accounting practices, significant difficulties encountered, significant matters discussed with management and representations requested (unless all governance manage the entity), circumstances affecting the form and content of the report, and other significant matters relevant to oversight of financial reporting.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-260.17\",\"standard_id\":\"ISA-260\",\"paragraph\":\"17\",\"topic\":\"Ethical requirements applied\",\"statement\":\"Communicate the ethical requirements, including independence, applied on the engagement, including any independence requirements specific to certain entities.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-260.18\",\"standard_id\":\"ISA-260\",\"paragraph\":\"18\",\"topic\":\"Independence communication for listed entities\",\"statement\":\"For listed entities, communicate a statement of compliance with independence requirements by the team, firm and network firms; all relationships and matters that may reasonably bear on independence, including total fees for audit and non-audit services by category; and the actions taken to address threats not at an acceptable level.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"The entity is listed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-260.19\",\"standard_id\":\"ISA-260\",\"paragraph\":\"19\",\"topic\":\"Form, timing and content of communications\",\"statement\":\"Communicate the form, timing and expected general content of communications.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-260.20\",\"standard_id\":\"ISA-260\",\"paragraph\":\"20\",\"topic\":\"Written communication of significant findings\",\"statement\":\"Communicate significant findings in writing where oral communication would not be adequate; written communications need not include every matter that arose.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Oral communication would not be adequate.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-260.21\",\"standard_id\":\"ISA-260\",\"paragraph\":\"21\",\"topic\":\"Written independence communication\",\"statement\":\"Communicate in writing on independence where paragraph 18 requires.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Paragraph 18 applies.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-260.22\",\"standard_id\":\"ISA-260\",\"paragraph\":\"22\",\"topic\":\"Timely communication\",\"statement\":\"Communicate with those charged with governance on a timely basis.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-260.23\",\"standard_id\":\"ISA-260\",\"paragraph\":\"23\",\"topic\":\"Adequacy of two-way communication\",\"statement\":\"Evaluate whether two-way communication with those charged with governance has been adequate for the audit; if not, evaluate the effect on the risk assessment and on the ability to obtain sufficient appropriate evidence, and act accordingly.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-260.24\",\"standard_id\":\"ISA-260\",\"paragraph\":\"24\",\"topic\":\"Documentation of communications\",\"statement\":\"Document oral communications of required matters, including when and to whom; retain copies of written communications.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-501.4\",\"standard_id\":\"ISA-501\",\"paragraph\":\"4\",\"topic\":\"Attendance at inventory counting\",\"statement\":\"Where inventory is material, obtain evidence of its existence and condition by attending the physical count unless impracticable: evaluate management's count instructions, observe the count, inspect the inventory and perform test counts; and test the final inventory records against the count results.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Inventory is material.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-501.5\",\"standard_id\":\"ISA-501\",\"paragraph\":\"5\",\"topic\":\"Count at a date other than the period end\",\"statement\":\"Where the count date differs from the financial statement date, perform procedures to obtain evidence that movements between the count date and the period end are properly recorded.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The physical count is at a date other than the financial statement date.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-501.6\",\"standard_id\":\"ISA-501\",\"paragraph\":\"6\",\"topic\":\"Unable to attend for unforeseen reasons\",\"statement\":\"Where unforeseen circumstances prevent attendance, make or observe some physical counts on an alternative date and perform procedures on intervening transactions.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Attendance is prevented by unforeseen circumstances.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-501.7\",\"standard_id\":\"ISA-501\",\"paragraph\":\"7\",\"topic\":\"Attendance impracticable\",\"statement\":\"Where attendance is impracticable, perform alternative procedures to obtain sufficient appropriate evidence of existence and condition; if that is not possible, modify the opinion.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Attendance at the count is impracticable.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-501.8\",\"standard_id\":\"ISA-501\",\"paragraph\":\"8\",\"topic\":\"Inventory held by third parties\",\"statement\":\"Where material inventory is held by a third party, obtain evidence of existence and condition by confirmation from the third party of quantities and condition, by inspection or other procedures, or both.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Inventory in the custody of a third party is material.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-501.9\",\"standard_id\":\"ISA-501\",\"paragraph\":\"9\",\"topic\":\"Identify litigation and claims\",\"statement\":\"Design and perform procedures to identify litigation and claims that may give rise to a risk of material misstatement: inquire of management and others including in-house counsel, review governance minutes and correspondence with external counsel, and review legal expense accounts.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-501.10\",\"standard_id\":\"ISA-501\",\"paragraph\":\"10\",\"topic\":\"Direct communication with external counsel\",\"statement\":\"Where a risk of material misstatement from litigation is assessed or other material litigation may exist, seek direct communication with external legal counsel through a letter of inquiry prepared by management and sent by the auditor; perform alternative procedures if direct communication is prohibited.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"A risk of material misstatement regarding litigation is assessed, or procedures indicate other material litigation may exist.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-501.11\",\"standard_id\":\"ISA-501\",\"paragraph\":\"11\",\"topic\":\"Refusal or inability regarding counsel\",\"statement\":\"Where management refuses permission to communicate with counsel or counsel does not respond appropriately, and alternative procedures do not yield sufficient appropriate evidence, modify the opinion.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Management refuses permission or counsel does not respond, and alternative procedures do not provide sufficient evidence.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-501.12\",\"standard_id\":\"ISA-501\",\"paragraph\":\"12\",\"topic\":\"Representation on litigation\",\"statement\":\"Request written representations that all known actual or possible litigation and claims whose effects should be considered have been disclosed to the auditor and accounted for and disclosed under the framework.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-501.13\",\"standard_id\":\"ISA-501\",\"paragraph\":\"13\",\"topic\":\"Segment information\",\"statement\":\"Obtain sufficient appropriate evidence on the presentation and disclosure of segment information by understanding management's methods, evaluating whether they are likely to produce compliant disclosure, testing their application where appropriate, and performing analytical or other procedures.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-505.7\",\"standard_id\":\"ISA-505\",\"paragraph\":\"7\",\"topic\":\"Control over confirmation requests\",\"statement\":\"When using external confirmations, maintain control over the requests: determine the information to be confirmed, select the confirming party, design requests that are properly addressed with responses returned directly to the auditor, and send the requests and any follow-ups.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-505.8\",\"standard_id\":\"ISA-505\",\"paragraph\":\"8\",\"topic\":\"Management refusal\",\"statement\":\"Where management refuses to allow a confirmation request, inquire into and seek evidence on the validity and reasonableness of its reasons, evaluate the implications for the risk assessment including fraud risk and for other procedures, and perform alternative procedures to obtain relevant and reliable evidence.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Management refuses to allow a confirmation request to be sent.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-505.9\",\"standard_id\":\"ISA-505\",\"paragraph\":\"9\",\"topic\":\"Unreasonable refusal\",\"statement\":\"Where the refusal is unreasonable, or alternative procedures cannot provide relevant and reliable evidence, communicate with those charged with governance and determine the implications for the audit and the opinion.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"The refusal is unreasonable or alternative procedures cannot provide relevant and reliable evidence.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-505.10\",\"standard_id\":\"ISA-505\",\"paragraph\":\"10\",\"topic\":\"Doubts about reliability of a response\",\"statement\":\"Where factors raise doubts about the reliability of a confirmation response, obtain further evidence to resolve them.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Factors raise doubts about the reliability of a response.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-505.11\",\"standard_id\":\"ISA-505\",\"paragraph\":\"11\",\"topic\":\"Unreliable response\",\"statement\":\"Where a response is determined to be unreliable, evaluate the implications for the risk assessment including fraud risk and for the nature, timing and extent of other procedures.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"A response is determined not to be reliable.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-505.12\",\"standard_id\":\"ISA-505\",\"paragraph\":\"12\",\"topic\":\"Non-responses\",\"statement\":\"For each non-response, perform alternative procedures to obtain relevant and reliable evidence.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-505.13\",\"standard_id\":\"ISA-505\",\"paragraph\":\"13\",\"topic\":\"Positive confirmation necessary\",\"statement\":\"Where a response to a positive confirmation is necessary and is not obtained, alternative procedures will not suffice; determine the implications for the audit and the opinion.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"A response to a positive confirmation is necessary to obtain sufficient appropriate evidence.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-505.14\",\"standard_id\":\"ISA-505\",\"paragraph\":\"14\",\"topic\":\"Investigate exceptions\",\"statement\":\"Investigate exceptions to determine whether they indicate misstatements.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-505.15\",\"standard_id\":\"ISA-505\",\"paragraph\":\"15\",\"topic\":\"Negative confirmations\",\"statement\":\"Do not use negative confirmations as the sole substantive procedure for an assessed risk unless the risk is assessed as low with evidence that relevant controls operate effectively, the population consists of many small homogeneous items, a very low exception rate is expected, and there is no reason to believe recipients would disregard the requests.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-505.16\",\"standard_id\":\"ISA-505\",\"paragraph\":\"16\",\"topic\":\"Evaluate the evidence obtained\",\"statement\":\"Evaluate whether the results of the confirmation procedures provide relevant and reliable evidence or whether further evidence is necessary.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-510.5\",\"standard_id\":\"ISA-510\",\"paragraph\":\"5\",\"topic\":\"Read prior statements and report\",\"statement\":\"Read the most recent financial statements and the predecessor auditor's report, if any, for information relevant to opening balances including disclosures.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-510.6\",\"standard_id\":\"ISA-510\",\"paragraph\":\"6\",\"topic\":\"Evidence on opening balances\",\"statement\":\"Obtain sufficient appropriate evidence about whether opening balances contain misstatements that materially affect the current period: check that closing balances were correctly brought forward or restated, that opening balances reflect appropriate policies, and review the predecessor's working papers, evaluate current-period evidence relevant to opening balances, or perform specific procedures.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-510.7\",\"standard_id\":\"ISA-510\",\"paragraph\":\"7\",\"topic\":\"Misstatements in opening balances\",\"statement\":\"Where evidence indicates material misstatements in opening balances, perform additional procedures to determine the effect on the current period and communicate misstatements found in the current period to management and those charged with governance.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Evidence indicates opening balances contain misstatements that could materially affect the current period.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-510.8\",\"standard_id\":\"ISA-510\",\"paragraph\":\"8\",\"topic\":\"Consistency of accounting policies\",\"statement\":\"Obtain sufficient appropriate evidence on whether the accounting policies in the opening balances are consistently applied in the current period and whether policy changes are appropriately accounted for, presented and disclosed.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-510.9\",\"standard_id\":\"ISA-510\",\"paragraph\":\"9\",\"topic\":\"Predecessor's modified opinion\",\"statement\":\"Where the predecessor's opinion was modified, evaluate the effect of the underlying matter in assessing the current period's risks of material misstatement.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The predecessor auditor's opinion was modified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-510.10\",\"standard_id\":\"ISA-510\",\"paragraph\":\"10\",\"topic\":\"Unable to obtain evidence on opening balances\",\"statement\":\"Where sufficient appropriate evidence on opening balances cannot be obtained, express a qualified opinion or disclaim an opinion.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Sufficient appropriate evidence on opening balances cannot be obtained.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-510.11\",\"standard_id\":\"ISA-510\",\"paragraph\":\"11\",\"topic\":\"Material misstatement in opening balances\",\"statement\":\"Where opening balances contain a material misstatement that is not appropriately accounted for, presented or disclosed, express a qualified or adverse opinion.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Opening balances contain a material misstatement not appropriately accounted for or disclosed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-510.12\",\"standard_id\":\"ISA-510\",\"paragraph\":\"12\",\"topic\":\"Policies inconsistent or change not disclosed\",\"statement\":\"Where accounting policies are not consistently applied to opening balances or a change is not appropriately accounted for or disclosed, express a qualified or adverse opinion.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Policies are not consistently applied, or a change is not appropriately accounted for or disclosed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-510.13\",\"standard_id\":\"ISA-510\",\"paragraph\":\"13\",\"topic\":\"Predecessor modification still relevant\",\"statement\":\"Where the predecessor's modification remains relevant and material to the current period, modify the current opinion under ISA 705 and ISA 710.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The predecessor's modification remains relevant and material.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-560.6\",\"standard_id\":\"ISA-560\",\"paragraph\":\"6\",\"topic\":\"Identify subsequent events\",\"statement\":\"Perform procedures designed to obtain sufficient appropriate evidence that all events between the financial statement date and the report date requiring adjustment or disclosure have been identified; procedures already concluded satisfactorily need not be repeated.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-560.7\",\"standard_id\":\"ISA-560\",\"paragraph\":\"7\",\"topic\":\"Nature and extent of the procedures\",\"statement\":\"Cover the period up to the report date or as near as practicable, taking the risk assessment into account, and include understanding management's procedures for identifying subsequent events, inquiring of management and governance, reading minutes of meetings held after the period end and inquiring about unminuted matters, and reading the latest interim financial statements.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-560.8\",\"standard_id\":\"ISA-560\",\"paragraph\":\"8\",\"topic\":\"Events identified\",\"statement\":\"Where events requiring adjustment or disclosure are identified, determine whether each is appropriately reflected in the financial statements under the framework.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Events requiring adjustment or disclosure are identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-560.9\",\"standard_id\":\"ISA-560\",\"paragraph\":\"9\",\"topic\":\"Representation on subsequent events\",\"statement\":\"Request a written representation that all subsequent events requiring adjustment or disclosure under the framework have been adjusted or disclosed.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-560.10\",\"standard_id\":\"ISA-560\",\"paragraph\":\"10\",\"topic\":\"Facts known after the report date, before issue\",\"statement\":\"Where such a fact becomes known before the financial statements are issued, discuss it with management and where appropriate governance, determine whether the financial statements need amendment and, if so, inquire how management intends to address it.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"A fact becomes known after the report date but before issue that might have led to an amended report.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-560.11\",\"standard_id\":\"ISA-560\",\"paragraph\":\"11\",\"topic\":\"Management amends before issue\",\"statement\":\"Where management amends the financial statements, perform the necessary procedures on the amendment and, unless paragraph 12 applies, extend subsequent-events procedures to the new report date and issue a new report dated no earlier than approval of the amended statements.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Management amends the financial statements before issue.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-560.12\",\"standard_id\":\"ISA-560\",\"paragraph\":\"12\",\"topic\":\"Amendment restricted to the event\",\"statement\":\"Where amendment and approval may be restricted to the subsequent event, either dual-date the report for that amendment or issue a new or amended report with an emphasis-of-matter or other-matter paragraph stating that subsequent-events procedures were restricted to that amendment.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Law, regulation or the framework permit restricting the amendment and its approval to the subsequent event.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-560.13\",\"standard_id\":\"ISA-560\",\"paragraph\":\"13\",\"topic\":\"Management does not amend before issue\",\"statement\":\"Where management does not amend statements that need amendment, modify the opinion if the report has not yet been provided; if it has, notify management and governance not to issue the statements and, if they are issued anyway, take action to prevent reliance on the report.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Management does not amend financial statements that the auditor believes need amendment, before issue.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-560.14\",\"standard_id\":\"ISA-560\",\"paragraph\":\"14\",\"topic\":\"Facts known after issue\",\"statement\":\"Where such a fact becomes known after issue, discuss it with management and where appropriate governance, determine whether amendment is needed and, if so, inquire how management intends to address it.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"A fact becomes known after the financial statements are issued that might have led to an amended report.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-560.15\",\"standard_id\":\"ISA-560\",\"paragraph\":\"15\",\"topic\":\"Management amends after issue\",\"statement\":\"Where management amends issued financial statements, perform procedures on the amendment, review management's steps to inform recipients of the earlier statements, and unless paragraph 12 applies extend subsequent-events procedures to the new report date and issue a new report; where paragraph 12 applies, amend or reissue the report accordingly.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Management amends previously issued financial statements.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-560.16\",\"standard_id\":\"ISA-560\",\"paragraph\":\"16\",\"topic\":\"Emphasis of matter on reissue\",\"statement\":\"Include in the new or amended report an emphasis-of-matter or other-matter paragraph referring to the note explaining the amendment and to the earlier report.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"A new or amended report is issued on amended financial statements.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-560.17\",\"standard_id\":\"ISA-560\",\"paragraph\":\"17\",\"topic\":\"Management fails to act after issue\",\"statement\":\"Where management does not inform recipients and does not amend statements that need amendment, notify management and governance that the auditor will seek to prevent reliance on the report and, if they still fail to act, take appropriate action to prevent reliance.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Management neither informs recipients nor amends statements that need amendment.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-580.9\",\"standard_id\":\"ISA-580\",\"paragraph\":\"9\",\"topic\":\"From whom representations are requested\",\"statement\":\"Request written representations from management with appropriate responsibility for the financial statements and knowledge of the matters concerned.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-580.10\",\"standard_id\":\"ISA-580\",\"paragraph\":\"10\",\"topic\":\"Representation on preparation\",\"statement\":\"Request a written representation that management has fulfilled its responsibility for preparing the financial statements under the applicable framework, including fair presentation where relevant, as set out in the engagement terms.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-580.11\",\"standard_id\":\"ISA-580\",\"paragraph\":\"11\",\"topic\":\"Representation on information and completeness\",\"statement\":\"Request a written representation that management has provided all relevant information and access agreed in the engagement terms, and that all transactions have been recorded and are reflected in the financial statements.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-580.12\",\"standard_id\":\"ISA-580\",\"paragraph\":\"12\",\"topic\":\"Description of responsibilities\",\"statement\":\"Describe management's responsibilities in the representations in the manner in which they are described in the engagement terms.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-580.13\",\"standard_id\":\"ISA-580\",\"paragraph\":\"13\",\"topic\":\"Other representations\",\"statement\":\"Request such other written representations as are determined necessary to support other evidence on the financial statements or specific assertions, in addition to those other ISAs require.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Other representations are needed to support evidence on the financial statements or specific assertions.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-580.14\",\"standard_id\":\"ISA-580\",\"paragraph\":\"14\",\"topic\":\"Date and period covered\",\"statement\":\"Date the representations as near as practicable to, but not after, the report date, and cover all financial statements and periods referred to in the report.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-580.15\",\"standard_id\":\"ISA-580\",\"paragraph\":\"15\",\"topic\":\"Form of the representation letter\",\"statement\":\"Obtain representations in the form of a letter addressed to the auditor; matters covered by public statements management is legally required to make need not be repeated.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-580.16\",\"standard_id\":\"ISA-580\",\"paragraph\":\"16\",\"topic\":\"Concerns about management\",\"statement\":\"Where concerns exist about management's competence, integrity, ethical values or diligence, determine their effect on the reliability of representations and of evidence generally.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The auditor has concerns about management's competence, integrity, ethical values or diligence.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-580.17\",\"standard_id\":\"ISA-580\",\"paragraph\":\"17\",\"topic\":\"Inconsistent representations\",\"statement\":\"Where representations are inconsistent with other evidence, perform procedures to resolve the matter; if unresolved, reconsider the assessment of management and the effect on the reliability of representations and evidence.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Written representations are inconsistent with other evidence.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-580.18\",\"standard_id\":\"ISA-580\",\"paragraph\":\"18\",\"topic\":\"Unreliable representations\",\"statement\":\"Where representations are concluded to be unreliable, take appropriate action including determining the effect on the opinion, having regard to the disclaimer requirement.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Written representations are concluded to be unreliable.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-580.19\",\"standard_id\":\"ISA-580\",\"paragraph\":\"19\",\"topic\":\"Representations not provided\",\"statement\":\"Where requested representations are not provided, discuss with management, re-evaluate management's integrity and the reliability of representations and evidence, and take appropriate action including determining the effect on the opinion.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Management does not provide one or more requested representations.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-580.20\",\"standard_id\":\"ISA-580\",\"paragraph\":\"20\",\"topic\":\"Disclaimer of opinion\",\"statement\":\"Disclaim an opinion where sufficient doubt about management's integrity makes the representations on preparation and completeness unreliable, or where management does not provide those representations.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Doubt about management integrity makes the required representations unreliable, or management does not provide them.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.13\",\"standard_id\":\"ISA-240\",\"paragraph\":\"13\",\"topic\":\"Professional scepticism about fraud\",\"statement\":\"Maintain professional scepticism throughout the audit, recognising that a material misstatement due to fraud could exist despite past experience of the honesty and integrity of management and those charged with governance.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.14\",\"standard_id\":\"ISA-240\",\"paragraph\":\"14\",\"topic\":\"Authenticity of documents\",\"statement\":\"Records and documents may be accepted as genuine unless there is reason to believe otherwise; where conditions suggest a document is not authentic or has undisclosed modified terms, investigate further.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Conditions suggest a document may not be authentic or its terms were modified without disclosure.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.15\",\"standard_id\":\"ISA-240\",\"paragraph\":\"15\",\"topic\":\"Inconsistent responses\",\"statement\":\"Where responses to inquiries of management or those charged with governance are inconsistent, investigate the inconsistencies.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Responses to inquiries of management or governance are inconsistent.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.16\",\"standard_id\":\"ISA-240\",\"paragraph\":\"16\",\"topic\":\"Team discussion on fraud\",\"statement\":\"The engagement team discussion places particular emphasis on how and where the financial statements may be susceptible to material misstatement due to fraud and how fraud might occur, setting aside beliefs that management and governance are honest.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.17\",\"standard_id\":\"ISA-240\",\"paragraph\":\"17\",\"topic\":\"Fraud information from risk assessment\",\"statement\":\"When performing risk assessment procedures under ISA 315, perform the procedures in paragraphs 18 to 25 to obtain information for identifying risks of material misstatement due to fraud.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.18\",\"standard_id\":\"ISA-240\",\"paragraph\":\"18\",\"topic\":\"Inquiries of management on fraud risk\",\"statement\":\"Inquire of management about its assessment of the risk of material misstatement due to fraud, its process for identifying and responding to fraud risks including specific risks and susceptible items, its communication to governance about that process, and its communication to employees on business practices and ethics.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.19\",\"standard_id\":\"ISA-240\",\"paragraph\":\"19\",\"topic\":\"Inquiries about actual or suspected fraud\",\"statement\":\"Inquire of management and others within the entity whether they know of any actual, suspected or alleged fraud affecting the entity.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.20\",\"standard_id\":\"ISA-240\",\"paragraph\":\"20\",\"topic\":\"Inquiries of internal audit\",\"statement\":\"Where an internal audit function exists, inquire of appropriate individuals within it about actual, suspected or alleged fraud and obtain its views on fraud risks.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The entity has an internal audit function.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.21\",\"standard_id\":\"ISA-240\",\"paragraph\":\"21\",\"topic\":\"Governance oversight of fraud risk\",\"statement\":\"Unless all those charged with governance manage the entity, understand how they oversee management's processes for identifying and responding to fraud risks and the controls established to mitigate them.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Not all of those charged with governance are involved in managing the entity.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.22\",\"standard_id\":\"ISA-240\",\"paragraph\":\"22\",\"topic\":\"Inquiries of governance about fraud\",\"statement\":\"Unless all those charged with governance manage the entity, inquire of them whether they know of actual, suspected or alleged fraud, partly to corroborate management's responses.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Not all of those charged with governance are involved in managing the entity.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.23\",\"standard_id\":\"ISA-240\",\"paragraph\":\"23\",\"topic\":\"Unusual relationships in analytics\",\"statement\":\"Evaluate whether unusual or unexpected relationships identified in analytical procedures, including those involving revenue accounts, may indicate risks of material misstatement due to fraud.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.24\",\"standard_id\":\"ISA-240\",\"paragraph\":\"24\",\"topic\":\"Other information\",\"statement\":\"Consider whether other information obtained indicates risks of material misstatement due to fraud.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.25\",\"standard_id\":\"ISA-240\",\"paragraph\":\"25\",\"topic\":\"Fraud risk factors\",\"statement\":\"Evaluate whether information obtained from risk assessment procedures indicates that one or more fraud risk factors are present.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.26\",\"standard_id\":\"ISA-240\",\"paragraph\":\"26\",\"topic\":\"Identify and assess fraud risks\",\"statement\":\"Identify and assess the risks of material misstatement due to fraud at the financial statement level and at the assertion level for classes of transactions, balances and disclosures.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.27\",\"standard_id\":\"ISA-240\",\"paragraph\":\"27\",\"topic\":\"Presumed risk in revenue recognition\",\"statement\":\"Presume that risks of fraud exist in revenue recognition and evaluate which types of revenue, revenue transactions or assertions give rise to those risks; a rebutted presumption must be documented under paragraph 48.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.28\",\"standard_id\":\"ISA-240\",\"paragraph\":\"28\",\"topic\":\"Fraud risks are significant risks\",\"statement\":\"Treat assessed risks of material misstatement due to fraud as significant risks; identify the controls that address them and evaluate their design and implementation.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.29\",\"standard_id\":\"ISA-240\",\"paragraph\":\"29\",\"topic\":\"Overall responses\",\"statement\":\"Determine overall responses to address the assessed risks of material misstatement due to fraud at the financial statement level.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.30\",\"standard_id\":\"ISA-240\",\"paragraph\":\"30\",\"topic\":\"Content of overall responses\",\"statement\":\"In determining overall responses, assign and supervise personnel according to their knowledge, skill and ability and the assessed fraud risks; evaluate whether the selection and application of accounting policies, particularly for subjective measurements and complex transactions, may indicate earnings management; and incorporate unpredictability in the nature, timing and extent of procedures.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.31\",\"standard_id\":\"ISA-240\",\"paragraph\":\"31\",\"topic\":\"Assertion-level responses to fraud risk\",\"statement\":\"Design and perform further procedures whose nature, timing and extent respond to the assessed risks of material misstatement due to fraud at the assertion level.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.32\",\"standard_id\":\"ISA-240\",\"paragraph\":\"32\",\"topic\":\"Management override is a significant risk\",\"statement\":\"Recognise that the risk of management override of controls is present in every entity, is a risk of material misstatement due to fraud, and is therefore a significant risk.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.33\",\"standard_id\":\"ISA-240\",\"paragraph\":\"33\",\"topic\":\"Procedures on override: journals, estimates, unusual transactions\",\"statement\":\"Irrespective of the assessed override risk, test the appropriateness of general-ledger journal entries and other adjustments (inquiring about unusual processing, selecting period-end entries and considering entries throughout the period); review accounting estimates for management bias including a retrospective review of prior-year judgments; and evaluate the business rationale of significant transactions outside the normal course of business.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.34\",\"standard_id\":\"ISA-240\",\"paragraph\":\"34\",\"topic\":\"Other override procedures\",\"statement\":\"Determine whether other procedures beyond those in paragraph 33 are needed to respond to identified risks of management override.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.35\",\"standard_id\":\"ISA-240\",\"paragraph\":\"35\",\"topic\":\"Final analytics and fraud\",\"statement\":\"Evaluate whether analytical procedures performed near the end of the audit indicate a previously unrecognised risk of material misstatement due to fraud.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.36\",\"standard_id\":\"ISA-240\",\"paragraph\":\"36\",\"topic\":\"Misstatement indicative of fraud\",\"statement\":\"On identifying a misstatement, evaluate whether it indicates fraud and, if so, its implications for other aspects of the audit, particularly the reliability of management representations, recognising that fraud is unlikely to be isolated.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"A misstatement is identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.37\",\"standard_id\":\"ISA-240\",\"paragraph\":\"37\",\"topic\":\"Fraud involving management\",\"statement\":\"Where a misstatement may result from fraud involving management, re-evaluate the assessed fraud risks and the planned responses, and consider whether circumstances indicate collusion when reconsidering the reliability of evidence already obtained.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"A misstatement is or may be the result of fraud involving management.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.38\",\"standard_id\":\"ISA-240\",\"paragraph\":\"38\",\"topic\":\"Material misstatement due to fraud\",\"statement\":\"Where it is confirmed, or cannot be concluded, whether the financial statements are materially misstated due to fraud, evaluate the implications for the audit.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The financial statements are, or may be, materially misstated due to fraud.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.39\",\"standard_id\":\"ISA-240\",\"paragraph\":\"39\",\"topic\":\"Ability to continue\",\"statement\":\"Where fraud or suspected fraud brings the ability to continue into question, determine the applicable professional and legal responsibilities including reporting to the appointing party or regulators, consider withdrawal where permitted, and on withdrawal discuss the reasons with management and governance and determine whether reporting the withdrawal is required.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Fraud or suspected fraud brings into question the ability to continue the audit.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.40\",\"standard_id\":\"ISA-240\",\"paragraph\":\"40\",\"topic\":\"Written representations on fraud\",\"statement\":\"Obtain written representations that management and, where appropriate, governance acknowledge responsibility for internal control to prevent and detect fraud, have disclosed the results of management's fraud risk assessment, their knowledge of fraud or suspected fraud involving management, employees with significant control roles or others where material, and their knowledge of allegations of fraud from employees, former employees, analysts, regulators or others.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.41\",\"standard_id\":\"ISA-240\",\"paragraph\":\"41\",\"topic\":\"Communicate fraud to management\",\"statement\":\"Where fraud is identified or indicated, communicate the matters to the appropriate level of management on a timely basis unless prohibited by law.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Fraud is identified or information indicates fraud may exist.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.42\",\"standard_id\":\"ISA-240\",\"paragraph\":\"42\",\"topic\":\"Communicate fraud to governance\",\"statement\":\"Unless all governance manage the entity, communicate identified or suspected fraud involving management, employees with significant control roles or others where material to those charged with governance on a timely basis; where management is suspected, also discuss the procedures needed to complete the audit; all unless prohibited by law.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Fraud involving management, employees with significant control roles, or others causing a material misstatement is identified or suspected.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.43\",\"standard_id\":\"ISA-240\",\"paragraph\":\"43\",\"topic\":\"Other fraud matters\",\"statement\":\"Communicate to those charged with governance, unless prohibited by law, any other fraud-related matters judged relevant to their responsibilities.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.44\",\"standard_id\":\"ISA-240\",\"paragraph\":\"44\",\"topic\":\"Reporting fraud outside the entity\",\"statement\":\"Where fraud is identified or suspected, determine whether law, regulation or ethical requirements require reporting to an appropriate outside authority, or establish responsibilities under which such reporting may be appropriate.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Fraud is identified or suspected.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.45\",\"standard_id\":\"ISA-240\",\"paragraph\":\"45\",\"topic\":\"Documentation of fraud risk assessment\",\"statement\":\"Document the significant decisions from the team discussion on susceptibility to fraud, the identified and assessed fraud risks at both levels, and the identified controls in the control activities component that address them.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.46\",\"standard_id\":\"ISA-240\",\"paragraph\":\"46\",\"topic\":\"Documentation of responses\",\"statement\":\"Document the overall responses to fraud risks at the financial statement level, the nature, timing and extent of procedures and their linkage to assertion-level fraud risks, and the results including procedures addressing management override.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.47\",\"standard_id\":\"ISA-240\",\"paragraph\":\"47\",\"topic\":\"Documentation of communications\",\"statement\":\"Document communications about fraud made to management, those charged with governance, regulators and others.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240.48\",\"standard_id\":\"ISA-240\",\"paragraph\":\"48\",\"topic\":\"Rebutted revenue presumption\",\"statement\":\"Where the presumed fraud risk in revenue recognition is concluded not to apply, document the reasons for that conclusion.\",\"kind\":\"documentation\",\"conditional\":1,\"condition\":\"The presumption of fraud risk in revenue recognition is concluded not to apply.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.5\",\"standard_id\":\"ISA-330\",\"paragraph\":\"5\",\"topic\":\"Overall responses\",\"statement\":\"Design and implement overall responses to address the assessed risks of material misstatement at the financial statement level.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.6\",\"standard_id\":\"ISA-330\",\"paragraph\":\"6\",\"topic\":\"Further procedures at the assertion level\",\"statement\":\"Design and perform further audit procedures whose nature, timing and extent are based on and responsive to the assessed risks of material misstatement at the assertion level.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.7\",\"standard_id\":\"ISA-330\",\"paragraph\":\"7\",\"topic\":\"Design considerations\",\"statement\":\"In designing further procedures, consider the reasons for each assessed risk, including the likelihood and magnitude of misstatement (inherent risk) and whether the assessment takes account of controls (control risk) and so requires evidence that they operate effectively; and obtain more persuasive evidence the higher the assessed risk.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.8\",\"standard_id\":\"ISA-330\",\"paragraph\":\"8\",\"topic\":\"When tests of controls are required\",\"statement\":\"Design and perform tests of controls where the assessment expects controls to operate effectively or where substantive procedures alone cannot provide sufficient appropriate evidence at the assertion level.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The risk assessment expects controls to operate effectively, or substantive procedures alone cannot provide sufficient evidence.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.9\",\"standard_id\":\"ISA-330\",\"paragraph\":\"9\",\"topic\":\"Persuasiveness and reliance\",\"statement\":\"Obtain more persuasive evidence from tests of controls the greater the reliance placed on a control's effectiveness.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.10\",\"standard_id\":\"ISA-330\",\"paragraph\":\"10\",\"topic\":\"Nature and extent of tests of controls\",\"statement\":\"Combine inquiry with other procedures to obtain evidence on how controls were applied at relevant times, how consistently, and by whom or by what means; and determine whether the controls depend on indirect controls whose effective operation must also be evidenced.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.11\",\"standard_id\":\"ISA-330\",\"paragraph\":\"11\",\"topic\":\"Timing of tests of controls\",\"statement\":\"Test controls for the particular time, or throughout the period, for which reliance is intended.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.12\",\"standard_id\":\"ISA-330\",\"paragraph\":\"12\",\"topic\":\"Interim evidence on controls\",\"statement\":\"Where control evidence was obtained at an interim date, obtain evidence about significant changes after that date and determine the additional evidence needed for the remaining period.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Evidence on operating effectiveness was obtained at an interim date.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.13\",\"standard_id\":\"ISA-330\",\"paragraph\":\"13\",\"topic\":\"Using evidence from previous audits\",\"statement\":\"In deciding whether previous-audit evidence on controls can be used and how long may elapse before retesting, consider the effectiveness of the other components of internal control, the risks from the control's characteristics, general IT controls, the control's effectiveness and past deviations and personnel changes, whether lack of change is itself a risk, and the risks of material misstatement and the extent of reliance.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Evidence about controls from previous audits is to be used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.14\",\"standard_id\":\"ISA-330\",\"paragraph\":\"14\",\"topic\":\"Retesting rotation\",\"statement\":\"Where previous-audit evidence is relied on, confirm through inquiry with observation or inspection that no significant changes occurred; test the controls in the current audit if changes affect relevance, and otherwise test each control at least once in every third audit and some controls in every audit.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Evidence from a previous audit is to be relied on.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.15\",\"standard_id\":\"ISA-330\",\"paragraph\":\"15\",\"topic\":\"Controls over significant risks\",\"statement\":\"Where reliance is intended on controls over a significant risk, test those controls in the current period.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Reliance is intended on controls over a significant risk.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.16\",\"standard_id\":\"ISA-330\",\"paragraph\":\"16\",\"topic\":\"Misstatements and control effectiveness\",\"statement\":\"When evaluating the operating effectiveness of controls relied on, evaluate whether misstatements detected by substantive procedures indicate the controls are not operating effectively; the absence of detected misstatements is not evidence that controls are effective.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.17\",\"standard_id\":\"ISA-330\",\"paragraph\":\"17\",\"topic\":\"Deviations detected\",\"statement\":\"Where deviations are detected in controls relied on, make specific inquiries to understand them and their consequences, and determine whether the tests still support reliance, whether additional tests are needed, or whether the risks must be addressed by substantive procedures.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Deviations from controls relied on are detected.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.18\",\"standard_id\":\"ISA-330\",\"paragraph\":\"18\",\"topic\":\"Substantive procedures for every material item\",\"statement\":\"Irrespective of the assessed risks, design and perform substantive procedures for each material class of transactions, account balance and disclosure.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.19\",\"standard_id\":\"ISA-330\",\"paragraph\":\"19\",\"topic\":\"Consider external confirmations\",\"statement\":\"Consider whether external confirmation procedures are to be performed as substantive procedures.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.20\",\"standard_id\":\"ISA-330\",\"paragraph\":\"20\",\"topic\":\"Closing process procedures\",\"statement\":\"Include substantive procedures over the closing process: agree or reconcile the financial statements, including disclosures, to the underlying records whether inside or outside the ledgers, and examine material journal entries and other adjustments made in preparing the financial statements.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.21\",\"standard_id\":\"ISA-330\",\"paragraph\":\"21\",\"topic\":\"Responses to significant risks\",\"statement\":\"For each significant risk, perform substantive procedures specifically responsive to it; where the approach consists only of substantive procedures, include tests of details.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"An assessed risk at the assertion level is a significant risk.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.22\",\"standard_id\":\"ISA-330\",\"paragraph\":\"22\",\"topic\":\"Interim substantive procedures\",\"statement\":\"Where substantive procedures are performed at an interim date, cover the remaining period with substantive procedures combined with tests of controls, or with further substantive procedures alone where sufficient, so that conclusions can be extended to the period end.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Substantive procedures are performed at an interim date.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.23\",\"standard_id\":\"ISA-330\",\"paragraph\":\"23\",\"topic\":\"Unexpected interim misstatements\",\"statement\":\"Where unexpected misstatements are detected at an interim date, evaluate whether the risk assessment and the planned remaining-period substantive procedures need modifying.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Unexpected misstatements are detected at an interim date.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.24\",\"standard_id\":\"ISA-330\",\"paragraph\":\"24\",\"topic\":\"Overall presentation\",\"statement\":\"Perform procedures to evaluate whether the overall presentation of the financial statements accords with the framework, considering classification and description of the information and the presentation, structure and content of the statements.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.25\",\"standard_id\":\"ISA-330\",\"paragraph\":\"25\",\"topic\":\"Reassess the risk assessment\",\"statement\":\"Before concluding, evaluate whether the assessments of risk at the assertion level remain appropriate given the procedures performed and evidence obtained.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.26\",\"standard_id\":\"ISA-330\",\"paragraph\":\"26\",\"topic\":\"Conclude on sufficiency\",\"statement\":\"Conclude whether sufficient appropriate evidence has been obtained, considering all relevant evidence whether it corroborates or contradicts the assertions.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.27\",\"standard_id\":\"ISA-330\",\"paragraph\":\"27\",\"topic\":\"Insufficient evidence\",\"statement\":\"Where sufficient appropriate evidence on a relevant assertion has not been obtained, attempt to obtain further evidence; if unable, express a qualified opinion or disclaim an opinion.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Sufficient appropriate evidence on a relevant assertion has not been obtained.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.28\",\"standard_id\":\"ISA-330\",\"paragraph\":\"28\",\"topic\":\"Documentation of responses\",\"statement\":\"Document the overall responses, the nature, timing and extent of further procedures, their linkage to the assessed risks at the assertion level, and the results and conclusions.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.29\",\"standard_id\":\"ISA-330\",\"paragraph\":\"29\",\"topic\":\"Documentation of reliance on prior evidence\",\"statement\":\"Where previous-audit evidence on controls is used, document the conclusions reached about relying on those controls.\",\"kind\":\"documentation\",\"conditional\":1,\"condition\":\"Previous-audit evidence on controls is used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330.30\",\"standard_id\":\"ISA-330\",\"paragraph\":\"30\",\"topic\":\"Documentation of agreement to records\",\"statement\":\"Documentation must demonstrate that the financial statements, including disclosures, agree or reconcile with the underlying accounting records.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.13\",\"standard_id\":\"ISA-315\",\"paragraph\":\"13\",\"topic\":\"Risk assessment procedures\",\"statement\":\"Design and perform risk assessment procedures that provide an appropriate basis for identifying and assessing risks of material misstatement, whether due to fraud or error, at the financial statement and assertion levels, and for designing further procedures; perform them without bias towards corroborative evidence or away from contradictory evidence.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.14\",\"standard_id\":\"ISA-315\",\"paragraph\":\"14\",\"topic\":\"Types of risk assessment procedure\",\"statement\":\"Risk assessment procedures include inquiries of management and other appropriate individuals including internal audit, analytical procedures, and observation and inspection.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.15\",\"standard_id\":\"ISA-315\",\"paragraph\":\"15\",\"topic\":\"Information from other sources\",\"statement\":\"Consider information obtained from acceptance and continuance procedures and, where applicable, from other engagements the engagement partner performed for the entity.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.16\",\"standard_id\":\"ISA-315\",\"paragraph\":\"16\",\"topic\":\"Information from previous experience\",\"statement\":\"Where information from previous experience with the entity or previous audits is to be used, evaluate whether it remains relevant and reliable for the current audit.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The auditor intends to use information from previous experience or previous audits.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.17\",\"standard_id\":\"ISA-315\",\"paragraph\":\"17\",\"topic\":\"Engagement team discussion\",\"statement\":\"The engagement partner and other key team members discuss the application of the applicable framework and the susceptibility of the financial statements to material misstatement.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.18\",\"standard_id\":\"ISA-315\",\"paragraph\":\"18\",\"topic\":\"Matters for absent team members\",\"statement\":\"Where team members were not involved in the discussion, the engagement partner determines which matters are communicated to them.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Some team members were not involved in the discussion.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.19\",\"standard_id\":\"ISA-315\",\"paragraph\":\"19\",\"topic\":\"Understand the entity and framework\",\"statement\":\"Obtain an understanding of the entity's organisational structure, ownership, governance and business model including its use of IT; industry, regulatory and other external factors; the measures used to assess financial performance; the applicable framework, accounting policies and reasons for changes; and how inherent risk factors affect the susceptibility of assertions to misstatement.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.20\",\"standard_id\":\"ISA-315\",\"paragraph\":\"20\",\"topic\":\"Appropriateness of accounting policies\",\"statement\":\"Evaluate whether the entity's accounting policies are appropriate and consistent with the applicable framework.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.21\",\"standard_id\":\"ISA-315\",\"paragraph\":\"21\",\"topic\":\"Control environment\",\"statement\":\"Understand the control environment: the controls, processes and structures addressing management oversight and culture, governance independence and oversight, assignment of authority, attracting and retaining competent people, and accountability; and evaluate whether management has created a culture of honesty and ethics, whether the environment provides a foundation for the other components, and whether deficiencies undermine the other components.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.22\",\"standard_id\":\"ISA-315\",\"paragraph\":\"22\",\"topic\":\"Entity's risk assessment process\",\"statement\":\"Understand the entity's process for identifying business risks relevant to financial reporting, assessing their significance and likelihood, and addressing them; and evaluate whether that process is appropriate to the entity's circumstances.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.23\",\"standard_id\":\"ISA-315\",\"paragraph\":\"23\",\"topic\":\"Risks management failed to identify\",\"statement\":\"Where risks of material misstatement are identified that management failed to identify, determine whether the entity's process should have identified them and if so why it did not, and consider the implications for the evaluation of that process.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The auditor identifies risks management's process failed to identify.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.24\",\"standard_id\":\"ISA-315\",\"paragraph\":\"24\",\"topic\":\"Monitoring process\",\"statement\":\"Understand the entity's process for monitoring the system of internal control: ongoing and separate evaluations and remediation of deficiencies, the internal audit function, and the sources and reliability of monitoring information; and evaluate whether the process is appropriate to the entity.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.25\",\"standard_id\":\"ISA-315\",\"paragraph\":\"25\",\"topic\":\"Information system and communication\",\"statement\":\"Understand the information system relevant to financial reporting: how transactions are initiated, recorded, processed, corrected, posted and reported; how non-transaction events are captured; the accounting records and supporting records; the financial reporting process including disclosures; the IT environment; how significant matters are communicated internally, with governance and externally; and evaluate whether the system supports preparation of the financial statements under the framework.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.26\",\"standard_id\":\"ISA-315\",\"paragraph\":\"26\",\"topic\":\"Control activities\",\"statement\":\"Identify controls that address significant risks, controls over journal entries including non-standard entries, controls whose operating effectiveness the auditor plans to test including where substantive procedures alone are insufficient, and other controls judged appropriate; identify the IT applications and aspects of the IT environment subject to risks arising from IT and the related general IT controls; and for each identified control evaluate its design and determine whether it has been implemented by procedures beyond inquiry.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.27\",\"standard_id\":\"ISA-315\",\"paragraph\":\"27\",\"topic\":\"Control deficiencies\",\"statement\":\"Based on the evaluation of each component of internal control, determine whether one or more control deficiencies have been identified.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.28\",\"standard_id\":\"ISA-315\",\"paragraph\":\"28\",\"topic\":\"Identify risks at both levels\",\"statement\":\"Identify the risks of material misstatement and determine whether they exist at the financial statement level or at the assertion level for classes of transactions, account balances and disclosures.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.29\",\"standard_id\":\"ISA-315\",\"paragraph\":\"29\",\"topic\":\"Relevant assertions and significant items\",\"statement\":\"Determine the relevant assertions and the related significant classes of transactions, account balances and disclosures.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.30\",\"standard_id\":\"ISA-315\",\"paragraph\":\"30\",\"topic\":\"Assess financial-statement-level risks\",\"statement\":\"For financial-statement-level risks, assess the risks, determine whether they affect assertion-level assessments, and evaluate the nature and extent of their pervasive effect.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.31\",\"standard_id\":\"ISA-315\",\"paragraph\":\"31\",\"topic\":\"Assess inherent risk\",\"statement\":\"For assertion-level risks, assess inherent risk by assessing the likelihood and magnitude of misstatement, taking into account how and to what degree inherent risk factors affect susceptibility and how financial-statement-level risks affect the assessment.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.32\",\"standard_id\":\"ISA-315\",\"paragraph\":\"32\",\"topic\":\"Significant risks\",\"statement\":\"Determine whether any assessed risks of material misstatement are significant risks.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.33\",\"standard_id\":\"ISA-315\",\"paragraph\":\"33\",\"topic\":\"Substantive procedures alone insufficient\",\"statement\":\"Determine whether substantive procedures alone cannot provide sufficient appropriate evidence for any assertion-level risk.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.34\",\"standard_id\":\"ISA-315\",\"paragraph\":\"34\",\"topic\":\"Assess control risk\",\"statement\":\"Where operating effectiveness of controls will be tested, assess control risk; otherwise assess control risk so that the risk of material misstatement equals the assessed inherent risk.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.35\",\"standard_id\":\"ISA-315\",\"paragraph\":\"35\",\"topic\":\"Evaluate the evidence from risk assessment\",\"statement\":\"Evaluate whether the evidence from risk assessment procedures provides an appropriate basis for identifying and assessing risks; if not, perform additional procedures; take into account all evidence whether corroborative or contradictory.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.36\",\"standard_id\":\"ISA-315\",\"paragraph\":\"36\",\"topic\":\"Material but not significant items\",\"statement\":\"For material classes of transactions, balances or disclosures not determined to be significant, evaluate whether that determination remains appropriate.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.37\",\"standard_id\":\"ISA-315\",\"paragraph\":\"37\",\"topic\":\"Revise the risk assessment\",\"statement\":\"Where new information is inconsistent with the evidence on which risks were identified or assessed, revise the identification or assessment.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"New information is inconsistent with the evidence on which the assessment was based.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315.38\",\"standard_id\":\"ISA-315\",\"paragraph\":\"38\",\"topic\":\"Documentation of risk assessment\",\"statement\":\"Document the team discussion and significant decisions; the key elements of the understanding of the entity, its environment, framework and each component of internal control, the sources of information and the procedures performed; the evaluation of the design and implementation of identified controls; and the identified and assessed risks at both levels including significant risks and risks for which substantive procedures alone are insufficient, with the rationale for significant judgments.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.13\",\"standard_id\":\"ISA-540\",\"paragraph\":\"13\",\"topic\":\"Understand the entity's estimates\",\"statement\":\"When understanding the entity, obtain an understanding of the transactions, events and conditions giving rise to accounting estimates; the framework's recognition, measurement and disclosure requirements for them; relevant regulatory factors; the estimates expected in the financial statements; governance oversight of estimates; how management applies specialised skills including experts; how the entity's risk assessment addresses estimates; the information system for estimates including how management selects methods, assumptions and data, understands and addresses estimation uncertainty and selects a point estimate; the identified controls over management's process; and how management reviews the outcome of prior estimates.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.14\",\"standard_id\":\"ISA-540\",\"paragraph\":\"14\",\"topic\":\"Retrospective review\",\"statement\":\"Review the outcome of previous accounting estimates, or their subsequent re-estimation, to assist in identifying and assessing current-period risks, scaled to the characteristics of the estimates; the review does not second-guess judgments that were appropriate on the information then available.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.15\",\"standard_id\":\"ISA-540\",\"paragraph\":\"15\",\"topic\":\"Specialised skills\",\"statement\":\"Determine whether the engagement team needs specialised skills or knowledge to assess risks, design and perform responses, or evaluate evidence relating to accounting estimates.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.16\",\"standard_id\":\"ISA-540\",\"paragraph\":\"16\",\"topic\":\"Assess inherent risk for estimates\",\"statement\":\"In identifying and assessing risks for an estimate and its disclosures, separately assessing inherent and control risk, take into account the degree of estimation uncertainty and the degree to which selection of the method, assumptions and data and selection of the point estimate and disclosures are affected by complexity, subjectivity or other inherent risk factors.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.17\",\"standard_id\":\"ISA-540\",\"paragraph\":\"17\",\"topic\":\"Significant risks for estimates\",\"statement\":\"Determine whether any of the assessed risks relating to estimates are significant risks; where one exists, identify the controls that address it and evaluate their design and implementation.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.18\",\"standard_id\":\"ISA-540\",\"paragraph\":\"18\",\"topic\":\"Responses to assessed risks\",\"statement\":\"Design further procedures responsive to the assessed risks and their reasons, using one or more of: evidence from events up to the report date, testing how management made the estimate, or developing an auditor's point estimate or range; obtain more persuasive evidence the higher the risk, and perform the procedures without bias towards corroborative or away from contradictory evidence.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.19\",\"standard_id\":\"ISA-540\",\"paragraph\":\"19\",\"topic\":\"Tests of controls over estimates\",\"statement\":\"Where the risk assessment expects controls to operate effectively or substantive procedures alone are insufficient, test the operating effectiveness of controls over estimates in a manner responsive to the reasons for the risk assessment, with more persuasive evidence the greater the reliance.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Reliance on controls is expected, or substantive procedures alone are insufficient.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.20\",\"standard_id\":\"ISA-540\",\"paragraph\":\"20\",\"topic\":\"Significant risks: controls and details\",\"statement\":\"For a significant risk relating to an estimate, test controls in the current period where reliance is planned, and where the approach is substantive only include tests of details.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"A significant risk relating to an estimate exists.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.21\",\"standard_id\":\"ISA-540\",\"paragraph\":\"21\",\"topic\":\"Evidence from subsequent events\",\"statement\":\"Where evidence from events up to the report date is used, evaluate whether it is sufficient and appropriate for the estimate, considering that changes between the event and the measurement date may affect its relevance.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Further procedures include evidence from events up to the report date.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.22\",\"standard_id\":\"ISA-540\",\"paragraph\":\"22\",\"topic\":\"Testing management's process\",\"statement\":\"Where management's process is tested, obtain sufficient appropriate evidence on the selection and application of methods, significant assumptions and data, and on how management selected the point estimate and developed the estimation-uncertainty disclosures.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Further procedures include testing how management made the estimate.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.23\",\"standard_id\":\"ISA-540\",\"paragraph\":\"23\",\"topic\":\"Methods\",\"statement\":\"Address whether the method is appropriate under the framework and any change from prior periods is appropriate, whether its selection indicates possible bias, whether calculations follow the method and are mathematically accurate, whether complex models are designed and adjusted appropriately and applied consistently, and whether the integrity of assumptions and data was maintained.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Management's process is tested.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.24\",\"standard_id\":\"ISA-540\",\"paragraph\":\"24\",\"topic\":\"Significant assumptions\",\"statement\":\"Address whether significant assumptions are appropriate under the framework and any changes are appropriate, whether their selection indicates possible bias, whether they are consistent with each other, with other estimates and with other areas of the business, and where applicable whether management has the intent and ability to carry out specific actions.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Management's process is tested.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.25\",\"standard_id\":\"ISA-540\",\"paragraph\":\"25\",\"topic\":\"Data\",\"statement\":\"Address whether the data is appropriate under the framework and changes are appropriate, whether its selection indicates possible bias, whether it is relevant and reliable, and whether management has understood and interpreted it appropriately including contractual terms.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Management's process is tested.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.26\",\"standard_id\":\"ISA-540\",\"paragraph\":\"26\",\"topic\":\"Point estimate and uncertainty disclosures\",\"statement\":\"Address whether management took appropriate steps to understand estimation uncertainty and to address it by selecting an appropriate point estimate and developing related disclosures.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Management's process is tested.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.27\",\"standard_id\":\"ISA-540\",\"paragraph\":\"27\",\"topic\":\"Management has not addressed uncertainty\",\"statement\":\"Where management has not adequately addressed estimation uncertainty, request additional procedures from management and evaluate the response; if still insufficient, develop an auditor's point estimate or range to the extent practicable; and evaluate whether a control deficiency exists and communicate it.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Management has not taken appropriate steps to understand or address estimation uncertainty.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.28\",\"standard_id\":\"ISA-540\",\"paragraph\":\"28\",\"topic\":\"Auditor's point estimate or range\",\"statement\":\"When developing a point estimate or range, evaluate whether the methods, assumptions or data used are appropriate under the framework, addressing the same matters as for management's methods, assumptions and data.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The auditor develops a point estimate or range.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.29\",\"standard_id\":\"ISA-540\",\"paragraph\":\"29\",\"topic\":\"Auditor's range\",\"statement\":\"Where a range is developed, include only amounts supported by sufficient appropriate evidence and evaluated as reasonable under the framework, and obtain evidence on the disclosures describing estimation uncertainty.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The auditor develops a range.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.30\",\"standard_id\":\"ISA-540\",\"paragraph\":\"30\",\"topic\":\"Evidence sources and management's expert\",\"statement\":\"Comply with ISA 500 for evidence on estimates regardless of source; when management's expert is used, the procedures on methods, assumptions and data assist in evaluating the expert's work, scaled to the expert's competence, objectivity and the nature of the work.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.31\",\"standard_id\":\"ISA-540\",\"paragraph\":\"31\",\"topic\":\"Other estimate disclosures\",\"statement\":\"Design and perform further procedures on the assessed risks for disclosures related to an estimate other than the estimation-uncertainty disclosures already addressed.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.32\",\"standard_id\":\"ISA-540\",\"paragraph\":\"32\",\"topic\":\"Indicators of management bias\",\"statement\":\"Evaluate whether management's judgments and decisions in making estimates, even if individually reasonable, indicate possible management bias; where indicators exist evaluate the implications for the audit, recognising that bias with intent to mislead is fraud.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.33\",\"standard_id\":\"ISA-540\",\"paragraph\":\"33\",\"topic\":\"Overall evaluation\",\"statement\":\"Evaluate whether the assessed risks remain appropriate including where bias indicators exist, whether management's recognition, measurement, presentation and disclosure decisions accord with the framework, and whether sufficient appropriate evidence has been obtained.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.34\",\"standard_id\":\"ISA-540\",\"paragraph\":\"34\",\"topic\":\"Consider all evidence; insufficient evidence\",\"statement\":\"Consider all relevant evidence whether corroborative or contradictory; where sufficient appropriate evidence cannot be obtained, evaluate the implications for the audit or the opinion.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.35\",\"standard_id\":\"ISA-540\",\"paragraph\":\"35\",\"topic\":\"Reasonable or misstated\",\"statement\":\"Determine whether the estimates and related disclosures are reasonable under the framework or misstated, distinguishing factual, judgmental and projected misstatements for the evaluation of uncorrected misstatements.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.36\",\"standard_id\":\"ISA-540\",\"paragraph\":\"36\",\"topic\":\"Disclosures for fair presentation\",\"statement\":\"Evaluate whether management has included the additional disclosures necessary for fair presentation under a fair presentation framework, or the disclosures necessary for the statements not to be misleading under a compliance framework.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.37\",\"standard_id\":\"ISA-540\",\"paragraph\":\"37\",\"topic\":\"Written representations on estimates\",\"statement\":\"Request written representations that the methods, significant assumptions and data used in the estimates and related disclosures are appropriate under the framework, and consider representations about specific estimates.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.38\",\"standard_id\":\"ISA-540\",\"paragraph\":\"38\",\"topic\":\"Communication on estimates\",\"statement\":\"When communicating with those charged with governance or management, consider the matters to communicate about estimates, taking into account whether the reasons for the risk assessment relate to estimation uncertainty or to complexity, subjectivity or other inherent risk factors, and any legally required communication with regulators.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540.39\",\"standard_id\":\"ISA-540\",\"paragraph\":\"39\",\"topic\":\"Documentation of estimates\",\"statement\":\"Document the key elements of the understanding relating to estimates including internal control, the linkage of further procedures to the assessed risks and their reasons, the responses where management did not address estimation uncertainty, indicators of possible bias and their evaluation, and significant judgments on whether estimates are reasonable or misstated.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-402.9\",\"standard_id\":\"ISA-402\",\"paragraph\":\"9\",\"topic\":\"Understand the use of the service organisation\",\"statement\":\"Understand how the entity uses the service organisation: the nature and significance of the services and their effect on internal control, the nature and materiality of transactions and processes affected, the degree of interaction, and the contractual relationship.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The entity uses a service organisation.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-402.10\",\"standard_id\":\"ISA-402\",\"paragraph\":\"10\",\"topic\":\"User-entity controls\",\"statement\":\"Identify the controls at the user entity that relate to the services, including those applied to transactions the service organisation processes, and evaluate their design and implementation.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The entity uses a service organisation.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-402.11\",\"standard_id\":\"ISA-402\",\"paragraph\":\"11\",\"topic\":\"Sufficiency of understanding\",\"statement\":\"Determine whether a sufficient understanding of the services and their effect on internal control has been obtained to provide a basis for identifying and assessing risks.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The entity uses a service organisation.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-402.12\",\"standard_id\":\"ISA-402\",\"paragraph\":\"12\",\"topic\":\"Sources when understanding is insufficient\",\"statement\":\"Where the user entity cannot supply a sufficient understanding, obtain it from a type 1 or type 2 report, by contacting the service organisation through the entity, by visiting it and performing procedures, or by using another auditor.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"A sufficient understanding cannot be obtained from the user entity.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-402.13\",\"standard_id\":\"ISA-402\",\"paragraph\":\"13\",\"topic\":\"Competence and standards behind a service auditor's report\",\"statement\":\"Before relying on a type 1 or type 2 report, be satisfied as to the service auditor's competence and independence and the adequacy of the standards under which the report was issued.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"A type 1 or type 2 report is to be used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-402.14\",\"standard_id\":\"ISA-402\",\"paragraph\":\"14\",\"topic\":\"Using a report for design and implementation\",\"statement\":\"When a type 1 or type 2 report supports the understanding of controls, evaluate whether its date or period is appropriate, evaluate the sufficiency of its evidence, and determine whether complementary user-entity controls are relevant and, if so, whether the entity has designed and implemented them.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"A type 1 or type 2 report supports the understanding of design and implementation.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-402.15\",\"standard_id\":\"ISA-402\",\"paragraph\":\"15\",\"topic\":\"Responding to risks\",\"statement\":\"In responding to assessed risks, determine whether sufficient evidence on the relevant assertions is available from records at the user entity and, if not, perform further procedures or use another auditor to perform them at the service organisation.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The entity uses a service organisation.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-402.16\",\"standard_id\":\"ISA-402\",\"paragraph\":\"16\",\"topic\":\"Tests of controls at the service organisation\",\"statement\":\"Where controls at the service organisation are expected to operate effectively, obtain evidence of their operating effectiveness from a type 2 report, from tests of controls performed at the service organisation, or from another auditor performing those tests.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Reliance on controls at the service organisation is expected.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-402.17\",\"standard_id\":\"ISA-402\",\"paragraph\":\"17\",\"topic\":\"Using a type 2 report for operating effectiveness\",\"statement\":\"When a type 2 report evidences operating effectiveness, evaluate whether its period is appropriate, whether complementary user-entity controls are relevant and implemented and tested, the adequacy of the period covered and the time elapsed since the tests, and whether the tests and results are relevant to the entity's assertions.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"A type 2 report is to be used as evidence of operating effectiveness.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-402.18\",\"standard_id\":\"ISA-402\",\"paragraph\":\"18\",\"topic\":\"Subservice organisations\",\"statement\":\"Where a type 1 or type 2 report excludes relevant services of a subservice organisation, apply the standard's requirements to those services.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The report excludes a relevant subservice organisation.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-402.19\",\"standard_id\":\"ISA-402\",\"paragraph\":\"19\",\"topic\":\"Fraud, non-compliance and misstatements at the service organisation\",\"statement\":\"Inquire of management whether the service organisation has reported, or the entity is otherwise aware of, fraud, non-compliance or uncorrected misstatements affecting the financial statements, and evaluate the effect on further procedures, conclusions and the report.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The entity uses a service organisation.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-402.20\",\"standard_id\":\"ISA-402\",\"paragraph\":\"20\",\"topic\":\"Modified opinion\",\"statement\":\"Modify the opinion where sufficient appropriate evidence about relevant services of the service organisation cannot be obtained.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Sufficient evidence on the service organisation's services cannot be obtained.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-402.21\",\"standard_id\":\"ISA-402\",\"paragraph\":\"21\",\"topic\":\"No reference in an unmodified report\",\"statement\":\"Do not refer to the work of a service auditor in a report with an unmodified opinion unless law requires it, in which case state that the reference does not diminish the auditor's responsibility.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-402.22\",\"standard_id\":\"ISA-402\",\"paragraph\":\"22\",\"topic\":\"Reference in a modified report\",\"statement\":\"Where reference to the service auditor is relevant to a modification, state that the reference does not diminish the auditor's responsibility for the opinion.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Reference to the service auditor is relevant to understanding a modification.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-550.11\",\"standard_id\":\"ISA-550\",\"paragraph\":\"11\",\"topic\":\"Related-party risk assessment procedures\",\"statement\":\"As part of risk assessment, perform the procedures in paragraphs 12 to 17 to obtain information relevant to identifying risks associated with related-party relationships and transactions.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-550.12\",\"standard_id\":\"ISA-550\",\"paragraph\":\"12\",\"topic\":\"Team discussion on related parties\",\"statement\":\"Include in the engagement team discussion specific consideration of the susceptibility of the financial statements to material misstatement from related-party relationships and transactions.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-550.13\",\"standard_id\":\"ISA-550\",\"paragraph\":\"13\",\"topic\":\"Inquiries about related parties\",\"statement\":\"Inquire of management about the identity of related parties including changes from the prior period, the nature of the relationships, and whether transactions occurred and their type and purpose.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-550.14\",\"standard_id\":\"ISA-550\",\"paragraph\":\"14\",\"topic\":\"Controls over related parties\",\"statement\":\"Inquire of management and others and perform other procedures to understand the controls over identifying, accounting for and disclosing related-party relationships and transactions, over authorising significant related-party transactions, and over authorising significant transactions outside the normal course of business.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-550.15\",\"standard_id\":\"ISA-550\",\"paragraph\":\"15\",\"topic\":\"Alertness when inspecting documents\",\"statement\":\"Remain alert when inspecting records for indications of undisclosed related parties or transactions, and in particular inspect bank and legal confirmations, minutes of shareholders and governance meetings, and other records judged necessary.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-550.16\",\"standard_id\":\"ISA-550\",\"paragraph\":\"16\",\"topic\":\"Significant transactions outside the normal course\",\"statement\":\"Where significant transactions outside the normal course of business are identified, inquire of management about their nature and whether related parties could be involved.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Significant transactions outside the normal course of business are identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-550.17\",\"standard_id\":\"ISA-550\",\"paragraph\":\"17\",\"topic\":\"Share information with the team\",\"statement\":\"Share relevant related-party information with the other members of the engagement team.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-550.18\",\"standard_id\":\"ISA-550\",\"paragraph\":\"18\",\"topic\":\"Assess related-party risks\",\"statement\":\"Identify and assess the risks associated with related-party relationships and transactions and determine whether any are significant risks; treat identified significant related-party transactions outside the normal course of business as giving rise to significant risks.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-550.19\",\"standard_id\":\"ISA-550\",\"paragraph\":\"19\",\"topic\":\"Related-party fraud risk factors\",\"statement\":\"Where fraud risk factors including a dominant related party are identified, consider them when assessing fraud risks under ISA 240.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Fraud risk factors, including a related party with dominant influence, are identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-550.20\",\"standard_id\":\"ISA-550\",\"paragraph\":\"20\",\"topic\":\"Responses to related-party risks\",\"statement\":\"Design and perform further procedures to obtain sufficient appropriate evidence on the assessed related-party risks, including those in paragraphs 21 to 24.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-550.21\",\"standard_id\":\"ISA-550\",\"paragraph\":\"21\",\"topic\":\"Confirm suspected undisclosed relationships\",\"statement\":\"Where arrangements or information suggest undisclosed related-party relationships or transactions, determine whether the circumstances confirm their existence.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Arrangements suggest undisclosed related parties or transactions.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-550.22\",\"standard_id\":\"ISA-550\",\"paragraph\":\"22\",\"topic\":\"Newly identified related parties\",\"statement\":\"Where undisclosed related parties or significant transactions are identified, promptly inform the team, request management to identify all transactions with them and explain why controls failed, perform substantive procedures on them, reconsider whether others exist, and if non-disclosure appears intentional evaluate the fraud implications.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Related parties or significant related-party transactions not previously disclosed are identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-550.23\",\"standard_id\":\"ISA-550\",\"paragraph\":\"23\",\"topic\":\"Significant related-party transactions outside the normal course\",\"statement\":\"For each significant related-party transaction outside the normal course of business, inspect the underlying contracts and evaluate whether the business rationale suggests fraudulent reporting or concealment of misappropriation, whether the terms match management's explanations, and whether accounting and disclosure are appropriate; and obtain evidence of appropriate authorisation and approval.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Significant related-party transactions outside the normal course of business are identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-550.24\",\"standard_id\":\"ISA-550\",\"paragraph\":\"24\",\"topic\":\"Arm's-length assertions\",\"statement\":\"Where the financial statements assert that a related-party transaction was on arm's-length terms, obtain sufficient appropriate evidence about that assertion.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Management asserts that a transaction was on arm's-length terms.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-550.25\",\"standard_id\":\"ISA-550\",\"paragraph\":\"25\",\"topic\":\"Evaluate accounting and disclosure\",\"statement\":\"In forming the opinion, evaluate whether identified related-party relationships and transactions are appropriately accounted for and disclosed and whether their effects prevent fair presentation or make the statements misleading.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-550.26\",\"standard_id\":\"ISA-550\",\"paragraph\":\"26\",\"topic\":\"Representations on related parties\",\"statement\":\"Where the framework has related-party requirements, obtain written representations that management has disclosed the identity of all related parties and all known relationships and transactions, and has appropriately accounted for and disclosed them.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The framework establishes related-party requirements.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-550.27\",\"standard_id\":\"ISA-550\",\"paragraph\":\"27\",\"topic\":\"Communicate significant related-party matters\",\"statement\":\"Unless all those charged with governance manage the entity, communicate significant matters arising in connection with related parties.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Not all of those charged with governance manage the entity.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-550.28\",\"standard_id\":\"ISA-550\",\"paragraph\":\"28\",\"topic\":\"Documentation of related parties\",\"statement\":\"Document the names of identified related parties and the nature of the relationships.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570.10\",\"standard_id\":\"ISA-570\",\"paragraph\":\"10\",\"topic\":\"Going concern in risk assessment\",\"statement\":\"During risk assessment, consider whether events or conditions may cast significant doubt on the entity's ability to continue as a going concern; where management has made a preliminary assessment, discuss it and any identified events and management's plans; where it has not, discuss the basis for using the going concern basis and inquire whether such events or conditions exist.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570.11\",\"standard_id\":\"ISA-570\",\"paragraph\":\"11\",\"topic\":\"Alertness for going concern evidence\",\"statement\":\"Remain alert throughout the audit for evidence of events or conditions that may cast significant doubt on going concern.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570.12\",\"standard_id\":\"ISA-570\",\"paragraph\":\"12\",\"topic\":\"Evaluate management's assessment\",\"statement\":\"Evaluate management's assessment of the entity's ability to continue as a going concern.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570.13\",\"standard_id\":\"ISA-570\",\"paragraph\":\"13\",\"topic\":\"Assessment period\",\"statement\":\"Cover the same period as management's assessment under the framework or a longer legal period; where management's assessment covers less than twelve months from the financial statement date, request that it be extended to at least twelve months.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570.14\",\"standard_id\":\"ISA-570\",\"paragraph\":\"14\",\"topic\":\"All relevant information\",\"statement\":\"Consider whether management's assessment includes all relevant information of which the auditor is aware from the audit.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570.15\",\"standard_id\":\"ISA-570\",\"paragraph\":\"15\",\"topic\":\"Beyond the assessment period\",\"statement\":\"Inquire of management about its knowledge of events or conditions beyond the assessment period that may cast significant doubt on going concern.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570.16\",\"standard_id\":\"ISA-570\",\"paragraph\":\"16\",\"topic\":\"Additional procedures when events or conditions exist\",\"statement\":\"Where events or conditions are identified, obtain sufficient appropriate evidence on whether a material uncertainty exists, considering mitigating factors: request an assessment if none exists, evaluate management's plans and their feasibility, evaluate the reliability of data and the support for assumptions behind any cash flow forecast, consider facts arising since the assessment, and request written representations on management's plans and their feasibility.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Events or conditions that may cast significant doubt have been identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570.17\",\"standard_id\":\"ISA-570\",\"paragraph\":\"17\",\"topic\":\"Conclude on the going concern basis\",\"statement\":\"Evaluate whether sufficient appropriate evidence has been obtained on, and conclude on, the appropriateness of management's use of the going concern basis of accounting.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570.18\",\"standard_id\":\"ISA-570\",\"paragraph\":\"18\",\"topic\":\"Conclude on material uncertainty\",\"statement\":\"Conclude whether a material uncertainty exists: one whose potential impact and likelihood are such that appropriate disclosure is necessary for fair presentation, or for the statements not to be misleading.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570.19\",\"standard_id\":\"ISA-570\",\"paragraph\":\"19\",\"topic\":\"Disclosure when a material uncertainty exists\",\"statement\":\"Where a material uncertainty exists, determine whether the financial statements adequately disclose the principal events or conditions and management's plans, and clearly disclose that a material uncertainty exists and the entity may be unable to realise its assets and discharge its liabilities in the normal course.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The going concern basis is appropriate but a material uncertainty exists.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570.20\",\"standard_id\":\"ISA-570\",\"paragraph\":\"20\",\"topic\":\"Disclosure when no material uncertainty exists\",\"statement\":\"Where events or conditions were identified but no material uncertainty exists, evaluate whether the financial statements provide adequate disclosure about them under the framework.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Events or conditions were identified but no material uncertainty is concluded.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570.21\",\"standard_id\":\"ISA-570\",\"paragraph\":\"21\",\"topic\":\"Inappropriate use of the going concern basis\",\"statement\":\"Where the going concern basis is used but is inappropriate, express an adverse opinion.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Use of the going concern basis is inappropriate.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570.22\",\"standard_id\":\"ISA-570\",\"paragraph\":\"22\",\"topic\":\"Material uncertainty adequately disclosed\",\"statement\":\"Where a material uncertainty is adequately disclosed, express an unmodified opinion and include a separate section headed as a material uncertainty related to going concern that draws attention to the note and states that the opinion is not modified in that respect.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"A material uncertainty exists and is adequately disclosed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570.23\",\"standard_id\":\"ISA-570\",\"paragraph\":\"23\",\"topic\":\"Material uncertainty not adequately disclosed\",\"statement\":\"Where a material uncertainty is not adequately disclosed, express a qualified or adverse opinion and state in the basis section that a material uncertainty exists and is not adequately disclosed.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"A material uncertainty exists and is not adequately disclosed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570.24\",\"standard_id\":\"ISA-570\",\"paragraph\":\"24\",\"topic\":\"Management unwilling to assess\",\"statement\":\"Where management is unwilling to make or extend its assessment when requested, consider the implications for the report.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Management is unwilling to make or extend its assessment.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570.25\",\"standard_id\":\"ISA-570\",\"paragraph\":\"25\",\"topic\":\"Communicate going concern matters\",\"statement\":\"Unless all those charged with governance manage the entity, communicate identified events or conditions, whether they constitute a material uncertainty, whether the going concern basis is appropriate, the adequacy of disclosures, and the implications for the report.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Not all of those charged with governance manage the entity, and events or conditions were identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570.26\",\"standard_id\":\"ISA-570\",\"paragraph\":\"26\",\"topic\":\"Significant delay in approval\",\"statement\":\"Where approval of the financial statements is significantly delayed, inquire into the reasons and, if the delay may relate to going concern, perform the additional procedures and reconsider the material-uncertainty conclusion.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Approval of the financial statements is significantly delayed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.15\",\"standard_id\":\"ISA-610\",\"paragraph\":\"15\",\"topic\":\"Evaluate the internal audit function\",\"statement\":\"Determine whether the internal audit function's work can be used by evaluating whether its organisational status and policies support objectivity, its level of competence, and whether it applies a systematic and disciplined approach including quality control.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The auditor considers using the work of the internal audit function.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.16\",\"standard_id\":\"ISA-610\",\"paragraph\":\"16\",\"topic\":\"When the function's work cannot be used\",\"statement\":\"Do not use the function's work where its status and policies do not adequately support objectivity, it lacks sufficient competence, or it does not apply a systematic and disciplined approach.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The function lacks objectivity, competence or a disciplined approach.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.17\",\"standard_id\":\"ISA-610\",\"paragraph\":\"17\",\"topic\":\"Nature and scope of the function's work\",\"statement\":\"As a basis for deciding where and how much of the function's work to use, consider the nature and scope of its performed or planned work and its relevance to the audit strategy and plan.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The function's work is to be used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.18\",\"standard_id\":\"ISA-610\",\"paragraph\":\"18\",\"topic\":\"Less use where more judgment or risk\",\"statement\":\"Make all significant judgments and plan to use less of the function's work and do more directly the more judgment is involved, the higher the assessed risk especially significant risks, the less the function's objectivity is supported, and the lower its competence.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The function's work is to be used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.19\",\"standard_id\":\"ISA-610\",\"paragraph\":\"19\",\"topic\":\"Sufficient involvement\",\"statement\":\"Evaluate whether the planned use of the function's work in aggregate would still leave the external auditor sufficiently involved, given sole responsibility for the opinion.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The function's work is to be used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.20\",\"standard_id\":\"ISA-610\",\"paragraph\":\"20\",\"topic\":\"Communicate planned use\",\"statement\":\"When communicating the planned scope and timing of the audit to those charged with governance, communicate how the function's work is planned to be used.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"The function's work is to be used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.21\",\"standard_id\":\"ISA-610\",\"paragraph\":\"21\",\"topic\":\"Coordinate with the function\",\"statement\":\"Discuss the planned use of the function's work with the function as a basis for coordinating activities.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"The function's work is to be used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.22\",\"standard_id\":\"ISA-610\",\"paragraph\":\"22\",\"topic\":\"Read the function's reports\",\"statement\":\"Read the function's reports on the work to be used to understand the nature and extent of its procedures and findings.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The function's work is to be used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.23\",\"standard_id\":\"ISA-610\",\"paragraph\":\"23\",\"topic\":\"Evaluate the adequacy of the work\",\"statement\":\"Perform sufficient procedures on the body of the function's work to be used to determine its adequacy, including whether it was properly planned, performed, supervised, reviewed and documented, whether sufficient appropriate evidence supports reasonable conclusions, and whether conclusions are appropriate and reports consistent with the work.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The function's work is to be used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.24\",\"standard_id\":\"ISA-610\",\"paragraph\":\"24\",\"topic\":\"Responsive procedures including reperformance\",\"statement\":\"Make the nature and extent of the procedures on the function's work responsive to the judgment involved, the assessed risk, the function's objectivity and competence, and include reperformance of some of the work.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The function's work is to be used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.25\",\"standard_id\":\"ISA-610\",\"paragraph\":\"25\",\"topic\":\"Re-evaluate conclusions\",\"statement\":\"Evaluate whether the conclusions about the function and the planned extent of use remain appropriate.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The function's work is used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.26\",\"standard_id\":\"ISA-610\",\"paragraph\":\"26\",\"topic\":\"Direct assistance prohibited by law\",\"statement\":\"Where law or regulation prohibits obtaining direct assistance from internal auditors, the direct-assistance requirements do not apply.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Law or regulation prohibits direct assistance.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.27\",\"standard_id\":\"ISA-610\",\"paragraph\":\"27\",\"topic\":\"Evaluate internal auditors for direct assistance\",\"statement\":\"Before using internal auditors for direct assistance, evaluate the existence and significance of threats to their objectivity, including by inquiring about interests and relationships, and their level of competence.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Direct assistance is planned and not prohibited.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.28\",\"standard_id\":\"ISA-610\",\"paragraph\":\"28\",\"topic\":\"When direct assistance cannot be used\",\"statement\":\"Do not use an internal auditor for direct assistance where there are significant threats to objectivity or insufficient competence.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Direct assistance is planned.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.29\",\"standard_id\":\"ISA-610\",\"paragraph\":\"29\",\"topic\":\"Nature and extent of assigned work\",\"statement\":\"In deciding what work to assign and how to direct, supervise and review it, consider the amount of judgment involved, the assessed risk, and the evaluation of threats to objectivity and of competence.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Direct assistance is used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.30\",\"standard_id\":\"ISA-610\",\"paragraph\":\"30\",\"topic\":\"Work not assignable\",\"statement\":\"Do not assign to internal auditors procedures involving significant judgments, procedures on higher risks needing more than limited judgment, work the function has already reported or will report to management or governance, or decisions about the function or its use.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Direct assistance is used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.31\",\"standard_id\":\"ISA-610\",\"paragraph\":\"31\",\"topic\":\"Communicate planned direct assistance\",\"statement\":\"When communicating the planned scope and timing to those charged with governance, communicate the nature and extent of planned direct assistance so as to reach a mutual understanding that it is not excessive.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Direct assistance is used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.32\",\"standard_id\":\"ISA-610\",\"paragraph\":\"32\",\"topic\":\"Aggregate involvement with direct assistance\",\"statement\":\"Evaluate whether the planned direct assistance, together with the planned use of the function's work, would still leave the external auditor sufficiently involved.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Direct assistance is used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.33\",\"standard_id\":\"ISA-610\",\"paragraph\":\"33\",\"topic\":\"Written agreements\",\"statement\":\"Before using direct assistance, obtain written agreement from an authorised representative of the entity that the internal auditors may follow the auditor's instructions without entity interference, and from the internal auditors that they will keep matters confidential as instructed and report threats to their objectivity.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Direct assistance is used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.34\",\"standard_id\":\"ISA-610\",\"paragraph\":\"34\",\"topic\":\"Direct, supervise and review direct assistance\",\"statement\":\"Direct, supervise and review the internal auditors' work, recognising they are not independent, responding to the evaluation of judgment, risk, objectivity and competence, and checking back to underlying evidence for some of the work, sufficiently to determine that the work supports its conclusions.\",\"kind\":\"quality\",\"conditional\":1,\"condition\":\"Direct assistance is used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.35\",\"standard_id\":\"ISA-610\",\"paragraph\":\"35\",\"topic\":\"Alertness during direct assistance\",\"statement\":\"Remain alert while directing, supervising and reviewing for indications that the evaluation of threats and competence is no longer appropriate.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Direct assistance is used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.36\",\"standard_id\":\"ISA-610\",\"paragraph\":\"36\",\"topic\":\"Documentation of using the function's work\",\"statement\":\"Document the evaluation of the function's objectivity, competence and disciplined approach, the nature and extent of the work used and the basis for that decision, and the procedures performed to evaluate its adequacy.\",\"kind\":\"documentation\",\"conditional\":1,\"condition\":\"The function's work is used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610.37\",\"standard_id\":\"ISA-610\",\"paragraph\":\"37\",\"topic\":\"Documentation of direct assistance\",\"statement\":\"Document the evaluation of threats to objectivity and of competence, the basis for the nature and extent of assigned work, who reviewed it and when and to what extent, the written agreements obtained, and the working papers the internal auditors prepared.\",\"kind\":\"documentation\",\"conditional\":1,\"condition\":\"Direct assistance is used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-620.7\",\"standard_id\":\"ISA-620\",\"paragraph\":\"7\",\"topic\":\"Need for an auditor's expert\",\"statement\":\"Where expertise in a field other than accounting or auditing is necessary, determine whether to use the work of an auditor's expert.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Expertise outside accounting or auditing is necessary for sufficient appropriate evidence.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-620.8\",\"standard_id\":\"ISA-620\",\"paragraph\":\"8\",\"topic\":\"Nature, timing and extent of procedures\",\"statement\":\"In determining the procedures on the expert, consider the nature of the matter, the risks of material misstatement in it, the significance of the expert's work, knowledge of the expert's previous work, and whether the expert is subject to the firm's quality management.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"An auditor's expert is used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-620.9\",\"standard_id\":\"ISA-620\",\"paragraph\":\"9\",\"topic\":\"Competence, capabilities and objectivity\",\"statement\":\"Evaluate whether the expert has the competence, capabilities and objectivity needed; for an external expert, inquire about interests and relationships that may threaten objectivity.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"An auditor's expert is used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-620.10\",\"standard_id\":\"ISA-620\",\"paragraph\":\"10\",\"topic\":\"Understand the field\",\"statement\":\"Obtain a sufficient understanding of the expert's field to determine the nature, scope and objectives of the work and to evaluate its adequacy.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"An auditor's expert is used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-620.11\",\"standard_id\":\"ISA-620\",\"paragraph\":\"11\",\"topic\":\"Agreement with the expert\",\"statement\":\"Agree with the expert, in writing where appropriate, the nature, scope and objectives of the work, the respective roles and responsibilities, the nature, timing and extent of communication including any report, and confidentiality.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"An auditor's expert is used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-620.12\",\"standard_id\":\"ISA-620\",\"paragraph\":\"12\",\"topic\":\"Evaluate the adequacy of the work\",\"statement\":\"Evaluate the adequacy of the expert's work: the relevance and reasonableness of findings and their consistency with other evidence, the relevance and reasonableness of significant assumptions and methods, and the relevance, completeness and accuracy of significant source data.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"An auditor's expert is used.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-620.13\",\"standard_id\":\"ISA-620\",\"paragraph\":\"13\",\"topic\":\"Inadequate work\",\"statement\":\"Where the expert's work is not adequate, agree further work with the expert or perform additional procedures.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The expert's work is not adequate.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-620.14\",\"standard_id\":\"ISA-620\",\"paragraph\":\"14\",\"topic\":\"No reference in an unmodified report\",\"statement\":\"Do not refer to an auditor's expert in a report with an unmodified opinion unless law requires it, in which case state that the reference does not reduce the auditor's responsibility.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-620.15\",\"standard_id\":\"ISA-620\",\"paragraph\":\"15\",\"topic\":\"Reference in a modified report\",\"statement\":\"Where the expert is referred to because it is relevant to a modification, state that the reference does not reduce the auditor's responsibility for the opinion.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Reference to the expert is relevant to understanding a modification.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-2.14\",\"standard_id\":\"ISQM-2\",\"paragraph\":\"14\",\"topic\":\"Understand the standard\",\"statement\":\"The firm and the engagement quality reviewer understand the standard, including its application material, so as to apply its requirements properly.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-2.15\",\"standard_id\":\"ISQM-2\",\"paragraph\":\"15\",\"topic\":\"Comply with each requirement\",\"statement\":\"The firm and the reviewer comply with each requirement unless it is not relevant to the engagement.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-2.16\",\"standard_id\":\"ISQM-2\",\"paragraph\":\"16\",\"topic\":\"Further actions to achieve the objective\",\"statement\":\"Where applying the requirements does not achieve the objective, take further actions to achieve it.\",\"kind\":\"quality\",\"conditional\":1,\"condition\":\"Applying the requirements does not provide a sufficient basis for the objective.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-2.17\",\"standard_id\":\"ISQM-2\",\"paragraph\":\"17\",\"topic\":\"Responsibility for appointing reviewers\",\"statement\":\"Establish policies assigning responsibility for appointing engagement quality reviewers to individuals with the competence, capabilities and authority to do so, and requiring them to make the appointment.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-2.18\",\"standard_id\":\"ISQM-2\",\"paragraph\":\"18\",\"topic\":\"Eligibility criteria\",\"statement\":\"Establish eligibility criteria requiring that the reviewer is not a member of the engagement team, has the competence, capabilities, time and authority to perform the review, complies with ethical requirements including objectivity and independence, and complies with relevant law.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-2.19\",\"standard_id\":\"ISQM-2\",\"paragraph\":\"19\",\"topic\":\"Cooling-off after serving as engagement partner\",\"statement\":\"Address threats to objectivity where a former engagement partner is appointed reviewer, specifying a cooling-off period of two years or longer where ethical requirements require.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-2.20\",\"standard_id\":\"ISQM-2\",\"paragraph\":\"20\",\"topic\":\"Eligibility of assistants\",\"statement\":\"Establish eligibility criteria for individuals assisting the reviewer: not members of the engagement team, with the competence, capabilities and time for their duties, and compliant with ethical requirements and law.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-2.21\",\"standard_id\":\"ISQM-2\",\"paragraph\":\"21\",\"topic\":\"Reviewer's overall responsibility\",\"statement\":\"Require the reviewer to take overall responsibility for the review and to determine the direction, supervision and review of assistants' work.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-2.22\",\"standard_id\":\"ISQM-2\",\"paragraph\":\"22\",\"topic\":\"Impairment of eligibility\",\"statement\":\"Establish policies addressing circumstances that impair the reviewer's eligibility, the actions to take, and the process for appointing a replacement.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-2.23\",\"standard_id\":\"ISQM-2\",\"paragraph\":\"23\",\"topic\":\"Reviewer becomes ineligible\",\"statement\":\"Where the reviewer becomes aware of impaired eligibility, notify the appropriate individuals and decline the appointment if the review has not started, or discontinue it if it has.\",\"kind\":\"quality\",\"conditional\":1,\"condition\":\"The reviewer becomes aware of circumstances impairing eligibility.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-2.24\",\"standard_id\":\"ISQM-2\",\"paragraph\":\"24\",\"topic\":\"Policies on performing the review\",\"statement\":\"Establish policies addressing the reviewer's responsibility to perform procedures at appropriate points during the engagement, the engagement partner's responsibilities including not dating the report until notified the review is complete, and threats to the reviewer's objectivity arising from discussions with the team.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-2.25\",\"standard_id\":\"ISQM-2\",\"paragraph\":\"25\",\"topic\":\"Performing the review\",\"statement\":\"In performing the review, read and understand information from the team and from the firm's monitoring process; discuss significant matters and judgments with the engagement partner; review selected documentation on significant judgments and evaluate their basis including scepticism, whether documentation supports conclusions and whether conclusions are appropriate; evaluate the basis for the partner's independence determination; evaluate consultation on difficult matters; evaluate the basis for the partner's determination of sufficient involvement; and review the financial statements and the report including key audit matters.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-2.26\",\"standard_id\":\"ISQM-2\",\"paragraph\":\"26\",\"topic\":\"Concerns about judgments\",\"statement\":\"Notify the engagement partner of concerns that significant judgments or conclusions are inappropriate and, if unresolved, notify the appropriate individuals in the firm that the review cannot be completed.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"The reviewer has concerns about significant judgments or conclusions.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-2.27\",\"standard_id\":\"ISQM-2\",\"paragraph\":\"27\",\"topic\":\"Completion of the review\",\"statement\":\"Determine whether the performance requirements have been fulfilled and the review is complete, and if so notify the engagement partner.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-2.28\",\"standard_id\":\"ISQM-2\",\"paragraph\":\"28\",\"topic\":\"Responsibility for review documentation\",\"statement\":\"Establish policies requiring the reviewer to take responsibility for documenting the review.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-2.29\",\"standard_id\":\"ISQM-2\",\"paragraph\":\"29\",\"topic\":\"Documentation included with the engagement file\",\"statement\":\"Establish policies requiring the review to be documented and the documentation included with the engagement documentation.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-2.30\",\"standard_id\":\"ISQM-2\",\"paragraph\":\"30\",\"topic\":\"Content of review documentation\",\"statement\":\"Determine that the review documentation enables an experienced practitioner to understand the procedures performed and conclusions reached, and that it includes the names of the reviewer and assistants, the documentation reviewed, the basis for the completion determination, the notifications made, and the completion date.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.16\",\"standard_id\":\"ISA-600\",\"paragraph\":\"16\",\"topic\":\"Group engagement partner responsibility\",\"statement\":\"The group engagement partner takes overall responsibility for quality on the group audit, creating an environment that emphasises expected behaviour and being sufficiently involved throughout, including in component auditors' work.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.17\",\"standard_id\":\"ISA-600\",\"paragraph\":\"17\",\"topic\":\"Acceptance: expectation of sufficient evidence\",\"statement\":\"Before accepting or continuing a group audit, determine whether sufficient appropriate evidence can reasonably be expected to be obtained as a basis for the group opinion.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.18\",\"standard_id\":\"ISA-600\",\"paragraph\":\"18\",\"topic\":\"Evidence unobtainable after acceptance\",\"statement\":\"Where after acceptance sufficient appropriate evidence cannot be obtained, consider the possible effects on the group audit.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"After acceptance it is concluded that sufficient appropriate evidence cannot be obtained.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.19\",\"standard_id\":\"ISA-600\",\"paragraph\":\"19\",\"topic\":\"Group management's acknowledgement of access\",\"statement\":\"Obtain group management's agreement that it acknowledges responsibility to provide access to all relevant information, additional information requested from group or component management, and unrestricted access to persons within the group.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.20\",\"standard_id\":\"ISA-600\",\"paragraph\":\"20\",\"topic\":\"Restrictions outside management's control\",\"statement\":\"Where restrictions outside group management's control prevent access to information or people, consider the possible effects on the group audit.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Access restrictions exist outside group management's control.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.21\",\"standard_id\":\"ISA-600\",\"paragraph\":\"21\",\"topic\":\"Restrictions imposed by group management\",\"statement\":\"Where restrictions imposed by group management would prevent sufficient evidence and lead to a disclaimer, do not accept or withdraw where possible, or, where declining or withdrawing is not possible, disclaim an opinion after performing the audit to the extent possible.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Group management imposes restrictions that would lead to a disclaimer.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.22\",\"standard_id\":\"ISA-600\",\"paragraph\":\"22\",\"topic\":\"Group strategy and plan\",\"statement\":\"Establish and update an overall group audit strategy and plan, determining the components at which audit work will be performed and the resources needed including component auditors' involvement.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.23\",\"standard_id\":\"ISA-600\",\"paragraph\":\"23\",\"topic\":\"Involvement in component auditors' work\",\"statement\":\"Evaluate whether the group auditor will be able to be sufficiently and appropriately involved in the component auditor's work.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Component auditors are involved.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.24\",\"standard_id\":\"ISA-600\",\"paragraph\":\"24\",\"topic\":\"Component auditor cooperation\",\"statement\":\"Request the component auditor to confirm cooperation, including whether the requested work will be performed.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Component auditors are involved.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.25\",\"standard_id\":\"ISA-600\",\"paragraph\":\"25\",\"topic\":\"Ethical requirements for component auditors\",\"statement\":\"Take responsibility for component auditors being made aware of the applicable ethical requirements and confirm whether they understand and will comply with them, including independence.\",\"kind\":\"ethics\",\"conditional\":1,\"condition\":\"Component auditors are involved.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.26\",\"standard_id\":\"ISA-600\",\"paragraph\":\"26\",\"topic\":\"Component auditor competence\",\"statement\":\"Determine that component auditors have the competence, capabilities and time to perform the assigned procedures, taking into account relevant monitoring, remediation or inspection information.\",\"kind\":\"quality\",\"conditional\":1,\"condition\":\"Component auditors are involved.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.27\",\"standard_id\":\"ISA-600\",\"paragraph\":\"27\",\"topic\":\"Obtain evidence without the component auditor\",\"statement\":\"Obtain the evidence for the component without involving the component auditor where the component auditor does not comply with ethical requirements including independence, or where serious concerns exist about involvement, cooperation, ethics or competence.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The component auditor is not independent or serious concerns exist.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.28\",\"standard_id\":\"ISA-600\",\"paragraph\":\"28\",\"topic\":\"Direction, supervision and review of component auditors\",\"statement\":\"Take responsibility for the nature, timing and extent of direction, supervision and review of component auditors, focusing on higher-risk and significant-risk areas and areas involving significant judgment.\",\"kind\":\"quality\",\"conditional\":1,\"condition\":\"Component auditors are involved.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.29\",\"standard_id\":\"ISA-600\",\"paragraph\":\"29\",\"topic\":\"Communications with component auditors\",\"statement\":\"Communicate with component auditors about respective responsibilities and expectations, including that communication takes place at appropriate times throughout the group audit.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Component auditors are involved.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.30\",\"standard_id\":\"ISA-600\",\"paragraph\":\"30\",\"topic\":\"Understand the group\",\"statement\":\"Take responsibility for understanding the group and its environment including structure, locations, nature and similarity of operations and IT; regulatory factors and performance measures; the framework and consistency of policies across the group; and the group's system of internal control including commonality of controls, centralisation, the consolidation process and communication of significant matters to component management.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.31\",\"standard_id\":\"ISA-600\",\"paragraph\":\"31\",\"topic\":\"Communicate to component auditors\",\"statement\":\"Communicate to component auditors on a timely basis matters relevant to their risk assessment procedures, related-party relationships and transactions relevant to their work, and going concern events or conditions relevant to their work.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Component auditors are involved.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.32\",\"standard_id\":\"ISA-600\",\"paragraph\":\"32\",\"topic\":\"Request communication from component auditors\",\"statement\":\"Request component auditors to communicate on a timely basis matters relevant to identifying and assessing group risks, related parties not previously identified, and going concern events or conditions they identify.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Component auditors are involved.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.33\",\"standard_id\":\"ISA-600\",\"paragraph\":\"33\",\"topic\":\"Identify and assess group risks\",\"statement\":\"Take responsibility for identifying and assessing the risks of material misstatement of the group financial statements, including from the consolidation process.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.34\",\"standard_id\":\"ISA-600\",\"paragraph\":\"34\",\"topic\":\"Evaluate the risk assessment evidence\",\"statement\":\"Evaluate whether the evidence from risk assessment procedures performed by the group auditor and component auditors provides an appropriate basis for identifying and assessing group risks.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Component auditors are involved.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.35\",\"standard_id\":\"ISA-600\",\"paragraph\":\"35\",\"topic\":\"Component performance materiality and threshold\",\"statement\":\"Where items are disaggregated across components, determine component performance materiality lower than group performance materiality to address aggregation risk, and a threshold for communicating misstatements to the group auditor not exceeding the amount clearly trivial to the group.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Classes of transactions, balances or disclosures are disaggregated across components.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.36\",\"standard_id\":\"ISA-600\",\"paragraph\":\"36\",\"topic\":\"Communicate materiality to component auditors\",\"statement\":\"Communicate the component performance materiality and the misstatement threshold to the component auditor.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Component auditors are involved.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.37\",\"standard_id\":\"ISA-600\",\"paragraph\":\"37\",\"topic\":\"Responsibility for further procedures\",\"statement\":\"Take responsibility for the nature, timing and extent of further procedures, including which components to perform work at and the work to be performed there.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.38\",\"standard_id\":\"ISA-600\",\"paragraph\":\"38\",\"topic\":\"Consolidation process procedures\",\"statement\":\"Design and perform further procedures on the consolidation process: evaluate whether all entities and business units are included and address sub-consolidations, evaluate consolidation adjustments and reclassifications for appropriateness, completeness and accuracy, evaluate whether consolidation judgments indicate bias, and respond to fraud risks in consolidation.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.39\",\"standard_id\":\"ISA-600\",\"paragraph\":\"39\",\"topic\":\"Differing accounting policies\",\"statement\":\"Where component information is not prepared under the group's accounting policies, evaluate whether it has been appropriately adjusted.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Component financial information uses policies different from the group's.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.40\",\"standard_id\":\"ISA-600\",\"paragraph\":\"40\",\"topic\":\"Differing period ends\",\"statement\":\"Where a component's reporting period end differs from the group's, evaluate whether appropriate adjustments have been made under the framework.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"A component's period end differs from the group's.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.41\",\"standard_id\":\"ISA-600\",\"paragraph\":\"41\",\"topic\":\"Communicate on responses\",\"statement\":\"Where component auditors are involved in further procedures, communicate about matters relevant to the design of responses to the assessed group risks.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Component auditors design or perform further procedures.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.42\",\"standard_id\":\"ISA-600\",\"paragraph\":\"42\",\"topic\":\"Evaluate component auditors' responses to higher risks\",\"statement\":\"For higher-risk and significant-risk areas where a component auditor determines the procedures, evaluate the appropriateness of their design and performance.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"A component auditor determines procedures for higher or significant risks.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.43\",\"standard_id\":\"ISA-600\",\"paragraph\":\"43\",\"topic\":\"Component work on consolidation\",\"statement\":\"Where component auditors perform procedures on the consolidation process, determine the direction, supervision and review of their work.\",\"kind\":\"quality\",\"conditional\":1,\"condition\":\"Component auditors perform procedures on the consolidation process.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.44\",\"standard_id\":\"ISA-600\",\"paragraph\":\"44\",\"topic\":\"Financial information matches\",\"statement\":\"Determine that the financial information identified in the component auditor's communication is the information incorporated in the group financial statements.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Component auditors are involved.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.45\",\"standard_id\":\"ISA-600\",\"paragraph\":\"45\",\"topic\":\"Component auditor's communication of results\",\"statement\":\"Request the component auditor to communicate the information audited, whether the requested work was performed, compliance with ethical requirements, non-compliance with laws, corrected and uncorrected misstatements above the threshold, bias indicators, control deficiencies, fraud involving component management or key employees or causing material misstatement, other significant matters communicated to component management or governance, other relevant matters including representation exceptions, and overall findings and conclusions.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Component auditors are involved.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.46\",\"standard_id\":\"ISA-600\",\"paragraph\":\"46\",\"topic\":\"Discuss and evaluate communications\",\"statement\":\"Discuss significant matters from component auditor communications with the component auditor, component management or group management, and evaluate whether the communications are adequate; if not, consider the implications.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Component auditors are involved.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.47\",\"standard_id\":\"ISA-600\",\"paragraph\":\"47\",\"topic\":\"Review of additional documentation\",\"statement\":\"Determine whether and to what extent additional component auditor documentation must be reviewed, considering the nature, timing and extent of their work, their competence and capabilities, and the direction, supervision and review applied.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Component auditors are involved.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.48\",\"standard_id\":\"ISA-600\",\"paragraph\":\"48\",\"topic\":\"Inadequate component work\",\"statement\":\"Where the component auditor's work is not adequate, determine what additional procedures are needed and whether the component auditor or group auditor performs them.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The component auditor's work is not adequate.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.49\",\"standard_id\":\"ISA-600\",\"paragraph\":\"49\",\"topic\":\"Subsequent events across the group\",\"statement\":\"Take responsibility for procedures, including requesting component auditors to perform procedures, designed to identify events requiring adjustment or disclosure in the group financial statements.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.50\",\"standard_id\":\"ISA-600\",\"paragraph\":\"50\",\"topic\":\"Component auditors notify subsequent events\",\"statement\":\"Request component auditors to notify the group auditor of subsequent events that may require adjustment or disclosure.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Component auditors are involved.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.51\",\"standard_id\":\"ISA-600\",\"paragraph\":\"51\",\"topic\":\"Sufficiency of group evidence\",\"statement\":\"Evaluate whether sufficient appropriate evidence has been obtained, including from component auditors' work, on which to base the group opinion.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.52\",\"standard_id\":\"ISA-600\",\"paragraph\":\"52\",\"topic\":\"Effect of misstatements and scope limitations\",\"statement\":\"Evaluate the effect on the group opinion of uncorrected misstatements identified by the group auditor or communicated by component auditors, and of any inability to obtain sufficient appropriate evidence.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.53\",\"standard_id\":\"ISA-600\",\"paragraph\":\"53\",\"topic\":\"No reference to component auditors\",\"statement\":\"Do not refer to a component auditor in the group report unless law requires it, in which case state that the reference does not diminish the group engagement partner's or firm's responsibility.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.54\",\"standard_id\":\"ISA-600\",\"paragraph\":\"54\",\"topic\":\"Communicate scope to group management\",\"statement\":\"Communicate to group management an overview of the planned scope and timing including the work at components.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.55\",\"standard_id\":\"ISA-600\",\"paragraph\":\"55\",\"topic\":\"Communicate fraud to group management\",\"statement\":\"Where fraud is identified or indicated, including by a component auditor, communicate it to the appropriate level of group management on a timely basis.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Fraud is identified or indicated.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.56\",\"standard_id\":\"ISA-600\",\"paragraph\":\"56\",\"topic\":\"Matters significant to a component with a statutory audit\",\"statement\":\"Where a component auditor must opine on a component, request group management to inform component management of matters significant to that component of which it may be unaware; if refused, discuss with group governance and, if unresolved, consider advising the component auditor not to issue its report.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"A component auditor issues a statutory opinion on a component.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.57\",\"standard_id\":\"ISA-600\",\"paragraph\":\"57\",\"topic\":\"Communicate with group governance\",\"statement\":\"Communicate to those charged with governance of the group an overview of the work at components and the planned involvement in component auditors' work, concerns about the quality of a component auditor's work and how they were addressed, limitations on scope, and fraud involving group or component management, key employees or others where material.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.58\",\"standard_id\":\"ISA-600\",\"paragraph\":\"58\",\"topic\":\"Group control deficiencies\",\"statement\":\"Determine whether identified deficiencies in the group's system of internal control, including those communicated by component auditors, must be communicated to group governance or management.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600.59\",\"standard_id\":\"ISA-600\",\"paragraph\":\"59\",\"topic\":\"Group audit documentation\",\"statement\":\"Document significant access restrictions and how they were addressed, the basis for determining components, the basis for component performance materiality and the misstatement threshold, the basis for concluding component auditors are competent, key elements of the understanding of the group's internal control, the direction, supervision and review of component auditors including any review of additional documentation, communications with component auditors on fraud, related parties, going concern and conclusions, and the evaluation of and response to component auditors' findings.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-701.9\",\"standard_id\":\"ISA-701\",\"paragraph\":\"9\",\"topic\":\"Matters requiring significant attention\",\"statement\":\"From the matters communicated with those charged with governance, determine those that required significant auditor attention, taking into account higher-risk and significant-risk areas, significant auditor judgments on areas involving significant management judgment including highly uncertain estimates, and the effect of significant events or transactions.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-701.10\",\"standard_id\":\"ISA-701\",\"paragraph\":\"10\",\"topic\":\"Determine the key audit matters\",\"statement\":\"Determine which of those matters were of most significance in the current-period audit; these are the key audit matters.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-701.11\",\"standard_id\":\"ISA-701\",\"paragraph\":\"11\",\"topic\":\"Key audit matters section\",\"statement\":\"Describe each key audit matter under its own subheading in a separate section of the report headed as key audit matters, with introductory language stating that they were of most significance, were addressed in the context of the audit as a whole, and that no separate opinion is provided on them.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-701.12\",\"standard_id\":\"ISA-701\",\"paragraph\":\"12\",\"topic\":\"Not a substitute for modification\",\"statement\":\"Do not communicate as a key audit matter a matter that requires the opinion to be modified.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-701.13\",\"standard_id\":\"ISA-701\",\"paragraph\":\"13\",\"topic\":\"Description of each matter\",\"statement\":\"For each key audit matter, refer to the related disclosures if any, explain why the matter was one of most significance, and describe how it was addressed in the audit.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-701.14\",\"standard_id\":\"ISA-701\",\"paragraph\":\"14\",\"topic\":\"When a key audit matter is not communicated\",\"statement\":\"Describe each key audit matter unless law precludes public disclosure or, in extremely rare cases, the adverse consequences of communicating would reasonably outweigh the public interest benefits and the entity has not publicly disclosed the matter.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Law precludes disclosure, or adverse consequences would outweigh the public interest.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-701.15\",\"standard_id\":\"ISA-701\",\"paragraph\":\"15\",\"topic\":\"Modified opinion and going concern matters\",\"statement\":\"Matters giving rise to a modified opinion or a going concern material uncertainty are key audit matters by nature but are reported under their own standards, with a reference to those sections in the key audit matters section rather than a description there.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"A matter gives rise to a modified opinion or a material uncertainty on going concern.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-701.16\",\"standard_id\":\"ISA-701\",\"paragraph\":\"16\",\"topic\":\"No key audit matters\",\"statement\":\"Where there are no key audit matters to communicate, or the only ones are those reported elsewhere, include a statement to that effect in the key audit matters section.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"There are no key audit matters, or the only ones are those covered by paragraph 15.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-701.17\",\"standard_id\":\"ISA-701\",\"paragraph\":\"17\",\"topic\":\"Communicate key audit matters\",\"statement\":\"Communicate to those charged with governance the matters determined to be key audit matters or, where applicable, the determination that there are none.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-701.18\",\"standard_id\":\"ISA-701\",\"paragraph\":\"18\",\"topic\":\"Documentation of key audit matters\",\"statement\":\"Document the matters that required significant attention and the rationale for whether each is a key audit matter, the rationale where none are communicated or only those reported elsewhere, and the rationale for not communicating a determined key audit matter.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.6\",\"standard_id\":\"ISA-705\",\"paragraph\":\"6\",\"topic\":\"When to modify\",\"statement\":\"Modify the opinion where the financial statements as a whole are not free from material misstatement, or where sufficient appropriate evidence to conclude that they are cannot be obtained.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The statements are materially misstated, or sufficient evidence cannot be obtained.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.7\",\"standard_id\":\"ISA-705\",\"paragraph\":\"7\",\"topic\":\"Qualified opinion\",\"statement\":\"Express a qualified opinion where misstatements are material but not pervasive, or where evidence is lacking and the possible effects of undetected misstatements could be material but not pervasive.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Misstatements or possible undetected misstatements are material but not pervasive.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.8\",\"standard_id\":\"ISA-705\",\"paragraph\":\"8\",\"topic\":\"Adverse opinion\",\"statement\":\"Express an adverse opinion where, having obtained sufficient appropriate evidence, misstatements are concluded to be both material and pervasive.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Misstatements are material and pervasive.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.9\",\"standard_id\":\"ISA-705\",\"paragraph\":\"9\",\"topic\":\"Disclaimer for lack of evidence\",\"statement\":\"Disclaim an opinion where sufficient appropriate evidence cannot be obtained and the possible effects of undetected misstatements could be both material and pervasive.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Evidence is lacking and possible effects could be material and pervasive.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.10\",\"standard_id\":\"ISA-705\",\"paragraph\":\"10\",\"topic\":\"Disclaimer for multiple uncertainties\",\"statement\":\"Disclaim an opinion where, in extremely rare cases of multiple uncertainties, their interaction and cumulative effect make it impossible to form an opinion despite evidence on each.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Multiple uncertainties interact so that an opinion cannot be formed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.11\",\"standard_id\":\"ISA-705\",\"paragraph\":\"11\",\"topic\":\"Request removal of a limitation\",\"statement\":\"Where a management-imposed limitation after acceptance is likely to require a qualified opinion or disclaimer, request that management remove it.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Management imposes a scope limitation after acceptance likely to require a qualification or disclaimer.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.12\",\"standard_id\":\"ISA-705\",\"paragraph\":\"12\",\"topic\":\"Management refuses\",\"statement\":\"Where management refuses to remove the limitation, communicate the matter to those charged with governance unless they all manage the entity, and determine whether alternative procedures can obtain sufficient evidence.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Management refuses to remove the limitation.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.13\",\"standard_id\":\"ISA-705\",\"paragraph\":\"13\",\"topic\":\"Implications of insufficient evidence\",\"statement\":\"Where sufficient evidence cannot be obtained, qualify the opinion if possible effects could be material but not pervasive; if they could be material and pervasive, withdraw where practicable and permitted or, if withdrawal is not practicable before reporting, disclaim an opinion.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Sufficient appropriate evidence cannot be obtained.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.14\",\"standard_id\":\"ISA-705\",\"paragraph\":\"14\",\"topic\":\"Communicate before withdrawing\",\"statement\":\"Before withdrawing, communicate to those charged with governance any misstatements identified that would have led to a modification.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"The auditor withdraws under paragraph 13.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.15\",\"standard_id\":\"ISA-705\",\"paragraph\":\"15\",\"topic\":\"No piecemeal opinions\",\"statement\":\"Where an adverse opinion or disclaimer is expressed on the financial statements as a whole, do not also express an unmodified opinion under the same framework on a single statement or element in the same report.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"An adverse opinion or disclaimer is expressed on the statements as a whole.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.16\",\"standard_id\":\"ISA-705\",\"paragraph\":\"16\",\"topic\":\"Heading of the opinion section\",\"statement\":\"Use the heading for a qualified opinion, adverse opinion or disclaimer of opinion, as appropriate, for the opinion section.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The opinion is modified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.17\",\"standard_id\":\"ISA-705\",\"paragraph\":\"17\",\"topic\":\"Wording of a qualified opinion\",\"statement\":\"State that, except for the effects (or possible effects, for lack of evidence) of the matters in the basis section, the statements present fairly or are prepared in all material respects under the framework.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"A qualified opinion is expressed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.18\",\"standard_id\":\"ISA-705\",\"paragraph\":\"18\",\"topic\":\"Wording of an adverse opinion\",\"statement\":\"State that, because of the significance of the matters in the basis section, the statements do not present fairly or have not been prepared in all material respects under the framework.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"An adverse opinion is expressed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.19\",\"standard_id\":\"ISA-705\",\"paragraph\":\"19\",\"topic\":\"Wording of a disclaimer\",\"statement\":\"State that no opinion is expressed, that because of the matters in the basis section sufficient appropriate evidence could not be obtained, and amend the statement that the statements were audited to say the auditor was engaged to audit them.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"An opinion is disclaimed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.20\",\"standard_id\":\"ISA-705\",\"paragraph\":\"20\",\"topic\":\"Basis for modified opinion section\",\"statement\":\"Amend the basis-for-opinion heading to reflect the modification and describe within it the matter giving rise to the modification.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The opinion is modified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.21\",\"standard_id\":\"ISA-705\",\"paragraph\":\"21\",\"topic\":\"Quantify financial effects\",\"statement\":\"Where a material misstatement relates to specific amounts, describe and quantify its financial effects in the basis section unless impracticable, and state where quantification is impracticable.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"A material misstatement relates to specific amounts.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.22\",\"standard_id\":\"ISA-705\",\"paragraph\":\"22\",\"topic\":\"Qualitative disclosures misstated\",\"statement\":\"Where a material misstatement relates to qualitative disclosures, explain in the basis section how the disclosures are misstated.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"A material misstatement relates to qualitative disclosures.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.23\",\"standard_id\":\"ISA-705\",\"paragraph\":\"23\",\"topic\":\"Omitted disclosures\",\"statement\":\"Where required information is omitted, discuss the omission with those charged with governance, describe the nature of the omitted information in the basis section, and include the omitted disclosures where practicable, not prohibited, and supported by sufficient evidence.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"A material misstatement arises from non-disclosure of required information.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.24\",\"standard_id\":\"ISA-705\",\"paragraph\":\"24\",\"topic\":\"Reasons for inability\",\"statement\":\"Where the modification results from an inability to obtain sufficient evidence, include the reasons in the basis section.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The modification results from inability to obtain evidence.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.25\",\"standard_id\":\"ISA-705\",\"paragraph\":\"25\",\"topic\":\"Amend the sufficiency statement\",\"statement\":\"For a qualified or adverse opinion, amend the statement on the sufficiency of evidence to refer to the qualified or adverse opinion.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"A qualified or adverse opinion is expressed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.26\",\"standard_id\":\"ISA-705\",\"paragraph\":\"26\",\"topic\":\"Elements omitted on disclaimer\",\"statement\":\"On a disclaimer, omit the reference to the auditor's responsibilities section and the statement on the sufficiency of evidence.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"An opinion is disclaimed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.27\",\"standard_id\":\"ISA-705\",\"paragraph\":\"27\",\"topic\":\"Other matters requiring modification\",\"statement\":\"Even on an adverse opinion or disclaimer, describe in the basis section the reasons for and effects of any other matters that would have required a modification.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"An adverse opinion or disclaimer is expressed and other matters would also have required modification.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.28\",\"standard_id\":\"ISA-705\",\"paragraph\":\"28\",\"topic\":\"Responsibilities description on disclaimer\",\"statement\":\"On a disclaimer for lack of evidence, reduce the description of the auditor's responsibilities to a statement of the responsibility to audit and report, a statement that evidence could not be obtained because of the matters in the basis section, and the statement on independence and ethics.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"An opinion is disclaimed for lack of evidence.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.29\",\"standard_id\":\"ISA-705\",\"paragraph\":\"29\",\"topic\":\"No key audit matters or other information on disclaimer\",\"statement\":\"Unless required by law, omit the key audit matters and other information sections when disclaiming an opinion.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"An opinion is disclaimed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705.30\",\"standard_id\":\"ISA-705\",\"paragraph\":\"30\",\"topic\":\"Communicate the expected modification\",\"statement\":\"Where a modification is expected, communicate to those charged with governance the circumstances leading to it and its wording.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"A modification is expected.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-706.8\",\"standard_id\":\"ISA-706\",\"paragraph\":\"8\",\"topic\":\"When to include an emphasis of matter\",\"statement\":\"Include an emphasis-of-matter paragraph where a matter presented or disclosed in the financial statements is fundamental to users' understanding, provided the opinion need not be modified for it and it has not been determined to be a key audit matter.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"A disclosed matter is fundamental to users' understanding.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-706.9\",\"standard_id\":\"ISA-706\",\"paragraph\":\"9\",\"topic\":\"Form of an emphasis of matter\",\"statement\":\"Place the paragraph in a separate section with a heading that includes the term emphasis of matter, refer clearly to the matter and to where the disclosures are found, refer only to information in the financial statements, and state that the opinion is not modified in respect of it.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"An emphasis-of-matter paragraph is included.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-706.10\",\"standard_id\":\"ISA-706\",\"paragraph\":\"10\",\"topic\":\"When to include an other matter\",\"statement\":\"Include an other-matter paragraph for a matter not presented in the financial statements that is relevant to understanding the audit, the auditor's responsibilities or the report, provided law does not prohibit it and it is not a key audit matter.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"A matter outside the financial statements is relevant to understanding the audit, the auditor's responsibilities or the report.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-706.11\",\"standard_id\":\"ISA-706\",\"paragraph\":\"11\",\"topic\":\"Form of an other matter\",\"statement\":\"Place the other-matter paragraph in a separate section headed other matter or another appropriate heading.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"An other-matter paragraph is included.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-706.12\",\"standard_id\":\"ISA-706\",\"paragraph\":\"12\",\"topic\":\"Communicate the expected paragraph\",\"statement\":\"Where such a paragraph is expected, communicate the expectation and its wording to those charged with governance.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"An emphasis-of-matter or other-matter paragraph is expected.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.10\",\"standard_id\":\"ISA-700\",\"paragraph\":\"10\",\"topic\":\"Form an opinion\",\"statement\":\"Form an opinion on whether the financial statements are prepared, in all material respects, in accordance with the applicable framework.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.11\",\"standard_id\":\"ISA-700\",\"paragraph\":\"11\",\"topic\":\"Conclude on reasonable assurance\",\"statement\":\"Conclude whether reasonable assurance has been obtained that the financial statements as a whole are free from material misstatement, taking into account the conclusions on sufficiency of evidence, on the materiality of uncorrected misstatements, and the evaluations in paragraphs 12 to 15.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.12\",\"standard_id\":\"ISA-700\",\"paragraph\":\"12\",\"topic\":\"Evaluate preparation under the framework\",\"statement\":\"Evaluate whether the financial statements are prepared in all material respects under the framework, including the qualitative aspects of accounting practices and indicators of bias in management's judgments.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.13\",\"standard_id\":\"ISA-700\",\"paragraph\":\"13\",\"topic\":\"Specific evaluations\",\"statement\":\"Evaluate whether the significant accounting policies are appropriately disclosed and understandable, whether the policies are consistent with the framework and appropriate, whether estimates and disclosures are reasonable, whether the information is relevant, reliable, comparable and understandable and not obscured by irrelevant material, whether disclosures are adequate to understand material transactions and events, and whether terminology including statement titles is appropriate.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.14\",\"standard_id\":\"ISA-700\",\"paragraph\":\"14\",\"topic\":\"Fair presentation\",\"statement\":\"Under a fair presentation framework, also evaluate whether the overall presentation, structure and content achieve fair presentation and whether the statements represent the underlying transactions and events in a manner that achieves it.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The framework is a fair presentation framework.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.15\",\"standard_id\":\"ISA-700\",\"paragraph\":\"15\",\"topic\":\"Reference to the framework\",\"statement\":\"Evaluate whether the financial statements adequately refer to or describe the applicable framework.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.16\",\"standard_id\":\"ISA-700\",\"paragraph\":\"16\",\"topic\":\"Unmodified opinion\",\"statement\":\"Express an unmodified opinion when the financial statements are concluded to be prepared in all material respects under the framework.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.17\",\"standard_id\":\"ISA-700\",\"paragraph\":\"17\",\"topic\":\"Modify the opinion\",\"statement\":\"Modify the opinion under ISA 705 where the statements as a whole are not free from material misstatement or sufficient evidence cannot be obtained.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The statements are materially misstated or sufficient evidence cannot be obtained.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.18\",\"standard_id\":\"ISA-700\",\"paragraph\":\"18\",\"topic\":\"Fair presentation not achieved\",\"statement\":\"Where statements under a fair presentation framework do not achieve fair presentation, discuss with management and determine whether a modification is necessary.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Statements under a fair presentation framework do not achieve fair presentation.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.19\",\"standard_id\":\"ISA-700\",\"paragraph\":\"19\",\"topic\":\"Misleading compliance-framework statements\",\"statement\":\"Under a compliance framework, fair presentation need not be evaluated, but where in extremely rare cases the statements are misleading, discuss with management and determine whether and how to communicate it in the report.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Statements under a compliance framework are misleading.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.20\",\"standard_id\":\"ISA-700\",\"paragraph\":\"20\",\"topic\":\"Report in writing\",\"statement\":\"The auditor's report is in writing.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.21\",\"standard_id\":\"ISA-700\",\"paragraph\":\"21\",\"topic\":\"Title\",\"statement\":\"Give the report a title clearly indicating that it is the report of an independent auditor.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.22\",\"standard_id\":\"ISA-700\",\"paragraph\":\"22\",\"topic\":\"Addressee\",\"statement\":\"Address the report as appropriate to the circumstances of the engagement.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.23\",\"standard_id\":\"ISA-700\",\"paragraph\":\"23\",\"topic\":\"Opinion section first\",\"statement\":\"Place the opinion in the first section of the report under the heading Opinion.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.24\",\"standard_id\":\"ISA-700\",\"paragraph\":\"24\",\"topic\":\"Content of the opinion section\",\"statement\":\"In the opinion section identify the entity, state that the statements have been audited, identify the title of each statement, refer to the notes including significant accounting policies, and specify the date or period of each statement.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.25\",\"standard_id\":\"ISA-700\",\"paragraph\":\"25\",\"topic\":\"Fair presentation opinion wording\",\"statement\":\"For an unmodified opinion under a fair presentation framework, state that the statements present fairly in all material respects, or give a true and fair view, in accordance with the framework, unless law requires otherwise.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"An unmodified opinion is expressed under a fair presentation framework.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.26\",\"standard_id\":\"ISA-700\",\"paragraph\":\"26\",\"topic\":\"Compliance framework opinion wording\",\"statement\":\"For an unmodified opinion under a compliance framework, state that the statements are prepared in all material respects in accordance with the framework.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"An unmodified opinion is expressed under a compliance framework.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.27\",\"standard_id\":\"ISA-700\",\"paragraph\":\"27\",\"topic\":\"Jurisdiction of the framework\",\"statement\":\"Where the framework is not IFRS or IPSAS, identify its jurisdiction of origin in the opinion.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The framework is not IFRS or IPSAS.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.28\",\"standard_id\":\"ISA-700\",\"paragraph\":\"28\",\"topic\":\"Basis for opinion\",\"statement\":\"Include a basis-for-opinion section directly after the opinion stating that the audit was conducted under the ISAs, referring to the auditor's responsibilities section, stating independence and fulfilment of other ethical responsibilities with the jurisdiction or the IESBA Code identified, and stating whether the evidence obtained is sufficient and appropriate.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.29\",\"standard_id\":\"ISA-700\",\"paragraph\":\"29\",\"topic\":\"Going concern reporting\",\"statement\":\"Where applicable, report on going concern under ISA 570.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Going concern reporting under ISA 570 applies.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.30\",\"standard_id\":\"ISA-700\",\"paragraph\":\"30\",\"topic\":\"Key audit matters for listed entities\",\"statement\":\"For audits of complete general purpose financial statements of listed entities, communicate key audit matters under ISA 701.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The audit is of a complete set of general purpose statements of a listed entity.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.31\",\"standard_id\":\"ISA-700\",\"paragraph\":\"31\",\"topic\":\"Key audit matters when otherwise required\",\"statement\":\"Where key audit matters are otherwise required or chosen, communicate them under ISA 701.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Law requires or the auditor decides to communicate key audit matters.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.32\",\"standard_id\":\"ISA-700\",\"paragraph\":\"32\",\"topic\":\"Other information reporting\",\"statement\":\"Where applicable, report on other information under ISA 720.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Other information reporting under ISA 720 applies.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.33\",\"standard_id\":\"ISA-700\",\"paragraph\":\"33\",\"topic\":\"Management responsibilities section\",\"statement\":\"Include a section headed as management's responsibilities for the financial statements, using the term appropriate to the jurisdiction.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.34\",\"standard_id\":\"ISA-700\",\"paragraph\":\"34\",\"topic\":\"Content of management responsibilities\",\"statement\":\"Describe management's responsibility for preparing the statements under the framework and for the internal control it deems necessary, and for assessing going concern and the appropriateness of the going concern basis and related disclosures, including when that basis is appropriate.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.35\",\"standard_id\":\"ISA-700\",\"paragraph\":\"35\",\"topic\":\"Identify those overseeing financial reporting\",\"statement\":\"Where oversight of financial reporting rests with persons other than those responsible for preparation, identify them and extend the heading to refer to those charged with governance.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Those overseeing financial reporting differ from those preparing it.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.36\",\"standard_id\":\"ISA-700\",\"paragraph\":\"36\",\"topic\":\"Fair presentation wording in responsibilities\",\"statement\":\"Under a fair presentation framework, refer to the preparation and fair presentation of the statements, or to statements that give a true and fair view.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The framework is a fair presentation framework.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.37\",\"standard_id\":\"ISA-700\",\"paragraph\":\"37\",\"topic\":\"Auditor responsibilities section\",\"statement\":\"Include a section headed as the auditor's responsibilities for the audit of the financial statements.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.38\",\"standard_id\":\"ISA-700\",\"paragraph\":\"38\",\"topic\":\"Objectives and materiality statements\",\"statement\":\"State that the objectives are to obtain reasonable assurance about whether the statements as a whole are free from material misstatement and to issue a report with the opinion; that reasonable assurance is high but not a guarantee; and that misstatements arise from fraud or error and are material if they could reasonably influence users' decisions, or give the framework's definition.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.39\",\"standard_id\":\"ISA-700\",\"paragraph\":\"39\",\"topic\":\"Description of the audit\",\"statement\":\"State that the auditor exercises professional judgment and scepticism, and describe the responsibilities to identify and assess risks and respond to them, to understand internal control without opining on it, to evaluate policies and estimates, to conclude on going concern and any material uncertainty, and under a fair presentation framework to evaluate overall presentation; in a group audit, describe the responsibility for group evidence, direction, supervision and review, and sole responsibility for the opinion.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.40\",\"standard_id\":\"ISA-700\",\"paragraph\":\"40\",\"topic\":\"Communication statements\",\"statement\":\"State that the auditor communicates with those charged with governance about scope, timing and significant findings including significant deficiencies; for listed entities that the auditor provides an independence statement and communicates relationships and actions taken; and where key audit matters are communicated, how they are determined and when they may be omitted.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.41\",\"standard_id\":\"ISA-700\",\"paragraph\":\"41\",\"topic\":\"Location of the responsibilities description\",\"statement\":\"Place the description of the auditor's responsibilities in the body of the report, in an appendix referenced from the report, or by reference to a website of an appropriate authority where law or national standards expressly permit.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.42\",\"standard_id\":\"ISA-700\",\"paragraph\":\"42\",\"topic\":\"Website description\",\"statement\":\"Where the description is on an authority's website, determine that it addresses and is not inconsistent with the required content.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The description is placed on an authority's website.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.43\",\"standard_id\":\"ISA-700\",\"paragraph\":\"43\",\"topic\":\"Other reporting responsibilities\",\"statement\":\"Address other reporting responsibilities in a separate section headed as a report on other legal and regulatory requirements, unless they cover the same topics as ISA reporting, in which case they may be presented with the related elements.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The report addresses other reporting responsibilities.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.44\",\"standard_id\":\"ISA-700\",\"paragraph\":\"44\",\"topic\":\"Differentiate other responsibilities\",\"statement\":\"Where other reporting responsibilities are presented with the ISA elements, clearly differentiate them.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Other reporting responsibilities are presented with ISA elements.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.45\",\"standard_id\":\"ISA-700\",\"paragraph\":\"45\",\"topic\":\"Structure with a separate section\",\"statement\":\"Where a separate section on other reporting responsibilities exists, place the ISA-required elements under a heading for the report on the audit of the financial statements, followed by the other section.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The report contains a separate other-responsibilities section.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.46\",\"standard_id\":\"ISA-700\",\"paragraph\":\"46\",\"topic\":\"Name of the engagement partner\",\"statement\":\"Include the engagement partner's name in reports on listed entities unless disclosure is reasonably expected to create a significant personal security threat, in which case discuss the intention with those charged with governance.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The entity is listed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.47\",\"standard_id\":\"ISA-700\",\"paragraph\":\"47\",\"topic\":\"Signature\",\"statement\":\"Sign the report.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.48\",\"standard_id\":\"ISA-700\",\"paragraph\":\"48\",\"topic\":\"Auditor's address\",\"statement\":\"Name the location in the jurisdiction where the auditor practises.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.49\",\"standard_id\":\"ISA-700\",\"paragraph\":\"49\",\"topic\":\"Date of the report\",\"statement\":\"Date the report no earlier than the date sufficient appropriate evidence was obtained, including evidence that all statements and disclosures have been prepared and that those with recognised authority have taken responsibility for them.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.50\",\"standard_id\":\"ISA-700\",\"paragraph\":\"50\",\"topic\":\"Report prescribed by law\",\"statement\":\"Where law prescribes the report's layout or wording, refer to the ISAs only if the report includes at minimum the title, addressee, opinion with framework reference, identification of the statements, independence statement, going concern sections where applicable, key audit matters where applicable, other information section where applicable, management responsibilities, a reference to the ISAs and law with the auditor's responsibilities, the engagement partner's name for listed entities, signature, address and date.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Law prescribes the layout or wording of the report.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.51\",\"standard_id\":\"ISA-700\",\"paragraph\":\"51\",\"topic\":\"National standards and ISAs\",\"statement\":\"Refer to the ISAs alongside national standards only where no conflict would lead to a different opinion or omission of a required paragraph, and the report includes the minimum elements, identifying the national standards.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The audit is conducted under national standards and the ISAs.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.52\",\"standard_id\":\"ISA-700\",\"paragraph\":\"52\",\"topic\":\"Jurisdiction of national standards\",\"statement\":\"Where the report refers to both, identify the jurisdiction of origin of the national standards.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The report refers to both national standards and the ISAs.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.53\",\"standard_id\":\"ISA-700\",\"paragraph\":\"53\",\"topic\":\"Supplementary information integral to the statements\",\"statement\":\"Evaluate whether supplementary information not required by the framework is nevertheless an integral part of the statements; if so, cover it by the opinion.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Supplementary information not required by the framework is presented.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700.54\",\"standard_id\":\"ISA-700\",\"paragraph\":\"54\",\"topic\":\"Supplementary information not integral\",\"statement\":\"Where supplementary information is not integral, evaluate whether it is clearly differentiated from the audited statements; if not, ask management to change its presentation and, if refused, identify it and explain in the report that it is unaudited.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Supplementary information is not an integral part of the statements.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-710.7\",\"standard_id\":\"ISA-710\",\"paragraph\":\"7\",\"topic\":\"Comparative information included and classified\",\"statement\":\"Determine whether the statements include the comparative information the framework requires and whether it is appropriately classified, evaluating that it agrees with the prior period or has been restated, and that accounting policies are consistent or changes properly accounted for and disclosed.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-710.8\",\"standard_id\":\"ISA-710\",\"paragraph\":\"8\",\"topic\":\"Possible misstatement in comparatives\",\"statement\":\"Where a possible material misstatement in comparative information becomes apparent, perform additional procedures to determine whether it exists, follow ISA 560 where the prior period was audited by the same auditor, and ensure comparatives agree with amended statements.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"A possible material misstatement in the comparative information becomes apparent.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-710.9\",\"standard_id\":\"ISA-710\",\"paragraph\":\"9\",\"topic\":\"Representations on all periods\",\"statement\":\"Request written representations for all periods referred to in the opinion and a specific representation on any restatement correcting a prior-period material misstatement.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-710.10\",\"standard_id\":\"ISA-710\",\"paragraph\":\"10\",\"topic\":\"No reference to corresponding figures\",\"statement\":\"Where corresponding figures are presented, do not refer to them in the opinion except as paragraphs 11, 12 and 14 provide.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Corresponding figures are presented.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-710.11\",\"standard_id\":\"ISA-710\",\"paragraph\":\"11\",\"topic\":\"Unresolved prior modification\",\"statement\":\"Where the prior report was modified and the matter is unresolved, modify the current opinion and either refer to both periods' figures where the effects on the current period are material, or explain that the modification arises from comparability.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The prior-period report was modified and the matter is unresolved.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-710.12\",\"standard_id\":\"ISA-710\",\"paragraph\":\"12\",\"topic\":\"Prior-period misstatement not restated\",\"statement\":\"Where a material prior-period misstatement under an unmodified opinion has not been properly restated or disclosed, express a qualified or adverse opinion modified in respect of the corresponding figures.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"A material misstatement exists in a prior period given an unmodified opinion and is not restated.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-710.13\",\"standard_id\":\"ISA-710\",\"paragraph\":\"13\",\"topic\":\"Predecessor auditor with corresponding figures\",\"statement\":\"Where reference to a predecessor is permitted and chosen, state in an other-matter paragraph that the prior period was audited by a predecessor, the type of opinion and reasons for any modification, and the date of that report.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The prior period was audited by a predecessor and reference is permitted and chosen.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-710.14\",\"standard_id\":\"ISA-710\",\"paragraph\":\"14\",\"topic\":\"Unaudited corresponding figures\",\"statement\":\"Where prior-period statements were unaudited, state in an other-matter paragraph that corresponding figures are unaudited, without relieving the auditor of evidence on opening balances.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The prior period was not audited.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-710.15\",\"standard_id\":\"ISA-710\",\"paragraph\":\"15\",\"topic\":\"Comparative financial statements\",\"statement\":\"Where comparative financial statements are presented, refer in the opinion to each period presented and opined on.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Comparative financial statements are presented.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-710.16\",\"standard_id\":\"ISA-710\",\"paragraph\":\"16\",\"topic\":\"Different opinion on the prior period\",\"statement\":\"Where the opinion on prior-period statements differs from the one previously expressed, disclose the substantive reasons in an other-matter paragraph.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The opinion on the prior period differs from that previously expressed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-710.17\",\"standard_id\":\"ISA-710\",\"paragraph\":\"17\",\"topic\":\"Predecessor auditor with comparative statements\",\"statement\":\"Where the prior period was audited by a predecessor, state in an other-matter paragraph that fact, the type of opinion and reasons for any modification, and the date of that report, unless the predecessor's report is reissued.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The prior period was audited by a predecessor.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-710.18\",\"standard_id\":\"ISA-710\",\"paragraph\":\"18\",\"topic\":\"Misstatement in predecessor-audited statements\",\"statement\":\"Where a material misstatement affects prior-period statements the predecessor reported on without modification, communicate it to management and governance and request that the predecessor be informed; if amended and the predecessor reissues, report only on the current period.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"A material misstatement affects prior-period statements the predecessor reported on without modification.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-710.19\",\"standard_id\":\"ISA-710\",\"paragraph\":\"19\",\"topic\":\"Unaudited comparative statements\",\"statement\":\"Where prior-period statements were unaudited, state in an other-matter paragraph that the comparative statements are unaudited, without relieving the auditor of evidence on opening balances.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The prior period was not audited.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-720.13\",\"standard_id\":\"ISA-720\",\"paragraph\":\"13\",\"topic\":\"Obtain the other information\",\"statement\":\"Determine with management which documents comprise the annual report and its timing, arrange to obtain the final version timely and where possible before the report date, and where documents will only be available later, request a written representation that they will be provided before issuance.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-720.14\",\"standard_id\":\"ISA-720\",\"paragraph\":\"14\",\"topic\":\"Read and consider\",\"statement\":\"Read the other information, comparing selected amounts and items with the financial statements to consider whether a material inconsistency exists, and consider whether it is materially inconsistent with the knowledge obtained in the audit.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-720.15\",\"standard_id\":\"ISA-720\",\"paragraph\":\"15\",\"topic\":\"Alertness for other misstatements\",\"statement\":\"While reading, remain alert for indications that other information unrelated to the financial statements or audit knowledge appears materially misstated.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-720.16\",\"standard_id\":\"ISA-720\",\"paragraph\":\"16\",\"topic\":\"Apparent inconsistency\",\"statement\":\"Where an apparent material inconsistency or misstatement is identified, discuss it with management and perform other procedures as needed to conclude whether the other information or the financial statements are materially misstated, or whether the understanding of the entity needs updating.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"A material inconsistency appears to exist or other information appears materially misstated.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-720.17\",\"standard_id\":\"ISA-720\",\"paragraph\":\"17\",\"topic\":\"Request correction\",\"statement\":\"Where the other information is materially misstated, request management to correct it; confirm any correction, or where refused communicate to those charged with governance and request correction.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"A material misstatement of the other information is concluded to exist.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-720.18\",\"standard_id\":\"ISA-720\",\"paragraph\":\"18\",\"topic\":\"Uncorrected before the report date\",\"statement\":\"Where other information obtained before the report date remains uncorrected after communicating with governance, take appropriate action: consider and communicate the implications for the report, or withdraw where possible.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Other information obtained before the report date remains uncorrected.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-720.19\",\"standard_id\":\"ISA-720\",\"paragraph\":\"19\",\"topic\":\"Uncorrected after the report date\",\"statement\":\"Where other information obtained after the report date is materially misstated, perform the necessary procedures if corrected, or otherwise take appropriate action within legal rights and obligations to bring the misstatement to users' attention.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Other information obtained after the report date is materially misstated.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-720.20\",\"standard_id\":\"ISA-720\",\"paragraph\":\"20\",\"topic\":\"Financial statements misstated or understanding outdated\",\"statement\":\"Where reading the other information reveals a material misstatement in the financial statements or a need to update the understanding of the entity, respond under the other ISAs.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The financial statements are misstated or the understanding needs updating.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-720.21\",\"standard_id\":\"ISA-720\",\"paragraph\":\"21\",\"topic\":\"Other information section\",\"statement\":\"Include a section headed other information where, at the report date, other information has been obtained or, for listed entities, is expected to be obtained.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Other information has been or is expected to be obtained.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-720.22\",\"standard_id\":\"ISA-720\",\"paragraph\":\"22\",\"topic\":\"Content of the section\",\"statement\":\"In the section state that management is responsible for the other information, identify the information obtained before the report date and for listed entities that expected later, state that the opinion does not cover it and no assurance is expressed, describe the auditor's responsibilities, and state either that there is nothing to report or describe an uncorrected material misstatement.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"An other information section is required.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-720.23\",\"standard_id\":\"ISA-720\",\"paragraph\":\"23\",\"topic\":\"Modified opinion implications\",\"statement\":\"Where the opinion is qualified or adverse, consider the implications of the underlying matter for the statement on the other information.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"A qualified or adverse opinion is expressed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-720.24\",\"standard_id\":\"ISA-720\",\"paragraph\":\"24\",\"topic\":\"Reporting prescribed by law\",\"statement\":\"Where law prescribes the layout or wording, refer to the ISAs only if the report identifies the other information obtained before the report date, describes the auditor's responsibilities, and states the outcome of the work.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Law prescribes the layout or wording of other-information reporting.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-720.25\",\"standard_id\":\"ISA-720\",\"paragraph\":\"25\",\"topic\":\"Documentation of other information\",\"statement\":\"Document the procedures performed and the final version of the other information on which the work was performed.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.11\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"11\",\"topic\":\"Risk assessment for going concern\",\"statement\":\"Design and perform risk assessment procedures that provide a basis for determining whether events or conditions exist that may cast significant doubt on going concern, identifying them before considering mitigating factors in management's plans.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.12\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"12\",\"topic\":\"Understand the entity for going concern\",\"statement\":\"Obtain an understanding of the business model, objectives, strategies and business risks relevant to going concern; industry conditions affecting financing; performance measures including forecasts, cash flows and budgeting; the framework's going concern requirements and disclosures; the basis for management's intended use of the going concern basis; governance oversight of management's assessment; the entity's risk assessment process for going concern; how management selects the method, assumptions and data for its assessment; and how the reporting process addresses going concern disclosures.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.13\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"13\",\"topic\":\"Alertness throughout the audit\",\"statement\":\"Remain alert throughout the audit for information about events or conditions that may cast significant doubt on going concern.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.14\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"14\",\"topic\":\"Events not identified by management\",\"statement\":\"Determine whether the evidence from risk assessment procedures indicates events or conditions that management has not identified or disclosed to the auditor.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.15\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"15\",\"topic\":\"Control deficiencies over going concern\",\"statement\":\"Based on the evaluation of the components of internal control, determine whether control deficiencies exist in respect of management's going concern assessment.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.16\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"16\",\"topic\":\"Request an assessment\",\"statement\":\"Where management has not assessed going concern, request that it do so; if management is unwilling, consider the implications for the audit.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Management has not performed an assessment.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.17\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"17\",\"topic\":\"Evaluate management's assessment\",\"statement\":\"Design and perform procedures to evaluate management's assessment of going concern, including the significant judgments on which it is based.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.18\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"18\",\"topic\":\"Unbiased procedures\",\"statement\":\"Perform the evaluation without bias towards corroborative evidence or away from contradictory evidence.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.19\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"19\",\"topic\":\"Method, assumptions and data\",\"statement\":\"Evaluate the method used by management, including its appropriateness under the framework and any changes, and the mathematical accuracy of calculations; the significant assumptions, including their appropriateness, changes and internal consistency; and the data, including its relevance, reliability and appropriateness; scaled to the results of risk assessment.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.20\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"20\",\"topic\":\"Beyond the assessment period\",\"statement\":\"Inquire about events or conditions beyond management's assessment period; where any are identified, request management to evaluate their potential significance.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.21\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"21\",\"topic\":\"Twelve months from approval\",\"statement\":\"Where management's assessment covers less than twelve months from the date of approval of the financial statements, request that it be extended to at least twelve months from that date.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Management's assessment covers less than twelve months from the date of approval.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.22\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"22\",\"topic\":\"Unwilling to extend\",\"statement\":\"Where management is unwilling to extend its assessment, discuss the matter with management and where appropriate those charged with governance.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Management is unwilling to extend its assessment.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.23\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"23\",\"topic\":\"Still unwilling\",\"statement\":\"Where extension is judged necessary and management remains unwilling, determine the implications for the audit.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Extension is judged necessary and management remains unwilling.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.24\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"24\",\"topic\":\"All relevant information\",\"statement\":\"Consider whether management's assessment includes all relevant information of which the auditor is aware.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.25\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"25\",\"topic\":\"Events identified by the auditor\",\"statement\":\"Where the auditor identifies events or conditions management did not identify, discuss their effect with management and request an evaluation of their significance, determine whether management must revise its assessment, and where applicable perform additional procedures on the revised assessment.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The auditor identifies events or conditions management did not identify or disclose.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.26\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"26\",\"topic\":\"Evaluate management's plans\",\"statement\":\"Where events or conditions are identified, evaluate whether management's plans are likely to mitigate their effects sufficiently, are feasible, and whether management has the intent and ability to carry them out.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Events or conditions have been identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.27\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"27\",\"topic\":\"Assumptions and data in plans\",\"statement\":\"Where management's plans use significant assumptions or data, evaluate them as for the assessment itself.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Management's plans rely on significant assumptions or data.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.28\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"28\",\"topic\":\"Third-party or related-party support\",\"statement\":\"Where plans depend on support from third parties or related parties including an owner-manager, obtain evidence of those parties' intent and ability to provide or maintain it.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Plans depend on financial support from third parties or related parties including an owner-manager.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.29\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"29\",\"topic\":\"Information after the report date\",\"statement\":\"Where going concern information becomes known after the report date but before issue, perform procedures under ISA 560.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Going concern information becomes known after the report date but before issue.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.30\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"30\",\"topic\":\"Evaluate and conclude on the basis\",\"statement\":\"Evaluate whether sufficient appropriate evidence has been obtained and conclude on the appropriateness of the going concern basis, evaluating whether management's judgments indicate possible bias and considering all evidence whether consistent or inconsistent.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.31\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"31\",\"topic\":\"Conclude on material uncertainty\",\"statement\":\"Conclude whether a material uncertainty exists related to events or conditions that may cast significant doubt on going concern.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.32\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"32\",\"topic\":\"Disclosures when no material uncertainty\",\"statement\":\"Where events or conditions exist but no material uncertainty is concluded, evaluate whether the financial statements adequately disclose them, including significant judgments made in concluding that no material uncertainty exists.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Events or conditions were identified but no material uncertainty exists.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.33\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"33\",\"topic\":\"Disclosures when a material uncertainty exists\",\"statement\":\"Where a material uncertainty exists, determine whether the statements adequately disclose the principal events or conditions and management's plans, and clearly state that a material uncertainty exists and the entity may be unable to realise its assets and discharge its liabilities in the normal course.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"A material uncertainty exists and the going concern basis is appropriate.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.34\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"34\",\"topic\":\"Going concern section when no material uncertainty\",\"statement\":\"Where the basis is appropriate and no material uncertainty exists, include a going concern section stating that the basis is appropriate, that no material uncertainty was identified, and that conclusions are not a guarantee; for listed entities where management made significant judgments, refer to the related disclosures and describe how the assessment was evaluated.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The going concern basis is appropriate and no material uncertainty exists.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.35\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"35\",\"topic\":\"Material uncertainty adequately disclosed\",\"statement\":\"Where a material uncertainty is adequately disclosed, express an unmodified opinion with a material uncertainty section that refers to the disclosures, for listed entities describes how the assessment was evaluated, states that a material uncertainty exists, and states that the opinion is not modified, the basis is appropriate, and conclusions are not a guarantee.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"A material uncertainty exists and is adequately disclosed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.36\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"36\",\"topic\":\"Material uncertainty not adequately disclosed\",\"statement\":\"Where a material uncertainty is not adequately disclosed, express a qualified or adverse opinion, state in the basis section that a material uncertainty exists and is not adequately disclosed, and include a material uncertainty section that refers to the basis section and states that the basis is appropriate and conclusions are not a guarantee.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"A material uncertainty exists and is not adequately disclosed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.37\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"37\",\"topic\":\"No going concern sections on disclaimer\",\"statement\":\"When disclaiming an opinion, omit the going concern and material uncertainty sections unless law requires them.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"An opinion is disclaimed.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.38\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"38\",\"topic\":\"Inappropriate going concern basis\",\"statement\":\"Where the going concern basis is inappropriate, express an adverse opinion and omit the going concern and material uncertainty sections unless law requires them.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Use of the going concern basis is inappropriate.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.39\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"39\",\"topic\":\"Written representations on going concern\",\"statement\":\"Request written representations that the going concern basis is appropriate, that the method, assumptions and data used are appropriate under the framework, that management's assessment reflects and has disclosed all events or conditions it is aware of, and that going concern matters including significant judgments are adequately disclosed.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.40\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"40\",\"topic\":\"Representations on plans\",\"statement\":\"Where events or conditions are identified, the representations also address management's plans and whether they mitigate the effects, their feasibility, and management's intent and ability to carry them out.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Events or conditions have been identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.41\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"41\",\"topic\":\"Timely communication of events\",\"statement\":\"Unless all those charged with governance manage the entity, communicate identified events or conditions to them on a timely basis.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Not all of those charged with governance manage the entity.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.42\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"42\",\"topic\":\"Content of communication\",\"statement\":\"Communicate whether the events or conditions constitute a material uncertainty, whether the going concern basis is appropriate, an overview of procedures and the basis for conclusions including the evaluation of management's plans, the adequacy of disclosures including significant judgments and mitigating factors, any unwillingness by management to make or extend its assessment, and the implications for the audit or report.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Events or conditions have been identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.43\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"43\",\"topic\":\"Reporting outside the entity\",\"statement\":\"When considering a material uncertainty section or a modified opinion on going concern, determine whether law, regulation or ethical requirements require or permit reporting to an appropriate outside authority.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"A material uncertainty section or going concern modification is being considered.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R.44\",\"standard_id\":\"ISA-570R\",\"paragraph\":\"44\",\"topic\":\"Documentation of going concern judgments\",\"statement\":\"Document the significant professional judgments on the appropriateness of the going concern basis, on whether a material uncertainty exists, and on the adequacy of going concern disclosures.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-800.8\",\"standard_id\":\"ISA-800\",\"paragraph\":\"8\",\"topic\":\"Understand the special purpose\",\"statement\":\"In an audit of special purpose financial statements, understand the purpose for which they are prepared, the intended users, and the steps management took to determine that the framework is acceptable.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-800.9\",\"standard_id\":\"ISA-800\",\"paragraph\":\"9\",\"topic\":\"Special consideration in applying the ISAs\",\"statement\":\"In planning and performing the audit, determine whether applying the ISAs requires special consideration in the circumstances.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-800.10\",\"standard_id\":\"ISA-800\",\"paragraph\":\"10\",\"topic\":\"Contractual interpretations\",\"statement\":\"Where the statements are prepared under a contract, understand any significant interpretations of the contract that management made.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"The statements are prepared under the provisions of a contract.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-800.11\",\"standard_id\":\"ISA-800\",\"paragraph\":\"11\",\"topic\":\"Apply ISA 700\",\"statement\":\"Apply the requirements of ISA 700 when forming an opinion and reporting on special purpose financial statements.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-800.12\",\"standard_id\":\"ISA-800\",\"paragraph\":\"12\",\"topic\":\"Describe contractual interpretations\",\"statement\":\"Where the statements are prepared under a contract, evaluate whether they adequately describe the significant interpretations on which they are based.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The statements are prepared under the provisions of a contract.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-800.13\",\"standard_id\":\"ISA-800\",\"paragraph\":\"13\",\"topic\":\"Purpose and framework choice in the report\",\"statement\":\"Describe in the report the purpose of the statements and where necessary the intended users, or refer to a note that does; where management could choose the framework, refer to its responsibility for determining that the framework is acceptable.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-800.14\",\"standard_id\":\"ISA-800\",\"paragraph\":\"14\",\"topic\":\"Emphasis of matter alerting readers\",\"statement\":\"Include an emphasis-of-matter paragraph alerting readers that the statements are prepared under a special purpose framework and may not be suitable for another purpose.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-805.7\",\"standard_id\":\"ISA-805\",\"paragraph\":\"7\",\"topic\":\"Practicability\",\"statement\":\"Where not also engaged on the complete set, determine whether an ISA audit of the single statement or element is practicable.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The auditor is not also engaged on the complete set of statements.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-805.8\",\"standard_id\":\"ISA-805\",\"paragraph\":\"8\",\"topic\":\"Framework acceptability for elements\",\"statement\":\"In determining the framework's acceptability, consider whether it will produce adequate disclosures for users to understand the statement or element and the effect of material transactions and events.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-805.9\",\"standard_id\":\"ISA-805\",\"paragraph\":\"9\",\"topic\":\"Form of opinion\",\"statement\":\"Consider whether the expected form of opinion is appropriate in the circumstances.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-805.10\",\"standard_id\":\"ISA-805\",\"paragraph\":\"10\",\"topic\":\"Adapt the ISAs\",\"statement\":\"Adapt all relevant ISAs as necessary in planning and performing the audit of a single statement or element.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-805.11\",\"standard_id\":\"ISA-805\",\"paragraph\":\"11\",\"topic\":\"Apply ISA 700 and 800\",\"statement\":\"Apply ISA 700 and where applicable ISA 800, adapted as necessary, when forming an opinion and reporting.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-805.12\",\"standard_id\":\"ISA-805\",\"paragraph\":\"12\",\"topic\":\"Separate opinions\",\"statement\":\"Where undertaken alongside an audit of the complete set, express a separate opinion for each engagement.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The engagement is undertaken with an audit of the complete set.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-805.13\",\"standard_id\":\"ISA-805\",\"paragraph\":\"13\",\"topic\":\"Differentiation from the complete set\",\"statement\":\"Where published with the complete set, ask management to rectify insufficient differentiation, differentiate the opinions, and do not issue the report until satisfied with the differentiation.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The single statement or element is published with the complete set.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-805.14\",\"standard_id\":\"ISA-805\",\"paragraph\":\"14\",\"topic\":\"Implications of matters in the complete-set report\",\"statement\":\"Consider the implications of a modified opinion, emphasis or other matter, material uncertainty, key audit matters or other-information statement in the complete-set report for the audit of the element and its report.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The complete-set report includes a modification, emphasis, going concern section, key audit matters or other information statement.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-805.15\",\"standard_id\":\"ISA-805\",\"paragraph\":\"15\",\"topic\":\"No unmodified opinion alongside adverse or disclaimer\",\"statement\":\"Where an adverse opinion or disclaimer is expressed on the complete set, do not include an unmodified opinion on a single statement or element in the same report.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"An adverse opinion or disclaimer is expressed on the complete set.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-805.16\",\"standard_id\":\"ISA-805\",\"paragraph\":\"16\",\"topic\":\"Unmodified opinion on an element in a separate report\",\"statement\":\"Express an unmodified opinion on an element despite an adverse opinion or disclaimer on the complete set only where law does not prohibit it, the opinion is in a report not published with the adverse report, and the element is not a major portion of the statements.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"An adverse opinion or disclaimer is expressed on the complete set and an unmodified opinion on an element is considered appropriate.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-805.17\",\"standard_id\":\"ISA-805\",\"paragraph\":\"17\",\"topic\":\"No unmodified opinion on a single statement\",\"statement\":\"Do not express an unmodified opinion on a single financial statement where an adverse opinion or disclaimer was expressed on the complete set, even in a separate report.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"An adverse opinion or disclaimer is expressed on the complete set.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.5\",\"standard_id\":\"ISA-810\",\"paragraph\":\"5\",\"topic\":\"Acceptance only as auditor of the full statements\",\"statement\":\"Accept an engagement to report on summary financial statements only when engaged to audit the statements from which they are derived.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.6\",\"standard_id\":\"ISA-810\",\"paragraph\":\"6\",\"topic\":\"Preconditions\",\"statement\":\"Before acceptance, determine that the applied criteria are acceptable, obtain management's acknowledgement of its responsibilities for preparing the summary statements, making the audited statements available and including the auditor's report, and agree the form of opinion.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.7\",\"standard_id\":\"ISA-810\",\"paragraph\":\"7\",\"topic\":\"Unacceptable criteria or no agreement\",\"statement\":\"Where the criteria are unacceptable or management's agreement is not obtained, do not accept unless law requires; a legally required engagement does not comply with the ISA and the report must not claim it does; reflect this in the terms and consider the effect on the audit.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The criteria are unacceptable or management's agreement is not obtained.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.8\",\"standard_id\":\"ISA-810\",\"paragraph\":\"8\",\"topic\":\"Procedures on summary statements\",\"statement\":\"Evaluate whether the summary statements disclose their summarised nature and identify the audited statements, describe where the audited statements are available or the law dispensing with that, disclose the criteria, agree with or can be recalculated from the audited statements, are prepared under the criteria, contain the necessary information at an appropriate level of aggregation, and that the audited statements are available to users.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.9\",\"standard_id\":\"ISA-810\",\"paragraph\":\"9\",\"topic\":\"Unmodified opinion wording\",\"statement\":\"Express an unmodified opinion as either consistent in all material respects with the audited statements, or a fair summary of them, in accordance with the applied criteria.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"An unmodified opinion is appropriate.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.10\",\"standard_id\":\"ISA-810\",\"paragraph\":\"10\",\"topic\":\"Opinion wording prescribed by law\",\"statement\":\"Where law prescribes different wording, perform the required procedures and any others needed, and evaluate whether users might misunderstand the opinion and whether explanation mitigates that.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"Law prescribes different opinion wording.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.11\",\"standard_id\":\"ISA-810\",\"paragraph\":\"11\",\"topic\":\"Explanation cannot mitigate misunderstanding\",\"statement\":\"Where explanation cannot mitigate misunderstanding, do not accept unless law requires, and do not claim compliance with the ISA.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Additional explanation cannot mitigate possible misunderstanding.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.12\",\"standard_id\":\"ISA-810\",\"paragraph\":\"12\",\"topic\":\"Later-dated report\",\"statement\":\"Where the summary report is dated later than the audit report, state that neither set of statements reflects events after the audit report date.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The summary report is dated after the audit report.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.13\",\"standard_id\":\"ISA-810\",\"paragraph\":\"13\",\"topic\":\"Facts existing at the audit report date\",\"statement\":\"Where previously unknown facts existing at the audit report date become known, do not issue the summary report until their consideration under ISA 560 is complete.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Facts existing at the audit report date become known.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.14\",\"standard_id\":\"ISA-810\",\"paragraph\":\"14\",\"topic\":\"Read accompanying information\",\"statement\":\"Read the other information in the document containing the summary statements and consider whether it is materially inconsistent with them.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.15\",\"standard_id\":\"ISA-810\",\"paragraph\":\"15\",\"topic\":\"Material inconsistency\",\"statement\":\"Where a material inconsistency exists, discuss it with management, determine whether the summary statements or the other information needs revision, and take appropriate action including considering the report if management refuses to revise.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"A material inconsistency is identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.16\",\"standard_id\":\"ISA-810\",\"paragraph\":\"16\",\"topic\":\"Elements of the summary report\",\"statement\":\"Include a title, addressee, identification of the summary statements and of the audited statements, an opinion, a statement that the summary statements omit disclosures and are not a substitute for the audited statements, any later-dating statement, a reference to the audit report and its date and opinion, management's responsibility, the auditor's responsibility, signature, address and date.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.17\",\"standard_id\":\"ISA-810\",\"paragraph\":\"17\",\"topic\":\"Different addressee\",\"statement\":\"Where the addressee differs from the audit report's, evaluate the appropriateness of the different addressee.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The addressee differs from that of the audit report.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.18\",\"standard_id\":\"ISA-810\",\"paragraph\":\"18\",\"topic\":\"Dating the summary report\",\"statement\":\"Date the summary report no earlier than the date sufficient evidence was obtained including management's assertion of responsibility, and no earlier than the audit report date.\",\"kind\":\"reporting\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.19\",\"standard_id\":\"ISA-810\",\"paragraph\":\"19\",\"topic\":\"Reference to matters in the audit report\",\"statement\":\"Where the audit report includes a qualified opinion, emphasis or other matter, material uncertainty, key audit matters or an other-information statement and the summary is consistent, state that fact and describe the basis and any effect on the summary statements.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The audit report includes a qualified opinion, emphasis or other matter, going concern section, key audit matters or other-information statement.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.20\",\"standard_id\":\"ISA-810\",\"paragraph\":\"20\",\"topic\":\"Adverse or disclaimer on the audited statements\",\"statement\":\"Where the audit report contains an adverse opinion or disclaimer, state that fact, describe its basis, and state that it is therefore inappropriate to express an opinion on the summary statements.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The audit report contains an adverse opinion or disclaimer.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.21\",\"standard_id\":\"ISA-810\",\"paragraph\":\"21\",\"topic\":\"Adverse opinion on the summary\",\"statement\":\"Where the summary statements are not consistent with or a fair summary of the audited statements and management will not change them, express an adverse opinion on the summary statements.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The summary statements are inconsistent and management refuses to change them.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.22\",\"standard_id\":\"ISA-810\",\"paragraph\":\"22\",\"topic\":\"Restriction or alert carried forward\",\"statement\":\"Where the audit report restricts distribution or alerts readers to a special purpose framework, include a similar restriction or alert in the summary report.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The audit report restricts distribution or alerts to a special purpose framework.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.23\",\"standard_id\":\"ISA-810\",\"paragraph\":\"23\",\"topic\":\"Omitted comparatives\",\"statement\":\"Where comparatives in the audited statements are omitted from the summary, determine whether the omission is reasonable and the effect of an unreasonable omission on the report.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The audited statements contain comparatives that the summary omits.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.24\",\"standard_id\":\"ISA-810\",\"paragraph\":\"24\",\"topic\":\"Comparatives reported on by another auditor\",\"statement\":\"Where the summary contains comparatives reported on by another auditor, include the matters ISA 710 requires.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The summary contains comparatives reported on by another auditor.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.25\",\"standard_id\":\"ISA-810\",\"paragraph\":\"25\",\"topic\":\"Unaudited supplementary information\",\"statement\":\"Evaluate whether unaudited supplementary information is clearly differentiated; ask management to change its presentation if not and, if refused, explain in the report that it is not covered.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Unaudited supplementary information accompanies the summary.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.26\",\"standard_id\":\"ISA-810\",\"paragraph\":\"26\",\"topic\":\"Report omitted from the document\",\"statement\":\"Where the entity plans to state that the auditor reported on the summary without including the report, request its inclusion and, if refused, take action to prevent inappropriate association.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The entity plans to state that the auditor reported on the summary without including the report.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810.27\",\"standard_id\":\"ISA-810\",\"paragraph\":\"27\",\"topic\":\"Reference to the auditor without engagement\",\"statement\":\"Where not engaged on the summary but the entity refers to the auditor, be satisfied that the reference is in the context of the audit report and does not imply the auditor reported on the summary; otherwise request a change or deletion, and if refused, advise disagreement and take action to prevent inappropriate reference.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"The auditor is not engaged on the summary and the entity refers to the auditor.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.17\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"17\",\"topic\":\"Comply with each requirement\",\"statement\":\"Comply with each requirement of the standard unless it is not relevant to the firm because of the nature and circumstances of the firm or its engagements.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.18\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"18\",\"topic\":\"Understanding by responsible individuals\",\"statement\":\"The individuals with ultimate and operational responsibility for the system understand the standard including its application material.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.19\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"19\",\"topic\":\"Design, implement and operate a system\",\"statement\":\"Design, implement and operate a system of quality management, exercising professional judgment according to the firm's nature and circumstances.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.20\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"20\",\"topic\":\"Assign responsibilities\",\"statement\":\"Assign ultimate responsibility and accountability to the chief executive, managing partner or managing board; operational responsibility for the system; and operational responsibility for independence compliance and for monitoring and remediation.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.21\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"21\",\"topic\":\"Suitability of responsible individuals\",\"statement\":\"Determine that those assigned have the experience, knowledge, influence, authority and time to fulfil their roles and understand that they are accountable.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.22\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"22\",\"topic\":\"Direct line of communication\",\"statement\":\"Determine that those with operational responsibilities have a direct line of communication to those with ultimate responsibility.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.23\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"23\",\"topic\":\"Risk assessment process\",\"statement\":\"Design and implement a risk assessment process to establish quality objectives, identify and assess quality risks, and design and implement responses.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.24\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"24\",\"topic\":\"Quality objectives\",\"statement\":\"Establish the quality objectives the standard specifies and any additional objectives the firm considers necessary.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.25\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"25\",\"topic\":\"Identify and assess quality risks\",\"statement\":\"Identify and assess quality risks by understanding the conditions, events and circumstances relating to the firm's complexity, decisions, leadership, resources, legal environment, network membership, engagement types and clients, and how they may adversely affect the objectives.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.26\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"26\",\"topic\":\"Responses to quality risks\",\"statement\":\"Design and implement responses based on and responsive to the assessed quality risks, including the specified responses in paragraph 34.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.27\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"27\",\"topic\":\"Identify the need for change\",\"statement\":\"Establish policies to identify information indicating that objectives, risks or responses need adding or modifying because of changes, and act on it.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.28\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"28\",\"topic\":\"Governance and leadership objectives\",\"statement\":\"Establish objectives that the firm demonstrates a culture committed to quality and the public interest, that leadership is responsible and accountable and demonstrates commitment, that the structure and assignment of roles are appropriate, and that resources including financial resources are planned and allocated consistently with the commitment to quality.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.29\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"29\",\"topic\":\"Ethical requirements objectives\",\"statement\":\"Establish objectives that the firm, its personnel, and others subject to the relevant ethical requirements including the network and service providers understand and fulfil their responsibilities.\",\"kind\":\"ethics\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.30\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"30\",\"topic\":\"Acceptance and continuance objectives\",\"statement\":\"Establish objectives that acceptance and continuance judgments are based on sufficient information about the engagement and the client's integrity and ethical values and on the firm's ability to perform the engagement, and that financial and operational priorities do not lead to inappropriate judgments.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.31\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"31\",\"topic\":\"Engagement performance objectives\",\"statement\":\"Establish objectives that engagement teams understand and fulfil their responsibilities including the partner's overall responsibility, that direction, supervision and review are appropriate, that judgment and scepticism are exercised, that consultation occurs and conclusions are implemented, that differences of opinion are resolved, and that documentation is assembled, maintained and retained appropriately.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.32\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"32\",\"topic\":\"Resources objectives\",\"statement\":\"Establish objectives on human resources (hiring, development, retention, commitment, competence, accountability, external sourcing, assignment of competent team members and system personnel), technological resources, intellectual resources, and resources from service providers.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.33\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"33\",\"topic\":\"Information and communication objectives\",\"statement\":\"Establish objectives that the information system captures and maintains relevant and reliable information, that the culture supports exchange of information, that information is exchanged with personnel and engagement teams, and that information is communicated externally including to the network, service providers, and as required by law or to support external understanding.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.34\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"34\",\"topic\":\"Specified responses\",\"statement\":\"Include responses that establish policies on identifying and addressing threats to ethical requirements and on breaches; annual independence confirmations; complaints and allegations; information that would have caused declining an engagement and legally mandated engagements; communication with governance of listed entities about the system and other external communication; and engagement quality reviews for listed entity audits, legally required reviews, and reviews the firm determines are an appropriate response.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.35\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"35\",\"topic\":\"Monitoring and remediation process\",\"statement\":\"Establish a monitoring and remediation process that provides relevant, reliable and timely information about the system and remediates deficiencies on a timely basis.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.36\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"36\",\"topic\":\"Design monitoring activities\",\"statement\":\"Design and perform monitoring activities that provide a basis for identifying deficiencies.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.37\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"37\",\"topic\":\"Nature, timing and extent of monitoring\",\"statement\":\"In determining monitoring activities, take into account the reasons for the risk assessments, the design of responses, the design of the risk assessment and monitoring processes, changes in the system, results of previous monitoring, and other information including complaints, external inspections and service provider information.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.38\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"38\",\"topic\":\"Inspection of completed engagements\",\"statement\":\"Include inspection of completed engagements, selecting engagements and partners with regard to the matters in paragraph 37 and other monitoring, and select at least one completed engagement per engagement partner on a cyclical basis.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.39\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"39\",\"topic\":\"Competence and objectivity of monitors\",\"statement\":\"Establish policies requiring those performing monitoring to be competent with sufficient time and to be objective, prohibiting team members or the engagement quality reviewer from inspecting their own engagement.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.40\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"40\",\"topic\":\"Evaluate findings\",\"statement\":\"Evaluate findings to determine whether deficiencies exist, including in the monitoring and remediation process.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.41\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"41\",\"topic\":\"Evaluate deficiencies\",\"statement\":\"Evaluate the severity and pervasiveness of identified deficiencies by investigating root causes and evaluating their individual and aggregate effect on the system.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.42\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"42\",\"topic\":\"Remedial actions\",\"statement\":\"Design and implement remedial actions responsive to the root cause analysis.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.43\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"43\",\"topic\":\"Evaluate remedial actions\",\"statement\":\"The individual responsible for monitoring evaluates whether remedial actions are appropriately designed to address deficiencies and their root causes and implemented, and whether earlier actions are effective.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.44\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"44\",\"topic\":\"Ineffective remediation\",\"statement\":\"Where remedial actions are not appropriately designed, implemented or effective, take action to modify them so that they are effective.\",\"kind\":\"quality\",\"conditional\":1,\"condition\":\"Remedial actions are not appropriately designed, implemented or effective.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.45\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"45\",\"topic\":\"Findings about a particular engagement\",\"statement\":\"Where findings indicate that required procedures were omitted or a report may be inappropriate, take action to comply with professional standards and law and, where the report is inappropriate, consider the implications including legal advice.\",\"kind\":\"quality\",\"conditional\":1,\"condition\":\"Findings indicate omitted procedures or an inappropriate report on an engagement.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.46\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"46\",\"topic\":\"Communicate monitoring results to leadership\",\"statement\":\"The individual responsible for monitoring communicates on a timely basis to those with ultimate and operational responsibility a description of the monitoring performed, the deficiencies with their severity and pervasiveness, and the remedial actions.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.47\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"47\",\"topic\":\"Communicate to engagement teams\",\"statement\":\"Communicate the monitoring matters to engagement teams and others with responsibilities in the system so that they can act promptly.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.48\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"48\",\"topic\":\"Understand network requirements\",\"statement\":\"Understand the network's requirements for the firm's system, the network services the firm uses, and the firm's responsibilities to implement them; the firm remains responsible for its system and must not let network requirements contravene the standard.\",\"kind\":\"quality\",\"conditional\":1,\"condition\":\"The firm belongs to a network.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.49\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"49\",\"topic\":\"Apply network requirements\",\"statement\":\"Determine how network requirements and services are relevant to and taken into account in the firm's system and how they are implemented, and evaluate whether they need adapting or supplementing.\",\"kind\":\"quality\",\"conditional\":1,\"condition\":\"The firm belongs to a network.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.50\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"50\",\"topic\":\"Network monitoring of the firm\",\"statement\":\"Where the network monitors the firm's system, determine the effect on the firm's own monitoring, the firm's responsibilities and actions, and obtain the network's results in a timely manner.\",\"kind\":\"quality\",\"conditional\":1,\"condition\":\"The network monitors the firm's system.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.51\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"51\",\"topic\":\"Network-wide monitoring results\",\"statement\":\"Understand the scope of the network's monitoring across firms and how results are communicated, obtain the overall results at least annually, communicate them internally, and consider their effect on the firm's system.\",\"kind\":\"quality\",\"conditional\":1,\"condition\":\"The firm belongs to a network.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.52\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"52\",\"topic\":\"Deficiencies in network requirements\",\"statement\":\"Where a deficiency in network requirements or services is identified, communicate it to the network and design remedial actions to address its effect.\",\"kind\":\"quality\",\"conditional\":1,\"condition\":\"The firm identifies a deficiency in network requirements or services.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.53\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"53\",\"topic\":\"Annual evaluation of the system\",\"statement\":\"The individual with ultimate responsibility evaluates the system as at a point in time at least annually.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.54\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"54\",\"topic\":\"Conclusion on the system\",\"statement\":\"Conclude whether the system provides reasonable assurance that its objectives are achieved, provides it except for severe but not pervasive deficiencies, or does not provide it.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.55\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"55\",\"topic\":\"Action on an adverse conclusion\",\"statement\":\"Where the conclusion is except-for or negative, take prompt and appropriate action and communicate to engagement teams and others as relevant and to external parties under the firm's policies.\",\"kind\":\"quality\",\"conditional\":1,\"condition\":\"The conclusion is except-for or negative.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.56\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"56\",\"topic\":\"Performance evaluation of leadership\",\"statement\":\"Undertake periodic performance evaluations of those with ultimate and operational responsibility, taking the evaluation of the system into account.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.57\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"57\",\"topic\":\"Documentation of the system\",\"statement\":\"Prepare documentation sufficient to support a consistent understanding of the system and roles, consistent implementation and operation of responses, and evidence of the design, implementation and operation of responses to support the evaluation.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.58\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"58\",\"topic\":\"Content of documentation\",\"statement\":\"Document the identity of those responsible, the quality objectives and risks, the responses and how they address the risks, the monitoring activities, findings, deficiencies, root causes, remedial actions and communications, and the basis for the conclusion on the system.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.59\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"59\",\"topic\":\"Network documentation\",\"statement\":\"Document the network-related matters and the evaluation of network requirements and services.\",\"kind\":\"documentation\",\"conditional\":1,\"condition\":\"The firm belongs to a network.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1.60\",\"standard_id\":\"ISQM-1\",\"paragraph\":\"60\",\"topic\":\"Retention period\",\"statement\":\"Establish a retention period for system documentation sufficient to monitor the system, or longer where law requires.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.19\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"19\",\"topic\":\"Professional scepticism about fraud\",\"statement\":\"Maintain professional scepticism throughout the audit, recognising that a material misstatement due to fraud could exist.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.20\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"20\",\"topic\":\"Alertness for fraud risk factors\",\"statement\":\"Remain alert throughout the audit for information indicating fraud risk factors and circumstances that may indicate fraud or suspected fraud.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.21\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"21\",\"topic\":\"Inconsistent responses\",\"statement\":\"Where responses to inquiries of management, governance, internal audit or others are inconsistent, investigate the inconsistencies.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Responses to inquiries are inconsistent.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.22\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"22\",\"topic\":\"Authenticity of documents\",\"statement\":\"Where conditions suggest a record may not be authentic or its terms were modified without disclosure, investigate further.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Conditions suggest a record or document may not be authentic or was modified without disclosure.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.23\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"23\",\"topic\":\"Team competence for fraud\",\"statement\":\"The engagement partner determines that the team collectively has the competence, capabilities, time and specialised skills to assess and respond to fraud risks and evaluate the evidence.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.24\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"24\",\"topic\":\"Direction, supervision and review responsive to fraud\",\"statement\":\"The engagement partner determines that direction, supervision and review respond to fraud risk factors, fraud or suspected fraud, and control deficiencies relevant to fraud identified during the audit.\",\"kind\":\"quality\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.25\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"25\",\"topic\":\"Ongoing communication on fraud\",\"statement\":\"Communicate fraud-related matters with management and those charged with governance at appropriate times throughout the audit.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.26\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"26\",\"topic\":\"Fraud risk assessment procedures\",\"statement\":\"Perform the procedures in paragraphs 27 to 38 as part of risk assessment and consider whether fraud risk factors are present.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.27\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"27\",\"topic\":\"Information from other sources\",\"statement\":\"Consider whether information from other sources indicates fraud risk factors.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.28\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"28\",\"topic\":\"Retrospective review of estimates\",\"statement\":\"Perform a retrospective review of management judgments and assumptions on previous estimates, scaled to their characteristics, to assist in assessing fraud risks.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.29\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"29\",\"topic\":\"Team discussion on fraud\",\"statement\":\"In the engagement team discussion emphasise how and where the statements are susceptible to fraud, exchanging ideas on culture, integrity and oversight, fraud risk factors including incentives, how fraudulent reporting could be perpetrated and concealed and how assets could be misappropriated, which revenue types or assertions give rise to fraud risk, and how management could override controls; and consider any fraud that may affect the strategy and plan.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.30\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"30\",\"topic\":\"Unusual relationships in analytics\",\"statement\":\"Determine whether unusual or unexpected relationships from analytical procedures, including revenue accounts, may indicate fraud risks.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.31\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"31\",\"topic\":\"Susceptibility to bias and fraud\",\"statement\":\"Based on the understanding of the entity and framework, understand matters that may increase susceptibility to misstatement from management bias or other fraud risk factors.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.32\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"32\",\"topic\":\"Control environment and fraud\",\"statement\":\"Understand how management's oversight and culture address fraud prevention and detection, the whistleblower programme and how allegations are handled, and governance oversight of fraud risks; inquire of management about its communications with governance on fraud processes; and inquire of those charged with governance about known or suspected fraud and allegations, their views on susceptibility to fraud, and known deficiencies in fraud-related controls.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.33\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"33\",\"topic\":\"Entity's risk assessment and fraud\",\"statement\":\"Understand how the entity's risk assessment identifies, assesses and addresses fraud risks for misappropriation and fraudulent reporting, and inquire of management and others about known or suspected fraud and their views on susceptibility.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.34\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"34\",\"topic\":\"Monitoring and internal audit on fraud\",\"statement\":\"Understand how the monitoring process evaluates fraud-related controls and remediates deficiencies and internal audit's objectives on fraud controls; inquire of internal audit about procedures over fraud controls, known or suspected fraud and its views, and known deficiencies.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.35\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"35\",\"topic\":\"Journal entry processing\",\"statement\":\"Include in the understanding of the information system how journal entries and other adjustments are initiated, processed, recorded and corrected.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.36\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"36\",\"topic\":\"Fraud-related control activities\",\"statement\":\"Include in the understanding of control activities the identification of controls that address fraud risks at the assertion level, including controls over journal entries and other adjustments.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.37\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"37\",\"topic\":\"Fraud-related control deficiencies\",\"statement\":\"Based on the evaluation of internal control, determine whether deficiencies relevant to preventing or detecting fraud exist.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.38\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"38\",\"topic\":\"Evaluate fraud risk factors\",\"statement\":\"Evaluate whether the evidence from risk assessment indicates that fraud risk factors are present.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.39\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"39\",\"topic\":\"Identify and assess fraud risks\",\"statement\":\"Identify and assess fraud risks at the financial statement and assertion levels taking fraud risk factors into account, treat them as significant risks, and identify and evaluate the design and implementation of controls addressing them.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.40\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"40\",\"topic\":\"Management override at the financial statement level\",\"statement\":\"Treat the risk of management override as a fraud risk at the financial statement level irrespective of its assessment, and determine whether it affects assertion-level risks.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.41\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"41\",\"topic\":\"Presumed fraud risk in revenue\",\"statement\":\"Presume fraud risks in revenue recognition and determine which types of revenue, transactions or assertions give rise to them, taking fraud risk factors into account.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.42\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"42\",\"topic\":\"Unbiased fraud responses\",\"statement\":\"Design and perform responses to fraud risks without bias towards corroborating management's assertions or away from contradicting them.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.43\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"43\",\"topic\":\"Unpredictability\",\"statement\":\"Incorporate an element of unpredictability in the nature, timing and extent of procedures responding to fraud risks.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.44\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"44\",\"topic\":\"Overall responses to fraud risks\",\"statement\":\"Determine overall responses to assessed fraud risks at the financial statement level.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.45\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"45\",\"topic\":\"Accounting policies indicating fraud\",\"statement\":\"In determining overall responses, evaluate whether the selection and application of accounting policies, particularly for subjective measurements and complex transactions, may indicate fraudulent reporting.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.46\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"46\",\"topic\":\"Assertion-level responses to fraud\",\"statement\":\"Design and perform further procedures responsive to the assessed fraud risks at the assertion level.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.47\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"47\",\"topic\":\"Override procedures\",\"statement\":\"Irrespective of the assessed override risk, perform the procedures in paragraphs 48 to 52 and determine whether other procedures are needed.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.48\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"48\",\"topic\":\"Test journal entries and adjustments\",\"statement\":\"Design and perform procedures to test the appropriateness of general-ledger journal entries and other adjustments made in preparing the statements.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.49\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"49\",\"topic\":\"Journal entry testing design\",\"statement\":\"In testing journal entries, inquire of those in the reporting process about unusual activity, obtain evidence about the completeness of the population of entries and adjustments for the period, select period-end entries, and determine the need to test entries throughout the period.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.50\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"50\",\"topic\":\"Bias in estimates as fraud risk\",\"statement\":\"Where indicators of possible management bias in estimates are identified, evaluate whether they may represent a fraud risk.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Indicators of possible management bias are identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.51\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"51\",\"topic\":\"Evaluation of bias\",\"statement\":\"In that evaluation, consider the evidence from the retrospective review and, where bias indicators exist, re-evaluate the estimates as a whole.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Indicators of possible management bias are identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.52\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"52\",\"topic\":\"Unusual transactions\",\"statement\":\"For significant transactions outside the normal course of business or otherwise unusual, evaluate whether the business rationale suggests fraudulent reporting or concealment of misappropriation.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.53\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"53\",\"topic\":\"Final analytics and fraud\",\"statement\":\"Determine whether analytical procedures performed near the end of the audit indicate a previously unrecognised fraud risk.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.54\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"54\",\"topic\":\"Overall evaluation of fraud responses\",\"statement\":\"Evaluate whether the assessed fraud risks remain appropriate and whether sufficient appropriate evidence has been obtained in response to them.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.55\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"55\",\"topic\":\"Understand identified fraud\",\"statement\":\"On identifying fraud or suspected fraud, understand the matter to determine its effect: inquire of management and where appropriate governance, evaluate the entity's investigation process, and evaluate any remedial actions.\",\"kind\":\"procedure\",\"conditional\":1,\"condition\":\"Fraud or suspected fraud is identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.56\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"56\",\"topic\":\"Partner determinations on fraud\",\"statement\":\"Except where clearly inconsequential, the engagement partner determines whether additional risk assessment procedures or further procedures are needed and whether additional responsibilities arise under ISA 250, and considers the impact on prior-period audits.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Fraud or suspected fraud is identified and not clearly inconsequential.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.57\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"57\",\"topic\":\"Misstatement due to fraud\",\"statement\":\"On identifying a misstatement due to fraud, determine whether it is material considering qualitative and quantitative circumstances, whether control deficiencies exist, its implications for other aspects of the audit including management involvement, and the reliability of representations and evidence including possible collusion.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"A misstatement due to fraud is identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.58\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"58\",\"topic\":\"Material misstatement due to fraud\",\"statement\":\"Where the statements are materially misstated due to fraud or sufficient evidence cannot be obtained to conclude, determine the implications for the audit and opinion under ISA 705 and where appropriate obtain legal advice.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"The statements are materially misstated due to fraud or evidence is insufficient to conclude.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.59\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"59\",\"topic\":\"Ability to continue\",\"statement\":\"Where fraud brings the ability to continue into question, determine the professional and legal responsibilities including reporting, consider withdrawal where permitted, on withdrawal discuss the reasons with management and governance and determine reporting requirements, and where withdrawal is prohibited consider whether a disclaimer results.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Fraud brings the ability to continue the audit into question.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.60\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"60\",\"topic\":\"Fraud matters requiring significant attention\",\"statement\":\"From fraud matters communicated with governance, determine those requiring significant auditor attention, taking into account assessed fraud risks, identified fraud or suspected fraud, and significant fraud-related deficiencies.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.61\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"61\",\"topic\":\"Fraud key audit matters\",\"statement\":\"Determine which of those fraud matters were of most significance and are therefore key audit matters.\",\"kind\":\"judgment\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.62\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"62\",\"topic\":\"Fraud subheading\",\"statement\":\"Use a subheading in the key audit matters section that clearly describes that the matter relates to fraud.\",\"kind\":\"reporting\",\"conditional\":1,\"condition\":\"A fraud-related key audit matter is communicated.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.63\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"63\",\"topic\":\"Written representations on fraud\",\"statement\":\"Obtain written representations that management and where appropriate governance acknowledge and have fulfilled their responsibility for fraud-related internal control, have disclosed the results of their fraud risk assessment, have disclosed knowledge of fraud or suspected fraud including allegations involving management, key control employees or others affecting the statements, and have disclosed suspected fraud and allegations communicated by employees, former employees, analysts, regulators or others.\",\"kind\":\"procedure\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.64\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"64\",\"topic\":\"Communicate fraud to management\",\"statement\":\"Communicate identified fraud or suspected fraud to the appropriate level of management on a timely basis unless prohibited by law.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Fraud or suspected fraud is identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.65\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"65\",\"topic\":\"Communicate fraud to governance\",\"statement\":\"Unless all governance manage the entity, communicate fraud or suspected fraud involving management, key control employees or others except clearly inconsequential matters to those charged with governance on a timely basis; where management is suspected, discuss the procedures needed to complete the audit; all unless prohibited by law.\",\"kind\":\"communication\",\"conditional\":1,\"condition\":\"Fraud or suspected fraud involving management, key control employees or others is identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.66\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"66\",\"topic\":\"Other fraud matters\",\"statement\":\"Communicate to those charged with governance, unless prohibited by law, other fraud-related matters relevant to their responsibilities.\",\"kind\":\"communication\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.67\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"67\",\"topic\":\"Reporting fraud outside the entity\",\"statement\":\"Where fraud or suspected fraud is identified, determine whether law, regulation or ethical requirements require or permit reporting to an appropriate outside authority.\",\"kind\":\"judgment\",\"conditional\":1,\"condition\":\"Fraud or suspected fraud is identified.\",\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R.68\",\"standard_id\":\"ISA-240R\",\"paragraph\":\"68\",\"topic\":\"Documentation of fraud\",\"statement\":\"Document the team discussion on fraud, the key elements of the understanding and procedures performed, the identified and assessed fraud risks with the rationale, the reasons for rebutting the revenue presumption, the results of override procedures with judgments and conclusions, identified fraud or suspected fraud with procedures and conclusions, and fraud communications with management, governance, authorities and others including their responses.\",\"kind\":\"documentation\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"IESBA-CODE.R100-R120\",\"standard_id\":\"IESBA-CODE\",\"paragraph\":\"R100-R120\",\"topic\":\"Fundamental principles and conceptual framework\",\"statement\":\"Comply with the fundamental principles of integrity, objectivity, professional competence and due care, confidentiality and professional behaviour, and apply the conceptual framework to identify, evaluate and address threats to compliance, using the reasonable and informed third party test.\",\"kind\":\"ethics\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"IESBA-CODE.Section 400\",\"standard_id\":\"IESBA-CODE\",\"paragraph\":\"Section 400\",\"topic\":\"Independence for audit engagements\",\"statement\":\"Be independent of the audit client in mind and in appearance throughout the engagement period and the period covered by the financial statements, applying the conceptual framework to independence and the additional provisions for public interest entities.\",\"kind\":\"ethics\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"IESBA-CODE.Section 410\",\"standard_id\":\"IESBA-CODE\",\"paragraph\":\"Section 410\",\"topic\":\"Fees\",\"statement\":\"Evaluate and address threats created by the level of fees, fee dependency on an audit client, overdue fees, and contingent fees, which are prohibited for audits; for public interest entities apply the fee-dependency safeguards and disclose fee-related information to those charged with governance and publicly where required.\",\"kind\":\"ethics\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"IESBA-CODE.Section 510\",\"standard_id\":\"IESBA-CODE\",\"paragraph\":\"Section 510\",\"topic\":\"Financial interests\",\"statement\":\"Do not hold a direct financial interest or a material indirect financial interest in an audit client, and evaluate threats from financial interests held by the firm, team members and their immediate family and by others.\",\"kind\":\"ethics\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"IESBA-CODE.Section 520\",\"standard_id\":\"IESBA-CODE\",\"paragraph\":\"Section 520\",\"topic\":\"Loans and guarantees\",\"statement\":\"Do not make or accept loans or guarantees with an audit client unless the client is a bank or similar institution and the loan is on normal terms and immaterial, and evaluate threats from loans with other clients.\",\"kind\":\"ethics\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"IESBA-CODE.Section 521\",\"standard_id\":\"IESBA-CODE\",\"paragraph\":\"Section 521\",\"topic\":\"Business relationships\",\"statement\":\"Do not enter into close business relationships with an audit client or its management unless the financial interest is immaterial and the relationship insignificant; evaluate threats from other business relationships.\",\"kind\":\"ethics\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"IESBA-CODE.Section 522\",\"standard_id\":\"IESBA-CODE\",\"paragraph\":\"Section 522\",\"topic\":\"Family and personal relationships\",\"statement\":\"Evaluate and address threats from family and personal relationships between team members and directors, officers or employees of the audit client in positions of significant influence, removing team members where required.\",\"kind\":\"ethics\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"IESBA-CODE.Section 523\",\"standard_id\":\"IESBA-CODE\",\"paragraph\":\"Section 523\",\"topic\":\"Recent service with an audit client\",\"statement\":\"Do not include on the team an individual who during the period covered by the report was a director, officer or employee able to influence the financial statements; evaluate threats from earlier service.\",\"kind\":\"ethics\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"IESBA-CODE.Section 524\",\"standard_id\":\"IESBA-CODE\",\"paragraph\":\"Section 524\",\"topic\":\"Employment with an audit client\",\"statement\":\"Evaluate and address threats when a former team member or partner joins an audit client, including the cooling-off requirements for key audit partners and senior personnel joining public interest entity clients.\",\"kind\":\"ethics\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"IESBA-CODE.Section 525\",\"standard_id\":\"IESBA-CODE\",\"paragraph\":\"Section 525\",\"topic\":\"Temporary personnel assignments\",\"statement\":\"Lend personnel to an audit client only for a short period, where they do not perform non-assurance services that would be prohibited and the client directs and supervises them.\",\"kind\":\"ethics\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"IESBA-CODE.Section 540\",\"standard_id\":\"IESBA-CODE\",\"paragraph\":\"Section 540\",\"topic\":\"Long association\",\"statement\":\"Evaluate familiarity and self-interest threats from long association of personnel with an audit client; for public interest entities apply the mandatory rotation periods and cooling-off periods for engagement partners, engagement quality reviewers and other key audit partners.\",\"kind\":\"ethics\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"IESBA-CODE.Section 600\",\"standard_id\":\"IESBA-CODE\",\"paragraph\":\"Section 600\",\"topic\":\"Non-assurance services\",\"statement\":\"Before providing a non-assurance service to an audit client, determine whether it creates a threat to independence that cannot be addressed and whether it is prohibited; do not assume management responsibility; for public interest entities do not provide a service that might create a self-review threat, and obtain concurrence of those charged with governance.\",\"kind\":\"ethics\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"},{\"id\":\"IESBA-CODE.Section 800\",\"standard_id\":\"IESBA-CODE\",\"paragraph\":\"Section 800\",\"topic\":\"Reports including a restriction on use and distribution\",\"statement\":\"Apply the modified independence provisions only where the report is restricted in use and distribution and the intended users understand the purpose and limitations of the report and agree the modified requirements.\",\"kind\":\"ethics\",\"conditional\":0,\"condition\":null,\"statement_ar\":null,\"statement_ar_status\":\"pending_draft\"}]"),
    ("responses", 89, "[{\"id\":\"RS-0001\",\"risk_id\":\"R-FSL-001\",\"procedure_id\":\"P-FSL-034\",\"response_type\":\"further_procedure\",\"rationale\":\"Journal entry testing is the mandated response to override.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0002\",\"risk_id\":\"R-FSL-001\",\"procedure_id\":\"P-FSL-035\",\"response_type\":\"further_procedure\",\"rationale\":\"Unusual transactions are evaluated for business rationale.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0003\",\"risk_id\":\"R-FSL-001\",\"procedure_id\":\"P-FSL-031\",\"response_type\":\"further_procedure\",\"rationale\":\"Estimates are reviewed for bias including retrospectively.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0004\",\"risk_id\":\"R-FSL-001\",\"procedure_id\":\"P-FSL-016\",\"response_type\":\"overall\",\"rationale\":\"Unpredictability and scepticism are set as overall responses.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0005\",\"risk_id\":\"R-FSL-002\",\"procedure_id\":\"P-FSL-012\",\"response_type\":\"further_procedure\",\"rationale\":\"Fraud inquiries and risk factor evaluation identify the incentives.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0006\",\"risk_id\":\"R-FSL-002\",\"procedure_id\":\"P-FSL-016\",\"response_type\":\"overall\",\"rationale\":\"Team assignment and unpredictability respond at the financial statement level.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0007\",\"risk_id\":\"R-FSL-002\",\"procedure_id\":\"P-REV-007\",\"response_type\":\"further_procedure\",\"rationale\":\"Revenue is the most common vehicle for fraudulent reporting.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0008\",\"risk_id\":\"R-FSL-003\",\"procedure_id\":\"P-FSL-032\",\"response_type\":\"further_procedure\",\"rationale\":\"The going concern assessment procedure evaluates management's assessment, plans and forecast.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0009\",\"risk_id\":\"R-FSL-003\",\"procedure_id\":\"P-TRE-005\",\"response_type\":\"further_procedure\",\"rationale\":\"Covenant compliance and facility availability are tested.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0010\",\"risk_id\":\"R-FSL-003\",\"procedure_id\":\"P-FSL-037\",\"response_type\":\"further_procedure\",\"rationale\":\"Subsequent events may confirm or relieve the doubt.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0011\",\"risk_id\":\"R-FSL-004\",\"procedure_id\":\"P-FSL-010\",\"response_type\":\"further_procedure\",\"rationale\":\"Evaluation of the control environment determines the pervasive effect.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0012\",\"risk_id\":\"R-FSL-004\",\"procedure_id\":\"P-FSL-016\",\"response_type\":\"overall\",\"rationale\":\"Overall responses shift the approach toward substantive procedures at the period end.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0013\",\"risk_id\":\"R-FSL-005\",\"procedure_id\":\"P-FSL-011\",\"response_type\":\"further_procedure\",\"rationale\":\"General IT controls are identified and evaluated with the application controls that depend on them.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0014\",\"risk_id\":\"R-FSL-005\",\"procedure_id\":\"P-FSL-017\",\"response_type\":\"further_procedure\",\"rationale\":\"Outsourced IT is covered through service organisation reports.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0015\",\"risk_id\":\"R-FSL-006\",\"procedure_id\":\"P-FSL-014\",\"response_type\":\"further_procedure\",\"rationale\":\"Identification procedures and alertness in inspecting records.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0016\",\"risk_id\":\"R-FSL-006\",\"procedure_id\":\"P-FSL-036\",\"response_type\":\"further_procedure\",\"rationale\":\"Substantive testing of identified transactions and disclosures.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0017\",\"risk_id\":\"R-FSL-007\",\"procedure_id\":\"P-FSL-013\",\"response_type\":\"further_procedure\",\"rationale\":\"Framework understanding and compliance inquiries.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0018\",\"risk_id\":\"R-FSL-007\",\"procedure_id\":\"P-FSL-051\",\"response_type\":\"further_procedure\",\"rationale\":\"Response procedures when non-compliance is identified or suspected.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0019\",\"risk_id\":\"R-FSL-007\",\"procedure_id\":\"P-TAX-004\",\"response_type\":\"further_procedure\",\"rationale\":\"VAT and e-invoicing compliance is tested directly.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0020\",\"risk_id\":\"R-FSL-008\",\"procedure_id\":\"P-FSL-030\",\"response_type\":\"further_procedure\",\"rationale\":\"Understanding and retrospective review of estimates.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0021\",\"risk_id\":\"R-FSL-008\",\"procedure_id\":\"P-FSL-031\",\"response_type\":\"further_procedure\",\"rationale\":\"Substantive evaluation of each significant estimate.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0022\",\"risk_id\":\"R-FSL-009\",\"procedure_id\":\"P-FSL-041\",\"response_type\":\"further_procedure\",\"rationale\":\"Closing process agreement and disclosure checklist.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0023\",\"risk_id\":\"R-FSL-009\",\"procedure_id\":\"P-FSL-034\",\"response_type\":\"further_procedure\",\"rationale\":\"Closing journals are within the journal-testing population.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0024\",\"risk_id\":\"R-FSL-010\",\"procedure_id\":\"P-FSL-021\",\"response_type\":\"further_procedure\",\"rationale\":\"Group planning determines components and materiality.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0025\",\"risk_id\":\"R-FSL-010\",\"procedure_id\":\"P-FSL-048\",\"response_type\":\"further_procedure\",\"rationale\":\"Consolidation process procedures and evaluation of component work.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0026\",\"risk_id\":\"R-REV-001\",\"procedure_id\":\"P-REV-005\",\"response_type\":\"further_procedure\",\"rationale\":\"Cut-off testing on both sides of the period end.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0027\",\"risk_id\":\"R-REV-001\",\"procedure_id\":\"P-REV-007\",\"response_type\":\"further_procedure\",\"rationale\":\"Fraud-responsive revenue procedures.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0028\",\"risk_id\":\"R-REV-001\",\"procedure_id\":\"P-REV-006\",\"response_type\":\"further_procedure\",\"rationale\":\"Contract terms review for non-standard arrangements.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0029\",\"risk_id\":\"R-REV-001\",\"procedure_id\":\"P-REV-004\",\"response_type\":\"further_procedure\",\"rationale\":\"Precise expectation exposes unusual period-end revenue.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0030\",\"risk_id\":\"R-REV-002\",\"procedure_id\":\"P-REV-008\",\"response_type\":\"further_procedure\",\"rationale\":\"Confirmation of receivables from third parties.\",\"rationale_ar\":null,\"rationale_ar_status\":\"pending_draft\"},{\"id\":\"RS-0031\",\"risk_id\":\"R-REV-002\",\"procedure_id\":\"P-REV-011\",\"response_type\":\"further_procedure\",\"rationale\":\"Subsequent receipts cor