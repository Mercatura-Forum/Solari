    ("charts", 1, "[{\"id\":\"IFRS-4D\",\"name\":\"Default four-digit IFRS-shaped chart\",\"code_kind\":\"numeric\",\"domain_start\":1000,\"domain_end\":6999,\"description\":\"The default numbering convention used when a source system does not supply its own leadsheet mapping. Assets 1xxx, equity 2xxx, non-current liabilities 3xxx, current liabilities 4xxx, income 5xxx, expenses 6xxx. Codes outside 1000-6999 are outside the chart's domain and are reported as unmapped rather than bucketed.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"}]"),
    ("computation_requirements", 44, "[{\"computation_id\":\"CALC-MATERIALITY\",\"requirement_id\":\"ISA-320.10\"},{\"computation_id\":\"CALC-MATERIALITY\",\"requirement_id\":\"ISA-320.11\"},{\"computation_id\":\"CALC-MATERIALITY\",\"requirement_id\":\"ISA-320.12\"},{\"computation_id\":\"CALC-MATERIALITY\",\"requirement_id\":\"ISA-320.13\"},{\"computation_id\":\"CALC-MATERIALITY\",\"requirement_id\":\"ISA-450.5\"},{\"computation_id\":\"CALC-MUS\",\"requirement_id\":\"ISA-530.6\"},{\"computation_id\":\"CALC-MUS\",\"requirement_id\":\"ISA-530.7\"},{\"computation_id\":\"CALC-MUS\",\"requirement_id\":\"ISA-530.8\"},{\"computation_id\":\"CALC-MUS\",\"requirement_id\":\"ISA-530.14\"},{\"computation_id\":\"CALC-MUS\",\"requirement_id\":\"ISA-530.15\"},{\"computation_id\":\"CALC-ATTRIBUTE\",\"requirement_id\":\"ISA-530.6\"},{\"computation_id\":\"CALC-ATTRIBUTE\",\"requirement_id\":\"ISA-530.7\"},{\"computation_id\":\"CALC-ATTRIBUTE\",\"requirement_id\":\"ISA-530.15\"},{\"computation_id\":\"CALC-ATTRIBUTE\",\"requirement_id\":\"ISA-330.10\"},{\"computation_id\":\"CALC-ANALYTICS\",\"requirement_id\":\"ISA-520.5\"},{\"computation_id\":\"CALC-ANALYTICS\",\"requirement_id\":\"ISA-520.6\"},{\"computation_id\":\"CALC-ANALYTICS\",\"requirement_id\":\"ISA-520.7\"},{\"computation_id\":\"CALC-AGGREGATION\",\"requirement_id\":\"ISA-450.5\"},{\"computation_id\":\"CALC-AGGREGATION\",\"requirement_id\":\"ISA-450.10\"},{\"computation_id\":\"CALC-AGGREGATION\",\"requirement_id\":\"ISA-450.11\"},{\"computation_id\":\"CALC-AGGREGATION\",\"requirement_id\":\"ISA-450.15\"},{\"computation_id\":\"CALC-GOING-CONCERN\",\"requirement_id\":\"ISA-570.13\"},{\"computation_id\":\"CALC-GOING-CONCERN\",\"requirement_id\":\"ISA-570.16\"},{\"computation_id\":\"CALC-GOING-CONCERN\",\"requirement_id\":\"ISA-570R.19\"},{\"computation_id\":\"CALC-GOING-CONCERN\",\"requirement_id\":\"ISA-570R.21\"},{\"computation_id\":\"CALC-GOING-CONCERN\",\"requirement_id\":\"ISA-570R.26\"},{\"computation_id\":\"CALC-COMPONENT-MATERIALITY\",\"requirement_id\":\"ISA-600.35\"},{\"computation_id\":\"CALC-COMPONENT-MATERIALITY\",\"requirement_id\":\"ISA-600.36\"},{\"computation_id\":\"CALC-JOURNAL-SCREEN\",\"requirement_id\":\"ISA-240.33\"},{\"computation_id\":\"CALC-JOURNAL-SCREEN\",\"requirement_id\":\"ISA-240.34\"},{\"computation_id\":\"CALC-JOURNAL-SCREEN\",\"requirement_id\":\"ISA-240R.48\"},{\"computation_id\":\"CALC-JOURNAL-SCREEN\",\"requirement_id\":\"ISA-240R.49\"},{\"computation_id\":\"CALC-JOURNAL-SCREEN\",\"requirement_id\":\"ISA-500.9\"},{\"computation_id\":\"CALC-JOURNAL-SCREEN\",\"requirement_id\":\"ISA-330.20\"},{\"computation_id\":\"CALC-TREND\",\"requirement_id\":\"ISA-315.14\"},{\"computation_id\":\"CALC-TREND\",\"requirement_id\":\"ISA-520.5\"},{\"computation_id\":\"CALC-TREND\",\"requirement_id\":\"ISA-520.6\"},{\"computation_id\":\"CALC-TIEOUT\",\"requirement_id\":\"ISA-330.20\"},{\"computation_id\":\"CALC-TIEOUT\",\"requirement_id\":\"ISA-330.30\"},{\"computation_id\":\"CALC-TIEOUT\",\"requirement_id\":\"ISA-700.13\"},{\"computation_id\":\"CALC-ROLLFORWARD\",\"requirement_id\":\"ISA-500.9\"},{\"computation_id\":\"CALC-ROLLFORWARD\",\"requirement_id\":\"ISA-520.5\"},{\"computation_id\":\"CALC-ROLLFORWARD\",\"requirement_id\":\"ISA-520.7\"},{\"computation_id\":\"CALC-ROLLFORWARD\",\"requirement_id\":\"ISA-330.20\"}]"),
    ("computations", 11, "[{\"id\":\"CALC-MATERIALITY\",\"term_id\":\"T-C-MATERIALITY\",\"name\":\"Materiality determination\",\"standard_id\":\"ISA-320\",\"spec_ref\":\"docs/COMPUTATIONS.md#materiality\",\"implementation\":\"computations/materiality.py\",\"vectors\":\"computations/vectors/materiality.json\",\"inputs\":\"[\\\"benchmark\\\", \\\"benchmark_amount\\\", \\\"percentage\\\", \\\"pm_factor\\\", \\\"trivial_factor\\\", \\\"specific\\\", \\\"prior\\\"]\",\"outputs\":\"[\\\"overall\\\", \\\"performance\\\", \\\"clearly_trivial\\\", \\\"specific\\\", \\\"revision\\\"]\",\"description\":\"Overall materiality from a benchmark and percentage, performance materiality as a bounded factor, the clearly trivial threshold, specific materiality levels, and the revision test that flags when procedures must be reconsidered.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"CALC-MUS\",\"term_id\":\"T-C-MUS\",\"name\":\"Monetary unit sampling for tests of details\",\"standard_id\":\"ISA-530\",\"spec_ref\":\"docs/COMPUTATIONS.md#sampling\",\"implementation\":\"computations/sampling.py\",\"vectors\":\"computations/vectors/sampling_mus.json\",\"inputs\":\"[\\\"book_value\\\", \\\"tolerable_misstatement\\\", \\\"beta\\\", \\\"expected_misstatement\\\", \\\"items\\\", \\\"random_start\\\", \\\"results\\\"]\",\"outputs\":\"[\\\"sample_size\\\", \\\"sampling_interval\\\", \\\"selected\\\", \\\"projected_misstatement\\\", \\\"basic_precision\\\", \\\"incremental_allowance\\\", \\\"upper_misstatement_limit\\\", \\\"conclusion\\\"]\",\"description\":\"Sample size from exactly solved Poisson reliability factors, systematic selection with a top stratum, and Stringer-bound evaluation of overstatements.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"CALC-ATTRIBUTE\",\"term_id\":\"T-C-ATTRIBUTE\",\"name\":\"Attribute sampling for tests of controls\",\"standard_id\":\"ISA-530\",\"spec_ref\":\"docs/COMPUTATIONS.md#sampling\",\"implementation\":\"computations/sampling.py\",\"vectors\":\"computations/vectors/sampling_attribute.json\",\"inputs\":\"[\\\"tolerable_rate\\\", \\\"beta\\\", \\\"expected_rate\\\", \\\"sample_size\\\", \\\"deviations\\\"]\",\"outputs\":\"[\\\"sample_size\\\", \\\"allowed_deviations\\\", \\\"sample_deviation_rate\\\", \\\"upper_deviation_limit\\\"]\",\"description\":\"Exact binomial sample size for a tolerable deviation rate and risk of overreliance, and the upper deviation limit achieved by the sample.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"CALC-ANALYTICS\",\"term_id\":\"T-C-ANALYTICS\",\"name\":\"Substantive and final analytical procedures\",\"standard_id\":\"ISA-520\",\"spec_ref\":\"docs/COMPUTATIONS.md#analytics\",\"implementation\":\"computations/analytics.py\",\"vectors\":\"computations/vectors/analytics.json\",\"inputs\":\"[\\\"lines\\\", \\\"performance_materiality\\\", \\\"threshold_pct\\\", \\\"minimum_amount\\\", \\\"tb\\\"]\",\"outputs\":\"[\\\"threshold\\\", \\\"expected\\\", \\\"difference\\\", \\\"investigate\\\", \\\"ratios\\\"]\",\"description\":\"Expectation models (prior growth, driver product, ratio to base, proof in total), a threshold derived from performance materiality, difference evaluation, and the standard ratio set.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"CALC-AGGREGATION\",\"term_id\":\"T-C-AGGREGATION\",\"name\":\"Aggregation and evaluation of misstatements\",\"standard_id\":\"ISA-450\",\"spec_ref\":\"docs/COMPUTATIONS.md#aggregation\",\"implementation\":\"computations/aggregation.py\",\"vectors\":\"computations/vectors/aggregation.json\",\"inputs\":\"[\\\"items\\\", \\\"overall_materiality\\\", \\\"performance_materiality\\\", \\\"clearly_trivial\\\", \\\"prior_uncorrected_pl\\\"]\",\"outputs\":\"[\\\"uncorrected\\\", \\\"uncorrected_by_type\\\", \\\"rollover_profit_effect\\\", \\\"iron_curtain_profit_effect\\\", \\\"headroom\\\", \\\"band\\\", \\\"material_individually_or_in_aggregate\\\"]\",\"description\":\"Accumulation of misstatements above the clearly trivial threshold by type and status, balanced-entry checks, element totals, rollover and iron-curtain evaluation, and comparison with materiality.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"CALC-GOING-CONCERN\",\"term_id\":\"T-C-GOING-CONCERN\",\"name\":\"Going concern assessment arithmetic\",\"standard_id\":\"ISA-570\",\"spec_ref\":\"docs/COMPUTATIONS.md#going-concern\",\"implementation\":\"computations/going_concern.py\",\"vectors\":\"computations/vectors/going_concern.json\",\"inputs\":\"[\\\"financial_statement_date\\\", \\\"approval_date\\\", \\\"assessment_end_date\\\", \\\"opening_cash\\\", \\\"monthly_forecast\\\", \\\"facilities\\\", \\\"covenants\\\", \\\"stress\\\", \\\"standard\\\"]\",\"outputs\":\"[\\\"required_assessment_end\\\", \\\"assessment_shortfall_days\\\", \\\"base\\\", \\\"stress\\\", \\\"covenants\\\", \\\"indicators\\\"]\",\"description\":\"Assessment period coverage under the extant and the 2024 revised standard, cash flow forecast headroom including undrawn facilities, first breach month in base and stress cases, and covenant tests.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"CALC-COMPONENT-MATERIALITY\",\"term_id\":\"T-C-COMPONENT-MATERIALITY\",\"name\":\"Component performance materiality\",\"standard_id\":\"ISA-600\",\"spec_ref\":\"docs/COMPUTATIONS.md#component-materiality\",\"implementation\":\"computations/materiality.py\",\"vectors\":\"computations/vectors/component_materiality.json\",\"inputs\":\"[\\\"group_overall\\\", \\\"group_performance\\\", \\\"group_clearly_trivial\\\", \\\"components\\\"]\",\"outputs\":\"[\\\"components\\\", \\\"all_compliant\\\"]\",\"description\":\"Component performance materiality below group performance materiality and a communication threshold within the group clearly trivial amount, per ISA 600 (Revised).35, checked for every component.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"CALC-JOURNAL-SCREEN\",\"term_id\":\"T-C-JOURNAL-SCREEN\",\"name\":\"Journal-entry population completeness and screening\",\"standard_id\":\"ISA-240\",\"spec_ref\":\"docs/COMPUTATIONS.md#journal-entries\",\"implementation\":\"computations/journals.py\",\"vectors\":\"computations/vectors/journals.json\",\"inputs\":\"[\\\"lines\\\", \\\"trial_balance\\\", \\\"params\\\"]\",\"outputs\":\"[\\\"completeness\\\", \\\"flagged\\\", \\\"flagged_by_criterion\\\"]\",\"description\":\"Completeness of the journal population against the trial balance per account, then every ISA 240 criterion applied to every entry with each flagged entry naming the criteria it met.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"CALC-TREND\",\"term_id\":\"T-C-TREND\",\"name\":\"Multi-period trend expectation\",\"standard_id\":\"ISA-520\",\"spec_ref\":\"docs/COMPUTATIONS.md#trend\",\"implementation\":\"computations/analytics.py\",\"vectors\":\"computations/vectors/trend.json\",\"inputs\":\"[\\\"series\\\", \\\"method\\\", \\\"precision_pct\\\"]\",\"outputs\":\"[\\\"expected\\\", \\\"range_low\\\", \\\"range_high\\\", \\\"outside_range\\\"]\",\"description\":\"Expectation for the current period from the prior periods by least-squares trend or mean, with a precision band, flagging the current value when outside it.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"CALC-TIEOUT\",\"term_id\":\"T-C-TIEOUT\",\"name\":\"Financial statement tie-out\",\"standard_id\":\"ISA-700\",\"spec_ref\":\"docs/COMPUTATIONS.md#tie-out\",\"implementation\":\"computations/tieout.py\",\"vectors\":\"computations/vectors/tieout.json\",\"inputs\":\"[\\\"statement_lines\\\", \\\"leadsheet_totals\\\"]\",\"outputs\":\"[\\\"lines\\\", \\\"lines_differing\\\", \\\"leadsheets_not_presented\\\", \\\"agrees\\\"]\",\"description\":\"Recomputes every presented statement line from mapped leadsheet totals and every subtotal from its components, reporting differences and leadsheets not presented.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"CALC-ROLLFORWARD\",\"term_id\":\"T-C-ROLLFORWARD\",\"name\":\"Movement schedule roll-forward\",\"standard_id\":\"ISA-500\",\"spec_ref\":\"docs/COMPUTATIONS.md#roll-forward\",\"implementation\":\"computations/rollforward.py\",\"vectors\":\"computations/vectors/rollforward.json\",\"inputs\":\"[\\\"schedules\\\"]\",\"outputs\":\"[\\\"schedules\\\", \\\"schedules_examined\\\", \\\"schedules_agreeing\\\", \\\"agrees\\\"]\",\"description\":\"Recomputes every component of a movement schedule from its opening balance and movements, refuses a component whose stated closing differs, and compares each schedule's closing total with the leadsheet balance it must equal and its opening with the prior period.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"}]"),
    ("cycles", 9, "[{\"id\":\"REV\",\"name\":\"Revenue and receivables\",\"sort_order\":1,\"description\":\"Sales, contract assets and liabilities, trade receivables and the allowance for expected credit losses, credit notes and cash receipts application.\",\"term_id\":\"T-CYCLE-REV\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"PUR\",\"name\":\"Purchases, payables and expenditure\",\"sort_order\":2,\"description\":\"Purchases of goods and services, trade and other payables, accruals, provisions and other liabilities, operating expenses and cash disbursements.\",\"term_id\":\"T-CYCLE-PUR\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"PAY\",\"name\":\"Payroll\",\"sort_order\":3,\"description\":\"Wages, salaries, bonuses, social insurance, employee benefit obligations and payroll liabilities.\",\"term_id\":\"T-CYCLE-PAY\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"INV\",\"name\":\"Inventory and cost of sales\",\"sort_order\":4,\"description\":\"Raw materials, work in progress, finished goods, physical counts, costing, net realisable value and cost of sales.\",\"term_id\":\"T-CYCLE-INV\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"PPE\",\"name\":\"Property, plant, equipment and intangibles\",\"sort_order\":5,\"description\":\"Tangible and intangible non-current assets, investment property, right-of-use assets, depreciation, amortisation and impairment.\",\"term_id\":\"T-CYCLE-PPE\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"TRE\",\"name\":\"Treasury and financial instruments\",\"sort_order\":6,\"description\":\"Cash and bank, borrowings, lease liabilities, investments, derivatives, finance income and costs, and covenant compliance.\",\"term_id\":\"T-CYCLE-TRE\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"EQY\",\"name\":\"Equity\",\"sort_order\":7,\"description\":\"Share capital, reserves, retained earnings, dividends, non-controlling interests and other components of equity.\",\"term_id\":\"T-CYCLE-EQY\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"TAX\",\"name\":\"Income and indirect taxes\",\"sort_order\":8,\"description\":\"Current and deferred income tax, value added tax and other indirect taxes, and their liabilities and assets.\",\"term_id\":\"T-CYCLE-TAX\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"FSL\",\"name\":\"Financial-statement level and entity-wide\",\"sort_order\":9,\"description\":\"Procedures that do not belong to a single transaction cycle: acceptance, planning, materiality, fraud and business-risk assessment, estimates, related parties, going concern, subsequent events, aggregation of misstatements, and reporting.\",\"term_id\":\"T-CYCLE-FSL\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"}]"),
    ("disclosure_requirements", 74, "[{\"id\":\"DR-IAS1-10\",\"standard\":\"IAS 1\",\"paragraph\":\"10\",\"eas_standard\":\"EAS 1\",\"eas_paragraph\":\"10\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Complete set\",\"requirement_en\":\"A complete set of financial statements: statement of financial position, statement of profit or loss and OCI, statement of changes in equity, statement of cash flows, notes with material accounting policy information, and comparative information.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":1},{\"id\":\"DR-IAS1-16\",\"standard\":\"IAS 1\",\"paragraph\":\"16\",\"eas_standard\":\"EAS 1\",\"eas_paragraph\":\"16\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Compliance statement\",\"requirement_en\":\"An explicit and unreserved statement of compliance with the framework (IFRS / EAS) in the notes.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":2},{\"id\":\"DR-IAS1-25\",\"standard\":\"IAS 1\",\"paragraph\":\"25\",\"eas_standard\":\"EAS 1\",\"eas_paragraph\":\"25\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Going concern\",\"requirement_en\":\"Material uncertainties related to events or conditions that cast significant doubt on the ability to continue as a going concern, and the basis when the statements are not prepared on a going concern basis.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":3},{\"id\":\"DR-IAS1-38\",\"standard\":\"IAS 1\",\"paragraph\":\"38\",\"eas_standard\":\"EAS 1\",\"eas_paragraph\":\"38\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Comparative information\",\"requirement_en\":\"Comparative information for the preceding period for all amounts, and narrative comparatives where relevant.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":4},{\"id\":\"DR-IAS1-51\",\"standard\":\"IAS 1\",\"paragraph\":\"51\",\"eas_standard\":\"EAS 1\",\"eas_paragraph\":\"51\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Identification\",\"requirement_en\":\"Name of the entity, whether the statements are of an individual entity or a group, the reporting date or period, the presentation currency and the level of rounding.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":5},{\"id\":\"DR-IAS1-54\",\"standard\":\"IAS 1\",\"paragraph\":\"54\",\"eas_standard\":\"EAS 1\",\"eas_paragraph\":\"54\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Statement of financial position line items\",\"requirement_en\":\"The minimum line items of the statement of financial position (PPE, investment property, intangibles, financial assets, inventories, receivables, cash, payables, provisions, financial liabilities, tax, equity).\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":6},{\"id\":\"DR-IAS1-60\",\"standard\":\"IAS 1\",\"paragraph\":\"60\",\"eas_standard\":\"EAS 1\",\"eas_paragraph\":\"60\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Current/non-current distinction\",\"requirement_en\":\"Current and non-current assets and liabilities presented separately, or in order of liquidity when that is reliable and more relevant.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":7},{\"id\":\"DR-IAS1-82\",\"standard\":\"IAS 1\",\"paragraph\":\"82\",\"eas_standard\":\"EAS 1\",\"eas_paragraph\":\"82\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Statement of profit or loss line items\",\"requirement_en\":\"The minimum line items of profit or loss (revenue, finance costs, share of profit of associates, tax expense, discontinued operations) and of other comprehensive income by nature.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":8},{\"id\":\"DR-IAS1-97\",\"standard\":\"IAS 1\",\"paragraph\":\"97\",\"eas_standard\":\"EAS 1\",\"eas_paragraph\":\"97\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Material items\",\"requirement_en\":\"The nature and amount of material items of income and expense disclosed separately (write-downs, restructurings, disposals, litigation settlements).\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":9},{\"id\":\"DR-IAS1-106\",\"standard\":\"IAS 1\",\"paragraph\":\"106\",\"eas_standard\":\"EAS 1\",\"eas_paragraph\":\"106\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Statement of changes in equity\",\"requirement_en\":\"Total comprehensive income, effects of retrospective application or restatement, and a reconciliation of each component of equity.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":10},{\"id\":\"DR-IAS1-107\",\"standard\":\"IAS 1\",\"paragraph\":\"107\",\"eas_standard\":\"EAS 1\",\"eas_paragraph\":\"107\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Dividends\",\"requirement_en\":\"Dividends recognised as distributions to owners and the related amount per share.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-RE\",\"sort_order\":11},{\"id\":\"DR-IAS1-117\",\"standard\":\"IAS 1\",\"paragraph\":\"117\",\"eas_standard\":\"EAS 1\",\"eas_paragraph\":\"117\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Accounting policies\",\"requirement_en\":\"Material accounting policy information: the measurement bases and the policies relevant to understanding the statements.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":12},{\"id\":\"DR-IAS1-122\",\"standard\":\"IAS 1\",\"paragraph\":\"122\",\"eas_standard\":\"EAS 1\",\"eas_paragraph\":\"122\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Judgements\",\"requirement_en\":\"The judgements, apart from estimates, that management has made in applying the accounting policies with the most significant effect on the amounts recognised.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":13},{\"id\":\"DR-IAS1-125\",\"standard\":\"IAS 1\",\"paragraph\":\"125\",\"eas_standard\":\"EAS 1\",\"eas_paragraph\":\"125\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Estimation uncertainty\",\"requirement_en\":\"The assumptions and other major sources of estimation uncertainty with a significant risk of material adjustment within the next year: nature and carrying amounts.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":14},{\"id\":\"DR-IAS1-134\",\"standard\":\"IAS 1\",\"paragraph\":\"134\",\"eas_standard\":\"EAS 1\",\"eas_paragraph\":\"134\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Capital management\",\"requirement_en\":\"Objectives, policies and processes for managing capital, and externally imposed capital requirements.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":15},{\"id\":\"DR-IAS1-137\",\"standard\":\"IAS 1\",\"paragraph\":\"137\",\"eas_standard\":\"EAS 1\",\"eas_paragraph\":\"137\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Proposed dividends\",\"requirement_en\":\"Dividends proposed or declared before authorisation but not recognised, and cumulative preference dividends not recognised.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-RE\",\"sort_order\":16},{\"id\":\"DR-IAS1-138\",\"standard\":\"IAS 1\",\"paragraph\":\"138\",\"eas_standard\":\"EAS 1\",\"eas_paragraph\":\"138\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Entity information\",\"requirement_en\":\"Domicile, legal form, country of incorporation, registered office, nature of operations and principal activities, and the parent and ultimate parent.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":17},{\"id\":\"DR-IAS2-36\",\"standard\":\"IAS 2\",\"paragraph\":\"36\",\"eas_standard\":\"EAS 2\",\"eas_paragraph\":\"36\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Inventories\",\"requirement_en\":\"Accounting policies and cost formula; total carrying amount by classification; amount recognised as expense; write-downs and reversals with the circumstances; inventories pledged as security.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-INV\",\"sort_order\":18},{\"id\":\"DR-IAS7-10\",\"standard\":\"IAS 7\",\"paragraph\":\"10\",\"eas_standard\":\"EAS 4\",\"eas_paragraph\":\"10\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Cash flow classification\",\"requirement_en\":\"Cash flows classified by operating, investing and financing activities.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":19},{\"id\":\"DR-IAS7-31\",\"standard\":\"IAS 7\",\"paragraph\":\"31\",\"eas_standard\":\"EAS 4\",\"eas_paragraph\":\"31\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Interest and dividends\",\"requirement_en\":\"Cash flows from interest and dividends received and paid, each disclosed separately and classified consistently.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":20},{\"id\":\"DR-IAS7-35\",\"standard\":\"IAS 7\",\"paragraph\":\"35\",\"eas_standard\":\"EAS 4\",\"eas_paragraph\":\"35\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Taxes\",\"requirement_en\":\"Cash flows from income taxes disclosed separately within operating activities unless specifically identified with financing or investing.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-TAXEXP\",\"sort_order\":21},{\"id\":\"DR-IAS7-43\",\"standard\":\"IAS 7\",\"paragraph\":\"43\",\"eas_standard\":\"EAS 4\",\"eas_paragraph\":\"43\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Non-cash transactions\",\"requirement_en\":\"Investing and financing transactions that do not require cash, disclosed elsewhere so as to provide all relevant information.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":22},{\"id\":\"DR-IAS7-44A\",\"standard\":\"IAS 7\",\"paragraph\":\"44A\",\"eas_standard\":\"EAS 4\",\"eas_paragraph\":\"44A\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Changes in liabilities from financing\",\"requirement_en\":\"A reconciliation of liabilities arising from financing activities (cash flows, acquisitions, foreign exchange, fair value changes, other).\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-BORNC,LS-BORC,LS-LEASNC,LS-LEASC\",\"sort_order\":23},{\"id\":\"DR-IAS7-45\",\"standard\":\"IAS 7\",\"paragraph\":\"45\",\"eas_standard\":\"EAS 4\",\"eas_paragraph\":\"45\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Cash components\",\"requirement_en\":\"The components of cash and cash equivalents and a reconciliation to the statement of financial position.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-CASH\",\"sort_order\":24},{\"id\":\"DR-IAS7-48\",\"standard\":\"IAS 7\",\"paragraph\":\"48\",\"eas_standard\":\"EAS 4\",\"eas_paragraph\":\"48\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Restricted cash\",\"requirement_en\":\"Significant cash and cash equivalent balances not available for use by the group, with management commentary.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-CASH\",\"sort_order\":25},{\"id\":\"DR-IAS8-28\",\"standard\":\"IAS 8\",\"paragraph\":\"28\",\"eas_standard\":\"EAS 5\",\"eas_paragraph\":\"28\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"New standards applied\",\"requirement_en\":\"The nature of a change in accounting policy on initial application of a standard, the transitional provisions and the adjustment for each line item affected.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"event\",\"sort_order\":26},{\"id\":\"DR-IAS8-30\",\"standard\":\"IAS 8\",\"paragraph\":\"30\",\"eas_standard\":\"EAS 5\",\"eas_paragraph\":\"30\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Standards issued not yet effective\",\"requirement_en\":\"Standards issued but not yet effective: the fact, and known or reasonably estimable information about the possible impact.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":27},{\"id\":\"DR-IAS8-39\",\"standard\":\"IAS 8\",\"paragraph\":\"39\",\"eas_standard\":\"EAS 5\",\"eas_paragraph\":\"39\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Changes in estimates\",\"requirement_en\":\"The nature and amount of a change in an accounting estimate that affects the current period or is expected to affect future periods.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"event\",\"sort_order\":28},{\"id\":\"DR-IAS8-49\",\"standard\":\"IAS 8\",\"paragraph\":\"49\",\"eas_standard\":\"EAS 5\",\"eas_paragraph\":\"49\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Prior period errors\",\"requirement_en\":\"The nature of a prior period error, the correction for each line item and per share, and the amount at the beginning of the earliest period presented.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"event\",\"sort_order\":29},{\"id\":\"DR-IAS10-17\",\"standard\":\"IAS 10\",\"paragraph\":\"17\",\"eas_standard\":\"EAS 7\",\"eas_paragraph\":\"17\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Date of authorisation\",\"requirement_en\":\"The date the financial statements were authorised for issue and who gave that authorisation.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":30},{\"id\":\"DR-IAS10-21\",\"standard\":\"IAS 10\",\"paragraph\":\"21\",\"eas_standard\":\"EAS 7\",\"eas_paragraph\":\"21\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Non-adjusting events\",\"requirement_en\":\"For each material non-adjusting event after the reporting period: its nature and an estimate of its financial effect, or a statement that it cannot be made.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"event\",\"sort_order\":31},{\"id\":\"DR-IAS12-79\",\"standard\":\"IAS 12\",\"paragraph\":\"79\",\"eas_standard\":\"EAS 24\",\"eas_paragraph\":\"79\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Tax expense components\",\"requirement_en\":\"The major components of tax expense (income): current, deferred, changes in tax rates, previously unrecognised tax losses.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-TAXEXP\",\"sort_order\":32},{\"id\":\"DR-IAS12-81\",\"standard\":\"IAS 12\",\"paragraph\":\"81\",\"eas_standard\":\"EAS 24\",\"eas_paragraph\":\"81\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Tax reconciliation\",\"requirement_en\":\"A numerical reconciliation between tax expense and accounting profit at the applicable rate, the rate used, and each type of temporary difference and unused tax loss with the deferred tax recognised.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-TAXEXP,LS-DTA,LS-DTL\",\"sort_order\":33},{\"id\":\"DR-IAS16-73\",\"standard\":\"IAS 16\",\"paragraph\":\"73\",\"eas_standard\":\"EAS 10\",\"eas_paragraph\":\"73\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"PPE reconciliation\",\"requirement_en\":\"For each class of PPE: measurement bases, depreciation methods, useful lives or rates, gross carrying amount and accumulated depreciation at the beginning and end, and a reconciliation of the carrying amount (additions, disposals, depreciation, impairment, transfers).\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-PPE\",\"sort_order\":34},{\"id\":\"DR-IAS16-74\",\"standard\":\"IAS 16\",\"paragraph\":\"74\",\"eas_standard\":\"EAS 10\",\"eas_paragraph\":\"74\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"PPE restrictions and commitments\",\"requirement_en\":\"Restrictions on title and PPE pledged as security; expenditure on PPE in the course of construction; contractual commitments for the acquisition of PPE.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-PPE\",\"sort_order\":35},{\"id\":\"DR-IAS19-53\",\"standard\":\"IAS 19\",\"paragraph\":\"53\",\"eas_standard\":\"EAS 38\",\"eas_paragraph\":\"53\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Short-term and defined contribution\",\"requirement_en\":\"The expense recognised for defined contribution plans; short-term benefit policies where material.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-STAFF,LS-EBO\",\"sort_order\":36},{\"id\":\"DR-IAS19-135\",\"standard\":\"IAS 19\",\"paragraph\":\"135\",\"eas_standard\":\"EAS 38\",\"eas_paragraph\":\"135\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Defined benefit plans\",\"requirement_en\":\"For defined benefit plans: characteristics and risks, reconciliations of the obligation and plan assets, the actuarial assumptions and a sensitivity analysis.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-EBO\",\"sort_order\":37},{\"id\":\"DR-IAS21-52\",\"standard\":\"IAS 21\",\"paragraph\":\"52\",\"eas_standard\":\"EAS 13\",\"eas_paragraph\":\"52\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Exchange differences\",\"requirement_en\":\"The amount of exchange differences recognised in profit or loss (excluding those on financial instruments at fair value through profit or loss) and net exchange differences recognised in OCI.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":38},{\"id\":\"DR-IAS21-53\",\"standard\":\"IAS 21\",\"paragraph\":\"53\",\"eas_standard\":\"EAS 13\",\"eas_paragraph\":\"53\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Functional and presentation currency\",\"requirement_en\":\"The functional currency, the presentation currency when different, and the reason for a different presentation currency.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":39},{\"id\":\"DR-IAS23-26\",\"standard\":\"IAS 23\",\"paragraph\":\"26\",\"eas_standard\":\"EAS 14\",\"eas_paragraph\":\"26\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Borrowing costs capitalised\",\"requirement_en\":\"The amount of borrowing costs capitalised during the period and the capitalisation rate used.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-PPE,LS-BORNC,LS-BORC\",\"sort_order\":40},{\"id\":\"DR-IAS24-13\",\"standard\":\"IAS 24\",\"paragraph\":\"13\",\"eas_standard\":\"EAS 15\",\"eas_paragraph\":\"13\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Parent and controlling party\",\"requirement_en\":\"Relationships between a parent and its subsidiaries irrespective of transactions; the name of the parent and, if different, the ultimate controlling party.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":41},{\"id\":\"DR-IAS24-17\",\"standard\":\"IAS 24\",\"paragraph\":\"17\",\"eas_standard\":\"EAS 15\",\"eas_paragraph\":\"17\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Key management personnel compensation\",\"requirement_en\":\"Key management personnel compensation in total and for each category (short-term, post-employment, other long-term, termination, share-based).\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":42},{\"id\":\"DR-IAS24-18\",\"standard\":\"IAS 24\",\"paragraph\":\"18\",\"eas_standard\":\"EAS 15\",\"eas_paragraph\":\"18\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Related party transactions\",\"requirement_en\":\"For each category of related party: the nature of the relationship, the amount of transactions, outstanding balances and their terms, guarantees, provisions for doubtful debts and the expense recognised.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":43},{\"id\":\"DR-IAS36-126\",\"standard\":\"IAS 36\",\"paragraph\":\"126\",\"eas_standard\":\"EAS 31\",\"eas_paragraph\":\"126\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Impairment losses\",\"requirement_en\":\"Impairment losses and reversals recognised in profit or loss and in OCI by class of asset and the line items in which they are included.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-IMP\",\"sort_order\":44},{\"id\":\"DR-IAS36-130\",\"standard\":\"IAS 36\",\"paragraph\":\"130\",\"eas_standard\":\"EAS 31\",\"eas_paragraph\":\"130\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Material impairment\",\"requirement_en\":\"For each material impairment loss or reversal: the events and circumstances, the amount, the nature of the asset or cash-generating unit, and whether the recoverable amount is fair value less costs of disposal or value in use, with the basis.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-IMP\",\"sort_order\":45},{\"id\":\"DR-IAS36-134\",\"standard\":\"IAS 36\",\"paragraph\":\"134\",\"eas_standard\":\"EAS 31\",\"eas_paragraph\":\"134\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Goodwill and indefinite-life intangibles\",\"requirement_en\":\"For each cash-generating unit with significant goodwill or indefinite-life intangibles: the carrying amounts, the basis of the recoverable amount, the key assumptions and the sensitivity to a reasonably possible change.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-INTG\",\"sort_order\":46},{\"id\":\"DR-IAS37-84\",\"standard\":\"IAS 37\",\"paragraph\":\"84\",\"eas_standard\":\"EAS 28\",\"eas_paragraph\":\"84\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Provisions\",\"requirement_en\":\"For each class of provision: a reconciliation of the carrying amount (additions, amounts used, unused amounts reversed, unwinding of discount).\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-PROVNC,LS-PROVC\",\"sort_order\":47},{\"id\":\"DR-IAS37-85\",\"standard\":\"IAS 37\",\"paragraph\":\"85\",\"eas_standard\":\"EAS 28\",\"eas_paragraph\":\"85\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Nature of provisions\",\"requirement_en\":\"For each class of provision: a brief description of the nature, the expected timing of outflows, uncertainties about amount or timing, and any expected reimbursement.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-PROVNC,LS-PROVC\",\"sort_order\":48},{\"id\":\"DR-IAS37-86\",\"standard\":\"IAS 37\",\"paragraph\":\"86\",\"eas_standard\":\"EAS 28\",\"eas_paragraph\":\"86\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Contingent liabilities\",\"requirement_en\":\"For each class of contingent liability: a brief description, an estimate of the financial effect, the uncertainties, and the possibility of reimbursement, unless the possibility of outflow is remote.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":49},{\"id\":\"DR-IAS38-118\",\"standard\":\"IAS 38\",\"paragraph\":\"118\",\"eas_standard\":\"EAS 23\",\"eas_paragraph\":\"118\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Intangible assets\",\"requirement_en\":\"For each class of intangible asset: finite or indefinite lives, amortisation methods, gross carrying amount and accumulated amortisation, the line items in which amortisation is included, and a reconciliation of the carrying amount.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-INTG\",\"sort_order\":50},{\"id\":\"DR-IAS38-126\",\"standard\":\"IAS 38\",\"paragraph\":\"126\",\"eas_standard\":\"EAS 23\",\"eas_paragraph\":\"126\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Research and development\",\"requirement_en\":\"The aggregate research and development expenditure recognised as an expense in the period.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-INTG,LS-OPEX\",\"sort_order\":51},{\"id\":\"DR-IAS40-75\",\"standard\":\"IAS 40\",\"paragraph\":\"75\",\"eas_standard\":\"EAS 34\",\"eas_paragraph\":\"75\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Investment property\",\"requirement_en\":\"Whether the fair value or cost model is applied; the criteria distinguishing investment property; the methods and assumptions for fair value; rental income and direct operating expenses; restrictions and obligations.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-INVP\",\"sort_order\":52},{\"id\":\"DR-IFRS7-7\",\"standard\":\"IFRS 7\",\"paragraph\":\"7\",\"eas_standard\":\"EAS 40\",\"eas_paragraph\":\"7\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Significance of financial instruments\",\"requirement_en\":\"Information that enables users to evaluate the significance of financial instruments for financial position and performance.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":53},{\"id\":\"DR-IFRS7-8\",\"standard\":\"IFRS 7\",\"paragraph\":\"8\",\"eas_standard\":\"EAS 40\",\"eas_paragraph\":\"8\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Categories\",\"requirement_en\":\"Carrying amounts of each category of financial assets and liabilities (amortised cost, FVTPL, FVOCI) in the statement of financial position or the notes.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":54},{\"id\":\"DR-IFRS7-20\",\"standard\":\"IFRS 7\",\"paragraph\":\"20\",\"eas_standard\":\"EAS 40\",\"eas_paragraph\":\"20\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Items of income, expense, gains and losses\",\"requirement_en\":\"Net gains or losses by category, total interest income and expense, fee income and expense, and impairment losses by class.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":55},{\"id\":\"DR-IFRS7-33\",\"standard\":\"IFRS 7\",\"paragraph\":\"33\",\"eas_standard\":\"EAS 40\",\"eas_paragraph\":\"33\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Nature and extent of risks — qualitative\",\"requirement_en\":\"For each type of risk arising from financial instruments: the exposures and how they arise, the objectives, policies and processes for managing the risk, and changes from the prior period.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":56},{\"id\":\"DR-IFRS7-35B\",\"standard\":\"IFRS 7\",\"paragraph\":\"35B\",\"eas_standard\":\"EAS 40\",\"eas_paragraph\":\"35B\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Credit risk\",\"requirement_en\":\"Credit risk management practices and how they relate to the recognition and measurement of expected credit losses; a reconciliation of the loss allowance by class; the credit risk exposure and collateral.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-REC,LS-OFA,LS-RECNC\",\"sort_order\":57},{\"id\":\"DR-IFRS7-39\",\"standard\":\"IFRS 7\",\"paragraph\":\"39\",\"eas_standard\":\"EAS 40\",\"eas_paragraph\":\"39\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Liquidity risk\",\"requirement_en\":\"A maturity analysis of financial liabilities showing the remaining contractual maturities, and how the liquidity risk is managed.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-AP,LS-BORNC,LS-BORC,LS-LEASNC,LS-LEASC\",\"sort_order\":58},{\"id\":\"DR-IFRS7-40\",\"standard\":\"IFRS 7\",\"paragraph\":\"40\",\"eas_standard\":\"EAS 40\",\"eas_paragraph\":\"40\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Market risk sensitivity\",\"requirement_en\":\"A sensitivity analysis for each type of market risk (currency, interest rate, other price) with the methods and assumptions used, and changes from the prior period.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":59},{\"id\":\"DR-IFRS7-42\",\"standard\":\"IFRS 7\",\"paragraph\":\"42\",\"eas_standard\":\"EAS 40\",\"eas_paragraph\":\"42\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Transfers\",\"requirement_en\":\"Transferred financial assets that are not derecognised in their entirety, and continuing involvement in derecognised assets.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"event\",\"sort_order\":60},{\"id\":\"DR-IFRS9-7.2\",\"standard\":\"IFRS 9\",\"paragraph\":\"7.2\",\"eas_standard\":\"EAS 47\",\"eas_paragraph\":\"7.2\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Transition and classification policies\",\"requirement_en\":\"The accounting policies for classification and measurement of financial instruments and for expected credit losses, including the definitions of default and of significant increase in credit risk.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"always\",\"sort_order\":61},{\"id\":\"DR-IFRS13-91\",\"standard\":\"IFRS 13\",\"paragraph\":\"91\",\"eas_standard\":\"EAS 45\",\"eas_paragraph\":\"91\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Fair value measurements\",\"requirement_en\":\"For assets and liabilities measured at fair value after initial recognition: the valuation techniques and inputs, and for recurring Level 3 measurements the effect on profit or loss or OCI.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"event\",\"sort_order\":62},{\"id\":\"DR-IFRS13-93\",\"standard\":\"IFRS 13\",\"paragraph\":\"93\",\"eas_standard\":\"EAS 45\",\"eas_paragraph\":\"93\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Fair value hierarchy\",\"requirement_en\":\"The level of the fair value hierarchy for each class, transfers between Level 1 and 2, and for Level 3 a reconciliation, a description of the valuation process and a sensitivity to unobservable inputs.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"event\",\"sort_order\":63},{\"id\":\"DR-IFRS13-97\",\"standard\":\"IFRS 13\",\"paragraph\":\"97\",\"eas_standard\":\"EAS 45\",\"eas_paragraph\":\"97\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Fair value disclosed but not measured\",\"requirement_en\":\"For assets and liabilities not measured at fair value but for which fair value is disclosed: the level of the hierarchy, the valuation techniques and the inputs.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-BORNC,LS-BORC\",\"sort_order\":64},{\"id\":\"DR-IFRS15-113\",\"standard\":\"IFRS 15\",\"paragraph\":\"113\",\"eas_standard\":\"EAS 48\",\"eas_paragraph\":\"113\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Contracts with customers\",\"requirement_en\":\"Revenue recognised from contracts with customers disclosed separately, and impairment losses on receivables or contract assets from those contracts.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-REV\",\"sort_order\":65},{\"id\":\"DR-IFRS15-114\",\"standard\":\"IFRS 15\",\"paragraph\":\"114\",\"eas_standard\":\"EAS 48\",\"eas_paragraph\":\"114\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Disaggregation of revenue\",\"requirement_en\":\"Revenue disaggregated into categories that depict how the nature, amount, timing and uncertainty of revenue and cash flows are affected by economic factors.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-REV\",\"sort_order\":66},{\"id\":\"DR-IFRS15-116\",\"standard\":\"IFRS 15\",\"paragraph\":\"116\",\"eas_standard\":\"EAS 48\",\"eas_paragraph\":\"116\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Contract balances\",\"requirement_en\":\"Opening and closing balances of receivables, contract assets and contract liabilities; revenue recognised from opening contract liabilities; significant changes in contract balances.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-CTRA,LS-CTRL\",\"sort_order\":67},{\"id\":\"DR-IFRS15-119\",\"standard\":\"IFRS 15\",\"paragraph\":\"119\",\"eas_standard\":\"EAS 48\",\"eas_paragraph\":\"119\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Performance obligations\",\"requirement_en\":\"When performance obligations are typically satisfied, significant payment terms, the nature of goods or services, obligations for returns and refunds, and warranties.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-REV\",\"sort_order\":68},{\"id\":\"DR-IFRS15-120\",\"standard\":\"IFRS 15\",\"paragraph\":\"120\",\"eas_standard\":\"EAS 48\",\"eas_paragraph\":\"120\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Remaining performance obligations\",\"requirement_en\":\"The transaction price allocated to unsatisfied performance obligations and when it is expected to be recognised, or the practical expedient relied upon.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-CTRL\",\"sort_order\":69},{\"id\":\"DR-IFRS15-123\",\"standard\":\"IFRS 15\",\"paragraph\":\"123\",\"eas_standard\":\"EAS 48\",\"eas_paragraph\":\"123\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Significant judgements\",\"requirement_en\":\"Judgements in determining the timing of satisfaction of performance obligations, the transaction price and its allocation.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-REV\",\"sort_order\":70},{\"id\":\"DR-IFRS16-47\",\"standard\":\"IFRS 16\",\"paragraph\":\"47\",\"eas_standard\":\"EAS 49\",\"eas_paragraph\":\"47\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Lessee presentation\",\"requirement_en\":\"Right-of-use assets and lease liabilities presented separately or disclosed by line item; interest and depreciation presented separately.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-ROU,LS-LEASNC,LS-LEASC\",\"sort_order\":71},{\"id\":\"DR-IFRS16-53\",\"standard\":\"IFRS 16\",\"paragraph\":\"53\",\"eas_standard\":\"EAS 49\",\"eas_paragraph\":\"53\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Lessee disclosures\",\"requirement_en\":\"Depreciation of right-of-use assets by class, interest on lease liabilities, short-term and low-value lease expense, variable lease payments, sublease income, total cash outflow for leases, additions to right-of-use assets, and carrying amounts by class.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-ROU,LS-LEASNC,LS-LEASC\",\"sort_order\":72},{\"id\":\"DR-IFRS16-58\",\"standard\":\"IFRS 16\",\"paragraph\":\"58\",\"eas_standard\":\"EAS 49\",\"eas_paragraph\":\"58\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Lease maturity analysis\",\"requirement_en\":\"A maturity analysis of lease liabilities applying IFRS 7.39 and B11, separately from other financial liabilities.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-LEASNC,LS-LEASC\",\"sort_order\":73},{\"id\":\"DR-IFRS16-59\",\"standard\":\"IFRS 16\",\"paragraph\":\"59\",\"eas_standard\":\"EAS 49\",\"eas_paragraph\":\"59\",\"eas_paragraph_status\":\"mirrors_ifrs_numbering_pending_check\",\"topic\":\"Lessee additional information\",\"requirement_en\":\"Qualitative and quantitative information about leasing activities: nature, future cash outflows not reflected in lease liabilities (variable payments, extension and termination options, residual value guarantees, leases not yet commenced), restrictions or covenants, and sale-and-leaseback.\",\"requirement_ar\":null,\"requirement_ar_status\":\"pending_draft\",\"trigger\":\"LS-ROU,LS-LEASNC,LS-LEASC\",\"sort_order\":74}]"),
    ("evidence_grades", 2, "[{\"id\":\"representation\",\"name\":\"Completeness by representation and reconciliation\",\"description\":\"Population completeness rests on the entity's records: a reconciliation of the population to the trial balance and the written representation that all transactions have been recorded.\",\"requirement_id\":\"ISA-500.9\"},{\"id\":\"cryptographic\",\"name\":\"Completeness by verified inclusion\",\"description\":\"Every line carries an inclusion proof verified against a published ledger root, so completeness is a property the auditor verifies rather than one management represents; the representation is still obtained but is corroborated.\",\"requirement_id\":\"ISA-580.11\"}]"),
    ("evidence_item_kinds", 12, "[{\"id\":\"EK-CONFIRMATION-REPLY\",\"term_id\":\"T-EK-CONFIRMATION-REPLY\",\"name\":\"Confirmation reply received directly\",\"reliability\":\"external_direct\",\"reproducible\":0,\"description\":\"A written reply from a third party received directly by the auditor (bank, customer, lawyer, custodian).\",\"sort_order\":1},{\"id\":\"EK-EXTERNAL-DOCUMENT\",\"term_id\":\"T-EK-EXTERNAL-DOCUMENT\",\"name\":\"External document held by the entity\",\"reliability\":\"external_via_entity\",\"reproducible\":0,\"description\":\"A document originated outside the entity but obtained from it (supplier invoice, bank statement, contract).\",\"sort_order\":2},{\"id\":\"EK-ENTITY-REPORT\",\"term_id\":\"T-EK-ENTITY-REPORT\",\"name\":\"Report or listing produced by the entity\",\"reliability\":\"entity_produced\",\"reproducible\":0,\"description\":\"Information produced by the entity's system whose accuracy and completeness must be evidenced before reliance (ISA 500.9).\",\"sort_order\":3},{\"id\":\"EK-INSPECTION\",\"term_id\":\"T-EK-INSPECTION\",\"name\":\"Inspection record\",\"reliability\":\"auditor_produced\",\"reproducible\":0,\"description\":\"The auditor's record of inspecting a document, record or asset.\",\"sort_order\":4},{\"id\":\"EK-OBSERVATION\",\"term_id\":\"T-EK-OBSERVATION\",\"name\":\"Observation record\",\"reliability\":\"auditor_produced\",\"reproducible\":0,\"description\":\"The auditor's record of observing a process or procedure being performed.\",\"sort_order\":5},{\"id\":\"EK-INQUIRY\",\"term_id\":\"T-EK-INQUIRY\",\"name\":\"Inquiry record\",\"reliability\":\"auditor_produced\",\"reproducible\":0,\"description\":\"The auditor's record of inquiries made and responses received.\",\"sort_order\":6},{\"id\":\"EK-RECALCULATION\",\"term_id\":\"T-EK-RECALCULATION\",\"name\":\"Recalculation or reperformance\",\"reliability\":\"auditor_produced\",\"reproducible\":1,\"description\":\"The auditor's independent recalculation or reperformance; reproducible from its inputs.\",\"sort_order\":7},{\"id\":\"EK-ANALYTICAL\",\"term_id\":\"T-EK-ANALYTICAL\",\"name\":\"Analytical procedure output\",\"reliability\":\"auditor_produced\",\"reproducible\":1,\"description\":\"Expectation, difference and threshold produced by a stated model from stated data; reproducible.\",\"sort_order\":8},{\"id\":\"EK-SNIP\",\"term_id\":\"T-EK-SNIP\",\"name\":\"Source-document extract (snip)\",\"reliability\":\"entity_produced\",\"reproducible\":0,\"description\":\"A region of a source document captured and cross-referenced to the working paper; evidence quality is that of the source.\",\"sort_order\":9},{\"id\":\"EK-AUTOMATED-TOOL\",\"term_id\":\"T-EK-AUTOMATED-TOOL\",\"name\":\"Output of an automated tool or technique\",\"reliability\":\"automated_tool\",\"reproducible\":0,\"description\":\"Information produced by software applied to a population (a ranking, a match, a screen); the record must state whether the output is reproducible from its inputs and, where a model is used, that it is not, so the evidence is weighed accordingly (ISA 500.A4–A5).\",\"sort_order\":10},{\"id\":\"EK-DETERMINISTIC-COMPUTATION\",\"term_id\":\"T-EK-DETERMINISTIC-COMPUTATION\",\"name\":\"Output of a deterministic computation\",\"reliability\":\"automated_tool\",\"reproducible\":1,\"description\":\"Output of one of the computations in this repository or another pure function with published vectors; reproducible by construction.\",\"sort_order\":11},{\"id\":\"EK-LEDGER-PROOF\",\"term_id\":\"T-EK-LEDGER-PROOF\",\"name\":\"Ledger inclusion proof\",\"reliability\":\"external_direct\",\"reproducible\":1,\"description\":\"A Merkle inclusion proof for a ledger entry verified against a published root and certificate; population completeness as a verified property rather than a representation.\",\"sort_order\":12}]"),
    ("leadsheets", 46, "[{\"id\":\"LS-PPE\",\"name\":\"Property, plant and equipment\",\"statement\":\"position\",\"class\":\"non_current_asset\",\"cycle_id\":\"PPE\",\"normal_balance\":\"debit\",\"sort_order\":1,\"description\":\"Land, buildings, plant, machinery, vehicles, fixtures and their accumulated depreciation and impairment.\",\"term_id\":\"T-LS-PPE\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-INVP\",\"name\":\"Investment property\",\"statement\":\"position\",\"class\":\"non_current_asset\",\"cycle_id\":\"PPE\",\"normal_balance\":\"debit\",\"sort_order\":2,\"description\":\"Property held to earn rentals or for capital appreciation, at cost or fair value.\",\"term_id\":\"T-LS-INVP\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-INTG\",\"name\":\"Intangible assets and goodwill\",\"statement\":\"position\",\"class\":\"non_current_asset\",\"cycle_id\":\"PPE\",\"normal_balance\":\"debit\",\"sort_order\":3,\"description\":\"Goodwill, software, licences, development costs, brands, and their accumulated amortisation and impairment.\",\"term_id\":\"T-LS-INTG\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-ROU\",\"name\":\"Right-of-use assets\",\"statement\":\"position\",\"class\":\"non_current_asset\",\"cycle_id\":\"PPE\",\"normal_balance\":\"debit\",\"sort_order\":4,\"description\":\"Lessee right-of-use assets and their depreciation.\",\"term_id\":\"T-LS-ROU\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-INVS\",\"name\":\"Investments\",\"statement\":\"position\",\"class\":\"non_current_asset\",\"cycle_id\":\"TRE\",\"normal_balance\":\"debit\",\"sort_order\":5,\"description\":\"Subsidiaries, associates, joint ventures and other long-term investments.\",\"term_id\":\"T-LS-INVS\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-RECNC\",\"name\":\"Non-current receivables\",\"statement\":\"position\",\"class\":\"non_current_asset\",\"cycle_id\":\"REV\",\"normal_balance\":\"debit\",\"sort_order\":6,\"description\":\"Long-term trade and other receivables, long-term loans to related parties.\",\"term_id\":\"T-LS-RECNC\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-DTA\",\"name\":\"Deferred tax assets\",\"statement\":\"position\",\"class\":\"non_current_asset\",\"cycle_id\":\"TAX\",\"normal_balance\":\"debit\",\"sort_order\":7,\"description\":\"Deferred tax assets on deductible temporary differences and unused losses.\",\"term_id\":\"T-LS-DTA\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-ONCA\",\"name\":\"Other non-current assets\",\"statement\":\"position\",\"class\":\"non_current_asset\",\"cycle_id\":\"FSL\",\"normal_balance\":\"debit\",\"sort_order\":8,\"description\":\"Assets held for sale, long-term deposits and other non-current assets not carried elsewhere.\",\"term_id\":\"T-LS-ONCA\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-INV\",\"name\":\"Inventories\",\"statement\":\"position\",\"class\":\"current_asset\",\"cycle_id\":\"INV\",\"normal_balance\":\"debit\",\"sort_order\":9,\"description\":\"Raw materials, work in progress, finished goods, goods in transit and the write-down to net realisable value.\",\"term_id\":\"T-LS-INV\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-REC\",\"name\":\"Trade and other receivables\",\"statement\":\"position\",\"class\":\"current_asset\",\"cycle_id\":\"REV\",\"normal_balance\":\"debit\",\"sort_order\":10,\"description\":\"Trade receivables, the allowance for expected credit losses, and other current receivables.\",\"term_id\":\"T-LS-REC\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-CTRA\",\"name\":\"Contract assets and accrued income\",\"statement\":\"position\",\"class\":\"current_asset\",\"cycle_id\":\"REV\",\"normal_balance\":\"debit\",\"sort_order\":11,\"description\":\"Unbilled revenue recognised over time, accrued income.\",\"term_id\":\"T-LS-CTRA\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-PREP\",\"name\":\"Prepayments\",\"statement\":\"position\",\"class\":\"current_asset\",\"cycle_id\":\"PUR\",\"normal_balance\":\"debit\",\"sort_order\":12,\"description\":\"Prepaid expenses and advances to suppliers.\",\"term_id\":\"T-LS-PREP\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-OFA\",\"name\":\"Other current financial assets\",\"statement\":\"position\",\"class\":\"current_asset\",\"cycle_id\":\"TRE\",\"normal_balance\":\"debit\",\"sort_order\":13,\"description\":\"Short-term investments, derivatives held as assets, restricted deposits.\",\"term_id\":\"T-LS-OFA\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-TAXA\",\"name\":\"Current tax assets\",\"statement\":\"position\",\"class\":\"current_asset\",\"cycle_id\":\"TAX\",\"normal_balance\":\"debit\",\"sort_order\":14,\"description\":\"Income tax recoverable, withholding tax credits, VAT recoverable.\",\"term_id\":\"T-LS-TAXA\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-CASH\",\"name\":\"Cash and cash equivalents\",\"statement\":\"position\",\"class\":\"current_asset\",\"cycle_id\":\"TRE\",\"normal_balance\":\"debit\",\"sort_order\":15,\"description\":\"Cash on hand, bank current and call accounts, short-term deposits with original maturity of three months or less, bank overdrafts where offset is permitted.\",\"term_id\":\"T-LS-CASH\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-SCAP\",\"name\":\"Share capital and premium\",\"statement\":\"position\",\"class\":\"equity\",\"cycle_id\":\"EQY\",\"normal_balance\":\"credit\",\"sort_order\":16,\"description\":\"Issued share capital, share premium and treasury shares.\",\"term_id\":\"T-LS-SCAP\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-RES\",\"name\":\"Reserves\",\"statement\":\"position\",\"class\":\"equity\",\"cycle_id\":\"EQY\",\"normal_balance\":\"credit\",\"sort_order\":17,\"description\":\"Legal reserve, revaluation reserve, fair value reserve, translation reserve and other reserves.\",\"term_id\":\"T-LS-RES\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-RE\",\"name\":\"Retained earnings\",\"statement\":\"position\",\"class\":\"equity\",\"cycle_id\":\"EQY\",\"normal_balance\":\"credit\",\"sort_order\":18,\"description\":\"Accumulated profits and losses, dividends declared.\",\"term_id\":\"T-LS-RE\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-NCI\",\"name\":\"Non-controlling interests\",\"statement\":\"position\",\"class\":\"equity\",\"cycle_id\":\"EQY\",\"normal_balance\":\"credit\",\"sort_order\":19,\"description\":\"Equity in subsidiaries not attributable to the parent.\",\"term_id\":\"T-LS-NCI\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-OEQ\",\"name\":\"Other equity\",\"statement\":\"position\",\"class\":\"equity\",\"cycle_id\":\"EQY\",\"normal_balance\":\"credit\",\"sort_order\":20,\"description\":\"Other components of equity, including accumulated other comprehensive income not carried in a named reserve.\",\"term_id\":\"T-LS-OEQ\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-BORNC\",\"name\":\"Borrowings (non-current)\",\"statement\":\"position\",\"class\":\"non_current_liability\",\"cycle_id\":\"TRE\",\"normal_balance\":\"credit\",\"sort_order\":21,\"description\":\"Bank loans, bonds and other borrowings due after more than twelve months.\",\"term_id\":\"T-LS-BORNC\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-LEASNC\",\"name\":\"Lease liabilities (non-current)\",\"statement\":\"position\",\"class\":\"non_current_liability\",\"cycle_id\":\"TRE\",\"normal_balance\":\"credit\",\"sort_order\":22,\"description\":\"Lease liabilities due after more than twelve months.\",\"term_id\":\"T-LS-LEASNC\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-DTL\",\"name\":\"Deferred tax liabilities\",\"statement\":\"position\",\"class\":\"non_current_liability\",\"cycle_id\":\"TAX\",\"normal_balance\":\"credit\",\"sort_order\":23,\"description\":\"Deferred tax on taxable temporary differences.\",\"term_id\":\"T-LS-DTL\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-PROVNC\",\"name\":\"Provisions (non-current)\",\"statement\":\"position\",\"class\":\"non_current_liability\",\"cycle_id\":\"PUR\",\"normal_balance\":\"credit\",\"sort_order\":24,\"description\":\"Long-term provisions: decommissioning, restructuring, legal claims, warranties beyond twelve months.\",\"term_id\":\"T-LS-PROVNC\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-EBO\",\"name\":\"Employee benefit obligations\",\"statement\":\"position\",\"class\":\"non_current_liability\",\"cycle_id\":\"PAY\",\"normal_balance\":\"credit\",\"sort_order\":25,\"description\":\"Defined benefit obligations, end-of-service benefits, long-service awards.\",\"term_id\":\"T-LS-EBO\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-ONCL\",\"name\":\"Other non-current liabilities\",\"statement\":\"position\",\"class\":\"non_current_liability\",\"cycle_id\":\"PUR\",\"normal_balance\":\"credit\",\"sort_order\":26,\"description\":\"Long-term payables, deferred income and government grants, other non-current liabilities.\",\"term_id\":\"T-LS-ONCL\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-BORC\",\"name\":\"Borrowings (current)\",\"statement\":\"position\",\"class\":\"current_liability\",\"cycle_id\":\"TRE\",\"normal_balance\":\"credit\",\"sort_order\":27,\"description\":\"Bank overdrafts, short-term loans and the current portion of long-term borrowings.\",\"term_id\":\"T-LS-BORC\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-LEASC\",\"name\":\"Lease liabilities (current)\",\"statement\":\"position\",\"class\":\"current_liability\",\"cycle_id\":\"TRE\",\"normal_balance\":\"credit\",\"sort_order\":28,\"description\":\"Lease liabilities due within twelve months.\",\"term_id\":\"T-LS-LEASC\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-AP\",\"name\":\"Trade payables\",\"statement\":\"position\",\"class\":\"current_liability\",\"cycle_id\":\"PUR\",\"normal_balance\":\"credit\",\"sort_order\":29,\"description\":\"Amounts owed to suppliers for goods and services received.\",\"term_id\":\"T-LS-AP\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-ACCR\",\"name\":\"Accruals and other payables\",\"statement\":\"position\",\"class\":\"current_liability\",\"cycle_id\":\"PUR\",\"normal_balance\":\"credit\",\"sort_order\":30,\"description\":\"Accrued expenses, other creditors, related-party payables, dividends payable.\",\"term_id\":\"T-LS-ACCR\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-CTRL\",\"name\":\"Contract liabilities and deferred revenue\",\"statement\":\"position\",\"class\":\"current_liability\",\"cycle_id\":\"REV\",\"normal_balance\":\"credit\",\"sort_order\":31,\"description\":\"Customer advances and revenue billed but not yet recognised.\",\"term_id\":\"T-LS-CTRL\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-PAYL\",\"name\":\"Payroll liabilities\",\"statement\":\"position\",\"class\":\"current_liability\",\"cycle_id\":\"PAY\",\"normal_balance\":\"credit\",\"sort_order\":32,\"description\":\"Wages payable, social insurance and payroll tax payable, bonus accruals, leave accruals.\",\"term_id\":\"T-LS-PAYL\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-TAXL\",\"name\":\"Current tax liabilities\",\"statement\":\"position\",\"class\":\"current_liability\",\"cycle_id\":\"TAX\",\"normal_balance\":\"credit\",\"sort_order\":33,\"description\":\"Income tax payable and withholding tax payable.\",\"term_id\":\"T-LS-TAXL\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-VAT\",\"name\":\"VAT and other indirect taxes\",\"statement\":\"position\",\"class\":\"current_liability\",\"cycle_id\":\"TAX\",\"normal_balance\":\"credit\",\"sort_order\":34,\"description\":\"Value added tax, sales tax and other indirect tax liabilities, net where offset is permitted.\",\"term_id\":\"T-LS-VAT\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-PROVC\",\"name\":\"Provisions (current)\",\"statement\":\"position\",\"class\":\"current_liability\",\"cycle_id\":\"PUR\",\"normal_balance\":\"credit\",\"sort_order\":35,\"description\":\"Short-term provisions: warranties, legal claims, onerous contracts, restructuring due within twelve months.\",\"term_id\":\"T-LS-PROVC\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-REV\",\"name\":\"Revenue\",\"statement\":\"performance\",\"class\":\"income\",\"cycle_id\":\"REV\",\"normal_balance\":\"credit\",\"sort_order\":36,\"description\":\"Revenue from contracts with customers, gross of discounts and returns presented as contra-revenue.\",\"term_id\":\"T-LS-REV\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-OINC\",\"name\":\"Other income\",\"statement\":\"performance\",\"class\":\"income\",\"cycle_id\":\"FSL\",\"normal_balance\":\"credit\",\"sort_order\":37,\"description\":\"Gains on disposal, grant income, rental income, share of profit of associates, other operating income.\",\"term_id\":\"T-LS-OINC\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-FININC\",\"name\":\"Finance income\",\"statement\":\"performance\",\"class\":\"income\",\"cycle_id\":\"TRE\",\"normal_balance\":\"credit\",\"sort_order\":38,\"description\":\"Interest income, dividend income, fair value gains on financial instruments, foreign exchange gains on financing.\",\"term_id\":\"T-LS-FININC\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-COS\",\"name\":\"Cost of sales\",\"statement\":\"performance\",\"class\":\"expense\",\"cycle_id\":\"INV\",\"normal_balance\":\"debit\",\"sort_order\":39,\"description\":\"Cost of goods sold and direct cost of services, including inventory write-downs.\",\"term_id\":\"T-LS-COS\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-OPEX\",\"name\":\"Operating expenses\",\"statement\":\"performance\",\"class\":\"expense\",\"cycle_id\":\"PUR\",\"normal_balance\":\"debit\",\"sort_order\":40,\"description\":\"Distribution and administrative expenses other than staff costs, depreciation and amortisation.\",\"term_id\":\"T-LS-OPEX\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-STAFF\",\"name\":\"Staff costs\",\"statement\":\"performance\",\"class\":\"expense\",\"cycle_id\":\"PAY\",\"normal_balance\":\"debit\",\"sort_order\":41,\"description\":\"Wages, salaries, bonuses, social insurance, pension and other employee benefit expense.\",\"term_id\":\"T-LS-STAFF\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-DEPR\",\"name\":\"Depreciation and amortisation\",\"statement\":\"performance\",\"class\":\"expense\",\"cycle_id\":\"PPE\",\"normal_balance\":\"debit\",\"sort_order\":42,\"description\":\"Depreciation of property, plant and equipment and right-of-use assets; amortisation of intangibles.\",\"term_id\":\"T-LS-DEPR\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-IMP\",\"name\":\"Impairment losses\",\"statement\":\"performance\",\"class\":\"expense\",\"cycle_id\":\"PPE\",\"normal_balance\":\"debit\",\"sort_order\":43,\"description\":\"Impairment of non-financial assets and goodwill; expected credit loss expense is presented here where the framework requires a separate line.\",\"term_id\":\"T-LS-IMP\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-OEXP\",\"name\":\"Other expenses\",\"statement\":\"performance\",\"class\":\"expense\",\"cycle_id\":\"FSL\",\"normal_balance\":\"debit\",\"sort_order\":44,\"description\":\"Losses on disposal, exceptional items, donations and other operating expenses not classified elsewhere.\",\"term_id\":\"T-LS-OEXP\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-FINC\",\"name\":\"Finance costs\",\"statement\":\"performance\",\"class\":\"expense\",\"cycle_id\":\"TRE\",\"normal_balance\":\"debit\",\"sort_order\":45,\"description\":\"Interest expense, lease interest, unwinding of discounts, fair value losses, foreign exchange losses on financing.\",\"term_id\":\"T-LS-FINC\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"LS-TAXEXP\",\"name\":\"Income tax expense\",\"statement\":\"performance\",\"class\":\"expense\",\"cycle_id\":\"TAX\",\"normal_balance\":\"debit\",\"sort_order\":46,\"description\":\"Current and deferred income tax expense or credit.\",\"term_id\":\"T-LS-TAXEXP\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"}]"),
    ("movement_schedules", 8, "[{\"id\":\"SCH-PPE\",\"term_id\":\"T-SCH-PPE\",\"name\":\"Property, plant and equipment\",\"leadsheet_id\":\"LS-PPE\",\"form_id\":\"F35-PPE-INTANGIBLES\",\"standard_id\":\"ISA-500\",\"paragraphs\":\"IAS 16.73(e)\",\"components\":\"[{\\\"id\\\": \\\"cost\\\", \\\"name\\\": \\\"Cost\\\", \\\"name_ar\\\": \\\"التكلفة\\\", \\\"contra\\\": 0}, {\\\"id\\\": \\\"accumulated_depreciation\\\", \\\"name\\\": \\\"Accumulated depreciation and impairment\\\", \\\"name_ar\\\": \\\"مجمع الإهلاك والاضمحلال\\\", \\\"contra\\\": 1}]\",\"labels\":\"{\\\"additions\\\": {\\\"en\\\": \\\"Additions\\\", \\\"ar\\\": \\\"الإضافات\\\"}, \\\"disposals\\\": {\\\"en\\\": \\\"Disposals\\\", \\\"ar\\\": \\\"الاستبعادات\\\"}, \\\"transfers\\\": {\\\"en\\\": \\\"Transfers and reclassifications\\\", \\\"ar\\\": \\\"التحويلات وإعادة التبويب\\\"}, \\\"revaluation\\\": {\\\"en\\\": \\\"Revaluation\\\", \\\"ar\\\": \\\"إعادة التقييم\\\"}, \\\"other\\\": {\\\"en\\\": \\\"Depreciation charge and impairment\\\", \\\"ar\\\": \\\"عبء الإهلاك والاضمحلال\\\"}}\",\"description\":\"Cost and accumulated depreciation reconciled from the opening to the closing carrying amount.\",\"sort_order\":1},{\"id\":\"SCH-INTG\",\"term_id\":\"T-SCH-INTG\",\"name\":\"Intangible assets\",\"leadsheet_id\":\"LS-INTG\",\"form_id\":\"F35-PPE-INTANGIBLES\",\"standard_id\":\"ISA-500\",\"paragraphs\":\"IAS 38.118(e)\",\"components\":\"[{\\\"id\\\": \\\"cost\\\", \\\"name\\\": \\\"Cost\\\", \\\"name_ar\\\": \\\"التكلفة\\\", \\\"contra\\\": 0}, {\\\"id\\\": \\\"accumulated_amortisation\\\", \\\"name\\\": \\\"Accumulated amortisation and impairment\\\", \\\"name_ar\\\": \\\"مجمع الاستهلاك والاضمحلال\\\", \\\"contra\\\": 1}]\",\"labels\":\"{\\\"additions\\\": {\\\"en\\\": \\\"Additions\\\", \\\"ar\\\": \\\"الإضافات\\\"}, \\\"disposals\\\": {\\\"en\\\": \\\"Disposals\\\", \\\"ar\\\": \\\"الاستبعادات\\\"}, \\\"transfers\\\": {\\\"en\\\": \\\"Transfers and reclassifications\\\", \\\"ar\\\": \\\"التحويلات وإعادة التبويب\\\"}, \\\"revaluation\\\": {\\\"en\\\": \\\"Revaluation\\\", \\\"ar\\\": \\\"إعادة التقييم\\\"}, \\\"other\\\": {\\\"en\\\": \\\"Amortisation charge and impairment\\\", \\\"ar\\\": \\\"عبء الاستهلاك والاضمحلال\\\"}}\",\"description\":\"Cost and accumulated amortisation reconciled from the opening to the closing carrying amount.\",\"sort_order\":2},{\"id\":\"SCH-INVP\",\"term_id\":\"T-SCH-INVP\",\"name\":\"Investment property\",\"leadsheet_id\":\"LS-INVP\",\"form_id\":\"F35-PPE-INTANGIBLES\",\"standard_id\":\"ISA-500\",\"paragraphs\":\"IAS 40.76 and 40.79(d)\",\"components\":\"[{\\\"id\\\": \\\"carrying_amount\\\", \\\"name\\\": \\\"Carrying amount\\\", \\\"name_ar\\\": \\\"القيمة الدفترية\\\", \\\"contra\\\": 0}]\",\"labels\":\"{\\\"additions\\\": {\\\"en\\\": \\\"Additions\\\", \\\"ar\\\": \\\"الإضافات\\\"}, \\\"disposals\\\": {\\\"en\\\": \\\"Disposals\\\", \\\"ar\\\": \\\"الاستبعادات\\\"}, \\\"transfers\\\": {\\\"en\\\": \\\"Transfers and reclassifications\\\", \\\"ar\\\": \\\"التحويلات وإعادة التبويب\\\"}, \\\"revaluation\\\": {\\\"en\\\": \\\"Fair value gains and losses\\\", \\\"ar\\\": \\\"أرباح وخسائر القيمة العادلة\\\"}, \\\"other\\\": {\\\"en\\\": \\\"Depreciation and impairment\\\", \\\"ar\\\": \\\"الإهلاك والاضمحلال\\\"}}\",\"description\":\"The carrying amount reconciled from the opening to the closing balance.\",\"sort_order\":3},{\"id\":\"SCH-INV\",\"term_id\":\"T-SCH-INV\",\"name\":\"Inventories\",\"leadsheet_id\":\"LS-INV\",\"form_id\":\"F34-INVENTORY-COST\",\"standard_id\":\"ISA-500\",\"paragraphs\":\"IAS 2.36\",\"components\":\"[{\\\"id\\\": \\\"raw_materials\\\", \\\"name\\\": \\\"Raw materials\\\", \\\"name_ar\\\": \\\"المواد الخام\\\", \\\"contra\\\": 0}, {\\\"id\\\": \\\"work_in_progress\\\", \\\"name\\\": \\\"Work in progress\\\", \\\"name_ar\\\": \\\"الإنتاج تحت التشغيل\\\", \\\"contra\\\": 0}, {\\\"id\\\": \\\"finished_goods\\\", \\\"name\\\": \\\"Finished goods\\\", \\\"name_ar\\\": \\\"الإنتاج التام\\\", \\\"contra\\\": 0}, {\\\"id\\\": \\\"write_down\\\", \\\"name\\\": \\\"Write-down to net realisable value\\\", \\\"name_ar\\\": \\\"التخفيض إلى صافي القيمة القابلة للتحقق\\\", \\\"contra\\\": 1}]\",\"labels\":\"{\\\"additions\\\": {\\\"en\\\": \\\"Purchases and production\\\", \\\"ar\\\": \\\"المشتريات والإنتاج\\\"}, \\\"disposals\\\": {\\\"en\\\": \\\"Cost of sales\\\", \\\"ar\\\": \\\"تكلفة المبيعات\\\"}, \\\"transfers\\\": {\\\"en\\\": \\\"Transfers and reclassifications\\\", \\\"ar\\\": \\\"التحويلات وإعادة التبويب\\\"}, \\\"revaluation\\\": {\\\"en\\\": \\\"Revaluation or remeasurement\\\", \\\"ar\\\": \\\"إعادة التقييم أو إعادة القياس\\\"}, \\\"other\\\": {\\\"en\\\": \\\"Write-downs and reversals\\\", \\\"ar\\\": \\\"التخفيضات وعكسها\\\"}}\",\"description\":\"Each category of inventory reconciled from the opening to the closing balance, with the write-down provision.\",\"sort_order\":4},{\"id\":\"SCH-REC\",\"term_id\":\"T-SCH-REC\",\"name\":\"Trade receivables\",\"leadsheet_id\":\"LS-REC\",\"form_id\":\"F31-REVENUE-RECEIVABLES\",\"standard_id\":\"ISA-500\",\"paragraphs\":\"IFRS 7.35H and 7.35I\",\"components\":\"[{\\\"id\\\": \\\"gross_receivables\\\", \\\"name\\\": \\\"Gross receivables\\\", \\\"name_ar\\\": \\\"المدينون الإجماليون\\\", \\\"contra\\\": 0}, {\\\"id\\\": \\\"loss_allowance\\\", \\\"name\\\": \\\"Loss allowance\\\", \\\"name_ar\\\": \\\"مخصص الخسائر الائتمانية\\\", \\\"contra\\\": 1}]\",\"labels\":\"{\\\"additions\\\": {\\\"en\\\": \\\"Invoiced\\\", \\\"ar\\\": \\\"المفوتر\\\"}, \\\"disposals\\\": {\\\"en\\\": \\\"Collected\\\", \\\"ar\\\": \\\"المحصل\\\"}, \\\"transfers\\\": {\\\"en\\\": \\\"Transfers and reclassifications\\\", \\\"ar\\\": \\\"التحويلات وإعادة التبويب\\\"}, \\\"revaluation\\\": {\\\"en\\\": \\\"Revaluation or remeasurement\\\", \\\"ar\\\": \\\"إعادة التقييم أو إعادة القياس\\\"}, \\\"other\\\": {\\\"en\\\": \\\"Written off and allowance movements\\\", \\\"ar\\\": \\\"المشطوب وحركة المخصص\\\"}}\",\"description\":\"Gross receivables and the loss allowance reconciled from the opening to the closing balance.\",\"sort_order\":5},{\"id\":\"SCH-AP\",\"term_id\":\"T-SCH-AP\",\"name\":\"Trade payables\",\"leadsheet_id\":\"LS-AP\",\"form_id\":\"F32-PURCHASES-PAYABLES\",\"standard_id\":\"ISA-500\",\"paragraphs\":\"IAS 1.77\",\"components\":\"[{\\\"id\\\": \\\"trade_payables\\\", \\\"name\\\": \\\"Trade payables\\\", \\\"name_ar\\\": \\\"الدائنون التجاريون\\\", \\\"contra\\\": 0}, {\\\"id\\\": \\\"other_payables\\\", \\\"name\\\": \\\"Other payables\\\", \\\"name_ar\\\": \\\"دائنون آخرون\\\", \\\"contra\\\": 0}]\",\"labels\":\"{\\\"additions\\\": {\\\"en\\\": \\\"Invoiced\\\", \\\"ar\\\": \\\"المفوتر\\\"}, \\\"disposals\\\": {\\\"en\\\": \\\"Paid\\\", \\\"ar\\\": \\\"المسدد\\\"}, \\\"transfers\\\": {\\\"en\\\": \\\"Transfers and reclassifications\\\", \\\"ar\\\": \\\"التحويلات وإعادة التبويب\\\"}, \\\"revaluation\\\": {\\\"en\\\": \\\"Revaluation or remeasurement\\\", \\\"ar\\\": \\\"إعادة التقييم أو إعادة القياس\\\"}, \\\"other\\\": {\\\"en\\\": \\\"Other movements\\\", \\\"ar\\\": \\\"حركات أخرى\\\"}}\",\"description\":\"Trade and other payables reconciled from the opening to the closing balance.\",\"sort_order\":6},{\"id\":\"SCH-BOR\",\"term_id\":\"T-SCH-BOR\",\"name\":\"Borrowings\",\"leadsheet_id\":\"LS-BORNC\",\"form_id\":\"F36-TREASURY\",\"standard_id\":\"ISA-500\",\"paragraphs\":\"IAS 7.44A\",\"components\":\"[{\\\"id\\\": \\\"principal\\\", \\\"name\\\": \\\"Principal\\\", \\\"name_ar\\\": \\\"أصل القرض\\\", \\\"contra\\\": 0}, {\\\"id\\\": \\\"accrued_interest\\\", \\\"name\\\": \\\"Accrued interest\\\", \\\"name_ar\\\": \\\"الفوائد المستحقة\\\", \\\"contra\\\": 0}]\",\"labels\":\"{\\\"additions\\\": {\\\"en\\\": \\\"Drawdowns\\\", \\\"ar\\\": \\\"السحوبات\\\"}, \\\"disposals\\\": {\\\"en\\\": \\\"Repayments\\\", \\\"ar\\\": \\\"السداد\\\"}, \\\"transfers\\\": {\\\"en\\\": \\\"Transfers and reclassifications\\\", \\\"ar\\\": \\\"التحويلات وإعادة التبويب\\\"}, \\\"revaluation\\\": {\\\"en\\\": \\\"Exchange differences\\\", \\\"ar\\\": \\\"فروق العملة\\\"}, \\\"other\\\": {\\\"en\\\": \\\"Interest, fees and other\\\", \\\"ar\\\": \\\"الفوائد والرسوم وأخرى\\\"}}\",\"description\":\"Principal and accrued interest reconciled from the opening to the closing balance, the reconciliation of liabilities arising from financing activities.\",\"sort_order\":7},{\"id\":\"SCH-RE\",\"term_id\":\"T-SCH-RE\",\"name\":\"Retained earnings\",\"leadsheet_id\":\"LS-RE\",\"form_id\":\"F37-EQUITY\",\"standard_id\":\"ISA-500\",\"paragraphs\":\"IAS 1.106\",\"components\":\"[{\\\"id\\\": \\\"retained_earnings\\\", \\\"name\\\": \\\"Retained earnings\\\", \\\"name_ar\\\": \\\"الأرباح المحتجزة\\\", \\\"contra\\\": 0}]\",\"labels\":\"{\\\"additions\\\": {\\\"en\\\": \\\"Profit for the year\\\", \\\"ar\\\": \\\"ربح السنة\\\"}, \\\"disposals\\\": {\\\"en\\\": \\\"Dividends\\\", \\\"ar\\\": \\\"توزيعات الأرباح\\\"}, \\\"transfers\\\": {\\\"en\\\": \\\"Transfers to and from reserves\\\", \\\"ar\\\": \\\"التحويلات من الاحتياطيات وإليها\\\"}, \\\"revaluation\\\": {\\\"en\\\": \\\"Remeasurements recognised directly\\\", \\\"ar\\\": \\\"إعادة القياس المعترف بها مباشرة\\\"}, \\\"other\\\": {\\\"en\\\": \\\"Other movements\\\", \\\"ar\\\": \\\"حركات أخرى\\\"}}\",\"description\":\"Retained earnings reconciled from the opening to the closing balance, one component of the statement of changes in equity.\",\"sort_order\":8}]"),
    ("population_criteria", 26, "[{\"id\":\"PC-PERIOD-END\",\"term_id\":\"T-PC-PERIOD-END\",\"name\":\"Entries at the period end\",\"rationale\":\"Entries recorded in the days around the period end are where the timing of revenue, accruals and reserves is most easily manipulated.\",\"parameters\":\"{\\\"period_end\\\":\\\"date\\\",\\\"days\\\":\\\"integer\\\"}\",\"defaults\":\"{\\\"days\\\":5}\",\"implementation\":\"computations/journals.py:c_period_end\",\"sort_order\":1},{\"id\":\"PC-POST-CLOSE\",\"term_id\":\"T-PC-POST-CLOSE\",\"name\":\"Entries posted after close with an in-period effective date\",\"rationale\":\"Post-closing entries change reported results after the books were thought final and are a recognised override vector.\",\"parameters\":\"{\\\"period_end\\\":\\\"date\\\"}\",\"defaults\":\"{}\",\"implementation\":\"computations/journals.py:c_post_close\",\"sort_order\":2},{\"id\":\"PC-ROUND-AMOUNT\",\"term_id\":\"T-PC-ROUND-AMOUNT\",\"name\":\"Round amounts\",\"rationale\":\"Estimates and fabricated entries tend to be round; genuine transactions rarely are.\",\"parameters\":\"{\\\"base\\\":\\\"money\\\",\\\"minimum\\\":\\\"money\\\"}\",\"defaults\":\"{\\\"base\\\":\\\"1000\\\",\\\"minimum\\\":\\\"10000\\\"}\",\"implementation\":\"computations/journals.py:c_round_amount\",\"sort_order\":3},{\"id\":\"PC-LARGE-AMOUNT\",\"term_id\":\"T-PC-LARGE-AMOUNT\",\"name\":\"Amounts at or above a threshold\",\"rationale\":\"Any single entry that could be material on its own is examined.\",\"parameters\":\"{\\\"threshold\\\":\\\"money\\\"}\",\"defaults\":\"{}\",\"implementation\":\"computations/journals.py:c_large_amount\",\"sort_order\":4},{\"id\":\"PC-UNUSUAL-ACCOUNT\",\"term_id\":\"T-PC-UNUSUAL-ACCOUNT\",\"name\":\"Unusual or sensitive accounts\",\"rationale\":\"Suspense, intercompany, related-party, reserve and seldom-used accounts are where misstatements are parked.\",\"parameters\":\"{\\\"accounts\\\":\\\"list of account codes\\\"}\",\"defaults\":\"{\\\"accounts\\\":[]}\",\"implementation\":\"computations/journals.py:c_unusual_account\",\"sort_order\":5},{\"id\":\"PC-SELF-APPROVED\",\"term_id\":\"T-PC-SELF-APPROVED\",\"name\":\"Self-approved or unapproved manual entries\",\"rationale\":\"Segregation of duties fails when the preparer approves the entry or no approval is recorded.\",\"parameters\":\"{}\",\"defaults\":\"{}\",\"implementation\":\"computations/journals.py:c_self_approved\",\"sort_order\":6},{\"id\":\"PC-WEEKEND-HOLIDAY\",\"term_id\":\"T-PC-WEEKEND-HOLIDAY\",\"name\":\"Posted on non-working days\",\"rationale\":\"Entries posted when no ordinary processing occurs deserve explanation; the working week is a parameter because Egypt's weekend is Friday and Saturday.\",\"parameters\":\"{\\\"weekend_days\\\":\\\"list of ISO weekday numbers (0=Monday)\\\",\\\"holidays\\\":\\\"list of dates\\\"}\",\"defaults\":\"{\\\"weekend_days\\\":[4,5],\\\"holidays\\\":[]}\",\"implementation\":\"computations/journals.py:c_weekend_or_holiday\",\"sort_order\":7},{\"id\":\"PC-OUT-OF-HOURS\",\"term_id\":\"T-PC-OUT-OF-HOURS\",\"name\":\"Posted outside working hours\",\"rationale\":\"Where a posting time exists, entries outside working hours are examined.\",\"parameters\":\"{\\\"start_hour\\\":\\\"integer\\\",\\\"end_hour\\\":\\\"integer\\\"}\",\"defaults\":\"{\\\"start_hour\\\":7,\\\"end_hour\\\":20}\",\"implementation\":\"computations/journals.py:c_out_of_hours\",\"sort_order\":8},{\"id\":\"PC-MANUAL\",\"term_id\":\"T-PC-MANUAL\",\"name\":\"Manual and top-side entries\",\"rationale\":\"Entries not generated by a subledger or system interface are the population management can most easily use to override controls.\",\"parameters\":\"{}\",\"defaults\":\"{}\",\"implementation\":\"computations/journals.py:c_manual\",\"sort_order\":9},{\"id\":\"PC-UNUSUAL-USER\",\"term_id\":\"T-PC-UNUSUAL-USER\",\"name\":\"Entries by unusual users\",\"rationale\":\"Entries prepared by senior management, IT personnel, leavers or generic accounts indicate override or access failures.\",\"parameters\":\"{\\\"users\\\":\\\"list of user identifiers\\\"}\",\"defaults\":\"{\\\"users\\\":[]}\",\"implementation\":\"computations/journals.py:c_unusual_user\",\"sort_order\":10},{\"id\":\"PC-NO-DESCRIPTION\",\"term_id\":\"T-PC-NO-DESCRIPTION\",\"name\":\"Missing or minimal description\",\"rationale\":\"An entry without a stated business purpose cannot be vouched from its face.\",\"parameters\":\"{\\\"min_length\\\":\\\"integer\\\"}\",\"defaults\":\"{\\\"min_length\\\":8}\",\"implementation\":\"computations/journals.py:c_no_description\",\"sort_order\":11},{\"id\":\"PC-KEYWORD\",\"term_id\":\"T-PC-KEYWORD\",\"name\":\"Keywords in the description\",\"rationale\":\"Words that signal adjustment, reclassification, correction, write-off, bonus, management, or the names of related parties.\",\"parameters\":\"{\\\"keywords\\\":\\\"list of strings\\\"}\",\"defaults\":\"{\\\"keywords\\\":[\\\"adjust\\\",\\\"reclass\\\",\\\"correct\\\",\\\"write off\\\",\\\"write-off\\\",\\\"plug\\\",\\\"per management\\\",\\\"reserve release\\\"]}\",\"implementation\":\"computations/journals.py:c_keyword\",\"sort_order\":12},{\"id\":\"PC-REVERSAL-AFTER-PERIOD\",\"term_id\":\"T-PC-REVERSAL-AFTER-PERIOD\",\"name\":\"Reversals after the period end\",\"rationale\":\"An entry booked in the period and reversed after it may have existed only to move the result.\",\"parameters\":\"{\\\"period_end\\\":\\\"date\\\"}\",\"defaults\":\"{}\",\"implementation\":\"computations/journals.py:c_reversal_after_period\",\"sort_order\":13},{\"id\":\"PC-SELDOM-USED-ACCOUNT\",\"term_id\":\"T-PC-SELDOM-USED-ACCOUNT\",\"name\":\"Seldom-used accounts\",\"rationale\":\"Accounts with very few entries in the period are outside the normal processing flow.\",\"parameters\":\"{\\\"max_entries\\\":\\\"integer\\\"}\",\"defaults\":\"{\\\"max_entries\\\":3}\",\"implementation\":\"computations/journals.py:c_seldom_used_account\",\"sort_order\":14},{\"id\":\"PC-DUPLICATE\",\"term_id\":\"T-PC-DUPLICATE\",\"name\":\"Duplicate entries\",\"rationale\":\"The same set of accounts and amounts posted more than once is the shape of a doubled invoice, a re-keyed batch or a concealed second payment.\",\"parameters\":\"{}\",\"defaults\":\"{}\",\"implementation\":\"computations/journals.py:c_duplicate\",\"sort_order\":15},{\"id\":\"PC-BELOW-THRESHOLD\",\"term_id\":\"T-PC-BELOW-THRESHOLD\",\"name\":\"Amounts just below an approval threshold\",\"rationale\":\"Amounts kept narrowly under an approval limit avoid the review the limit exists to trigger.\",\"parameters\":\"{\\\"threshold\\\":\\\"decimal\\\",\\\"band_percent\\\":\\\"decimal\\\"}\",\"defaults\":\"{\\\"band_percent\\\":\\\"10\\\"}\",\"implementation\":\"computations/journals.py:c_below_threshold\",\"sort_order\":16},{\"id\":\"PC-TOP-SIDE\",\"term_id\":\"T-PC-TOP-SIDE\",\"name\":\"Top-side entries\",\"rationale\":\"Entries made outside the subledgers at consolidation or by management are the classic vehicle for overriding controls.\",\"parameters\":\"{}\",\"defaults\":\"{}\",\"implementation\":\"computations/journals.py:c_top_side\",\"sort_order\":17},{\"id\":\"PC-LEAVER\",\"term_id\":\"T-PC-LEAVER\",\"name\":\"Entries by users after they left\",\"rationale\":\"A posting under a user who had already left means a shared password, a dormant account still open, or a backdated entry.\",\"parameters\":\"{\\\"leavers\\\":\\\"object: user -> leaving date\\\"}\",\"defaults\":\"{\\\"leavers\\\":{}}\",\"implementation\":\"computations/journals.py:c_leaver\",\"sort_order\":18},{\"id\":\"PC-UNAUTHORISED-APPROVER\",\"term_id\":\"T-PC-UNAUTHORISED-APPROVER\",\"name\":\"Approved by a user outside the approver list\",\"rationale\":\"An approval by someone not authorised to approve is no approval.\",\"parameters\":\"{\\\"approvers\\\":\\\"list of users\\\"}\",\"defaults\":\"{\\\"approvers\\\":[]}\",\"implementation\":\"computations/journals.py:c_unauthorised_approver\",\"sort_order\":19},{\"id\":\"PC-UNUSUAL-FLOW\",\"term_id\":\"T-PC-UNUSUAL-FLOW\",\"name\":\"Unusual combinations of accounts\",\"rationale\":\"A combination of debited and credited accounts seen in almost no other entry is outside the normal flow of transactions.\",\"parameters\":\"{\\\"max_entries\\\":\\\"integer\\\"}\",\"defaults\":\"{\\\"max_entries\\\":2}\",\"implementation\":\"computations/journals.py:c_unusual_flow\",\"sort_order\":20},{\"id\":\"PC-ACCOUNT-PAIR\",\"term_id\":\"T-PC-ACCOUNT-PAIR\",\"name\":\"Declared risky account pairs\",\"rationale\":\"Some flows are risky by nature: cash directly to revenue, revenue to expense, receivables written straight to reserves; each pair is declared by account prefix.\",\"parameters\":\"{\\\"pairs\\\":\\\"list of [debit_prefix, credit_prefix]\\\"}\",\"defaults\":\"{\\\"pairs\\\":[]}\",\"implementation\":\"computations/journals.py:c_account_pair\",\"sort_order\":21},{\"id\":\"PC-BACKDATED\",\"term_id\":\"T-PC-BACKDATED\",\"name\":\"Backdated entries\",\"rationale\":\"An effective date well before the posting date moves a result into an earlier period after the fact.\",\"parameters\":\"{\\\"days\\\":\\\"integer\\\"}\",\"defaults\":\"{\\\"days\\\":30}\",\"implementation\":\"computations/journals.py:c_backdated\",\"sort_order\":22},{\"id\":\"PC-SEQUENCE-GAP\",\"term_id\":\"T-PC-SEQUENCE-GAP\",\"name\":\"Gaps in the entry sequence\",\"rationale\":\"A missing number in the entry sequence is an entry that was deleted, held back, or never recorded.\",\"parameters\":\"{}\",\"defaults\":\"{}\",\"implementation\":\"computations/journals.py:c_sequence_gap\",\"sort_order\":23},{\"id\":\"PC-HIGH-VOLUME-USER\",\"term_id\":\"T-PC-HIGH-VOLUME-USER\",\"name\":\"Users with unusually many entries\",\"rationale\":\"A single preparer behind a large share of the population concentrates the fraud risk in one person and one set of access rights.\",\"parameters\":\"{\\\"max_entries\\\":\\\"integer\\\"}\",\"defaults\":\"{\\\"max_entries\\\":500}\",\"implementation\":\"computations/journals.py:c_high_volume_user\",\"sort_order\":24},{\"id\":\"PC-MANY-LINES\",\"term_id\":\"T-PC-MANY-LINES\",\"name\":\"Entries with many lines\",\"rationale\":\"Long entries hide a line among many and are where a plug is easiest to bury.\",\"parameters\":\"{\\\"max_lines\\\":\\\"integer\\\"}\",\"defaults\":\"{\\\"max_lines\\\":25}\",\"implementation\":\"computations/journals.py:c_many_lines\",\"sort_order\":25},{\"id\":\"PC-NO-REFERENCE\",\"term_id\":\"T-PC-NO-REFERENCE\",\"name\":\"No document reference\",\"rationale\":\"An entry no line of which cites a document has no evidence trail to follow.\",\"parameters\":\"{}\",\"defaults\":\"{}\",\"implementation\":\"computations/journals.py:c_no_reference\",\"sort_order\":26}]"),
    ("population_criterion_requirements", 130, "[{\"criterion_id\":\"PC-PERIOD-END\",\"requirement_id\":\"ISA-240.33\"},{\"criterion_id\":\"PC-PERIOD-END\",\"requirement_id\":\"ISA-240.34\"},{\"criterion_id\":\"PC-PERIOD-END\",\"requirement_id\":\"ISA-240R.48\"},{\"criterion_id\":\"PC-PERIOD-END\",\"requirement_id\":\"ISA-240R.49\"},{\"criterion_id\":\"PC-PERIOD-END\",\"requirement_id\":\"ISA-330.20\"},{\"criterion_id\":\"PC-POST-CLOSE\",\"requirement_id\":\"ISA-240.33\"},{\"criterion_id\":\"PC-POST-CLOSE\",\"requirement_id\":\"ISA-240.34\"},{\"criterion_id\":\"PC-POST-CLOSE\",\"requirement_id\":\"ISA-240R.48\"},{\"criterion_id\":\"PC-POST-CLOSE\",\"requirement_id\":\"ISA-240R.49\"},{\"criterion_id\":\"PC-POST-CLOSE\",\"requirement_id\":\"ISA-330.20\"},{\"criterion_id\":\"PC-ROUND-AMOUNT\",\"requirement_id\":\"ISA-240.33\"},{\"criterion_id\":\"PC-ROUND-AMOUNT\",\"requirement_id\":\"ISA-240.34\"},{\"criterion_id\":\"PC-ROUND-AMOUNT\",\"requirement_id\":\"ISA-240R.48\"},{\"criterion_id\":\"PC-ROUND-AMOUNT\",\"requirement_id\":\"ISA-240R.49\"},{\"criterion_id\":\"PC-ROUND-AMOUNT\",\"requirement_id\":\"ISA-330.20\"},{\"criterion_id\":\"PC-LARGE-AMOUNT\",\"requirement_id\":\"ISA-240.33\"},{\"criterion_id\":\"PC-LARGE-AMOUNT\",\"requirement_id\":\"ISA-240.34\"},{\"criterion_id\":\"PC-LARGE-AMOUNT\",\"requirement_id\":\"ISA-240R.48\"},{\"criterion_id\":\"PC-LARGE-AMOUNT\",\"requirement_id\":\"ISA-240R.49\"},{\"criterion_id\":\"PC-LARGE-AMOUNT\",\"requirement_id\":\"ISA-330.20\"},{\"criterion_id\":\"PC-UNUSUAL-ACCOUNT\",\"requirement_id\":\"ISA-240.33\"},{\"criterion_id\":\"PC-UNUSUAL-ACCOUNT\",\"requirement_id\":\"ISA-240.34\"},{\"criterion_id\":\"PC-UNUSUAL-ACCOUNT\",\"requirement_id\":\"ISA-240R.48\"},{\"criterion_id\":\"PC-UNUSUAL-ACCOUNT\",\"requirement_id\":\"ISA-240R.49\"},{\"criterion_id\":\"PC-UNUSUAL-ACCOUNT\",\"requirement_id\":\"ISA-330.20\"},{\"criterion_id\":\"PC-SELF-APPROVED\",\"requirement_id\":\"ISA-240.33\"},{\"criterion_id\":\"PC-SELF-APPROVED\",\"requir