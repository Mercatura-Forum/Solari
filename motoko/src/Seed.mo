\":\"ISQM-1.29\",\"relation\":\"supports\"},{\"procedure_id\":\"P-FSL-002\",\"requirement_id\":\"ISQM-1.29\",\"relation\":\"supports\"},{\"procedure_id\":\"P-FSL-002\",\"requirement_id\":\"ISQM-1.34\",\"relation\":\"supports\"},{\"procedure_id\":\"P-FSL-050\",\"requirement_id\":\"ISQM-1.31\",\"relation\":\"supports\"},{\"procedure_id\":\"P-FSL-050\",\"requirement_id\":\"ISQM-1.32\",\"relation\":\"supports\"},{\"procedure_id\":\"P-FSL-050\",\"requirement_id\":\"ISQM-1.35\",\"relation\":\"supports\"},{\"procedure_id\":\"P-FSL-050\",\"requirement_id\":\"ISQM-1.46\",\"relation\":\"supports\"},{\"procedure_id\":\"P-FSL-050\",\"requirement_id\":\"ISQM-1.47\",\"relation\":\"supports\"},{\"procedure_id\":\"P-FSL-006\",\"requirement_id\":\"ISA-600.35\",\"relation\":\"supports\"},{\"procedure_id\":\"P-FSL-039\",\"requirement_id\":\"ISA-600.52\",\"relation\":\"supports\"},{\"procedure_id\":\"P-REV-008\",\"requirement_id\":\"ISA-500.10\",\"relation\":\"discharges\"},{\"procedure_id\":\"P-PUR-007\",\"requirement_id\":\"ISA-500.10\",\"relation\":\"discharges\"},{\"procedure_id\":\"P-INV-002\",\"requirement_id\":\"ISA-501.7\",\"relation\":\"discharges\"},{\"procedure_id\":\"P-FSL-014\",\"requirement_id\":\"ISA-550.19\",\"relation\":\"discharges\"},{\"procedure_id\":\"P-FSL-057\",\"requirement_id\":\"ISA-700.13\",\"relation\":\"discharges\"},{\"procedure_id\":\"P-FSL-057\",\"requirement_id\":\"ISA-700.15\",\"relation\":\"discharges\"},{\"procedure_id\":\"P-FSL-057\",\"requirement_id\":\"ISA-330.24\",\"relation\":\"supports\"},{\"procedure_id\":\"P-FSL-057\",\"requirement_id\":\"ISA-540.36\",\"relation\":\"supports\"},{\"procedure_id\":\"P-FSL-057\",\"requirement_id\":\"ISA-550.25\",\"relation\":\"supports\"}]"),
    ("procedures", 120, "[{\"id\":\"P-FSL-001\",\"term_id\":\"T-P-FSL-001\",\"cycle_id\":\"FSL\",\"name\":\"Client acceptance and continuance evaluation\",\"nature\":\"general\",\"timing\":\"planning\",\"evidence\":\"inquiry\",\"population\":\"entity\",\"computation_id\":null,\"objective\":\"Decide whether the firm may accept or continue the engagement.\",\"description\":\"Evaluate the integrity and ethical values of the client and its management, the firm's competence and resources for the engagement, and independence; record the conclusion and any information that would have led to declining.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-002\",\"term_id\":\"T-P-FSL-002\",\"cycle_id\":\"FSL\",\"name\":\"Independence and ethics confirmation\",\"nature\":\"general\",\"timing\":\"planning\",\"evidence\":\"inquiry\",\"population\":\"entity\",\"computation_id\":null,\"objective\":\"Confirm that the team, firm and network are independent and ethical requirements are met.\",\"description\":\"Obtain and evaluate independence confirmations from every team member, screen financial interests, relationships, fees and non-assurance services against the IESBA Code, and record the conclusion before dating the report.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-003\",\"term_id\":\"T-P-FSL-003\",\"cycle_id\":\"FSL\",\"name\":\"Engagement letter and preconditions\",\"nature\":\"general\",\"timing\":\"planning\",\"evidence\":\"inspection\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Establish the preconditions for an audit and agree the terms.\",\"description\":\"Confirm the reporting framework is acceptable, obtain management's acknowledgement of its responsibilities, and issue or re-confirm the engagement letter covering objective, scope, responsibilities, framework and report form.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-004\",\"term_id\":\"T-P-FSL-004\",\"cycle_id\":\"FSL\",\"name\":\"Communication with the predecessor auditor\",\"nature\":\"general\",\"timing\":\"planning\",\"evidence\":\"inquiry\",\"population\":\"entity\",\"computation_id\":null,\"objective\":\"Obtain information relevant to acceptance and opening balances on an initial engagement.\",\"description\":\"With client permission, inquire of the predecessor about reasons for the change, disagreements, integrity concerns and unresolved matters; read the predecessor's report and, where access is granted, the prior working papers.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-005\",\"term_id\":\"T-P-FSL-005\",\"cycle_id\":\"FSL\",\"name\":\"Overall audit strategy and audit plan\",\"nature\":\"general\",\"timing\":\"planning\",\"evidence\":\"mixed\",\"population\":\"entity\",\"computation_id\":null,\"objective\":\"Set the scope, timing and direction of the audit and plan the procedures.\",\"description\":\"Prepare the strategy (scope, reporting objectives, significant factors, resources) and the audit plan (direction and supervision, risk assessment procedures, further procedures at the assertion level); update both as the audit progresses and obtain partner review.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-006\",\"term_id\":\"T-C-MATERIALITY\",\"cycle_id\":\"FSL\",\"name\":\"Materiality determination\",\"nature\":\"general\",\"timing\":\"planning\",\"evidence\":\"recalculation\",\"population\":\"none\",\"computation_id\":\"CALC-MATERIALITY\",\"objective\":\"Determine overall, specific and performance materiality and the clearly trivial threshold.\",\"description\":\"Select the benchmark and percentage with a documented rationale, compute overall materiality, performance materiality and the clearly trivial threshold, identify any classes, balances or disclosures needing a lower level, and revise on new information.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-007\",\"term_id\":\"T-P-FSL-007\",\"cycle_id\":\"FSL\",\"name\":\"Engagement team discussion\",\"nature\":\"risk_assessment\",\"timing\":\"planning\",\"evidence\":\"inquiry\",\"population\":\"entity\",\"computation_id\":null,\"objective\":\"Share knowledge of the entity and consider susceptibility to misstatement including fraud.\",\"description\":\"Hold and minute the discussion among key team members covering the framework, susceptibility to material misstatement, fraud scenarios including revenue and management override, related parties and going concern; communicate conclusions to members not present.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-008\",\"term_id\":\"T-P-FSL-008\",\"cycle_id\":\"FSL\",\"name\":\"Understanding the entity and its environment\",\"nature\":\"risk_assessment\",\"timing\":\"planning\",\"evidence\":\"mixed\",\"population\":\"entity\",\"computation_id\":null,\"objective\":\"Obtain the understanding that grounds the risk assessment.\",\"description\":\"Through inquiry, analytical procedures, observation and inspection, understand the organisational structure, ownership, governance and business model including IT, industry and regulatory factors, performance measures, the framework and accounting policies, and how inherent risk factors affect assertions.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-009\",\"term_id\":\"T-P-FSL-009\",\"cycle_id\":\"FSL\",\"name\":\"Preliminary analytical review\",\"nature\":\"risk_assessment\",\"timing\":\"planning\",\"evidence\":\"analytical\",\"population\":\"leadsheet\",\"computation_id\":\"CALC-TREND\",\"objective\":\"Identify unusual relationships that may indicate risks including fraud.\",\"description\":\"Compare current-period leadsheet balances and key ratios with prior periods, budgets and industry data; investigate unexpected relationships, with particular attention to revenue, and feed the results into the risk assessment.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-010\",\"term_id\":\"T-P-FSL-010\",\"cycle_id\":\"FSL\",\"name\":\"Understanding the control environment, risk assessment and monitoring\",\"nature\":\"risk_assessment\",\"timing\":\"planning\",\"evidence\":\"mixed\",\"population\":\"controls\",\"computation_id\":null,\"objective\":\"Evaluate the entity-level components of internal control.\",\"description\":\"Understand and evaluate the control environment, the entity's risk assessment process and its monitoring process including internal audit, and determine whether deficiencies in these components undermine the other components.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-011\",\"term_id\":\"T-P-FSL-011\",\"cycle_id\":\"FSL\",\"name\":\"Understanding the information system and control activities\",\"nature\":\"risk_assessment\",\"timing\":\"planning\",\"evidence\":\"mixed\",\"population\":\"controls\",\"computation_id\":null,\"objective\":\"Identify controls that address assertion-level risks and the IT environment they depend on.\",\"description\":\"For each significant class of transactions, balance and disclosure, understand how transactions flow from initiation to the financial statements, identify controls addressing significant risks, journal entries and controls to be relied on, identify IT applications and general IT controls, and evaluate design and implementation by procedures beyond inquiry.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-012\",\"term_id\":\"T-P-FSL-012\",\"cycle_id\":\"FSL\",\"name\":\"Fraud risk assessment inquiries\",\"nature\":\"risk_assessment\",\"timing\":\"planning\",\"evidence\":\"inquiry\",\"population\":\"entity\",\"computation_id\":null,\"objective\":\"Obtain information to identify fraud risks.\",\"description\":\"Inquire of management, internal audit and those charged with governance about fraud risk assessment, processes, known or suspected fraud and allegations; evaluate fraud risk factors; identify and assess fraud risks at both levels, presuming a risk in revenue recognition and treating management override as a significant risk.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-013\",\"term_id\":\"T-P-FSL-013\",\"cycle_id\":\"FSL\",\"name\":\"Laws and regulations: framework and compliance inquiries\",\"nature\":\"risk_assessment\",\"timing\":\"planning\",\"evidence\":\"mixed\",\"population\":\"entity\",\"computation_id\":null,\"objective\":\"Identify laws with a direct effect on the financial statements and possible non-compliance with others.\",\"description\":\"Understand the legal and regulatory framework (companies law, tax law, sector regulation, e-invoicing obligations), obtain evidence of compliance with laws that directly affect amounts and disclosures, inquire about compliance with other laws, and inspect regulator correspondence.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-014\",\"term_id\":\"T-P-FSL-014\",\"cycle_id\":\"FSL\",\"name\":\"Related-party identification\",\"nature\":\"risk_assessment\",\"timing\":\"planning\",\"evidence\":\"mixed\",\"population\":\"entity\",\"computation_id\":null,\"objective\":\"Identify related parties and transactions and the controls over them.\",\"description\":\"Inquire about the identity of related parties, relationships and transactions; understand the controls over identification, authorisation and disclosure; inspect bank and legal confirmations, minutes and the commercial register for undisclosed relationships; share findings with the team.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-015\",\"term_id\":\"T-P-FSL-015\",\"cycle_id\":\"FSL\",\"name\":\"Identify and assess risks of material misstatement\",\"nature\":\"risk_assessment\",\"timing\":\"planning\",\"evidence\":\"mixed\",\"population\":\"entity\",\"computation_id\":null,\"objective\":\"Produce the assessed risk register that drives the audit plan.\",\"description\":\"Identify risks at the financial statement and assertion levels, determine relevant assertions and significant classes, balances and disclosures, assess inherent risk on the likelihood and magnitude spectrum, determine significant risks and risks where substantive procedures alone are insufficient, assess control risk, and evaluate whether the evidence supports the assessment.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-016\",\"term_id\":\"T-P-FSL-016\",\"cycle_id\":\"FSL\",\"name\":\"Overall responses and audit programme design\",\"nature\":\"general\",\"timing\":\"planning\",\"evidence\":\"mixed\",\"population\":\"none\",\"computation_id\":null,\"objective\":\"Translate assessed risks into overall responses and further procedures.\",\"description\":\"Set overall responses (team assignment, scepticism, unpredictability, changes to nature, timing and extent), design further procedures whose nature, timing and extent respond to each assessed risk and its reasons, and link every programme step to a risk and assertion.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-017\",\"term_id\":\"T-P-FSL-017\",\"cycle_id\":\"FSL\",\"name\":\"Service organisation evaluation\",\"nature\":\"risk_assessment\",\"timing\":\"planning\",\"evidence\":\"mixed\",\"population\":\"entity\",\"computation_id\":null,\"objective\":\"Understand outsourced processing and obtain evidence over it.\",\"description\":\"Where payroll, IT hosting, custody or processing is outsourced, understand the services and complementary user controls, obtain and evaluate type 1 or type 2 reports for period, scope, subservice exclusions and bridging, or perform procedures at the service organisation.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-018\",\"term_id\":\"T-P-FSL-018\",\"cycle_id\":\"FSL\",\"name\":\"Using internal audit\",\"nature\":\"risk_assessment\",\"timing\":\"planning\",\"evidence\":\"mixed\",\"population\":\"entity\",\"computation_id\":null,\"objective\":\"Decide whether and how internal audit work or direct assistance can be used.\",\"description\":\"Evaluate the function's objectivity, competence and disciplined approach, decide the areas and extent of use, read its reports, test its work including reperformance, and where direct assistance is used obtain the written agreements and direct, supervise and review the work.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-019\",\"term_id\":\"T-P-FSL-019\",\"cycle_id\":\"FSL\",\"name\":\"Using an auditor's expert\",\"nature\":\"general\",\"timing\":\"any\",\"evidence\":\"mixed\",\"population\":\"entity\",\"computation_id\":null,\"objective\":\"Obtain evidence in a field outside accounting and auditing.\",\"description\":\"Where valuation, actuarial, legal, engineering or IT expertise is needed, evaluate the expert's competence and objectivity, agree the scope in writing, understand the field, and evaluate the relevance and reasonableness of the findings, assumptions, methods and source data.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-020\",\"term_id\":\"T-P-FSL-020\",\"cycle_id\":\"FSL\",\"name\":\"Opening balances on an initial engagement\",\"nature\":\"test_of_details\",\"timing\":\"interim\",\"evidence\":\"mixed\",\"population\":\"leadsheet\",\"computation_id\":null,\"objective\":\"Obtain evidence that opening balances are free from material misstatement.\",\"description\":\"Agree opening balances to the prior-period closing balances or restatements, evaluate the accounting policies applied, review the predecessor's working papers where available or perform specific procedures on opening balances, and evaluate the effect of any prior modification.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-021\",\"term_id\":\"T-P-FSL-021\",\"cycle_id\":\"FSL\",\"name\":\"Group audit planning and component scoping\",\"nature\":\"general\",\"timing\":\"planning\",\"evidence\":\"mixed\",\"population\":\"entity\",\"computation_id\":\"CALC-COMPONENT-MATERIALITY\",\"objective\":\"Plan a group audit and determine the work at components.\",\"description\":\"Understand the group, its consolidation process and commonality of controls, determine components at which work is performed, set component performance materiality and the misstatement threshold, evaluate and communicate with component auditors, and plan direction, supervision and review of their work.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-030\",\"term_id\":\"T-P-FSL-030\",\"cycle_id\":\"FSL\",\"name\":\"Accounting estimates: understanding and retrospective review\",\"nature\":\"risk_assessment\",\"timing\":\"planning\",\"evidence\":\"mixed\",\"population\":\"entity\",\"computation_id\":null,\"objective\":\"Identify the estimates in the statements and how management makes them.\",\"description\":\"Inventory the accounting estimates, understand management's process for methods, assumptions and data and how it addresses estimation uncertainty, identify controls, and review the outcome of prior-period estimates against subsequent events.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-031\",\"term_id\":\"T-P-FSL-031\",\"cycle_id\":\"FSL\",\"name\":\"Accounting estimates: substantive evaluation\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Obtain evidence that each significant estimate is reasonable under the framework.\",\"description\":\"For each estimate with an assessed risk, obtain evidence from subsequent events, test management's method, significant assumptions and data, or develop an auditor's point estimate or range; evaluate estimation-uncertainty disclosures and indicators of management bias; conclude whether the estimate is reasonable or misstated.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-032\",\"term_id\":\"T-P-FSL-032\",\"cycle_id\":\"FSL\",\"name\":\"Going concern assessment\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"documents\",\"computation_id\":\"CALC-GOING-CONCERN\",\"objective\":\"Conclude on the going concern basis and whether a material uncertainty exists.\",\"description\":\"Evaluate management's assessment over at least twelve months, its method, assumptions and data, cash flow forecast reliability, plans and their feasibility, third-party support, covenant compliance and a stress case; inquire about events beyond the period; conclude on the basis of accounting and on material uncertainty and evaluate disclosures.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-033\",\"term_id\":\"T-P-FSL-033\",\"cycle_id\":\"FSL\",\"name\":\"Litigation, claims and legal letters\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Identify litigation and claims and evaluate provisions and disclosures.\",\"description\":\"Inquire of management and in-house counsel, review minutes, legal expense accounts and correspondence, and where a risk exists send a letter of inquiry through management to external counsel requesting a direct reply; evaluate provisions and contingent liability disclosures.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-034\",\"term_id\":\"T-P-FSL-034\",\"cycle_id\":\"FSL\",\"name\":\"Journal entry and adjustment testing for management override\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"sub_ledger\",\"computation_id\":\"CALC-JOURNAL-SCREEN\",\"objective\":\"Respond to the presumed risk of management override.\",\"description\":\"Obtain the complete population of journal entries and adjustments in the population contract, reconcile it to the trial balance per account before any test (opening plus activity equals closing, every entry balanced), then apply the ISA 240 criteria to every entry: period-end and post-close timing, round and large amounts, unusual, sensitive and seldom-used accounts, self-approved or unapproved manual entries, non-working-day and out-of-hours posting, unusual users, missing descriptions, keywords and post-period reversals; vouch each flagged entry to support and business rationale and record the rule that selected it.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-035\",\"term_id\":\"T-P-FSL-035\",\"cycle_id\":\"FSL\",\"name\":\"Significant unusual transactions\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Evaluate the business rationale of significant transactions outside the normal course.\",\"description\":\"Identify significant transactions outside the normal course of business, inspect contracts and approvals, evaluate whether the rationale suggests fraudulent reporting or concealment, whether related parties are involved, and whether accounting and disclosure are appropriate.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-036\",\"term_id\":\"T-P-FSL-036\",\"cycle_id\":\"FSL\",\"name\":\"Related-party transactions substantive testing\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Obtain evidence over identified related-party transactions and disclosures.\",\"description\":\"For significant related-party transactions inspect agreements, evaluate terms against explanations, obtain evidence of authorisation, test any arm's-length assertion, confirm balances where appropriate, and evaluate the completeness and adequacy of disclosures.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-037\",\"term_id\":\"T-P-FSL-037\",\"cycle_id\":\"FSL\",\"name\":\"Subsequent events review\",\"nature\":\"completion\",\"timing\":\"completion\",\"evidence\":\"mixed\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Identify events after the period end requiring adjustment or disclosure.\",\"description\":\"Up to the report date, understand management's procedures, inquire of management and governance, read post-period minutes and interim statements, review post-period cash, legal and regulatory activity, and evaluate whether each event is properly reflected.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-038\",\"term_id\":\"T-WRITTEN-REPRESENTATION\",\"cycle_id\":\"FSL\",\"name\":\"Written representations\",\"nature\":\"completion\",\"timing\":\"completion\",\"evidence\":\"inquiry\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Obtain the representation letter as of the report date.\",\"description\":\"Draft, agree and obtain a representation letter from management with appropriate responsibilities, dated as near as practicable to the report date, covering preparation, information and completeness, fraud, laws, related parties, estimates, going concern, subsequent events and uncorrected misstatements; evaluate reliability.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-039\",\"term_id\":\"T-P-FSL-039\",\"cycle_id\":\"FSL\",\"name\":\"Evaluation of misstatements\",\"nature\":\"completion\",\"timing\":\"completion\",\"evidence\":\"recalculation\",\"population\":\"none\",\"computation_id\":\"CALC-AGGREGATION\",\"objective\":\"Accumulate and evaluate identified misstatements against materiality.\",\"description\":\"Record every misstatement other than clearly trivial ones by type and status, reassess materiality on actual results, communicate misstatements to management and request correction, evaluate uncorrected misstatements individually and in aggregate including prior-period effects and qualitative factors, and communicate them to those charged with governance.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-040\",\"term_id\":\"T-P-FSL-040\",\"cycle_id\":\"FSL\",\"name\":\"Final analytical review\",\"nature\":\"completion\",\"timing\":\"completion\",\"evidence\":\"analytical\",\"population\":\"leadsheet\",\"computation_id\":\"CALC-ANALYTICS\",\"objective\":\"Corroborate the overall conclusion that the statements are consistent with the understanding of the entity.\",\"description\":\"Near the end of the audit compare final leadsheet balances and ratios with expectations, prior periods and the risk assessment, investigate residual differences, and consider whether the results indicate a previously unrecognised fraud risk.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-041\",\"term_id\":\"T-P-FSL-041\",\"cycle_id\":\"FSL\",\"name\":\"Financial statement closing process and presentation review\",\"nature\":\"completion\",\"timing\":\"completion\",\"evidence\":\"mixed\",\"population\":\"documents\",\"computation_id\":\"CALC-TIEOUT\",\"objective\":\"Agree the statements to the records and evaluate presentation and disclosure.\",\"description\":\"Agree or reconcile the statements and disclosures to the trial balance and underlying records, examine material closing adjustments, complete the disclosure checklist for the framework, and evaluate classification, description, structure and fair presentation.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-042\",\"term_id\":\"T-STD-ISA-710\",\"cycle_id\":\"FSL\",\"name\":\"Comparative information\",\"nature\":\"completion\",\"timing\":\"completion\",\"evidence\":\"mixed\",\"population\":\"leadsheet\",\"computation_id\":null,\"objective\":\"Ensure comparatives agree with the prior period and policies are consistent.\",\"description\":\"Agree corresponding figures to the prior-period statements or restatements, evaluate consistency of policies and the accounting for changes, and evaluate any implications of a prior modification or a predecessor auditor.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-043\",\"term_id\":\"T-P-FSL-043\",\"cycle_id\":\"FSL\",\"name\":\"Other information in the annual report\",\"nature\":\"completion\",\"timing\":\"completion\",\"evidence\":\"inspection\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Read the other information for material inconsistency with the statements or audit knowledge.\",\"description\":\"Obtain the final annual report documents, compare amounts and narrative with the statements and audit knowledge, respond to apparent inconsistencies, and complete the other information section of the report.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-044\",\"term_id\":\"T-P-FSL-044\",\"cycle_id\":\"FSL\",\"name\":\"Sufficiency of evidence and risk reassessment\",\"nature\":\"completion\",\"timing\":\"completion\",\"evidence\":\"mixed\",\"population\":\"none\",\"computation_id\":null,\"objective\":\"Conclude that the assessed risks remain appropriate and evidence is sufficient.\",\"description\":\"Before concluding, revisit each assessed risk against the evidence obtained, consider contradictory evidence, evaluate whether further procedures are needed, and record the conclusion on sufficiency and appropriateness.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-045\",\"term_id\":\"T-P-FSL-045\",\"cycle_id\":\"FSL\",\"name\":\"Forming the opinion and drafting the report\",\"nature\":\"completion\",\"timing\":\"completion\",\"evidence\":\"mixed\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Form the opinion and prepare the auditor's report.\",\"description\":\"Conclude on reasonable assurance, decide the form of opinion and any modification, going concern section, key audit matters, emphasis or other matter paragraphs and other information section, and prepare the report with all required elements, signature, address and date.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-046\",\"term_id\":\"T-P-FSL-046\",\"cycle_id\":\"FSL\",\"name\":\"Key audit matters determination\",\"nature\":\"completion\",\"timing\":\"completion\",\"evidence\":\"mixed\",\"population\":\"none\",\"computation_id\":null,\"objective\":\"Determine and describe key audit matters for listed entities.\",\"description\":\"From matters communicated with those charged with governance, determine those requiring significant attention and those of most significance, describe why each was significant and how it was addressed with reference to disclosures, and communicate the determination.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-047\",\"term_id\":\"T-STD-ISA-260\",\"cycle_id\":\"FSL\",\"name\":\"Communication with those charged with governance\",\"nature\":\"completion\",\"timing\":\"any\",\"evidence\":\"inquiry\",\"population\":\"entity\",\"computation_id\":null,\"objective\":\"Communicate planning matters, significant findings, independence and deficiencies.\",\"description\":\"Communicate the auditor's responsibilities, planned scope and timing including significant risks, significant findings, independence matters, uncorrected misstatements, fraud and non-compliance matters, going concern conclusions, key audit matters and significant control deficiencies in writing, on a timely basis, and document oral communications.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-048\",\"term_id\":\"T-P-FSL-048\",\"cycle_id\":\"FSL\",\"name\":\"Group audit completion\",\"nature\":\"completion\",\"timing\":\"completion\",\"evidence\":\"mixed\",\"population\":\"entity\",\"computation_id\":null,\"objective\":\"Evaluate component auditors' work and conclude on the group opinion.\",\"description\":\"Obtain and evaluate component auditors' communications, review additional documentation where needed, audit the consolidation process including eliminations, adjustments, differing policies and period ends, perform group subsequent events procedures, evaluate the sufficiency of group evidence and the effect of misstatements, and communicate with group governance.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-049\",\"term_id\":\"T-EQR\",\"cycle_id\":\"FSL\",\"name\":\"Engagement quality review\",\"nature\":\"general\",\"timing\":\"completion\",\"evidence\":\"mixed\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Complete the engagement quality review before dating the report where required.\",\"description\":\"Where the engagement is a listed entity audit, legally required or firm-designated, appoint an eligible reviewer, provide the significant judgments, financial statements and draft report, resolve concerns and differences of opinion, and obtain notification of completion before dating the report.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-050\",\"term_id\":\"T-P-FSL-050\",\"cycle_id\":\"FSL\",\"name\":\"Partner review, consultation and file assembly\",\"nature\":\"general\",\"timing\":\"completion\",\"evidence\":\"mixed\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Discharge the engagement partner's quality responsibilities and close the file.\",\"description\":\"Review documentation of significant matters and judgments, the statements and the report, ensure consultations are documented and implemented, determine that sufficient evidence supports the report, and assemble the final file within the firm's deadline after the report date without later deletion.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-051\",\"term_id\":\"T-P-FSL-051\",\"cycle_id\":\"FSL\",\"name\":\"Non-compliance with laws: response procedures\",\"nature\":\"test_of_details\",\"timing\":\"any\",\"evidence\":\"mixed\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Respond to identified or suspected non-compliance.\",\"description\":\"Understand the act and its circumstances, obtain further information to evaluate the effect, discuss with management and governance, consider legal advice, evaluate implications for risk assessment and representations, evaluate reporting duties to outside authorities, and evaluate the effect on the opinion.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-052\",\"term_id\":\"T-P-FSL-052\",\"cycle_id\":\"FSL\",\"name\":\"Response to identified or suspected fraud\",\"nature\":\"general\",\"timing\":\"any\",\"evidence\":\"mixed\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Determine the effect of identified or suspected fraud on the audit.\",\"description\":\"Understand the matter, evaluate the entity's investigation and remediation, re-evaluate fraud risks and planned responses, reconsider the reliability of evidence and representations, determine materiality and control deficiencies, evaluate the ability to continue, and determine outside reporting duties.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-REV-001\",\"term_id\":\"T-P-REV-001\",\"cycle_id\":\"REV\",\"name\":\"Walkthrough of the revenue process\",\"nature\":\"risk_assessment\",\"timing\":\"interim\",\"evidence\":\"mixed\",\"population\":\"controls\",\"computation_id\":null,\"objective\":\"Confirm the understanding of the order-to-cash flow and identify controls.\",\"description\":\"Trace one transaction of each revenue stream from order or contract through delivery, invoicing, recording in the sales ledger and general ledger, and cash receipt, identifying the controls over credit approval, pricing, dispatch, invoicing, credit notes and cash application.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-REV-002\",\"term_id\":\"T-P-REV-002\",\"cycle_id\":\"REV\",\"name\":\"Tests of controls over invoicing and dispatch\",\"nature\":\"test_of_controls\",\"timing\":\"interim\",\"evidence\":\"mixed\",\"population\":\"controls\",\"computation_id\":\"CALC-ATTRIBUTE\",\"objective\":\"Obtain evidence that invoicing controls operated throughout the period.\",\"description\":\"Select a statistically sized sample of dispatches and invoices across the period, reperform the matching of dispatch note, order and price list to invoice, verify approval of credit notes and sequence controls, and evaluate deviations against the tolerable rate.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-REV-003\",\"term_id\":\"T-P-REV-003\",\"cycle_id\":\"REV\",\"name\":\"Tests of controls over credit approval and cash application\",\"nature\":\"test_of_controls\",\"timing\":\"interim\",\"evidence\":\"mixed\",\"population\":\"controls\",\"computation_id\":\"CALC-ATTRIBUTE\",\"objective\":\"Obtain evidence over controls that affect receivable valuation and existence.\",\"description\":\"Sample new customer accounts and credit limit changes for approval, sample cash receipts for timely and correct application, and test the monthly reconciliation of the sales ledger to the general ledger and of receipts to bank.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-REV-004\",\"term_id\":\"T-P-REV-004\",\"cycle_id\":\"REV\",\"name\":\"Substantive analytical procedure on revenue\",\"nature\":\"substantive_analytical\",\"timing\":\"year_end\",\"evidence\":\"analytical\",\"population\":\"leadsheet\",\"computation_id\":\"CALC-ANALYTICS\",\"objective\":\"Obtain evidence over revenue occurrence, completeness and accuracy through a precise expectation.\",\"description\":\"Build an expectation of revenue by stream from independent drivers (units shipped times contracted prices, occupancy times rates, subscriber counts times fees), evaluate data reliability, set the acceptable difference from performance materiality, and investigate differences above it with corroborated explanations.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-REV-005\",\"term_id\":\"T-P-REV-005\",\"cycle_id\":\"REV\",\"name\":\"Revenue cut-off testing\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Ensure revenue is recorded in the period in which control transferred.\",\"description\":\"Select the last dispatches, service completions or milestone certificates before the period end and the first after it, trace each to the invoice and ledger posting date, and test credit notes issued after the period end for sales that should be reversed.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-REV-006\",\"term_id\":\"T-P-REV-006\",\"cycle_id\":\"REV\",\"name\":\"Revenue recognition policy and contract review\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Evaluate recognition against the five-step model for each revenue stream.\",\"description\":\"For each stream identify the contract, performance obligations, transaction price including variable consideration, allocation and timing of satisfaction; inspect a sample of contracts with non-standard terms, bill-and-hold, consignment, rebates and returns, and evaluate the policy and disclosures.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-REV-007\",\"term_id\":\"T-P-REV-007\",\"cycle_id\":\"REV\",\"name\":\"Revenue fraud-risk responsive procedures\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Respond to the presumed fraud risk in revenue recognition.\",\"description\":\"For the revenue types and assertions identified as fraud risks, test manual and top-side revenue journals, sales to new or unusual customers near the period end, transactions with unusual terms, and revenue recorded without corresponding cash receipts; incorporate unpredictability in selection.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-REV-008\",\"term_id\":\"T-P-REV-008\",\"cycle_id\":\"REV\",\"name\":\"External confirmation of receivables\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"external_confirmation\",\"population\":\"sub_ledger\",\"computation_id\":\"CALC-MUS\",\"objective\":\"Obtain third-party evidence of the existence and accuracy of receivable balances.\",\"description\":\"Select balances by monetary unit sampling plus all large and unusual balances, control the preparation and dispatch of positive confirmation requests, receive replies directly, reconcile differences, and evaluate reliability of responses.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-REV-009\",\"term_id\":\"T-P-REV-009\",\"cycle_id\":\"REV\",\"name\":\"Alternative procedures for non-responses\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Obtain evidence for confirmations not returned.\",\"description\":\"For each non-response inspect subsequent cash receipts matched to the specific invoices, and where unpaid inspect invoices, dispatch evidence and customer acceptance; evaluate implications where management refused permission to confirm.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-REV-010\",\"term_id\":\"T-P-REV-010\",\"cycle_id\":\"REV\",\"name\":\"Receivables ageing and expected credit loss allowance\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Evaluate the valuation of receivables and the loss allowance.\",\"description\":\"Reconcile the ageing to the ledger, test ageing accuracy for a sample, evaluate the ECL model: historical loss rates by bucket, forward-looking adjustments, specific provisions for disputed or overdue balances, and subsequent receipts; conclude whether the allowance is reasonable or misstated.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-REV-011\",\"term_id\":\"T-P-REV-011\",\"cycle_id\":\"REV\",\"name\":\"Subsequent receipts testing\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Obtain evidence of existence and recoverability from post-period cash.\",\"description\":\"Trace a sample of period-end receivable balances to cash received after the period end, matching receipts to specific invoices, and investigate balances unpaid at the date of testing.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-REV-012\",\"term_id\":\"T-P-REV-012\",\"cycle_id\":\"REV\",\"name\":\"Contract assets and liabilities testing\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Evaluate unbilled revenue, deferred revenue and customer advances.\",\"description\":\"Reconcile contract balances to the contract register, test progress measurement inputs for over-time revenue, test deferred revenue release and customer advances to contracts and cash, and evaluate presentation.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-REV-013\",\"term_id\":\"T-P-REV-013\",\"cycle_id\":\"REV\",\"name\":\"Revenue completeness through external records\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Test completeness from populations outside the sales ledger.\",\"description\":\"Select items from dispatch logs, service delivery records, point-of-sale reports or the tax authority e-invoicing portal and trace them into the sales ledger; reconcile e-invoice totals submitted to the tax authority with recorded revenue and VAT output.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-REV-014\",\"term_id\":\"T-P-REV-014\",\"cycle_id\":\"REV\",\"name\":\"Receivables presentation, credit balances and related parties\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Evaluate classification and disclosure of receivables.\",\"description\":\"Identify credit balances for reclassification, non-current and related-party receivables, pledged or factored balances, and evaluate disclosures of credit risk and ageing.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PUR-001\",\"term_id\":\"T-P-PUR-001\",\"cycle_id\":\"PUR\",\"name\":\"Walkthrough of the purchase-to-pay process\",\"nature\":\"risk_assessment\",\"timing\":\"interim\",\"evidence\":\"mixed\",\"population\":\"controls\",\"computation_id\":null,\"objective\":\"Confirm the understanding of purchasing, receiving, invoicing and payment and identify controls.\",\"description\":\"Trace one purchase of goods and one of services from requisition and order through receipt, invoice matching, ledger posting and payment, identifying controls over authorisation, three-way matching, supplier master data and payment release.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PUR-002\",\"term_id\":\"T-P-PUR-002\",\"cycle_id\":\"PUR\",\"name\":\"Tests of controls over purchase authorisation and matching\",\"nature\":\"test_of_controls\",\"timing\":\"interim\",\"evidence\":\"mixed\",\"population\":\"controls\",\"computation_id\":\"CALC-ATTRIBUTE\",\"objective\":\"Obtain evidence that purchase controls operated throughout the period.\",\"description\":\"Sample purchase invoices across the period and reperform the match to order, goods receipt and approval; test supplier master changes for authorisation and segregation; evaluate deviations against the tolerable rate.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PUR-003\",\"term_id\":\"T-P-PUR-003\",\"cycle_id\":\"PUR\",\"name\":\"Search for unrecorded liabilities\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Obtain evidence of the completeness of payables and accruals.\",\"description\":\"Inspect payments made and invoices received after the period end above a threshold, determine the period to which each relates, and trace those relating to the period to the payables ledger or accruals; review unmatched goods receipts and open purchase orders.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PUR-004\",\"term_id\":\"T-P-PUR-004\",\"cycle_id\":\"PUR\",\"name\":\"Supplier statement reconciliation\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Obtain evidence of the existence, completeness and accuracy of supplier balances.\",\"description\":\"Select major and unusual suppliers and those with nil or debit balances, obtain statements directly or through confirmation, reconcile to the ledger, and investigate reconciling items including goods in transit and unrecorded invoices.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PUR-005\",\"term_id\":\"T-P-PUR-005\",\"cycle_id\":\"PUR\",\"name\":\"Purchases and expense cut-off\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Ensure purchases and expenses are recorded in the correct period.\",\"description\":\"Select the last goods receipts and service confirmations before the period end and the first after, trace to invoice and ledger posting period, and test accruals for services received but not invoiced.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PUR-006\",\"term_id\":\"T-P-PUR-006\",\"cycle_id\":\"PUR\",\"name\":\"Substantive analytical procedures on operating expenses\",\"nature\":\"substantive_analytical\",\"timing\":\"year_end\",\"evidence\":\"analytical\",\"population\":\"leadsheet\",\"computation_id\":\"CALC-ANALYTICS\",\"objective\":\"Obtain evidence over expense completeness and accuracy through expectations.\",\"description\":\"Build expectations for recurring expenses (rent from lease schedules, utilities from consumption, insurance from policies, depreciation from the register), compare with recorded amounts month by month, and investigate differences above the threshold.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PUR-007\",\"term_id\":\"T-P-PUR-007\",\"cycle_id\":\"PUR\",\"name\":\"Vouching of expenses and classification review\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"sub_ledger\",\"computation_id\":\"CALC-MUS\",\"objective\":\"Obtain evidence of occurrence, accuracy and classification of expenses.\",\"description\":\"Select expense items by monetary unit sampling and by risk criteria, vouch each to invoice, approval and evidence of receipt, and evaluate classification between expense captions and against capital expenditure.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PUR-008\",\"term_id\":\"T-P-PUR-008\",\"cycle_id\":\"PUR\",\"name\":\"Accruals reasonableness and roll-forward\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"recalculation\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Evaluate accrued expenses for completeness and valuation.\",\"description\":\"Obtain the accruals listing, compare with the prior period and with the search for unrecorded liabilities, recalculate systematic accruals (interest, bonuses, utilities, professional fees), and inspect subsequent settlement.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PUR-009\",\"term_id\":\"T-P-PUR-009\",\"cycle_id\":\"PUR\",\"name\":\"Provisions and contingencies evaluation\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Evaluate recognition, measurement and disclosure of provisions.\",\"description\":\"Obtain the provisions schedule, evaluate each against the recognition criteria (present obligation, probable outflow, reliable estimate), test the measurement assumptions and discounting, inspect supporting correspondence and legal advice, and evaluate contingent liability disclosures.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PUR-010\",\"term_id\":\"T-P-PUR-010\",\"cycle_id\":\"PUR\",\"name\":\"Other non-current liabilities and deferred income\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Obtain evidence over long-term payables, government grants and deferred income.\",\"description\":\"Agree balances to agreements, confirm where appropriate, recalculate the release of deferred income and grants over the related period, and evaluate current and non-current classification.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PUR-011\",\"term_id\":\"T-P-PUR-011\",\"cycle_id\":\"PUR\",\"name\":\"Payables presentation and debit balances\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Evaluate classification and disclosure of payables.\",\"description\":\"Identify debit balances for reclassification, related-party payables, and amounts due after twelve months; evaluate disclosures of liquidity risk and maturity.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PAY-001\",\"term_id\":\"T-P-PAY-001\",\"cycle_id\":\"PAY\",\"name\":\"Walkthrough of the payroll process\",\"nature\":\"risk_assessment\",\"timing\":\"interim\",\"evidence\":\"mixed\",\"population\":\"controls\",\"computation_id\":null,\"objective\":\"Confirm the understanding of hire-to-pay and identify controls.\",\"description\":\"Trace a starter, a leaver and a pay change from HR authorisation through the payroll master file, gross-to-net calculation, approval, payment and posting, identifying controls over master data changes, timesheet approval and payroll review.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PAY-002\",\"term_id\":\"T-P-PAY-002\",\"cycle_id\":\"PAY\",\"name\":\"Tests of controls over payroll master data and approval\",\"nature\":\"test_of_controls\",\"timing\":\"interim\",\"evidence\":\"mixed\",\"population\":\"controls\",\"computation_id\":\"CALC-ATTRIBUTE\",\"objective\":\"Obtain evidence that payroll controls operated throughout the period.\",\"description\":\"Sample starters, leavers and rate changes for authorised HR documentation, sample monthly payroll runs for independent review and approval before payment, and test the reconciliation of payroll to the bank payment file.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PAY-003\",\"term_id\":\"T-P-PAY-003\",\"cycle_id\":\"PAY\",\"name\":\"Payroll proof in total\",\"nature\":\"substantive_analytical\",\"timing\":\"year_end\",\"evidence\":\"analytical\",\"population\":\"leadsheet\",\"computation_id\":\"CALC-ANALYTICS\",\"objective\":\"Obtain evidence over staff cost completeness and accuracy through an expectation.\",\"description\":\"Build an expectation from average headcount by grade times average pay plus statutory contributions and bonuses, reconcile monthly payroll totals to the ledger, and investigate differences above the threshold.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PAY-004\",\"term_id\":\"T-P-PAY-004\",\"cycle_id\":\"PAY\",\"name\":\"Employee existence and pay accuracy sample\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"sub_ledger\",\"computation_id\":\"CALC-MUS\",\"objective\":\"Obtain evidence that employees exist and are paid at authorised rates.\",\"description\":\"Select employees from the payroll and from the HR file in both directions, inspect contracts, identity records and attendance, recalculate gross-to-net including social insurance and tax withholding, and trace net pay to the bank payment.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PAY-005\",\"term_id\":\"T-P-PAY-005\",\"cycle_id\":\"PAY\",\"name\":\"Social insurance and payroll tax reconciliation\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"recalculation\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Obtain evidence of the completeness of statutory payroll liabilities.\",\"description\":\"Reconcile social insurance and payroll withholding tax returns to payroll records and to the liability accounts, recalculate contributions on the statutory bases and ceilings, and inspect payment after the period end.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PAY-006\",\"term_id\":\"T-P-PAY-006\",\"cycle_id\":\"PAY\",\"name\":\"Bonus, leave and end-of-service accruals\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Evaluate payroll-related accruals and employee benefit obligations.\",\"description\":\"Recalculate leave accruals from HR balances and rates, evaluate bonus accruals against approved schemes and post-period payments, and for defined benefit or end-of-service obligations evaluate the actuarial method, assumptions and data with an expert where needed.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PAY-007\",\"term_id\":\"T-P-PAY-007\",\"cycle_id\":\"PAY\",\"name\":\"Directors' and key management remuneration\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Obtain evidence over remuneration of key management and its disclosure.\",\"description\":\"Agree remuneration of directors and key management to board and remuneration committee approvals and contracts, and evaluate related-party disclosure of key management compensation.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-INV-001\",\"term_id\":\"T-P-INV-001\",\"cycle_id\":\"INV\",\"name\":\"Walkthrough of inventory and costing\",\"nature\":\"risk_assessment\",\"timing\":\"interim\",\"evidence\":\"mixed\",\"population\":\"controls\",\"computation_id\":null,\"objective\":\"Confirm the understanding of inventory movements, costing and count controls.\",\"description\":\"Trace a receipt, an issue to production, a transfer to finished goods and a dispatch through the inventory system and ledger, and understand the standard or actual costing method, overhead absorption, count procedures and the obsolescence review.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-INV-002\",\"term_id\":\"T-P-INV-002\",\"cycle_id\":\"INV\",\"name\":\"Attendance at physical inventory counting\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"observation\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Obtain evidence of the existence and condition of inventory.\",\"description\":\"Evaluate the count instructions, observe the count, inspect inventory for condition and obsolescence, perform test counts from floor to sheet and sheet to floor, record cut-off information and last document numbers, and follow the count results into the final inventory records.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-INV-003\",\"term_id\":\"T-P-INV-003\",\"cycle_id\":\"INV\",\"name\":\"Roll-forward or roll-back from the count date\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"recalculation\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Bridge the count date to the period end.\",\"description\":\"Where the count is not at the period end, reconcile the counted quantities to the period-end records through tested receipts, issues and adjustments, and investigate unusual movements between the dates.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-INV-004\",\"term_id\":\"T-P-INV-004\",\"cycle_id\":\"INV\",\"name\":\"Inventory held by third parties\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"external_confirmation\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Obtain evidence over inventory in the custody of others.\",\"description\":\"Confirm quantities and condition directly with warehouses, consignees and processors, evaluate the custodian's controls where balances are material, and where appropriate attend the custodian's count.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-INV-005\",\"term_id\":\"T-P-INV-005\",\"cycle_id\":\"INV\",\"name\":\"Cost testing of inventory\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"sub_ledger\",\"computation_id\":\"CALC-MUS\",\"objective\":\"Obtain evidence that inventory is carried at cost determined under the framework.\",\"description\":\"Select items by monetary unit sampling, agree raw material cost to purchase invoices, test labour and overhead absorption rates to payroll and production records and normal capacity, test standard cost variances, and test the cost formula (weighted average or FIFO).\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-INV-006\",\"term_id\":\"T-P-INV-006\",\"cycle_id\":\"INV\",\"name\":\"Net realisable value and obsolescence\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Evaluate whether inventory is written down where required.\",\"description\":\"Compare cost with post-period selling prices less costs to complete and sell for a sample, analyse slow-moving and aged items, evaluate management's write-down methodology and assumptions, and inspect condition findings from the count.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-INV-007\",\"term_id\":\"T-P-INV-007\",\"cycle_id\":\"INV\",\"name\":\"Inventory cut-off\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Ensure receipts and dispatches are recorded in the correct period consistently with payables and revenue.\",\"description\":\"Using the last document numbers recorded at the count, test goods received and dispatched around the period end for inclusion in inventory, purchases and sales in the correct period, including goods in transit under the delivery terms.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-INV-008\",\"term_id\":\"T-P-INV-008\",\"cycle_id\":\"INV\",\"name\":\"Cost of sales analytical procedures\",\"nature\":\"substantive_analytical\",\"timing\":\"year_end\",\"evidence\":\"analytical\",\"population\":\"leadsheet\",\"computation_id\":\"CALC-ANALYTICS\",\"objective\":\"Obtain evidence over cost of sales through gross margin expectations.\",\"description\":\"Compare gross margin by product line and month with expectations from prior periods, price and cost changes and mix, reconcile cost of sales to opening inventory plus purchases less closing inventory, and investigate differences above the threshold.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-INV-009\",\"term_id\":\"T-P-INV-009\",\"cycle_id\":\"INV\",\"name\":\"Inventory presentation and pledges\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Evaluate disclosure and rights over inventory.\",\"description\":\"Inspect borrowing agreements and bank confirmations for pledged inventory, evaluate classification between raw materials, work in progress and finished goods, and evaluate disclosure of the cost formula and write-downs.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PPE-001\",\"term_id\":\"T-P-PPE-001\",\"cycle_id\":\"PPE\",\"name\":\"Fixed asset register reconciliation\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"recalculation\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Agree the register to the ledger and the movements schedule.\",\"description\":\"Reconcile cost, accumulated depreciation and net book value per the register to the ledger and the movements note; investigate reconciling items and unusual movements.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PPE-002\",\"term_id\":\"T-P-PPE-002\",\"cycle_id\":\"PPE\",\"name\":\"Additions vouching and capitalisation review\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"sub_ledger\",\"computation_id\":\"CALC-MUS\",\"objective\":\"Obtain evidence of the occurrence, accuracy and classification of additions.\",\"description\":\"Select additions by monetary unit sampling and by risk, vouch to invoices, contracts, approvals and evidence of delivery or completion, evaluate capitalisation against the framework including directly attributable costs and borrowing costs, and test repairs and maintenance for items that should be capitalised.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PPE-003\",\"term_id\":\"T-P-PPE-003\",\"cycle_id\":\"PPE\",\"name\":\"Disposals and derecognition\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Obtain evidence that disposals are complete and gains or losses correct.\",\"description\":\"Inspect disposal approvals and sale proceeds, recalculate gains and losses, and review scrapped, idle or fully depreciated assets and post-period disposals for assets that should have been derecognised.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PPE-004\",\"term_id\":\"T-P-PPE-004\",\"cycle_id\":\"PPE\",\"name\":\"Physical verification and title\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Obtain evidence of the existence of and rights to significant assets.\",\"description\":\"Physically inspect a sample of assets from the register and trace a sample of assets seen on site to the register; inspect title deeds, registration certificates and lease agreements, and bank confirmations for charges over assets.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PPE-005\",\"term_id\":\"T-P-PPE-005\",\"cycle_id\":\"PPE\",\"name\":\"Depreciation and amortisation recalculation\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"recalculation\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Obtain evidence over the accuracy of depreciation and amortisation.\",\"description\":\"Recalculate the charge by class from the register using the approved useful lives, residual values and methods, evaluate the reasonableness of useful lives against actual disposal experience, and reconcile the charge to the ledger and the expense caption.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PPE-006\",\"term_id\":\"T-P-PPE-006\",\"cycle_id\":\"PPE\",\"name\":\"Impairment assessment\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Evaluate whether impairment indicators exist and any impairment test.\",\"description\":\"Inquire and inspect for indicators (losses, idle assets, market declines, obsolescence), and where a test is performed evaluate the cash-generating units, the value-in-use model, discount rate, growth and cash flow assumptions and sensitivity, using an expert where needed; for goodwill test annually.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PPE-007\",\"term_id\":\"T-P-PPE-007\",\"cycle_id\":\"PPE\",\"name\":\"Intangible assets and development costs\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Obtain evidence over recognition and measurement of intangibles.\",\"description\":\"Test capitalised development costs against the recognition criteria, agree acquired intangibles to purchase agreements and allocations, recalculate amortisation, and evaluate indefinite-life conclusions.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PPE-008\",\"term_id\":\"T-P-PPE-008\",\"cycle_id\":\"PPE\",\"name\":\"Right-of-use assets and lease accounting\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"recalculation\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Obtain evidence over lessee accounting for right-of-use assets.\",\"description\":\"Agree the lease register to contracts, recalculate the initial measurement, depreciation and remeasurement of right-of-use assets from the lease terms and discount rate, and evaluate the completeness of the register against rent expense and commitments.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PPE-009\",\"term_id\":\"T-P-PPE-009\",\"cycle_id\":\"PPE\",\"name\":\"Investment property valuation\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Obtain evidence over the measurement of investment property.\",\"description\":\"Where fair value is used evaluate the valuer's competence and objectivity, the valuation method, comparable evidence and assumptions; where cost is used test depreciation and impairment; evaluate rental income against leases.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PPE-010\",\"term_id\":\"T-P-PPE-010\",\"cycle_id\":\"PPE\",\"name\":\"Non-current asset presentation and commitments\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Evaluate disclosures of non-current assets.\",\"description\":\"Evaluate the movements note, disclosure of useful lives, pledged assets, capital commitments from contracts and board approvals, and assets held for sale classification.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-TRE-001\",\"term_id\":\"T-P-TRE-001\",\"cycle_id\":\"TRE\",\"name\":\"Bank confirmation\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"external_confirmation\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Obtain direct third-party evidence over bank balances, facilities, security and signatories.\",\"description\":\"Send confirmation requests under audit control to every bank the entity dealt with during the period, including closed accounts, requesting balances, loans, guarantees, security, derivatives and authorised signatories; receive replies directly and reconcile to the records.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-TRE-002\",\"term_id\":\"T-P-TRE-002\",\"cycle_id\":\"TRE\",\"name\":\"Bank reconciliation testing\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Obtain evidence that recorded cash agrees with the bank.\",\"description\":\"For each account test the period-end reconciliation: agree the bank balance to the confirmation and statement, the book balance to the ledger, check arithmetic, and test outstanding items to the subsequent bank statement, investigating stale or unusual items.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-TRE-003\",\"term_id\":\"T-P-TRE-003\",\"cycle_id\":\"TRE\",\"name\":\"Cash count and cash-in-transit\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"observation\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Obtain evidence of the existence of cash on hand and in transit.\",\"description\":\"Count petty cash and tills at or near the period end in the presence of the custodian and reconcile to the records; trace cash in transit to the subsequent bank deposit.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-TRE-004\",\"term_id\":\"T-P-TRE-004\",\"cycle_id\":\"TRE\",\"name\":\"Cash cut-off and window dressing\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Detect transfers and receipts recorded in the wrong period.\",\"description\":\"Inspect inter-account transfers around the period end for recording in the same period on both sides, and test large receipts and payments in the last and first days for correct period.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-TRE-005\",\"term_id\":\"T-P-TRE-005\",\"cycle_id\":\"TRE\",\"name\":\"Borrowings confirmation and covenant compliance\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Obtain evidence over borrowings, their terms, classification and covenant compliance.\",\"description\":\"Agree balances to bank confirmations and agreements, recalculate accrued interest and the current portion, test covenant calculations at the period end, evaluate classification where covenants are breached or waived, and evaluate going concern implications.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-TRE-006\",\"term_id\":\"T-P-TRE-006\",\"cycle_id\":\"TRE\",\"name\":\"Interest income and expense recalculation\",\"nature\":\"substantive_analytical\",\"timing\":\"year_end\",\"evidence\":\"recalculation\",\"population\":\"leadsheet\",\"computation_id\":\"CALC-ANALYTICS\",\"objective\":\"Obtain evidence over finance income and costs through recalculation.\",\"description\":\"Recalculate interest from average balances and contractual rates for each facility and deposit, compare with recorded amounts, and investigate differences above the threshold.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-TRE-007\",\"term_id\":\"T-P-TRE-007\",\"cycle_id\":\"TRE\",\"name\":\"Lease liabilities recalculation\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"recalculation\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Obtain evidence over the measurement and classification of lease liabilities.\",\"description\":\"Recalculate lease liabilities from the contracts, payment schedules and incremental borrowing rates, test modifications and remeasurements, split current and non-current, and reconcile lease interest to finance costs.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-TRE-008\",\"term_id\":\"T-P-TRE-008\",\"cycle_id\":\"TRE\",\"name\":\"Investments existence and valuation\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Obtain evidence over investments and other financial assets.\",\"description\":\"Confirm holdings with custodians and registrars, agree acquisitions and disposals to contracts and cash, evaluate classification and measurement under the financial instruments framework, test fair values to quoted prices or evaluate valuation models with an expert where needed, and test impairment of equity-accounted investments.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-TRE-009\",\"term_id\":\"T-P-TRE-009\",\"cycle_id\":\"TRE\",\"name\":\"Foreign currency translation and derivatives\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"recalculation\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Obtain evidence over translation of foreign balances and derivative accounting.\",\"description\":\"Retranslate foreign currency monetary balances at the closing rates from an independent source, recalculate exchange differences, agree derivative positions to confirmations, evaluate hedge documentation and effectiveness, and evaluate disclosures.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-TRE-010\",\"term_id\":\"T-P-TRE-010\",\"cycle_id\":\"TRE\",\"name\":\"Cash flow statement and liquidity disclosures\",\"nature\":\"test_of_details\",\"timing\":\"completion\",\"evidence\":\"recalculation\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Obtain evidence that the cash flow statement and liquidity disclosures are correct.\",\"description\":\"Reconcile the cash flow statement to movements in the audited balances, test classification of operating, investing and financing items, and evaluate maturity, liquidity and capital management disclosures.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-EQY-001\",\"term_id\":\"T-P-EQY-001\",\"cycle_id\":\"EQY\",\"name\":\"Share capital agreement to statutory records\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Obtain evidence over issued capital and its changes.\",\"description\":\"Agree share capital to the commercial register extract, articles and share register, inspect approvals and cash received for issues, and evaluate treasury share transactions and premium.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-EQY-002\",\"term_id\":\"T-P-EQY-002\",\"cycle_id\":\"EQY\",\"name\":\"Reserves and legal reserve movements\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"recalculation\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Obtain evidence that reserve movements comply with law, the articles and the framework.\",\"description\":\"Recalculate the statutory legal reserve transfer required by the companies law and articles, agree revaluation, fair value and translation reserve movements to the underlying audited balances, and evaluate distributable reserves.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-EQY-003\",\"term_id\":\"T-P-EQY-003\",\"cycle_id\":\"EQY\",\"name\":\"Dividends and retained earnings\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"inspection\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Obtain evidence over dividends declared and paid and the reconciliation of retained earnings.\",\"description\":\"Agree dividends to general assembly minutes and payment, recalculate withholding tax on dividends, reconcile retained earnings from opening balance through profit, dividends and other movements, and evaluate disclosure of dividends proposed after the period end.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-EQY-004\",\"term_id\":\"T-P-EQY-004\",\"cycle_id\":\"EQY\",\"name\":\"Non-controlling interests and other equity\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"recalculation\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Obtain evidence over non-controlling interests and other components of equity.\",\"description\":\"Recalculate non-controlling interests from subsidiaries' audited results and ownership percentages, test changes in ownership without loss of control, and agree other comprehensive income components to the related audited balances.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-EQY-005\",\"term_id\":\"T-P-EQY-005\",\"cycle_id\":\"EQY\",\"name\":\"Statement of changes in equity and disclosures\",\"nature\":\"test_of_details\",\"timing\":\"completion\",\"evidence\":\"recalculation\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Ensure the statement of changes in equity and capital disclosures are complete and accurate.\",\"description\":\"Reconcile every column of the statement of changes in equity to the audited components, and evaluate disclosures of share classes, rights, restrictions and capital management.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-TAX-001\",\"term_id\":\"T-P-TAX-001\",\"cycle_id\":\"TAX\",\"name\":\"Current income tax computation\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"recalculation\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Obtain evidence over the current tax charge and liability.\",\"description\":\"Recalculate taxable profit from accounting profit through permanent and temporary adjustments under the tax law, apply the enacted rates, agree instalments and withholding credits to receipts and returns, and reconcile the liability to filed returns and assessments.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-TAX-002\",\"term_id\":\"T-P-TAX-002\",\"cycle_id\":\"TAX\",\"name\":\"Deferred tax proof\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"recalculation\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Obtain evidence over deferred tax balances and the effective rate reconciliation.\",\"description\":\"Recalculate temporary differences by category from the audited carrying amounts and tax bases, apply enacted rates, evaluate the recoverability of deferred tax assets against forecasts, reconcile the tax charge to the effective rate, and evaluate disclosures.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-TAX-003\",\"term_id\":\"T-P-TAX-003\",\"cycle_id\":\"TAX\",\"name\":\"Tax provisions and uncertain positions\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Evaluate provisions for open tax years and uncertain tax treatments.\",\"description\":\"Inspect assessments, appeals and correspondence with the tax authority, evaluate management's assessment of uncertain positions and the measurement of provisions, obtain tax adviser opinions, and evaluate disclosure of contingencies.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-TAX-004\",\"term_id\":\"T-P-TAX-004\",\"cycle_id\":\"TAX\",\"name\":\"VAT reconciliation to returns and e-invoicing\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"recalculation\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Obtain evidence over VAT liabilities and their consistency with revenue and purchases.\",\"description\":\"Reconcile output VAT to recorded taxable revenue and to e-invoices accepted on the tax authority portal, reconcile input VAT to recorded purchases, agree the period-end balance to filed returns and subsequent payment, and evaluate compliance with the filing obligations.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-TAX-005\",\"term_id\":\"T-P-TAX-005\",\"cycle_id\":\"TAX\",\"name\":\"Withholding tax compliance\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"recalculation\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Obtain evidence that withholding tax is deducted, remitted and recorded.\",\"description\":\"Select payments subject to withholding (suppliers, services, dividends, interest), recalculate the deduction under the tax law, agree remittances to returns and payments, and evaluate exposure for under-deduction.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-053\",\"term_id\":\"T-P-FSL-053\",\"cycle_id\":\"FSL\",\"name\":\"Facts becoming known after the report date\",\"nature\":\"completion\",\"timing\":\"completion\",\"evidence\":\"mixed\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Respond to facts that become known after the auditor's report is dated, before or after issue of the financial statements.\",\"description\":\"Discuss the fact with management and governance, determine whether the statements need amendment, audit any amendment, extend subsequent-events procedures or dual-date the report, issue a new or amended report with the required paragraph, and where management does not act take steps to prevent reliance on the report.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-054\",\"term_id\":\"T-P-FSL-054\",\"cycle_id\":\"FSL\",\"name\":\"Interim procedures roll-forward and reliance on prior-period control evidence\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"controls\",\"computation_id\":null,\"objective\":\"Extend interim conclusions to the period end and justify any reliance on controls tested in prior audits.\",\"description\":\"For substantive procedures and tests of controls performed at an interim date, obtain evidence about changes in the remaining period, perform roll-forward substantive procedures or combined tests of controls, and where controls tested in previous audits are relied on confirm no significant change by inquiry with observation or inspection and observe the three-year retesting rotation; controls over significant risks are always tested in the current period.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-055\",\"term_id\":\"T-P-FSL-055\",\"cycle_id\":\"FSL\",\"name\":\"Special purpose, single statement and summary financial statement engagements\",\"nature\":\"completion\",\"timing\":\"completion\",\"evidence\":\"mixed\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Apply the additional acceptance, performance and reporting considerations for special purpose frameworks, single statements or elements, and summary financial statements.\",\"description\":\"Understand the purpose, users and framework acceptability, adapt the ISAs, evaluate contractual interpretations, and prepare the report with the required description of purpose, emphasis-of-matter alert, separate opinions, differentiation from the complete set, and for summary statements the required elements, references to the audit report and any restriction or alert.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-PUR-012\",\"term_id\":\"T-P-PUR-012\",\"cycle_id\":\"PUR\",\"name\":\"Prepayments and advances testing\",\"nature\":\"test_of_details\",\"timing\":\"year_end\",\"evidence\":\"mixed\",\"population\":\"sub_ledger\",\"computation_id\":null,\"objective\":\"Obtain evidence over prepaid expenses and advances to suppliers.\",\"description\":\"Agree the prepayments listing to the ledger, vouch a sample to invoices and contracts, recalculate the unexpired portion by time apportionment, confirm or inspect supplier acknowledgements for significant advances, and evaluate recoverability of long-outstanding advances.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null},{\"id\":\"P-FSL-057\",\"term_id\":\"T-P-FSL-057\",\"cycle_id\":\"FSL\",\"name\":\"Disclosure checklist completion\",\"nature\":\"completion\",\"timing\":\"completion\",\"evidence\":\"inspection\",\"population\":\"documents\",\"computation_id\":null,\"objective\":\"Evaluate the financial statement disclosures against the applicable framework item by item.\",\"description\":\"Complete the disclosure checklist for the applicable framework (IFRS or Egyptian Accounting Standards): for each item record applicability, whether it is disclosed and where, evaluate the disclosure of significant accounting policies, estimates and judgments, and the adequacy of disclosures for material transactions and events; evaluate consistency with the audited balances and with the other information.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"mapping_status\":\"mapped\",\"unmapped_reason\":null}]"),
    ("qm_components", 13, "[{\"id\":\"QMC-LEAD\",\"term_id\":\"T-QMC-LEAD\",\"name\":\"Responsibilities and leadership accountability\",\"description\":\"Who is ultimately and operationally accountable for the system, and the understanding, authority, time and lines of communication they must have.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"isqm1_paragraphs\":\"17-22\",\"sort_order\":1},{\"id\":\"QMC-RISK\",\"term_id\":\"T-QMC-RISK\",\"name\":\"The firm's risk assessment process\",\"description\":\"The process that establishes quality objectives, identifies and assesses quality risks, designs responses, and detects when they must change.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"isqm1_paragraphs\":\"23-27\",\"sort_order\":2},{\"id\":\"QMC-GOV\",\"term_id\":\"T-QMC-GOV\",\"name\":\"Governance and leadership\",\"description\":\"The culture, accountability, structure and resourcing decisions that set the environment for the system.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"isqm1_paragraphs\":\"28\",\"sort_order\":3},{\"id\":\"QMC-ETH\",\"term_id\":\"T-QMC-ETH\",\"name\":\"Relevant ethical requirements\",\"description\":\"Understanding and fulfilment of ethical requirements including independence by the firm, its personnel, the network and service providers.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"isqm1_paragraphs\":\"29\",\"sort_order\":4},{\"id\":\"QMC-ACC\",\"term_id\":\"T-QMC-ACC\",\"name\":\"Acceptance and continuance\",\"description\":\"Judgments about accepting or continuing client relationships and engagements, and the priorities that must not distort them.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"isqm1_paragraphs\":\"30\",\"sort_order\":5},{\"id\":\"QMC-PERF\",\"term_id\":\"T-QMC-PERF\",\"name\":\"Engagement performance\",\"description\":\"Team responsibilities, direction and supervision, judgment and scepticism, consultation, differences of opinion, and documentation assembly and retention.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"isqm1_paragraphs\":\"31\",\"sort_order\":6},{\"id\":\"QMC-RES\",\"term_id\":\"T-QMC-RES\",\"name\":\"Resources\",\"description\":\"Human, technological and intellectual resources and those from service providers, obtained, developed, assigned and used to enable quality.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"isqm1_paragraphs\":\"32\",\"sort_order\":7},{\"id\":\"QMC-INFO\",\"term_id\":\"T-QMC-INFO\",\"name\":\"Information and communication\",\"description\":\"The information system, the culture of exchange, and communication within the firm and to external parties.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"isqm1_paragraphs\":\"33\",\"sort_order\":8},{\"id\":\"QMC-RESP\",\"term_id\":\"T-QMC-RESP\",\"name\":\"Specified responses\",\"description\":\"The responses every firm must implement irrespective of its risk assessment.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"isqm1_paragraphs\":\"34\",\"sort_order\":9},{\"id\":\"QMC-MON\",\"term_id\":\"T-QMC-MON\",\"name\":\"Monitoring and remediation\",\"description\":\"Monitoring activities including inspection of completed engagements, evaluation of findings and deficiencies, root cause analysis, remedial actions and communication.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"isqm1_paragraphs\":\"35-47\",\"sort_order\":10},{\"id\":\"QMC-NET\",\"term_id\":\"T-QMC-NET\",\"name\":\"Network requirements and services\",\"description\":\"Understanding, applying and evaluating network requirements and services, and monitoring performed by the network.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"isqm1_paragraphs\":\"48-52\",\"sort_order\":11},{\"id\":\"QMC-EVAL\",\"term_id\":\"T-QMC-EVAL\",\"name\":\"Evaluation of the system\",\"description\":\"The annual point-in-time evaluation and conclusion by the individual with ultimate responsibility, and performance evaluations of leadership.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"isqm1_paragraphs\":\"53-56\",\"sort_order\":12},{\"id\":\"QMC-DOC\",\"term_id\":\"T-QMC-DOC\",\"name\":\"Documentation\",\"description\":\"Documentation of the system, its content and its retention.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"isqm1_paragraphs\":\"57-60\",\"sort_order\":13}]"),
