    ("risks", 35, "[{\"id\":\"R-FSL-001\",\"term_id\":\"T-R-FSL-001\",\"name\":\"Management override of controls\",\"category\":\"fraud\",\"level\":\"financial_statement\",\"cycle_id\":null,\"significant\":1,\"presumed\":1,\"description\":\"Management can manipulate records and prepare fraudulent statements by overriding controls that otherwise operate; the risk is present in every entity and is a significant risk by standard.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-FSL-002\",\"term_id\":\"T-R-FSL-002\",\"name\":\"Fraudulent financial reporting incentives\",\"category\":\"fraud\",\"level\":\"financial_statement\",\"cycle_id\":null,\"significant\":1,\"presumed\":0,\"description\":\"Incentives or pressures such as covenant headroom, bonus targets, listing or financing needs create a risk of misstatement across the statements.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-FSL-003\",\"term_id\":\"T-R-FSL-003\",\"name\":\"Going concern uncertainty\",\"category\":\"inherent\",\"level\":\"financial_statement\",\"cycle_id\":null,\"significant\":1,\"presumed\":0,\"description\":\"Events or conditions such as losses, negative cash flows, covenant breaches or loss of financing cast doubt on the ability to continue as a going concern and affect the basis of preparation and disclosures.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-FSL-004\",\"term_id\":\"T-R-FSL-004\",\"name\":\"Weak control environment\",\"category\":\"control\",\"level\":\"financial_statement\",\"cycle_id\":null,\"significant\":0,\"presumed\":0,\"description\":\"A control environment that does not support integrity, competence and oversight undermines every other component and raises the risk of undetected misstatement pervasively.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-FSL-005\",\"term_id\":\"T-R-FSL-005\",\"name\":\"Risks arising from the use of IT\",\"category\":\"control\",\"level\":\"financial_statement\",\"cycle_id\":null,\"significant\":0,\"presumed\":0,\"description\":\"Unrestricted access, unauthorised program changes or failed interfaces can cause systematic misstatement of automated processing and undermine application controls relied on.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-FSL-006\",\"term_id\":\"T-R-FSL-006\",\"name\":\"Undisclosed related parties and transactions\",\"category\":\"fraud\",\"level\":\"financial_statement\",\"cycle_id\":null,\"significant\":1,\"presumed\":0,\"description\":\"Related-party relationships and transactions, especially with a dominant owner-manager, may be undisclosed or conducted on non-market terms and concealed within ordinary captions.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-FSL-007\",\"term_id\":\"T-R-FSL-007\",\"name\":\"Non-compliance with laws and regulations\",\"category\":\"inherent\",\"level\":\"financial_statement\",\"cycle_id\":null,\"significant\":0,\"presumed\":0,\"description\":\"Non-compliance with tax, companies, labour, sector or e-invoicing law can produce unrecorded liabilities, penalties, or consequences that affect the statements or the entity's ability to operate.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-FSL-008\",\"term_id\":\"T-R-FSL-008\",\"name\":\"Complex or judgmental accounting estimates\",\"category\":\"inherent\",\"level\":\"financial_statement\",\"cycle_id\":null,\"significant\":0,\"presumed\":0,\"description\":\"Estimates with high estimation uncertainty, complexity or subjectivity (expected credit losses, impairment, provisions, fair values, deferred tax recoverability) are susceptible to error and bias.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-FSL-009\",\"term_id\":\"T-R-FSL-009\",\"name\":\"Financial statement closing and disclosure errors\",\"category\":\"inherent\",\"level\":\"financial_statement\",\"cycle_id\":null,\"significant\":0,\"presumed\":0,\"description\":\"Manual consolidation, top-side adjustments, spreadsheet-based closing and complex disclosure requirements create a risk that the statements do not agree with the records or omit required disclosures.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-FSL-010\",\"term_id\":\"T-R-FSL-010\",\"name\":\"Group consolidation errors\",\"category\":\"inherent\",\"level\":\"financial_statement\",\"cycle_id\":null,\"significant\":0,\"presumed\":0,\"description\":\"Omitted components, incorrect eliminations, inconsistent policies and differing period ends can misstate the group financial statements.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-REV-001\",\"term_id\":\"T-R-REV-001\",\"name\":\"Revenue recognised before control transfers (cut-off and occurrence)\",\"category\":\"fraud\",\"level\":\"assertion\",\"cycle_id\":\"REV\",\"significant\":1,\"presumed\":1,\"description\":\"Sales recorded before delivery or service completion, bill-and-hold, side agreements and post-period reversals overstate revenue; presumed fraud risk under the standard.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-REV-002\",\"term_id\":\"T-R-REV-002\",\"name\":\"Fictitious or overstated sales\",\"category\":\"fraud\",\"level\":\"assertion\",\"cycle_id\":\"REV\",\"significant\":1,\"presumed\":0,\"description\":\"Sales to fictitious customers, duplicate invoices or inflated prices overstate revenue and receivables.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-REV-003\",\"term_id\":\"T-R-REV-003\",\"name\":\"Incomplete revenue and cash receipts\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"REV\",\"significant\":0,\"presumed\":0,\"description\":\"Unrecorded cash sales, unbilled deliveries and diverted receipts understate revenue and receivables, particularly in cash-intensive businesses.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-REV-004\",\"term_id\":\"T-R-REV-004\",\"name\":\"Expected credit loss allowance misstated\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"REV\",\"significant\":1,\"presumed\":0,\"description\":\"The loss allowance depends on ageing accuracy, historical loss rates and forward-looking assumptions and is susceptible to bias toward lower provisions.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-REV-005\",\"term_id\":\"T-R-REV-005\",\"name\":\"Contract balances misstated\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"REV\",\"significant\":0,\"presumed\":0,\"description\":\"Over-time revenue measured on progress estimates, deferred revenue release and customer advances are susceptible to error in timing and amount.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-PUR-001\",\"term_id\":\"T-R-PUR-001\",\"name\":\"Unrecorded liabilities and accruals\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"PUR\",\"significant\":0,\"presumed\":0,\"description\":\"Invoices received after the period end, unmatched receipts and unaccrued services understate payables and expenses.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-PUR-002\",\"term_id\":\"T-R-PUR-002\",\"name\":\"Fictitious or duplicate purchases and payments\",\"category\":\"fraud\",\"level\":\"assertion\",\"cycle_id\":\"PUR\",\"significant\":0,\"presumed\":0,\"description\":\"Payments to fictitious suppliers, duplicate invoices or unauthorised purchases misappropriate assets and overstate expenses.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-PUR-003\",\"term_id\":\"T-R-PUR-003\",\"name\":\"Provisions incomplete or misstated\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"PUR\",\"significant\":0,\"presumed\":0,\"description\":\"Obligations from litigation, warranties, restructuring and onerous contracts may be unrecognised or measured without adequate support.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-PUR-004\",\"term_id\":\"T-R-PUR-004\",\"name\":\"Expense misclassification and capitalisation\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"PUR\",\"significant\":0,\"presumed\":0,\"description\":\"Expenses may be capitalised to improve results, or capital items expensed, and costs allocated to the wrong captions.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-PAY-001\",\"term_id\":\"T-R-PAY-001\",\"name\":\"Fictitious employees and unauthorised pay\",\"category\":\"fraud\",\"level\":\"assertion\",\"cycle_id\":\"PAY\",\"significant\":0,\"presumed\":0,\"description\":\"Ghost employees, leavers still paid and unauthorised rate changes overstate staff costs and misappropriate cash.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-PAY-002\",\"term_id\":\"T-R-PAY-002\",\"name\":\"Payroll liabilities and statutory contributions incomplete\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"PAY\",\"significant\":0,\"presumed\":0,\"description\":\"Social insurance, payroll tax, bonus, leave and end-of-service obligations may be unrecorded or miscalculated.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-INV-001\",\"term_id\":\"T-R-INV-001\",\"name\":\"Inventory does not exist or is in poor condition\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"INV\",\"significant\":1,\"presumed\":0,\"description\":\"Recorded inventory may not exist, may be damaged or obsolete, or may be held by third parties without adequate evidence.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-INV-002\",\"term_id\":\"T-R-INV-002\",\"name\":\"Inventory cost misstated\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"INV\",\"significant\":0,\"presumed\":0,\"description\":\"Cost formulas, overhead absorption, standard cost variances and by-product allocations are susceptible to error.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-INV-003\",\"term_id\":\"T-R-INV-003\",\"name\":\"Net realisable value below cost\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"INV\",\"significant\":1,\"presumed\":0,\"description\":\"Slow-moving, obsolete or price-eroded inventory may be carried above net realisable value; the write-down is an estimate susceptible to bias.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-INV-004\",\"term_id\":\"T-R-INV-004\",\"name\":\"Inventory cut-off inconsistent with purchases and sales\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"INV\",\"significant\":0,\"presumed\":0,\"description\":\"Goods in transit and period-end movements may be counted without the corresponding liability or sale, or vice versa.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-PPE-001\",\"term_id\":\"T-R-PPE-001\",\"name\":\"Additions do not exist or are not capitalisable\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"PPE\",\"significant\":0,\"presumed\":0,\"description\":\"Recorded additions may be fictitious, may include costs that should be expensed, or may belong to related parties.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-PPE-002\",\"term_id\":\"T-R-PPE-002\",\"name\":\"Depreciation and useful lives misstated\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"PPE\",\"significant\":0,\"presumed\":0,\"description\":\"Useful lives, residual values and methods may not reflect consumption, and the register may not reconcile to the ledger.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-PPE-003\",\"term_id\":\"T-R-PPE-003\",\"name\":\"Impairment not recognised\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"PPE\",\"significant\":1,\"presumed\":0,\"description\":\"Indicators of impairment may be ignored, or value-in-use models may use unsupported assumptions, leaving assets and goodwill overstated.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-PPE-004\",\"term_id\":\"T-R-PPE-004\",\"name\":\"Lease accounting incomplete or mismeasured\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"PPE\",\"significant\":0,\"presumed\":0,\"description\":\"Leases may be omitted from the register, or right-of-use assets and liabilities measured with wrong terms or rates.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-TRE-001\",\"term_id\":\"T-R-TRE-001\",\"name\":\"Cash misappropriation and unrecorded bank accounts\",\"category\":\"fraud\",\"level\":\"assertion\",\"cycle_id\":\"TRE\",\"significant\":0,\"presumed\":0,\"description\":\"Cash may be diverted, bank accounts omitted from the records, or reconciliations manipulated to conceal shortages.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-TRE-002\",\"term_id\":\"T-R-TRE-002\",\"name\":\"Borrowings misclassified or covenants breached\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"TRE\",\"significant\":0,\"presumed\":0,\"description\":\"Breached covenants without waivers require current classification and may indicate going concern issues; accrued interest and fees may be misstated.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-TRE-003\",\"term_id\":\"T-R-TRE-003\",\"name\":\"Investments and financial instruments mismeasured\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"TRE\",\"significant\":0,\"presumed\":0,\"description\":\"Classification under the financial instruments framework and fair values from models or inactive markets are complex and judgmental.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-EQY-001\",\"term_id\":\"T-R-EQY-001\",\"name\":\"Equity transactions not authorised or reserves non-compliant\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"EQY\",\"significant\":0,\"presumed\":0,\"description\":\"Capital changes, dividends and reserve transfers may lack the required approvals or breach the companies law and articles.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-TAX-001\",\"term_id\":\"T-R-TAX-001\",\"name\":\"Income tax computation and deferred tax misstated\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"TAX\",\"significant\":0,\"presumed\":0,\"description\":\"Tax adjustments, rate changes, loss recoverability and uncertain positions make the tax charge and balances susceptible to error and bias.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"},{\"id\":\"R-TAX-002\",\"term_id\":\"T-R-TAX-002\",\"name\":\"VAT and withholding tax non-compliance\",\"category\":\"inherent\",\"level\":\"assertion\",\"cycle_id\":\"TAX\",\"significant\":0,\"presumed\":0,\"description\":\"Output VAT not reconciled to e-invoicing submissions, input VAT overclaimed, or withholding not deducted creates unrecorded liabilities and penalties.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\"}]"),
    ("selection_methods", 10, "[{\"id\":\"SM-RANDOM\",\"term_id\":\"T-SM-RANDOM\",\"name\":\"Random selection\",\"statistical\":1,\"is_sampling\":1,\"computation_id\":\"CALC-MUS\",\"description\":\"Every sampling unit has an equal chance; selected with a documented seed so the selection is reproducible.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"sort_order\":1},{\"id\":\"SM-SYSTEMATIC\",\"term_id\":\"T-SM-SYSTEMATIC\",\"name\":\"Systematic (interval) selection\",\"statistical\":1,\"is_sampling\":1,\"computation_id\":\"CALC-MUS\",\"description\":\"A fixed interval through the population from a random start; monetary unit sampling is systematic selection over cumulative value.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"sort_order\":2},{\"id\":\"SM-MUS\",\"term_id\":\"T-SM-MUS\",\"name\":\"Monetary unit sampling\",\"statistical\":1,\"is_sampling\":1,\"computation_id\":\"CALC-MUS\",\"description\":\"Value-weighted systematic selection where each monetary unit is a sampling unit and larger items are more likely to be selected.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"sort_order\":3},{\"id\":\"SM-STRATIFIED\",\"term_id\":\"T-SM-STRATIFIED\",\"name\":\"Stratified random selection\",\"statistical\":1,\"is_sampling\":1,\"computation_id\":\"CALC-MUS\",\"description\":\"The population is divided into strata with distinct characteristics and each stratum is sampled; results are evaluated per stratum and combined.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"sort_order\":4},{\"id\":\"SM-ATTRIBUTE\",\"term_id\":\"T-SM-ATTRIBUTE\",\"name\":\"Attribute sampling\",\"statistical\":1,\"is_sampling\":1,\"computation_id\":\"CALC-ATTRIBUTE\",\"description\":\"Selection sized and evaluated for a rate of deviation from a control, evaluated against the tolerable rate.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"sort_order\":5},{\"id\":\"SM-HAPHAZARD\",\"term_id\":\"T-SM-HAPHAZARD\",\"name\":\"Haphazard selection\",\"statistical\":0,\"is_sampling\":1,\"computation_id\":null,\"description\":\"Selection without a structured technique, avoiding conscious bias; conclusions extend to the population but the sampling risk is not measured.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"sort_order\":6},{\"id\":\"SM-BLOCK\",\"term_id\":\"T-SM-BLOCK\",\"name\":\"Block selection\",\"statistical\":0,\"is_sampling\":1,\"computation_id\":null,\"description\":\"Contiguous items selected together; rarely an appropriate sampling technique because most populations are structured so that items in sequence share characteristics.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"sort_order\":7},{\"id\":\"SM-SPECIFIC\",\"term_id\":\"T-SM-SPECIFIC\",\"name\":\"Specific item selection\",\"statistical\":0,\"is_sampling\":0,\"computation_id\":null,\"description\":\"High-value, key or unusual items selected by judgment; not sampling, so the results do not extend to the remainder of the population, which must be addressed separately.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"sort_order\":8},{\"id\":\"SM-RISK-RANKED\",\"term_id\":\"T-SM-RISK-RANKED\",\"name\":\"Risk-ranked selection\",\"statistical\":0,\"is_sampling\":0,\"computation_id\":null,\"description\":\"Items ranked by a scoring rule or a tool and selected from the top; non-statistical, and where the rule is a model the reproducibility of the ranking must be recorded with the evidence.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"sort_order\":9},{\"id\":\"SM-COVERAGE\",\"term_id\":\"T-SM-COVERAGE\",\"name\":\"Coverage selection\",\"statistical\":0,\"is_sampling\":0,\"computation_id\":null,\"description\":\"Items selected in descending value until a stated proportion of the population value is covered; not sampling, the remainder needs its own response.\",\"description_ar\":null,\"description_ar_status\":\"pending_draft\",\"sort_order\":10}]"),
    ("standards", 76, "[{\"id\":\"ISA-200\",\"family\":\"ISA\",\"number\":\"200\",\"title\":\"Overall objectives of the independent auditor and the conduct of an audit\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009, as amended by later conforming changes.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Overall objectives, ethical requirements, professional scepticism and judgment, sufficient appropriate evidence, and conduct of an audit in accordance with the ISAs.\",\"term_id\":\"T-STD-ISA-200\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-210\",\"family\":\"ISA\",\"number\":\"210\",\"title\":\"Agreeing the terms of audit engagements\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009, as amended.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Preconditions for an audit, agreement of engagement terms, recurring audits and changes in terms.\",\"term_id\":\"T-STD-ISA-210\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-220\",\"family\":\"ISA\",\"number\":\"220\",\"title\":\"Quality management for an audit of financial statements\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"ISA 220 (Revised): effective for audits of periods beginning on or after 15 December 2022.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Engagement-level quality management: leadership, ethics and independence, acceptance and continuance, resources, engagement performance, review, documentation.\",\"term_id\":\"T-STD-ISA-220\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-230\",\"family\":\"ISA\",\"number\":\"230\",\"title\":\"Audit documentation\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009, as amended.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Timely preparation, form, content and extent of documentation, assembly of the final file, and retention.\",\"term_id\":\"T-STD-ISA-230\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240\",\"family\":\"ISA\",\"number\":\"240\",\"title\":\"The auditor's responsibilities relating to fraud\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Extant ISA 240: effective for audits of periods beginning on or after 15 December 2009, as amended. Superseded by ISA 240 (Revised) for periods beginning on or after 15 December 2026.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Professional scepticism, engagement team discussion, fraud risk assessment, presumed risks in revenue recognition and management override, responses, evaluation of evidence, representations and communications.\",\"term_id\":\"T-STD-ISA-240\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-250\",\"family\":\"ISA\",\"number\":\"250\",\"title\":\"Consideration of laws and regulations\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"ISA 250 (Revised): effective for audits of periods beginning on or after 15 December 2017.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Obtaining understanding of the legal framework, procedures on compliance, responses to identified or suspected non-compliance, reporting and documentation.\",\"term_id\":\"T-STD-ISA-250\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-260\",\"family\":\"ISA\",\"number\":\"260\",\"title\":\"Communication with those charged with governance\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"ISA 260 (Revised): effective for audits of periods beginning on or after 15 December 2016.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Identification of those charged with governance, matters to be communicated, the communication process and documentation.\",\"term_id\":\"T-STD-ISA-260\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-265\",\"family\":\"ISA\",\"number\":\"265\",\"title\":\"Communicating deficiencies in internal control\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Determination of whether deficiencies are significant, and written communication of significant deficiencies to those charged with governance and management.\",\"term_id\":\"T-STD-ISA-265\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-300\",\"family\":\"ISA\",\"number\":\"300\",\"title\":\"Planning an audit of financial statements\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009, as amended.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Involvement of key engagement team members, preliminary engagement activities, overall audit strategy and audit plan, changes during the audit, direction and supervision, initial engagement considerations and documentation.\",\"term_id\":\"T-STD-ISA-300\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-315\",\"family\":\"ISA\",\"number\":\"315\",\"title\":\"Identifying and assessing the risks of material misstatement\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"ISA 315 (Revised 2019): effective for audits of periods beginning on or after 15 December 2021.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Risk assessment procedures, understanding the entity and its environment, the applicable framework and the system of internal control, identification and assessment of risks at the financial-statement and assertion levels, significant risks, stand-back and documentation.\",\"term_id\":\"T-STD-ISA-315\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-320\",\"family\":\"ISA\",\"number\":\"320\",\"title\":\"Materiality in planning and performing an audit\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009, as amended.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Materiality for the financial statements as a whole, materiality for particular classes of transactions, balances or disclosures, performance materiality, revision during the audit and documentation.\",\"term_id\":\"T-STD-ISA-320\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-330\",\"family\":\"ISA\",\"number\":\"330\",\"title\":\"The auditor's responses to assessed risks\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009, as amended.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Overall responses, further audit procedures responsive to assessed risks, tests of controls, substantive procedures, adequacy of presentation, sufficiency of evidence and documentation.\",\"term_id\":\"T-STD-ISA-330\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-402\",\"family\":\"ISA\",\"number\":\"402\",\"title\":\"Audit considerations relating to an entity using a service organization\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009, as amended.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Understanding services provided, responding to assessed risks including use of type 1 and type 2 reports, and reporting.\",\"term_id\":\"T-STD-ISA-402\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-450\",\"family\":\"ISA\",\"number\":\"450\",\"title\":\"Evaluation of misstatements identified during the audit\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009, as amended.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Accumulation of misstatements, consideration as the audit progresses, communication and correction, evaluation of the effect of uncorrected misstatements, written representations and documentation.\",\"term_id\":\"T-STD-ISA-450\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-500\",\"family\":\"ISA\",\"number\":\"500\",\"title\":\"Audit evidence\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009, as amended. ISA 500 (Revised) applies for periods beginning on or after 15 December 2026.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Sufficient appropriate audit evidence, information to be used as evidence, selecting items for testing, and inconsistency or doubts over reliability.\",\"term_id\":\"T-AUDIT-EVIDENCE\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-501\",\"family\":\"ISA\",\"number\":\"501\",\"title\":\"Audit evidence: specific considerations for selected items\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009, as amended.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Inventory (attendance at physical counting), litigation and claims, and segment information.\",\"term_id\":\"T-STD-ISA-501\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-505\",\"family\":\"ISA\",\"number\":\"505\",\"title\":\"External confirmations\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009, as amended.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Design and control of confirmation requests, management refusal, reliability of responses, non-responses, negative confirmations and evaluation of evidence obtained.\",\"term_id\":\"T-STD-ISA-505\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-510\",\"family\":\"ISA\",\"number\":\"510\",\"title\":\"Initial audit engagements: opening balances\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009, as amended.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Procedures on opening balances, consistency of accounting policies, relevant information in the predecessor's report and reporting conclusions.\",\"term_id\":\"T-STD-ISA-510\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-520\",\"family\":\"ISA\",\"number\":\"520\",\"title\":\"Analytical procedures\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009, as amended.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Substantive analytical procedures, analytical procedures that assist when forming an overall conclusion, and investigation of results.\",\"term_id\":\"T-ANALYTICAL-PROCEDURES\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-530\",\"family\":\"ISA\",\"number\":\"530\",\"title\":\"Audit sampling\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009, as amended.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Sample design, size and selection, performing procedures, nature and cause of deviations and misstatements, projecting misstatements and evaluating results.\",\"term_id\":\"T-AUDIT-SAMPLING\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-540\",\"family\":\"ISA\",\"number\":\"540\",\"title\":\"Auditing accounting estimates and related disclosures\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"ISA 540 (Revised): effective for audits of periods beginning on or after 15 December 2019.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Risk assessment procedures for estimates, identification and assessment of risks including estimation uncertainty, responses (events after period end, testing management's process, developing a point estimate or range), disclosures, indicators of bias, overall evaluation, representations, communication and documentation.\",\"term_id\":\"T-STD-ISA-540\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-550\",\"family\":\"ISA\",\"number\":\"550\",\"title\":\"Related parties\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009, as amended.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Risk assessment procedures and related activities, identification and assessment of risks, responses to significant related-party transactions outside the normal course of business, evaluation of accounting and disclosure, representations, communication and documentation.\",\"term_id\":\"T-STD-ISA-550\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-560\",\"family\":\"ISA\",\"number\":\"560\",\"title\":\"Subsequent events\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009, as amended.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Events between the period end and the auditor's report date, facts that become known after the report date but before issue, and facts that become known after the financial statements have been issued.\",\"term_id\":\"T-SUBSEQUENT-EVENTS\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570\",\"family\":\"ISA\",\"number\":\"570\",\"title\":\"Going concern\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"ISA 570 (Revised): effective for audits of periods beginning on or after 15 December 2016. Superseded by ISA 570 (Revised 2024) for periods beginning on or after 15 December 2026.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Risk assessment procedures, evaluation of management's assessment, period beyond management's assessment, additional procedures when events or conditions are identified, conclusions, implications for the report, communication and delay in approval.\",\"term_id\":\"T-GOING-CONCERN\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-580\",\"family\":\"ISA\",\"number\":\"580\",\"title\":\"Written representations\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009, as amended.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Management from whom representations are requested, representations about responsibilities and other representations, date and period covered, doubt as to reliability and refusal to provide representations.\",\"term_id\":\"T-WRITTEN-REPRESENTATION\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-600\",\"family\":\"ISA\",\"number\":\"600\",\"title\":\"Special considerations: audits of group financial statements\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"ISA 600 (Revised): effective for audits of group financial statements for periods beginning on or after 15 December 2023.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Group engagement partner responsibilities, acceptance and continuance, overall strategy and plan, understanding the group and components, materiality, responding to assessed risks, component auditors, consolidation process, subsequent events, evaluation of evidence, communication and documentation.\",\"term_id\":\"T-STD-ISA-600\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-610\",\"family\":\"ISA\",\"number\":\"610\",\"title\":\"Using the work of internal auditors\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"ISA 610 (Revised 2013): effective for audits of periods beginning on or after 15 December 2014.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Determining whether, in which areas and to what extent the work of the internal audit function can be used; using internal auditors to provide direct assistance; documentation.\",\"term_id\":\"T-STD-ISA-610\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-620\",\"family\":\"ISA\",\"number\":\"620\",\"title\":\"Using the work of an auditor's expert\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009, as amended.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Determining the need for an expert, nature timing and extent of procedures, competence capabilities and objectivity, understanding the field, agreement with the expert, evaluating adequacy of the expert's work, and reference in the report.\",\"term_id\":\"T-STD-ISA-620\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-700\",\"family\":\"ISA\",\"number\":\"700\",\"title\":\"Forming an opinion and reporting on financial statements\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"ISA 700 (Revised): effective for audits of periods ending on or after 15 December 2016, as amended.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Forming the opinion, form of opinion, content and structure of the auditor's report, supplementary information.\",\"term_id\":\"T-STD-ISA-700\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-701\",\"family\":\"ISA\",\"number\":\"701\",\"title\":\"Communicating key audit matters\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods ending on or after 15 December 2016.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Determining key audit matters, communicating them in the report, communication with those charged with governance and documentation.\",\"term_id\":\"T-STD-ISA-701\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-705\",\"family\":\"ISA\",\"number\":\"705\",\"title\":\"Modifications to the opinion\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"ISA 705 (Revised): effective for audits of periods ending on or after 15 December 2016.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Circumstances when a modification is required, determining the type of modification (qualified, adverse, disclaimer), form and content of the report when the opinion is modified, communication with those charged with governance.\",\"term_id\":\"T-STD-ISA-705\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-706\",\"family\":\"ISA\",\"number\":\"706\",\"title\":\"Emphasis of matter and other matter paragraphs\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"ISA 706 (Revised): effective for audits of periods ending on or after 15 December 2016.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"When and how to include emphasis of matter and other matter paragraphs, and communication with those charged with governance.\",\"term_id\":\"T-STD-ISA-706\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-710\",\"family\":\"ISA\",\"number\":\"710\",\"title\":\"Comparative information\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2009, as amended.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Audit procedures on corresponding figures and comparative financial statements, and audit reporting for each approach.\",\"term_id\":\"T-STD-ISA-710\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-720\",\"family\":\"ISA\",\"number\":\"720\",\"title\":\"The auditor's responsibilities relating to other information\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"ISA 720 (Revised): effective for audits of periods ending on or after 15 December 2016.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Obtaining the other information, reading and considering it, responding to material inconsistencies and misstatements, reporting and documentation.\",\"term_id\":\"T-STD-ISA-720\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-800\",\"family\":\"ISA\",\"number\":\"800\",\"title\":\"Special considerations: audits of financial statements prepared under special purpose frameworks\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"ISA 800 (Revised): effective for audits of periods ending on or after 15 December 2016.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Acceptance, planning and performing, and reporting considerations for special purpose financial statements.\",\"term_id\":\"T-STD-ISA-800\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-805\",\"family\":\"ISA\",\"number\":\"805\",\"title\":\"Special considerations: audits of single financial statements and specific elements\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"ISA 805 (Revised): effective for audits of periods ending on or after 15 December 2016.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Acceptance, planning, performing and reporting considerations for single statements and specific elements, accounts or items.\",\"term_id\":\"T-STD-ISA-805\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-810\",\"family\":\"ISA\",\"number\":\"810\",\"title\":\"Engagements to report on summary financial statements\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"ISA 810 (Revised): effective for engagements for periods ending on or after 15 December 2016.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Acceptance, procedures, form of opinion and the report on summary financial statements.\",\"term_id\":\"T-STD-ISA-810\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-240R\",\"family\":\"ISA\",\"number\":\"240R\",\"title\":\"The auditor's responsibilities relating to fraud (Revised)\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"ISA 240 (Revised): effective for audits of periods beginning on or after 15 December 2026. Not yet in force; carried so that engagements for those periods can be mapped before the effective date.\",\"equivalent_of\":null,\"supersedes\":\"ISA-240\",\"in_force\":0,\"scope\":\"Revised fraud standard: strengthened scepticism, fraud risk assessment and response requirements, communication and transparency in the auditor's report.\",\"term_id\":\"T-STD-ISA-240R\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISA-570R\",\"family\":\"ISA\",\"number\":\"570R\",\"title\":\"Going concern (Revised 2024)\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"ISA 570 (Revised 2024): effective for audits of periods beginning on or after 15 December 2026. Not yet in force; carried so that engagements for those periods can be mapped before the effective date.\",\"equivalent_of\":null,\"supersedes\":\"ISA-570\",\"in_force\":0,\"scope\":\"Revised going concern standard: enhanced risk assessment, evaluation of management's assessment over at least twelve months from the date of approval, evaluation of disclosures, and expanded reporting including material uncertainty and close-call disclosures.\",\"term_id\":\"T-STD-ISA-570R\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-1\",\"family\":\"ISQM\",\"number\":\"1\",\"title\":\"Quality management for firms that perform audits or reviews\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Systems of quality management designed and implemented by 15 December 2022.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Firm-level system of quality management: governance and leadership, risk assessment process, ethical requirements, acceptance and continuance, engagement performance, resources, information and communication, monitoring and remediation, network requirements, evaluation and documentation.\",\"term_id\":\"T-STD-ISQM-1\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ISQM-2\",\"family\":\"ISQM\",\"number\":\"2\",\"title\":\"Engagement quality reviews\",\"jurisdiction\":\"INTL\",\"issuer\":\"IAASB\",\"edition\":\"IAASB 2025 Handbook, Volume I (published September 2025)\",\"effective_note\":\"Effective for audits of periods beginning on or after 15 December 2022.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Appointment and eligibility of engagement quality reviewers, performance of the review, and documentation.\",\"term_id\":\"T-STD-ISQM-2\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"IESBA-CODE\",\"family\":\"IESBA\",\"number\":\"CODE\",\"title\":\"International Code of Ethics for Professional Accountants (including International Independence Standards)\",\"jurisdiction\":\"INTL\",\"issuer\":\"IESBA\",\"edition\":\"IESBA Handbook of the International Code of Ethics for Professional Accountants, 2024 edition\",\"effective_note\":\"Restructured Code effective 15 June 2019, with later revisions (fees, non-assurance services, public interest entity definition, technology, group audits) effective through 2024.\",\"equivalent_of\":null,\"supersedes\":null,\"in_force\":1,\"scope\":\"Fundamental principles, conceptual framework, and the International Independence Standards for audit and review engagements (Part 4A).\",\"term_id\":\"T-STD-IESBA-CODE\",\"scope_ar\":null,\"scope_ar_status\":\"pending_draft\"},{\"id\":\"ESA-200\",\"family\":\"ESA\",\"number\":\"200\",\"title\":\"Egyptian Standard on Auditing 200: Overall objectives of the independent auditor and the conduct of an audit\",\"jurisdiction\":\"EG\",\"issuer\":\"Egyptian Standing Committee for Accounting and Auditing Standards (Ministry of Investment; reorganised under Prime Ministerial Decree 2115 of 2023)\",\"edition\":\"Egyptian Standards on Auditing, Limited Review and Other Assurance Engagements, issued by Ministerial Decree 166 of 2008 (38 standards, numbered to match the ISAs); replaced by the standards approved by Prime Ministerial Decree 3725 of 2025 from 1 January 2027.\",\"effective_note\":\"The 2008 standard applies to audits 