module {
  /// (form id, form definition as JSON), forms 39 onwards at version 1, in catalogue order.
  public let FORMS : [(Text, Text)] = [
    ("F39-WITHDRAWAL", "{\"id\":\"F39-WITHDRAWAL\",\"number\":39,\"kind\":\"worksheet\",\"phase\":\"completion\",\"title\":{\"en\":\"Withdrawal from the engagement\",\"ar\":\"الانسحاب من الارتباط\"},\"purpose\":{\"en\":\"Record the ground for withdrawing from the engagement, the consultation and the firm's approval, the communications made, and the implications for the auditor's report, before the partner withdraws.\",\"ar\":\"تسجيل سبب الانسحاب من الارتباط، والمشاورة وموافقة المكتب، والمراسلات التي تمت، وآثار ذلك على تقرير المراجع، قبل أن ينسحب الشريك.\"},\"procedures\":[\"P-FSL-050\"],\"standards\":[\"ISA-210\",\"ISA-240\",\"ISA-250\",\"ISA-220\",\"ISA-705\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"grounds\",\"title\":{\"en\":\"The ground and the circumstances\",\"ar\":\"السبب والظروف\"},\"fields\":[{\"id\":\"ground\",\"label\":{\"en\":\"Ground for withdrawal\",\"ar\":\"سبب الانسحاب\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"scope_limitation\",\"label\":{\"en\":\"Management imposes a limitation on scope, or a change of terms cannot be agreed (ISA 210.17)\",\"ar\":\"الإدارة تفرض قيداً على النطاق، أو تعذر الاتفاق على تغيير الشروط (معيار 210 فقرة 17)\"}},{\"value\":\"fraud\",\"label\":{\"en\":\"Fraud or suspected fraud brings the engagement into question (ISA 240.38)\",\"ar\":\"غش أو اشتباه في غش يضع الارتباط موضع تساؤل (معيار 240 فقرة 38)\"}},{\"value\":\"non_compliance\",\"label\":{\"en\":\"Non-compliance with laws and regulations (ISA 250.19)\",\"ar\":\"عدم الامتثال للقوانين واللوائح (معيار 250 فقرة 19)\"}},{\"value\":\"independence\",\"label\":{\"en\":\"A threat to independence that cannot be reduced to an acceptable level\",\"ar\":\"تهديد للاستقلال لا يمكن تخفيضه إلى مستوى مقبول\"}},{\"value\":\"other\",\"label\":{\"en\":\"Another ground, stated below\",\"ar\":\"سبب آخر، مبين أدناه\"}}]},{\"id\":\"circumstances\",\"label\":{\"en\":\"The circumstances: what was found, when, and how management responded\",\"ar\":\"الظروف: ما تم اكتشافه، ومتى، وكيف استجابت الإدارة\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"alternatives\",\"label\":{\"en\":\"Why continuing is not possible, and what constrains withdrawing (legal or regulatory duties, ISA 240.38(b), ISA 250.19)\",\"ar\":\"لماذا لا يمكن الاستمرار، وما الذي يقيد الانسحاب (واجبات قانونية أو تنظيمية، معيار 240 فقرة 38(ب)، معيار 250 فقرة 19)\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"consultation\",\"label\":{\"en\":\"The consultation the firm's policy requires (the record, agreed)\",\"ar\":\"المشاورة التي تتطلبها سياسة المكتب (السجل، متفق عليه)\"},\"type\":\"text\",\"required\":true,\"cites\":[\"RK-CONSULTATION\"],\"help\":{\"en\":\"The record number of the consultation on the withdrawal: it is cited only once its conclusion is agreed (ISA 220.35).\",\"ar\":\"رقم سجل المشاورة بشأن الانسحاب: لا يُستشهد به إلا بعد الاتفاق على استنتاجه (معيار 220 فقرة 35).\"}},{\"id\":\"firm_approved_by\",\"label\":{\"en\":\"Firm approval: by whom\",\"ar\":\"موافقة المكتب: من\"},\"type\":\"text\",\"required\":true},{\"id\":\"firm_approved_on\",\"label\":{\"en\":\"Firm approval: on\",\"ar\":\"موافقة المكتب: في\"},\"type\":\"date\",\"required\":true}]},{\"id\":\"communications\",\"title\":{\"en\":\"Communications\",\"ar\":\"المراسلات\"},\"fields\":[{\"id\":\"management_discussed\",\"label\":{\"en\":\"The reasons discussed with the appropriate level of management (ISA 240.38(c), ISA 250.19)\",\"ar\":\"نوقشت الأسباب مع المستوى المناسب من الإدارة (معيار 240 فقرة 38(ج)، معيار 250 فقرة 19)\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"tcwg_discussed\",\"label\":{\"en\":\"The reasons discussed with those charged with governance; the written communication follows the withdrawal\",\"ar\":\"نوقشت الأسباب مع المكلفين بالحوكمة؛ ويلي الانسحابَ الإبلاغ الكتابي\"},\"type\":\"yesno\",\"required\":true},{\"id\":\"regulator\",\"label\":{\"en\":\"Regulator or other authority\",\"ar\":\"الجهة الرقابية أو أي سلطة أخرى\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"not_required\",\"label\":{\"en\":\"Not required\",\"ar\":\"غير مطلوب\"}},{\"value\":\"notified\",\"label\":{\"en\":\"Notified\",\"ar\":\"تم الإبلاغ\"}},{\"value\":\"to_be_notified\",\"label\":{\"en\":\"To be notified by the date stated\",\"ar\":\"سيتم الإبلاغ بحلول التاريخ المبين\"}}]},{\"id\":\"regulator_note\",\"label\":{\"en\":\"Which authority, on what duty, by when\",\"ar\":\"أي جهة، وبموجب أي واجب، وبحلول متى\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"successor_note\",\"label\":{\"en\":\"What a successor auditor will be told on inquiry\",\"ar\":\"ما سيُبلَّغ به المراجع الخلف عند الاستفسار\"},\"type\":\"textarea\",\"required\":false}]},{\"id\":\"report\",\"title\":{\"en\":\"The report and the date\",\"ar\":\"التقرير والتاريخ\"},\"fields\":[{\"id\":\"report_implication\",\"label\":{\"en\":\"Implication for the auditor's report\",\"ar\":\"الأثر على تقرير المراجع\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"no_report\",\"label\":{\"en\":\"No auditor's report is issued\",\"ar\":\"لا يصدر تقرير للمراجع\"}},{\"value\":\"report_withdrawn\",\"label\":{\"en\":\"A report already issued is withdrawn\",\"ar\":\"يُسحب تقرير صدر بالفعل\"}},{\"value\":\"disclaimer\",\"label\":{\"en\":\"A disclaimer of opinion is issued (ISA 705.13)\",\"ar\":\"يصدر امتناع عن إبداء الرأي (معيار 705 فقرة 13)\"}}]},{\"id\":\"report_note\",\"label\":{\"en\":\"The matters the report or its withdrawal states\",\"ar\":\"الأمور التي يبينها التقرير أو سحبه\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"withdrawal_date\",\"label\":{\"en\":\"Date of withdrawal\",\"ar\":\"تاريخ الانسحاب\"},\"type\":\"date\",\"required\":true}]}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F40-BALANCE-ANALYTICS", "{\"id\":\"F40-BALANCE-ANALYTICS\",\"number\":40,\"kind\":\"worksheet\",\"phase\":\"fieldwork\",\"per\":\"leadsheet\",\"title\":{\"en\":\"Substantive analytical procedure: {leadsheet_name} ({leadsheet})\",\"ar\":\"إجراء تحليلي أساسي: {leadsheet_name} ({leadsheet})\"},\"purpose\":{\"en\":\"Build an expectation for the balance, set the difference that is acceptable without investigation, compare the recorded balance with the expectation, and investigate any difference beyond it.\",\"ar\":\"بناء توقع للرصيد، وتحديد الفرق المقبول دون فحص، ومقارنة الرصيد المسجل بالتوقع، وفحص أي فرق يتجاوزه.\"},\"procedures\":[],\"standards\":[\"ISA-520\",\"ISA-330\"],\"computation\":\"analytical_review\",\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"balance\",\"title\":{\"en\":\"The balance\",\"ar\":\"الرصيد\"},\"fields\":[{\"id\":\"recorded\",\"label\":{\"en\":\"Recorded balance, adjusted ({leadsheet})\",\"ar\":\"الرصيد المسجل بعد التعديل ({leadsheet})\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.{leadsheet}\",\"readonly\":true},{\"id\":\"prior\",\"label\":{\"en\":\"Prior period balance\",\"ar\":\"رصيد الفترة السابقة\"},\"type\":\"money\",\"required\":false,\"autofill\":\"tb.leadsheet.{leadsheet}.prior\",\"readonly\":true},{\"id\":\"performance_materiality\",\"label\":{\"en\":\"Performance materiality\",\"ar\":\"مادية الأداء\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.materiality.performance\",\"readonly\":true},{\"id\":\"suitability\",\"label\":{\"en\":\"Why a substantive analytical procedure suits the assertions on this balance\",\"ar\":\"لماذا يناسب الإجراء التحليلي الأساسي التأكيدات على هذا الرصيد\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"data_reliability\",\"label\":{\"en\":\"Reliability of the data the expectation is built from: source, controls over it, and evidence of its accuracy\",\"ar\":\"موثوقية البيانات التي بُني عليها التوقع: مصدرها، والرقابة عليها، وأدلة دقتها\"},\"type\":\"textarea\",\"required\":true}],\"note\":{\"en\":\"The recorded balance is the leadsheet's adjusted balance, frozen when the paper is prepared; a later trial balance or a booked entry drifts it.\",\"ar\":\"الرصيد المسجل هو الرصيد المعدّل للورقة الرئيسية، ويُثبت عند إعداد الورقة؛ ويؤدي ميزان لاحق أو قيد مقيد إلى انحرافه.\"}},{\"id\":\"expectation\",\"title\":{\"en\":\"The expectation and its precision\",\"ar\":\"التوقع ودقته\"},\"fields\":[{\"id\":\"model\",\"label\":{\"en\":\"How the expectation is built\",\"ar\":\"كيفية بناء التوقع\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"prior_growth\",\"label\":{\"en\":\"Prior period balance grown by a rate\",\"ar\":\"رصيد الفترة السابقة مضافاً إليه معدل نمو\"}},{\"value\":\"driver_product\",\"label\":{\"en\":\"Product of drivers (volume by price, balance by rate)\",\"ar\":\"حاصل ضرب المحركات (الكمية في السعر، الرصيد في المعدل)\"}},{\"value\":\"ratio_to_base\",\"label\":{\"en\":\"Ratio to a base balance\",\"ar\":\"نسبة إلى رصيد أساس\"}},{\"value\":\"proof_in_total\",\"label\":{\"en\":\"Proof in total from components\",\"ar\":\"إثبات إجمالي من المكونات\"}}]},{\"id\":\"growth_pct\",\"label\":{\"en\":\"Growth rate applied to the prior balance (percent)\",\"ar\":\"معدل النمو المطبق على الرصيد السابق (بالمئة)\"},\"type\":\"percent\",\"required\":false},{\"id\":\"drivers\",\"label\":{\"en\":\"Drivers multiplied together\",\"ar\":\"المحركات المضروبة معاً\"},\"type\":\"table\",\"required\":false,\"columns\":[{\"id\":\"name\",\"label\":{\"en\":\"Driver\",\"ar\":\"المحرك\"},\"type\":\"text\",\"required\":true},{\"id\":\"value\",\"label\":{\"en\":\"Value\",\"ar\":\"القيمة\"},\"type\":\"money\",\"required\":true}]},{\"id\":\"base\",\"label\":{\"en\":\"Base balance\",\"ar\":\"الرصيد الأساس\"},\"type\":\"money\",\"required\":false},{\"id\":\"ratio_pct\",\"label\":{\"en\":\"Ratio applied to the base (percent)\",\"ar\":\"النسبة المطبقة على الأساس (بالمئة)\"},\"type\":\"percent\",\"required\":false},{\"id\":\"components\",\"label\":{\"en\":\"Components summed\",\"ar\":\"المكونات المجمّعة\"},\"type\":\"table\",\"required\":false,\"columns\":[{\"id\":\"name\",\"label\":{\"en\":\"Component\",\"ar\":\"المكوّن\"},\"type\":\"text\",\"required\":true},{\"id\":\"amount\",\"label\":{\"en\":\"Amount\",\"ar\":\"المبلغ\"},\"type\":\"money\",\"required\":true}]},{\"id\":\"threshold_pct\",\"label\":{\"en\":\"Acceptable difference as a share of performance materiality (percent)\",\"ar\":\"الفرق المقبول كنسبة من مادية الأداء (بالمئة)\"},\"type\":\"percent\",\"required\":true,\"default\":\"50\"},{\"id\":\"minimum_amount\",\"label\":{\"en\":\"Acceptable difference, minimum amount\",\"ar\":\"الفرق المقبول، الحد الأدنى\"},\"type\":\"money\",\"required\":false},{\"id\":\"precision\",\"label\":{\"en\":\"Why this expectation is precise enough to identify a material misstatement\",\"ar\":\"لماذا يُعد هذا التوقع دقيقاً بما يكفي لتحديد تحريف جوهري\"},\"type\":\"textarea\",\"required\":true}],\"note\":{\"en\":\"Fill the inputs the chosen model needs, then compute the paper: the expectation, the threshold and the difference are read from the computation and frozen when the paper is prepared.\",\"ar\":\"املأ المدخلات التي يحتاجها النموذج المختار ثم احسب الورقة: يُقرأ التوقع والحد والفرق من الاحتساب وتُثبت عند إعداد الورقة.\"}},{\"id\":\"results\",\"title\":{\"en\":\"The comparison\",\"ar\":\"المقارنة\"},\"fields\":[{\"id\":\"expected\",\"label\":{\"en\":\"Expected balance\",\"ar\":\"الرصيد المتوقع\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.analytical_review.lines.0.expected\",\"readonly\":true},{\"id\":\"threshold\",\"label\":{\"en\":\"Acceptable difference\",\"ar\":\"الفرق المقبول\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.analytical_review.threshold\",\"readonly\":true},{\"id\":\"difference\",\"label\":{\"en\":\"Difference, recorded less expected\",\"ar\":\"الفرق، المسجل ناقص المتوقع\"},\"type\":\"money\",\"required\":false,\"autofill\":\"paper.analytical_review.lines.0.difference\",\"readonly\":true},{\"id\":\"difference_pct\",\"label\":{\"en\":\"Difference as a share of the expectation (percent)\",\"ar\":\"الفرق كنسبة من التوقع (بالمئة)\"},\"type\":\"text\",\"required\":false,\"autofill\":\"paper.analytical_review.lines.0.difference_pct\",\"readonly\":true},{\"id\":\"investigate\",\"label\":{\"en\":\"Difference beyond the acceptable amount\",\"ar\":\"الفرق يتجاوز المقبول\"},\"type\":\"text\",\"required\":false,\"autofill\":\"paper.analytical_review.lines.0.investigate\",\"readonly\":true}]},{\"id\":\"investigation\",\"title\":{\"en\":\"Investigation and conclusion\",\"ar\":\"الفحص والاستنتاج\"},\"fields\":[{\"id\":\"investigation\",\"label\":{\"en\":\"Inquiry of management and the further procedures performed on the difference\",\"ar\":\"الاستفسار من الإدارة والإجراءات الإضافية المنفذة على الفرق\"},\"type\":\"textarea\",\"required\":false,\"required_if\":{\"field\":\"investigate\",\"equals\":true,\"message\":{\"en\":\"a difference beyond the acceptable amount is investigated before the paper is prepared\",\"ar\":\"يُفحص الفرق الذي يتجاوز المقبول قبل إعداد الورقة\"}}},{\"id\":\"corroboration\",\"label\":{\"en\":\"Evidence obtained for management's explanation\",\"ar\":\"الأدلة التي تم الحصول عليها لتفسير الإدارة\"},\"type\":\"textarea\",\"required\":false},{\"id\":\"conclusion\",\"label\":{\"en\":\"Conclusion\",\"ar\":\"الاستنتاج\"},\"type\":\"select\",\"required\":true,\"options\":[{\"value\":\"consistent\",\"label\":{\"en\":\"The recorded balance is consistent with the expectation\",\"ar\":\"الرصيد المسجل متسق مع التوقع\"}},{\"value\":\"explained\",\"label\":{\"en\":\"The difference is explained and corroborated\",\"ar\":\"الفرق مفسر ومدعوم بأدلة\"}},{\"value\":\"misstatement\",\"label\":{\"en\":\"A misstatement is indicated and recorded\",\"ar\":\"يوجد مؤشر على تحريف وتم تسجيله\"}},{\"value\":\"inconclusive\",\"label\":{\"en\":\"Inconclusive: another procedure is performed\",\"ar\":\"غير حاسم: يُنفذ إجراء آخر\"}}]},{\"id\":\"rationale\",\"label\":{\"en\":\"Rationale\",\"ar\":\"المبررات\"},\"type\":\"textarea\",\"required\":true}],\"note\":{\"en\":\"ISA 520.7: a difference beyond the acceptable amount is investigated by inquiring of management and obtaining evidence for the responses, and by other procedures as necessary.\",\"ar\":\"معيار المراجعة الدولي 520.7: يُفحص الفرق الذي يتجاوز المقبول بالاستفسار من الإدارة والحصول على أدلة لردودها، وبإجراءات أخرى عند الحاجة.\"}}],\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F41-CONFIRMATION-RECEIVABLE", "{\"id\":\"F41-CONFIRMATION-RECEIVABLE\",\"number\":41,\"kind\":\"letter\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Receivable confirmation request\",\"ar\":\"طلب مصادقة على رصيد مدين\"},\"purpose\":{\"en\":\"Request a customer's direct confirmation of the balance owed to the entity at the period end, under the auditor's control.\",\"ar\":\"طلب مصادقة العميل مباشرةً على الرصيد المستحق للمنشأة في نهاية الفترة، تحت رقابة المراجع.\"},\"procedures\":[\"P-REV-008\"],\"standards\":[\"ISA-505\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"request\",\"title\":{\"en\":\"The request\",\"ar\":\"الطلب\"},\"fields\":[{\"id\":\"party\",\"label\":{\"en\":\"Customer\",\"ar\":\"العميل\"},\"type\":\"text\",\"required\":true},{\"id\":\"address\",\"label\":{\"en\":\"Address\",\"ar\":\"العنوان\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"reply_to\",\"label\":{\"en\":\"Reply directly to (the auditor's address)\",\"ar\":\"يُرد مباشرةً إلى (عنوان المراجع)\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"request_date\",\"label\":{\"en\":\"Date of the request\",\"ar\":\"تاريخ الطلب\"},\"type\":\"date\",\"required\":true},{\"id\":\"reply_by\",\"label\":{\"en\":\"Reply requested by\",\"ar\":\"الرد مطلوب قبل\"},\"type\":\"date\",\"required\":true},{\"id\":\"balance\",\"label\":{\"en\":\"Balance owed per the entity's records\",\"ar\":\"الرصيد المستحق وفقًا لسجلات المنشأة\"},\"type\":\"money\",\"required\":true},{\"id\":\"balance_date\",\"label\":{\"en\":\"Balance as at\",\"ar\":\"الرصيد في\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"sent\",\"label\":{\"en\":\"Requests sent under this letter\",\"ar\":\"الطلبات المرسلة بموجب هذا الخطاب\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-REQUEST.for.P-REV-008\",\"readonly\":true}]}],\"letter\":{\"en\":[\"To {{field:party}}, {{field:address}}\",\"Our auditors are auditing the financial statements of {{engagement.client}} for the period ended {{engagement.period_end}}. Our records show a balance owed by you of {{field:balance}} {{engagement.currency}} as at {{field:balance_date}}.\",\"Please confirm directly to our auditors whether this balance agrees with your records, and if not, state the amount per your records and the details of any difference.\",\"Please send your reply directly to our auditors at the address below, not to the entity. This request is not a request for payment.\",\"Reply to: {{field:reply_to}}. Please reply by {{field:reply_by}}.\",\"For and on behalf of {{engagement.client}}: ______________________  Date: {{field:request_date}}\",\"Confirmation: the balance stated above agrees with our records / differs as follows: ____________________  Signed: __________  Title: __________  Date: __________\"],\"ar\":[\"إلى {{field:party}}، {{field:address}}\",\"يقوم مراجعونا بمراجعة القوائم المالية لـ {{engagement.client}} عن الفترة المنتهية في {{engagement.period_end}}. وتُظهر سجلاتنا رصيدًا مستحقًا عليكم قدره {{field:balance}} {{engagement.currency}} في {{field:balance_date}}.\",\"يرجى التكرم بالمصادقة مباشرةً لدى مراجعينا على مطابقة هذا الرصيد لسجلاتكم، وإن لم يكن مطابقًا فبيان الرصيد وفقًا لسجلاتكم وتفاصيل أي فرق.\",\"يرجى إرسال ردكم مباشرةً إلى مراجعينا على العنوان أدناه وليس إلى المنشأة. هذا الطلب ليس مطالبة بالسداد.\",\"يُرد إلى: {{field:reply_to}}. يرجى الرد قبل {{field:reply_by}}.\",\"عن وبالنيابة عن {{engagement.client}}: ______________________  التاريخ: {{field:request_date}}\",\"المصادقة: الرصيد الموضح أعلاه مطابق لسجلاتنا / يختلف على النحو التالي: ____________________  التوقيع: __________  الصفة: __________  التاريخ: __________\"]},\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F42-CONFIRMATION-PAYABLE", "{\"id\":\"F42-CONFIRMATION-PAYABLE\",\"number\":42,\"kind\":\"letter\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Payable confirmation request\",\"ar\":\"طلب مصادقة على رصيد دائن\"},\"purpose\":{\"en\":\"Request a supplier's direct statement of the balance owed by the entity at the period end, without stating the entity's own figure, so that unrecorded liabilities surface.\",\"ar\":\"طلب كشف حساب مباشر من المورد بالرصيد المستحق على المنشأة في نهاية الفترة، دون ذكر رقم المنشأة، لتظهر الالتزامات غير المسجلة.\"},\"procedures\":[\"P-PUR-004\"],\"standards\":[\"ISA-505\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"request\",\"title\":{\"en\":\"The request\",\"ar\":\"الطلب\"},\"fields\":[{\"id\":\"party\",\"label\":{\"en\":\"Supplier\",\"ar\":\"المورد\"},\"type\":\"text\",\"required\":true},{\"id\":\"address\",\"label\":{\"en\":\"Address\",\"ar\":\"العنوان\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"reply_to\",\"label\":{\"en\":\"Reply directly to (the auditor's address)\",\"ar\":\"يُرد مباشرةً إلى (عنوان المراجع)\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"request_date\",\"label\":{\"en\":\"Date of the request\",\"ar\":\"تاريخ الطلب\"},\"type\":\"date\",\"required\":true},{\"id\":\"reply_by\",\"label\":{\"en\":\"Reply requested by\",\"ar\":\"الرد مطلوب قبل\"},\"type\":\"date\",\"required\":true},{\"id\":\"balance_date\",\"label\":{\"en\":\"Balance as at\",\"ar\":\"الرصيد في\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"balance\",\"label\":{\"en\":\"Balance per the entity's records (not stated in the letter)\",\"ar\":\"الرصيد وفقًا لسجلات المنشأة (لا يُذكر في الخطاب)\"},\"type\":\"money\",\"required\":true},{\"id\":\"sent\",\"label\":{\"en\":\"Requests sent under this letter\",\"ar\":\"الطلبات المرسلة بموجب هذا الخطاب\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-REQUEST.for.P-PUR-004\",\"readonly\":true}]}],\"letter\":{\"en\":[\"To {{field:party}}, {{field:address}}\",\"Our auditors are auditing the financial statements of {{engagement.client}} for the period ended {{engagement.period_end}}. Please send directly to our auditors a statement of the amount owed to you by the entity as at {{field:balance_date}}, listing the unpaid invoices and any credits.\",\"Please send your reply directly to our auditors at the address below, not to the entity. This request is not a request for payment.\",\"Reply to: {{field:reply_to}}. Please reply by {{field:reply_by}}.\",\"For and on behalf of {{engagement.client}}: ______________________  Date: {{field:request_date}}\"],\"ar\":[\"إلى {{field:party}}، {{field:address}}\",\"يقوم مراجعونا بمراجعة القوائم المالية لـ {{engagement.client}} عن الفترة المنتهية في {{engagement.period_end}}. يرجى إرسال كشف مباشر إلى مراجعينا بالمبلغ المستحق لكم على المنشأة في {{field:balance_date}}، مع بيان الفواتير غير المسددة وأي إشعارات دائنة.\",\"يرجى إرسال ردكم مباشرةً إلى مراجعينا على العنوان أدناه وليس إلى المنشأة. هذا الطلب ليس مطالبة بالسداد.\",\"يُرد إلى: {{field:reply_to}}. يرجى الرد قبل {{field:reply_by}}.\",\"عن وبالنيابة عن {{engagement.client}}: ______________________  التاريخ: {{field:request_date}}\"]},\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F43-CONFIRMATION-DEBT", "{\"id\":\"F43-CONFIRMATION-DEBT\",\"number\":43,\"kind\":\"letter\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Long-term debt confirmation request\",\"ar\":\"طلب مصادقة على الديون طويلة الأجل\"},\"purpose\":{\"en\":\"Request a lender's direct confirmation of the principal outstanding, the interest terms, the security given and the covenants and their compliance at the period end.\",\"ar\":\"طلب مصادقة المقرض مباشرةً على أصل الدين القائم وشروط الفائدة والضمانات المقدمة والتعهدات والالتزام بها في نهاية الفترة.\"},\"procedures\":[\"P-TRE-005\"],\"standards\":[\"ISA-505\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"request\",\"title\":{\"en\":\"The request\",\"ar\":\"الطلب\"},\"fields\":[{\"id\":\"party\",\"label\":{\"en\":\"Lender\",\"ar\":\"المقرض\"},\"type\":\"text\",\"required\":true},{\"id\":\"address\",\"label\":{\"en\":\"Address\",\"ar\":\"العنوان\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"reply_to\",\"label\":{\"en\":\"Reply directly to (the auditor's address)\",\"ar\":\"يُرد مباشرةً إلى (عنوان المراجع)\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"request_date\",\"label\":{\"en\":\"Date of the request\",\"ar\":\"تاريخ الطلب\"},\"type\":\"date\",\"required\":true},{\"id\":\"reply_by\",\"label\":{\"en\":\"Reply requested by\",\"ar\":\"الرد مطلوب قبل\"},\"type\":\"date\",\"required\":true},{\"id\":\"facility\",\"label\":{\"en\":\"Facility and reference\",\"ar\":\"التسهيل ومرجعه\"},\"type\":\"text\",\"required\":true},{\"id\":\"principal\",\"label\":{\"en\":\"Principal outstanding per the entity's records\",\"ar\":\"أصل الدين القائم وفقًا لسجلات المنشأة\"},\"type\":\"money\",\"required\":true},{\"id\":\"balance_date\",\"label\":{\"en\":\"Balance as at\",\"ar\":\"الرصيد في\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"sent\",\"label\":{\"en\":\"Requests sent under this letter\",\"ar\":\"الطلبات المرسلة بموجب هذا الخطاب\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-REQUEST.for.P-TRE-005\",\"readonly\":true}]}],\"letter\":{\"en\":[\"To {{field:party}}, {{field:address}}\",\"Our auditors are auditing the financial statements of {{engagement.client}} for the period ended {{engagement.period_end}}. Please confirm directly to our auditors, for facility {{field:facility}}, the principal outstanding as at {{field:balance_date}} (our records show {{field:principal}} {{engagement.currency}}), the accrued interest, the interest rate and repayment terms, the security held, the covenants and whether any was breached, and any guarantees given.\",\"Please send your reply directly to our auditors at the address below, not to the entity. This request is not a request for payment.\",\"Reply to: {{field:reply_to}}. Please reply by {{field:reply_by}}.\",\"For and on behalf of {{engagement.client}}: ______________________  Date: {{field:request_date}}\"],\"ar\":[\"إلى {{field:party}}، {{field:address}}\",\"يقوم مراجعونا بمراجعة القوائم المالية لـ {{engagement.client}} عن الفترة المنتهية في {{engagement.period_end}}. يرجى المصادقة مباشرةً لدى مراجعينا، بشأن التسهيل {{field:facility}}، على أصل الدين القائم في {{field:balance_date}} (تُظهر سجلاتنا {{field:principal}} {{engagement.currency}})، والفوائد المستحقة، وسعر الفائدة وشروط السداد، والضمانات المحتفظ بها، والتعهدات وما إذا أُخل بأي منها، وأي كفالات مقدمة.\",\"يرجى إرسال ردكم مباشرةً إلى مراجعينا على العنوان أدناه وليس إلى المنشأة. هذا الطلب ليس مطالبة بالسداد.\",\"يُرد إلى: {{field:reply_to}}. يرجى الرد قبل {{field:reply_by}}.\",\"عن وبالنيابة عن {{engagement.client}}: ______________________  التاريخ: {{field:request_date}}\"]},\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F44-CONFIRMATION-INVENTORY-CONSIGNED", "{\"id\":\"F44-CONFIRMATION-INVENTORY-CONSIGNED\",\"number\":44,\"kind\":\"letter\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Confirmation of inventory consigned to others\",\"ar\":\"مصادقة على مخزون مودع لدى الغير\"},\"purpose\":{\"en\":\"Request a consignee's direct confirmation of the entity's goods it holds on consignment at the period end, by description and quantity.\",\"ar\":\"طلب مصادقة المودَع لديه مباشرةً على بضائع المنشأة التي يحتفظ بها لديه على سبيل الأمانة في نهاية الفترة، بالوصف والكمية.\"},\"procedures\":[\"P-INV-004\"],\"standards\":[\"ISA-501\",\"ISA-505\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"request\",\"title\":{\"en\":\"The request\",\"ar\":\"الطلب\"},\"fields\":[{\"id\":\"party\",\"label\":{\"en\":\"Consignee\",\"ar\":\"المودَع لديه\"},\"type\":\"text\",\"required\":true},{\"id\":\"address\",\"label\":{\"en\":\"Address\",\"ar\":\"العنوان\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"reply_to\",\"label\":{\"en\":\"Reply directly to (the auditor's address)\",\"ar\":\"يُرد مباشرةً إلى (عنوان المراجع)\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"request_date\",\"label\":{\"en\":\"Date of the request\",\"ar\":\"تاريخ الطلب\"},\"type\":\"date\",\"required\":true},{\"id\":\"reply_by\",\"label\":{\"en\":\"Reply requested by\",\"ar\":\"الرد مطلوب قبل\"},\"type\":\"date\",\"required\":true},{\"id\":\"goods\",\"label\":{\"en\":\"Goods per the entity's records\",\"ar\":\"البضائع وفقًا لسجلات المنشأة\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"description\",\"label\":{\"en\":\"Description\",\"ar\":\"الوصف\"},\"type\":\"text\",\"required\":true},{\"id\":\"quantity\",\"label\":{\"en\":\"Quantity\",\"ar\":\"الكمية\"},\"type\":\"text\",\"required\":true},{\"id\":\"location\",\"label\":{\"en\":\"Location\",\"ar\":\"الموقع\"},\"type\":\"text\",\"required\":false}]},{\"id\":\"balance_date\",\"label\":{\"en\":\"As at\",\"ar\":\"في\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"sent\",\"label\":{\"en\":\"Requests sent under this letter\",\"ar\":\"الطلبات المرسلة بموجب هذا الخطاب\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-REQUEST.for.P-INV-004\",\"readonly\":true}]}],\"letter\":{\"en\":[\"To {{field:party}}, {{field:address}}\",\"Our auditors are auditing the financial statements of {{engagement.client}} for the period ended {{engagement.period_end}}. Our records show the following goods of the entity held by you on consignment as at {{field:balance_date}}:\",\"{{table:goods}}\",\"Please confirm directly to our auditors the description, quantity and condition of the goods you hold, whether any lien or charge attaches to them, and the terms under which they are held.\",\"Please send your reply directly to our auditors at the address below, not to the entity. This request is not a request for payment.\",\"Reply to: {{field:reply_to}}. Please reply by {{field:reply_by}}.\",\"For and on behalf of {{engagement.client}}: ______________________  Date: {{field:request_date}}\"],\"ar\":[\"إلى {{field:party}}، {{field:address}}\",\"يقوم مراجعونا بمراجعة القوائم المالية لـ {{engagement.client}} عن الفترة المنتهية في {{engagement.period_end}}. وتُظهر سجلاتنا البضائع التالية للمنشأة المودعة لديكم على سبيل الأمانة في {{field:balance_date}}:\",\"{{table:goods}}\",\"يرجى المصادقة مباشرةً لدى مراجعينا على وصف البضائع التي تحتفظون بها وكميتها وحالتها، وما إذا كان عليها أي حق حبس أو رهن، والشروط التي تُحفظ بموجبها.\",\"يرجى إرسال ردكم مباشرةً إلى مراجعينا على العنوان أدناه وليس إلى المنشأة. هذا الطلب ليس مطالبة بالسداد.\",\"يُرد إلى: {{field:reply_to}}. يرجى الرد قبل {{field:reply_by}}.\",\"عن وبالنيابة عن {{engagement.client}}: ______________________  التاريخ: {{field:request_date}}\"]},\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F45-CONFIRMATION-INVENTORY-HELD", "{\"id\":\"F45-CONFIRMATION-INVENTORY-HELD\",\"number\":45,\"kind\":\"letter\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Confirmation of inventory held by others\",\"ar\":\"مصادقة على مخزون محتفظ به لدى الغير\"},\"purpose\":{\"en\":\"Request a warehouse or custodian's direct confirmation of the entity's goods in its custody at the period end, by description and quantity.\",\"ar\":\"طلب مصادقة المستودع أو أمين الحفظ مباشرةً على بضائع المنشأة في عهدته في نهاية الفترة، بالوصف والكمية.\"},\"procedures\":[\"P-INV-004\"],\"standards\":[\"ISA-501\",\"ISA-505\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"request\",\"title\":{\"en\":\"The request\",\"ar\":\"الطلب\"},\"fields\":[{\"id\":\"party\",\"label\":{\"en\":\"Custodian\",\"ar\":\"أمين الحفظ\"},\"type\":\"text\",\"required\":true},{\"id\":\"address\",\"label\":{\"en\":\"Address\",\"ar\":\"العنوان\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"reply_to\",\"label\":{\"en\":\"Reply directly to (the auditor's address)\",\"ar\":\"يُرد مباشرةً إلى (عنوان المراجع)\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"request_date\",\"label\":{\"en\":\"Date of the request\",\"ar\":\"تاريخ الطلب\"},\"type\":\"date\",\"required\":true},{\"id\":\"reply_by\",\"label\":{\"en\":\"Reply requested by\",\"ar\":\"الرد مطلوب قبل\"},\"type\":\"date\",\"required\":true},{\"id\":\"goods\",\"label\":{\"en\":\"Goods per the entity's records\",\"ar\":\"البضائع وفقًا لسجلات المنشأة\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"description\",\"label\":{\"en\":\"Description\",\"ar\":\"الوصف\"},\"type\":\"text\",\"required\":true},{\"id\":\"quantity\",\"label\":{\"en\":\"Quantity\",\"ar\":\"الكمية\"},\"type\":\"text\",\"required\":true},{\"id\":\"location\",\"label\":{\"en\":\"Warehouse or location\",\"ar\":\"المستودع أو الموقع\"},\"type\":\"text\",\"required\":false}]},{\"id\":\"balance_date\",\"label\":{\"en\":\"As at\",\"ar\":\"في\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"sent\",\"label\":{\"en\":\"Requests sent under this letter\",\"ar\":\"الطلبات المرسلة بموجب هذا الخطاب\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-REQUEST.for.P-INV-004\",\"readonly\":true}]}],\"letter\":{\"en\":[\"To {{field:party}}, {{field:address}}\",\"Our auditors are auditing the financial statements of {{engagement.client}} for the period ended {{engagement.period_end}}. Our records show the following goods of the entity in your custody as at {{field:balance_date}}:\",\"{{table:goods}}\",\"Please confirm directly to our auditors the description and quantity of the goods held, the date of your last physical count, any goods pledged or subject to a lien, and the charges outstanding to you.\",\"Please send your reply directly to our auditors at the address below, not to the entity. This request is not a request for payment.\",\"Reply to: {{field:reply_to}}. Please reply by {{field:reply_by}}.\",\"For and on behalf of {{engagement.client}}: ______________________  Date: {{field:request_date}}\"],\"ar\":[\"إلى {{field:party}}، {{field:address}}\",\"يقوم مراجعونا بمراجعة القوائم المالية لـ {{engagement.client}} عن الفترة المنتهية في {{engagement.period_end}}. وتُظهر سجلاتنا البضائع التالية للمنشأة في عهدتكم في {{field:balance_date}}:\",\"{{table:goods}}\",\"يرجى المصادقة مباشرةً لدى مراجعينا على وصف البضائع المحتفظ بها وكميتها، وتاريخ آخر جرد فعلي أجريتموه، وأي بضائع مرهونة أو خاضعة لحق حبس، والرسوم المستحقة لكم.\",\"يرجى إرسال ردكم مباشرةً إلى مراجعينا على العنوان أدناه وليس إلى المنشأة. هذا الطلب ليس مطالبة بالسداد.\",\"يُرد إلى: {{field:reply_to}}. يرجى الرد قبل {{field:reply_by}}.\",\"عن وبالنيابة عن {{engagement.client}}: ______________________  التاريخ: {{field:request_date}}\"]},\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F46-LEGAL-LETTER", "{\"id\":\"F46-LEGAL-LETTER\",\"number\":46,\"kind\":\"letter\",\"phase\":\"fieldwork\",\"title\":{\"en\":\"Letter of inquiry to legal counsel\",\"ar\":\"خطاب استفسار إلى المستشار القانوني\"},\"purpose\":{\"en\":\"Inquire of the entity's external legal counsel, through a letter the auditor sends, about litigation and claims, their status and the likely outcome, at the period end.\",\"ar\":\"الاستفسار من المستشار القانوني الخارجي للمنشأة، بخطاب يرسله المراجع، عن الدعاوى والمطالبات وحالتها والنتيجة المرجحة في نهاية الفترة.\"},\"procedures\":[\"P-FSL-033\"],\"standards\":[\"ISA-501\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"request\",\"title\":{\"en\":\"The request\",\"ar\":\"الطلب\"},\"fields\":[{\"id\":\"party\",\"label\":{\"en\":\"Legal counsel\",\"ar\":\"المستشار القانوني\"},\"type\":\"text\",\"required\":true},{\"id\":\"address\",\"label\":{\"en\":\"Address\",\"ar\":\"العنوان\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"reply_to\",\"label\":{\"en\":\"Reply directly to (the auditor's address)\",\"ar\":\"يُرد مباشرةً إلى (عنوان المراجع)\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"request_date\",\"label\":{\"en\":\"Date of the request\",\"ar\":\"تاريخ الطلب\"},\"type\":\"date\",\"required\":true},{\"id\":\"reply_by\",\"label\":{\"en\":\"Reply requested by\",\"ar\":\"الرد مطلوب قبل\"},\"type\":\"date\",\"required\":true},{\"id\":\"matters\",\"label\":{\"en\":\"Matters per management's list\",\"ar\":\"المسائل وفقًا لقائمة الإدارة\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"matter\",\"label\":{\"en\":\"Matter\",\"ar\":\"المسألة\"},\"type\":\"text\",\"required\":true},{\"id\":\"status\",\"label\":{\"en\":\"Status per management\",\"ar\":\"الحالة وفقًا للإدارة\"},\"type\":\"text\",\"required\":true},{\"id\":\"exposure\",\"label\":{\"en\":\"Estimated exposure\",\"ar\":\"التعرض المقدر\"},\"type\":\"money\",\"required\":false}]},{\"id\":\"sent\",\"label\":{\"en\":\"Requests sent under this letter\",\"ar\":\"الطلبات المرسلة بموجب هذا الخطاب\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-REQUEST.for.P-FSL-033\",\"readonly\":true}]}],\"letter\":{\"en\":[\"To {{field:party}}, {{field:address}}\",\"In connection with the audit of the financial statements of {{engagement.client}} for the period ended {{engagement.period_end}}, management has prepared the following list of litigation, claims and assessments with which you have been engaged:\",\"{{table:matters}}\",\"Please confirm directly to our auditors whether the list is complete, and for each matter give your evaluation of the likely outcome and an estimate of the financial effect, or state that you cannot. Please also state any unasserted claims you consider probable of assertion, and the amount of any unbilled fees.\",\"Please send your reply directly to our auditors at the address below, not to the entity. This request is not a request for payment.\",\"Reply to: {{field:reply_to}}. Please reply by {{field:reply_by}}.\",\"For and on behalf of {{engagement.client}}: ______________________  Date: {{field:request_date}}\"],\"ar\":[\"إلى {{field:party}}، {{field:address}}\",\"فيما يتعلق بمراجعة القوائم المالية لـ {{engagement.client}} عن الفترة المنتهية في {{engagement.period_end}}، أعدت الإدارة القائمة التالية بالدعاوى والمطالبات والتقييمات التي تولّيتموها:\",\"{{table:matters}}\",\"يرجى المصادقة مباشرةً لدى مراجعينا على اكتمال القائمة، وإبداء تقييمكم للنتيجة المرجحة لكل مسألة وتقدير أثرها المالي، أو بيان تعذر ذلك. كما يرجى بيان أي مطالبات غير مؤكدة ترون احتمال إثارتها، ومبلغ أي أتعاب لم تُفوتر بعد.\",\"يرجى إرسال ردكم مباشرةً إلى مراجعينا على العنوان أدناه وليس إلى المنشأة. هذا الطلب ليس مطالبة بالسداد.\",\"يُرد إلى: {{field:reply_to}}. يرجى الرد قبل {{field:reply_by}}.\",\"عن وبالنيابة عن {{engagement.client}}: ______________________  التاريخ: {{field:request_date}}\"]},\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F47-PREDECESSOR-LETTER", "{\"id\":\"F47-PREDECESSOR-LETTER\",\"number\":47,\"kind\":\"letter\",\"phase\":\"planning\",\"title\":{\"en\":\"Communication with the predecessor auditor\",\"ar\":\"مراسلة المراجع السابق\"},\"purpose\":{\"en\":\"Ask the predecessor auditor, with the client's consent, about matters bearing on the acceptance of the engagement and the opening balances.\",\"ar\":\"سؤال المراجع السابق، بموافقة العميل، عن الأمور المؤثرة في قبول الارتباط وفي الأرصدة الافتتاحية.\"},\"procedures\":[\"P-FSL-004\"],\"standards\":[\"ISA-300\",\"ISA-510\",\"IESBA-CODE\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"request\",\"title\":{\"en\":\"The request\",\"ar\":\"الطلب\"},\"fields\":[{\"id\":\"party\",\"label\":{\"en\":\"Predecessor auditor\",\"ar\":\"المراجع السابق\"},\"type\":\"text\",\"required\":true},{\"id\":\"address\",\"label\":{\"en\":\"Address\",\"ar\":\"العنوان\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"reply_to\",\"label\":{\"en\":\"Reply directly to (the auditor's address)\",\"ar\":\"يُرد مباشرةً إلى (عنوان المراجع)\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"request_date\",\"label\":{\"en\":\"Date of the request\",\"ar\":\"تاريخ الطلب\"},\"type\":\"date\",\"required\":true},{\"id\":\"reply_by\",\"label\":{\"en\":\"Reply requested by\",\"ar\":\"الرد مطلوب قبل\"},\"type\":\"date\",\"required\":true},{\"id\":\"consent_date\",\"label\":{\"en\":\"Date of the client's written consent\",\"ar\":\"تاريخ موافقة العميل الكتابية\"},\"type\":\"date\",\"required\":true},{\"id\":\"prior_period_end\",\"label\":{\"en\":\"Prior period end audited by the predecessor\",\"ar\":\"نهاية الفترة السابقة التي راجعها المراجع السابق\"},\"type\":\"date\",\"required\":true},{\"id\":\"sent\",\"label\":{\"en\":\"Requests sent under this letter\",\"ar\":\"الطلبات المرسلة بموجب هذا الخطاب\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-REQUEST.for.P-FSL-004\",\"readonly\":true}]}],\"letter\":{\"en\":[\"To {{field:party}}, {{field:address}}\",\"We have been asked to accept appointment as auditors of {{engagement.client}} for the period ending {{engagement.period_end}}. The entity gave its written consent on {{field:consent_date}} for you to reply to us.\",\"Please tell us whether there is any professional reason why we should not accept the appointment, and, for the period ended {{field:prior_period_end}}, of any disagreements with management, matters of unlawful acts, significant deficiencies in internal control or unpaid fees, and whether we may review your working papers on the opening balances.\",\"Reply to: {{field:reply_to}}. Please reply by {{field:reply_by}}.\",\"Yours faithfully, the engagement partner.\"],\"ar\":[\"إلى {{field:party}}، {{field:address}}\",\"طُلب منا قبول التعيين مراجعين لـ {{engagement.client}} عن الفترة المنتهية في {{engagement.period_end}}. وقد منحت المنشأة موافقتها الكتابية في {{field:consent_date}} على أن تردوا علينا.\",\"يرجى إفادتنا عما إذا كان هناك سبب مهني يمنع قبولنا التعيين، وعن الفترة المنتهية في {{field:prior_period_end}}، بأي خلافات مع الإدارة أو أمور تتعلق بأفعال غير قانونية أو أوجه قصور جوهرية في الرقابة الداخلية أو أتعاب غير مسددة، وما إذا كان يمكننا الاطلاع على أوراق عملكم بشأن الأرصدة الافتتاحية.\",\"يُرد إلى: {{field:reply_to}}. يرجى الرد قبل {{field:reply_by}}.\",\"وتفضلوا بقبول فائق الاحترام، شريك الارتباط.\"]},\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F48-GOVERNANCE-PLANNING-LETTER", "{\"id\":\"F48-GOVERNANCE-PLANNING-LETTER\",\"number\":48,\"kind\":\"letter\",\"phase\":\"planning\",\"title\":{\"en\":\"Planning letter to those charged with governance\",\"ar\":\"خطاب التخطيط إلى المكلفين بالحوكمة\"},\"purpose\":{\"en\":\"Communicate the planned scope and timing of the audit, the significant risks identified, the team and the auditor's independence to those charged with governance before fieldwork.\",\"ar\":\"إبلاغ المكلفين بالحوكمة بالنطاق والتوقيت المخططين للمراجعة والمخاطر المهمة المحددة والفريق واستقلال المراجع قبل العمل الميداني.\"},\"procedures\":[\"P-FSL-047\"],\"standards\":[\"ISA-260\",\"ISA-300\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"request\",\"title\":{\"en\":\"The letter\",\"ar\":\"الخطاب\"},\"fields\":[{\"id\":\"party\",\"label\":{\"en\":\"Those charged with governance\",\"ar\":\"المكلفون بالحوكمة\"},\"type\":\"text\",\"required\":true},{\"id\":\"address\",\"label\":{\"en\":\"Address\",\"ar\":\"العنوان\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"request_date\",\"label\":{\"en\":\"Date of the letter\",\"ar\":\"تاريخ الخطاب\"},\"type\":\"date\",\"required\":true},{\"id\":\"scope\",\"label\":{\"en\":\"Planned scope and approach\",\"ar\":\"النطاق والمنهج المخططان\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"timing\",\"label\":{\"en\":\"Timing of the audit and the expected report date\",\"ar\":\"توقيت المراجعة وتاريخ التقرير المتوقع\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"significant_risks\",\"label\":{\"en\":\"Significant risks identified\",\"ar\":\"المخاطر المهمة المحددة\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"team\",\"label\":{\"en\":\"The engagement team and its leadership\",\"ar\":\"فريق الارتباط وقيادته\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"independence\",\"label\":{\"en\":\"Statement of independence and safeguards\",\"ar\":\"بيان الاستقلال والضمانات\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"reply_to\",\"label\":{\"en\":\"Contact at the firm\",\"ar\":\"جهة الاتصال بالمكتب\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"reply_by\",\"label\":{\"en\":\"Comments requested by\",\"ar\":\"التعليقات مطلوبة قبل\"},\"type\":\"date\",\"required\":true},{\"id\":\"sent\",\"label\":{\"en\":\"Requests sent under this letter\",\"ar\":\"الطلبات المرسلة بموجب هذا الخطاب\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-REQUEST.for.P-FSL-047\",\"readonly\":true}]}],\"letter\":{\"en\":[\"To {{field:party}}, {{field:address}}\",\"We write ahead of our audit of the financial statements of {{engagement.client}} for the period ending {{engagement.period_end}} to communicate its planned scope and timing.\",\"Scope and approach: {{field:scope}}\",\"Timing: {{field:timing}}\",\"Significant risks identified at this stage: {{field:significant_risks}}\",\"The engagement team: {{field:team}}\",\"Independence: {{field:independence}}\",\"We would welcome your views on these matters and on any area you would like us to consider. Reply to: {{field:reply_to}}. Please reply by {{field:reply_by}}.\",\"Yours faithfully, the engagement partner. Date: {{field:request_date}}\"],\"ar\":[\"إلى {{field:party}}، {{field:address}}\",\"نكتب إليكم قبل مراجعتنا للقوائم المالية لـ {{engagement.client}} عن الفترة المنتهية في {{engagement.period_end}} لإبلاغكم بالنطاق والتوقيت المخططين لها.\",\"النطاق والمنهج: {{field:scope}}\",\"التوقيت: {{field:timing}}\",\"المخاطر المهمة المحددة في هذه المرحلة: {{field:significant_risks}}\",\"فريق الارتباط: {{field:team}}\",\"الاستقلال: {{field:independence}}\",\"يسرنا الاطلاع على آرائكم في هذه الأمور وفي أي مجال ترغبون في أن ننظر فيه. يُرد إلى: {{field:reply_to}}. يرجى الرد قبل {{field:reply_by}}.\",\"وتفضلوا بقبول فائق الاحترام، شريك الارتباط. التاريخ: {{field:request_date}}\"]},\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
    ("F49-DELIVERABLES-LETTER", "{\"id\":\"F49-DELIVERABLES-LETTER\",\"number\":49,\"kind\":\"letter\",\"phase\":\"planning\",\"title\":{\"en\":\"Deliverables letter\",\"ar\":\"خطاب المخرجات\"},\"purpose\":{\"en\":\"Set out in writing, beside the engagement letter, what the firm will deliver and when, what the entity will provide and by when, and the fee basis.\",\"ar\":\"تحديد كتابةً، إلى جانب خطاب الارتباط، ما سيقدمه المكتب ومتى، وما ستوفره المنشأة ومتى، وأساس الأتعاب.\"},\"procedures\":[\"P-FSL-003\"],\"standards\":[\"ISA-210\"],\"sections\":[{\"id\":\"engagement\",\"title\":{\"en\":\"Engagement\",\"ar\":\"الارتباط\"},\"fields\":[{\"id\":\"client\",\"label\":{\"en\":\"Entity audited\",\"ar\":\"المنشأة محل المراجعة\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.client\",\"readonly\":true},{\"id\":\"period_start\",\"label\":{\"en\":\"Period from\",\"ar\":\"الفترة من\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_start\",\"readonly\":true},{\"id\":\"period_end\",\"label\":{\"en\":\"Period to\",\"ar\":\"الفترة إلى\"},\"type\":\"date\",\"required\":false,\"autofill\":\"engagement.period_end\",\"readonly\":true},{\"id\":\"framework\",\"label\":{\"en\":\"Financial reporting framework\",\"ar\":\"إطار التقرير المالي\"},\"type\":\"text\",\"required\":false,\"autofill\":\"engagement.framework\",\"readonly\":true}]},{\"id\":\"request\",\"title\":{\"en\":\"The letter\",\"ar\":\"الخطاب\"},\"fields\":[{\"id\":\"party\",\"label\":{\"en\":\"Addressee at the entity\",\"ar\":\"المرسل إليه في المنشأة\"},\"type\":\"text\",\"required\":true},{\"id\":\"address\",\"label\":{\"en\":\"Address\",\"ar\":\"العنوان\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"request_date\",\"label\":{\"en\":\"Date of the letter\",\"ar\":\"تاريخ الخطاب\"},\"type\":\"date\",\"required\":true},{\"id\":\"deliverables\",\"label\":{\"en\":\"What the firm delivers\",\"ar\":\"ما يقدمه المكتب\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"deliverable\",\"label\":{\"en\":\"Deliverable\",\"ar\":\"المخرج\"},\"type\":\"text\",\"required\":true},{\"id\":\"date\",\"label\":{\"en\":\"Date\",\"ar\":\"التاريخ\"},\"type\":\"date\",\"required\":true}]},{\"id\":\"provided_by_entity\",\"label\":{\"en\":\"What the entity provides, and by when\",\"ar\":\"ما توفره المنشأة ومتى\"},\"type\":\"table\",\"required\":true,\"columns\":[{\"id\":\"item\",\"label\":{\"en\":\"Item\",\"ar\":\"البند\"},\"type\":\"text\",\"required\":true},{\"id\":\"date\",\"label\":{\"en\":\"By\",\"ar\":\"قبل\"},\"type\":\"date\",\"required\":true}]},{\"id\":\"fees\",\"label\":{\"en\":\"Fee basis and billing\",\"ar\":\"أساس الأتعاب والفوترة\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"reply_to\",\"label\":{\"en\":\"Contact at the firm\",\"ar\":\"جهة الاتصال بالمكتب\"},\"type\":\"textarea\",\"required\":true},{\"id\":\"reply_by\",\"label\":{\"en\":\"Acknowledgement requested by\",\"ar\":\"الإقرار مطلوب قبل\"},\"type\":\"date\",\"required\":true},{\"id\":\"sent\",\"label\":{\"en\":\"Requests sent under this letter\",\"ar\":\"الطلبات المرسلة بموجب هذا الخطاب\"},\"type\":\"integer\",\"required\":false,\"autofill\":\"records.RK-REQUEST.for.P-FSL-003\",\"readonly\":true}]}],\"letter\":{\"en\":[\"To {{field:party}}, {{field:address}}\",\"Further to our engagement letter for the audit of {{engagement.client}} for the period ending {{engagement.period_end}}, we set out what we will deliver and when:\",\"{{table:deliverables}}\",\"And what we ask the entity to provide, and by when:\",\"{{table:provided_by_entity}}\",\"Fees: {{field:fees}}\",\"Please acknowledge this letter. Reply to: {{field:reply_to}}. Please reply by {{field:reply_by}}.\",\"Yours faithfully, the engagement partner. Date: {{field:request_date}}\"],\"ar\":[\"إلى {{field:party}}، {{field:address}}\",\"إلحاقًا بخطاب الارتباط الخاص بمراجعة {{engagement.client}} عن الفترة المنتهية في {{engagement.period_end}}، نبين فيما يلي ما سنقدمه ومتى:\",\"{{table:deliverables}}\",\"وما نطلب من المنشأة توفيره ومتى:\",\"{{table:provided_by_entity}}\",\"الأتعاب: {{field:fees}}\",\"يرجى الإقرار باستلام هذا الخطاب. يُرد إلى: {{field:reply_to}}. يرجى الرد قبل {{field:reply_by}}.\",\"وتفضلوا بقبول فائق الاحترام، شريك الارتباط. التاريخ: {{field:request_date}}\"]},\"signoff\":{\"prepare\":[\"partner\",\"manager\",\"senior\",\"staff\"],\"review\":[\"partner\",\"manager\"],\"approve\":[\"partner\"]},\"version\":1,\"ar_status\":\"draft_pending_review\"}"),
  ];

  public func get(id : Text) : ?Text {
    for ((k, v) in FORMS.vals()) { if (k == id) return ?v };
    null
  };
};
